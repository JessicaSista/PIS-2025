@page "/sonda-test"
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http
@inject NavigationManager Navigation
@using System.Net.Http.Json

<PageTitle>Dispositivos Sonda</PageTitle>

<h3>Visualizador Interactivo de Dispositivos</h3>
<p>
    Busca un dispositivo en la lista o selecciónalo directamente para ver sus detalles completos.
</p>


<button class="btn btn-primary px-4 py-2 mb-3" @onclick="CallApi" disabled="@isLoadingList">
    @if (isLoadingList)
    {
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        <span class="ms-2">Cargando Lista...</span>
    }
    else
    {
        <span><i class="fas fa-sync-alt me-2"></i>Obtener Dispositivos</span>
    }
</button>


<button class="btn btn-primary" @onclick="GoToSourcesGroups">
    Ir a Prueba Sources y DeviceGroups
</button>
<hr />

@if (isLoadingList)
{
    <div class="d-flex justify-content-center mt-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando datos...</span>
        </div>
    </div>
}
else if (errorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        <h4><i class="fas fa-exclamation-triangle me-2"></i>Error al Cargar los Datos</h4>
        <p>@errorMessage</p>
    </div>
}
else if (devices != null)
{
    <div class="row g-4">
        <!-- Columna del Menú de Dispositivos -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-list me-2"></i>Menú de Dispositivos (@FilteredDevices.Count())
                </div>
                <div class="card-body">
                    <input type="text" class="form-control mb-3" placeholder="Buscar por nombre..." @bind="searchTerm" @bind:event="oninput" />
                    <div class="list-group" style="max-height: 600px; overflow-y: auto;">
                        @foreach (var device in FilteredDevices)
                        {
                            <button type="button"
                                    class="list-group-item list-group-item-action @(selectedDevice == device ? "active" : "")"
                                    @onclick="() => SelectDevice(device)">
                                @device.Name
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna de Detalles del Dispositivo Seleccionado -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-info-circle me-2"></i>Detalles del Dispositivo
                </div>
                @if (selectedDevice == null)
                {
                    <div class="card-body text-center d-flex align-items-center justify-content-center" style="min-height: 300px;">
                        <div>
                            <h5 class="card-title">Selecciona un dispositivo</h5>
                            <p class="card-text text-muted">Haz clic en un nombre de la lista para ver sus detalles aquí.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-body">
                        <h4>@selectedDevice.Name <span class="badge @(selectedDevice.IsActive ? "bg-success" : "bg-secondary") ms-2">@(selectedDevice.IsActive ? "Activo" : "Inactivo")</span></h4>
                        <p class="text-muted">ID: @selectedDevice.Id | Tipo: @(selectedDevice.Source?.Name ?? "N/A")</p>

                        <!-- Nuevo Botón para Detalles Completos -->
                        <button class="btn btn-outline-info btn-sm" @onclick="GetFullDeviceDetailsAsync" disabled="@isLoadingDetails">
                            @if (isLoadingDetails)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span class="ms-1">Cargando...</span>
                            }
                            else
                            {
                                <i class="fas fa-search-plus me-1"></i>
                            }
                            Ver Detalles Completos
                        </button>
                        <hr />

                        <!-- Área para mostrar los detalles completos -->
                        @if (fullDeviceDetails != null)
                        {
                            <div class="alert alert-info">
                                <h5>Detalles Adicionales</h5>
                                @if (fullDeviceDetails.Integrations?.Any() == true)
                                {
                                    <p><strong>Integraciones:</strong></p>
                                    <ul>
                                        @foreach (var integration in fullDeviceDetails.Integrations)
                                        {
                                            <li>@integration.Name (@integration.ExternalId)</li>
                                        }
                                    </ul>
                                }
                                @if (fullDeviceDetails.SendConfigurations?.Any() == true)
                                {
                                    <p><strong>Configuraciones de Envío:</strong></p>
                                    <ul>
                                        @foreach (var config in fullDeviceDetails.SendConfigurations)
                                        {
                                            <li>@config.Name: <code>@config.Configuration</code></li>
                                        }
                                    </ul>
                                }
                            </div>
                        }

                        @if (selectedDevice.Sensors?.Any() == true)
                        {
                            <h6 class="mt-4">Sensores (@selectedDevice.Sensors.Count)</h6>
                            <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                                <table class="table table-sm table-bordered table-striped">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Nombre a Mostrar</th>
                                            <th>Tipo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var sensor in selectedDevice.Sensors)
                                        {
                                            <tr>
                                                <td>@sensor.DisplayName</td>
                                                <td><span class="badge bg-secondary">@sensor.Type</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool isLoadingList = false;
    private bool isLoadingDetails = false;
    private List<Device>? devices;
    private string? errorMessage;
    private Device? selectedDevice;
    private Device? fullDeviceDetails;

    private string searchTerm = "";
    private IEnumerable<Device> FilteredDevices =>
        devices?.Where(d => string.IsNullOrWhiteSpace(searchTerm) ||
                              (d.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
        ?? Enumerable.Empty<Device>();

    private void SelectDevice(Device device)
    {
        selectedDevice = device;
        fullDeviceDetails = null;
    }

    private async Task GetFullDeviceDetailsAsync()
    {
        if (selectedDevice == null) return;

        isLoadingDetails = true;
        fullDeviceDetails = null;
        errorMessage = null;

        string username = "admin";
        string password = "admin";

        try
        {
            fullDeviceDetails = await Http.GetFromJsonAsync<Device>($"api/SondaMain/devices/{selectedDevice.Id}");
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudieron cargar los detalles para el dispositivo {selectedDevice.Id}. Error: {ex.Message}";
        }
        finally
        {
            isLoadingDetails = false;
        }
    }

    private async Task CallApi()
    {
        isLoadingList = true;
        devices = null;
        errorMessage = null;
        selectedDevice = null;
        fullDeviceDetails = null;

        int pageNumber = 1;
        string username = "admin";
        string password = "admin";

        try
        {
            var url = $"api/SondaMain/devices?page={pageNumber}&user={username}&pass={password}";
            devices = await Http.GetFromJsonAsync<List<Device>>(url);
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error al cargar los datos: {ex.Message}";
        }
        finally
        {
            isLoadingList = false;
        }
    }

    private void GoToSourcesGroups()
    {
        Navigation.NavigateTo("/sonda-test-sources-groups");
    }
}
