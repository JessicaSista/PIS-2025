@page "/sonda-test"
@inject HttpClient Http
@using System.Net.Http.Json

@*
  Asegúrate de que las clases del modelo (como Device) sean accesibles
  desde tu proyecto Client. Lo ideal es que estén en un proyecto "Shared".
*@
@using OmniMonitor.Shared.Dtos;

<PageTitle>Dispositivos de Sonda</PageTitle>

<h3>Integración con API de Sonda</h3>
<p>
    Presiona el botón para llamar a nuestro backend, el cual a su vez se comunicará con la API de Sonda para obtener la lista de dispositivos.
</p>

<button class="btn btn-primary px-4 py-2" @onclick="CallApi" disabled="@isLoading">
    @if (isLoading)
    {
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        <span class="ms-2">Cargando...</span>
    }
    else
    {
        <span>Llamar a la API 🚀</span>
    }
</button>

<hr />

@if (isLoading)
{
    <p><em>Esperando respuesta del servidor...</em></p>
}

@if (errorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        <h4>Error</h4>
        <p>@errorMessage</p>
    </div>
}

@*
  Esta sección ahora muestra una tabla si la lista de 'devices' no es nula.
*@
@if (devices != null)
{
    <div class="alert alert-success">
        <strong>¡Éxito!</strong> Se encontraron @devices.Count() dispositivos.
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Fuente (Source)</th>
                <th>Estado</th>
                <th>Último Dato Recibido</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var device in devices)
            {
                <tr>
                    <td>@device.Id</td>
                    <td>@device.Name</td>
                    <td>@device.Source?.Name</td>
                    <td>
                        @if (device.IsActive)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </td>
                    <td>@device.LastDataReceived?.ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
}


@code {
    private bool isLoading = false;
    // La variable ahora es una lista de objetos Device, no un string.
    private List<Device>? devices;
    private string? errorMessage;

    private async Task CallApi()
    {
        isLoading = true;
        devices = null;
        errorMessage = null;

        try
        {
            // GetFromJsonAsync maneja la deserialización del JSON automáticamente.
            devices = await Http.GetFromJsonAsync<List<Device>>("api/Sonda/devices");
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió una excepción al conectar con el servidor: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}