            var encodedToken = GetEncodedToken();
            
            var sourcesResponse = await Http.GetAsync($"api/SondaMain/sources?token={encodedToken}");
            Console.WriteLine($"[DEBUG EditarDataset] Sources response status: {sourcesResponse.StatusCode}");
            
            if (sourcesResponse.IsSuccessStatusCode)
            {
