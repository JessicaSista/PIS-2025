                    }
                    
                    if (existenteUM.DatasetNews != null && existenteUM.DatasetNews.Any())
                    {
                        selectedNewsIds = new HashSet<int>(existenteUM.DatasetNews.Select(dn => dn.Id_news));
                    }
                    
                    return true;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading as UM: {ex.Message}");
        }
        return false;
    }

    private async Task LoadSourcesAndGroups()
