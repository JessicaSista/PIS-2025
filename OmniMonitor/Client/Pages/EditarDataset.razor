@page "/editarDataset/{id:int}"
@using OmniMonitor.Shared.Dtos
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Blazored.LocalStorage
@using OmniMonitor.Shared.Dtos.AM
@using OmniMonitor.Shared.Dtos.EM
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http
@using MudBlazor
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Datasets> Localizer
@inject ILocalStorageService LocalStorage


<PageTitle>Editar Dataset</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1 mt-2 mx-4" Style=" font-weight: 500; font-family: Inter, Roboto, sans-serif;">
    @Localizer["EditarDataset"]
</MudText>

<!-- Selector de tipo de dataset -->
<MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Modulo"]</MudText>
<MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
    <MudSelect T="string"
               @bind-Value="selectedTipo"
               Variant="Variant.Outlined"
               Class="flex-grow-1 dark-field"
               InputClass="dark-field-input"
               PopoverClass="dark-field-popover">
        @foreach (var tipo in tiposDataset)
        {
            <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
        }
    </MudSelect>
</MudStack>

@if (cargando)
{
    <MudProgressCircular Class="mx-4" Indeterminate="true" Color="MudBlazor.Color.Primary" />
}
else if (noEncontrado)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mx-4 my-4">
        No se encontró el dataset solicitado.
    </MudAlert>
}
else if (selectedTipo == "Insight Monitor")
{
    <!-- Campo Nombre -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Nombre"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField @bind-Value="addName" Placeholder="@Localizer["AgregarNombre"]"
                      Variant="Variant.Outlined"
                      Class="flex-grow-1 dark-field"
                      MaxLength="50"
                      Required="true" />
    </MudStack>

    <!-- Campo Descripción -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Descripcion"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField T="string"
                      @bind-Value="addDesc"
                      Placeholder="@Localizer["AgregarDescripcion"]"
                      Variant="Variant.Outlined"
                      TextFieldType="MudBlazor.TextFieldType.Multiline"
                      Lines="3"
                      Class="@($"flex-grow-1 dark-field mt-0 {(string.IsNullOrWhiteSpace(addDesc) ? "required-empty" : "")}")"
                      MaxLength="200"
                      Required="true" />
    </MudStack>

    <!-- Cuatro selects en la misma línea: Fuente, Grupo, Dispositivo y Sensor -->
    <MudStack Row Spacing="2" Class="mb-4 mx-4">
        <!-- Fuente -->
        <div style="width: 25%;">
            <MudSelect T="int?"
                       Value="@selectedSourceId"
                       ValueChanged="@OnSourceChanged"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarFuente"]"
                       Class="@($"dark-field")"
                       Required="true">
                @foreach (var source in sources)
                {
                    <MudSelectItem Value="@((int?)source.Id)">@source.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Grupo -->
        <div style="width: 25%;">
            <MudSelect T="int?"
                       Value="@selectedGroupId"
                       ValueChanged="@OnGroupChanged"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarGrupo"]"
                       Class="dark-field">
                @foreach (var group in deviceGroups)
                {
                    <MudSelectItem Value="@((int?)group.Id)">@group.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Dispositivo -->
        <div style="width: 25%;">
            <MudSelect T="int"
                       SelectedValues="selectedDeviceIds"
                       SelectedValuesChanged="OnSelectedDevicesChanged"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarDispositivo"]"
                       Class="dark-field"
                       Disabled="@(!selectedSourceId.HasValue)"
                       ToStringFunc="@(id => devices.FirstOrDefault(d => d.Id == id)?.Name ?? id.ToString())">
                @foreach (var device in devices)
                {
                    <MudSelectItem T="int" Value="@device.Id">@device.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Sensor -->
        <div style="width: 25%;">
            <MudSelect T="string"
                       @bind-Value="selectedSensor"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarSensor"]"
                       Class="@($"dark-field")"
                       Disabled="@(!selectedSourceId.HasValue)"
                       Required="true">
                @foreach (var sensor in sensores)
                {
                    <MudSelectItem Value="@sensor">@sensor</MudSelectItem>
                }
            </MudSelect>
        </div>
    </MudStack>

    <div class="mb-4 mx-4" style="display: flex; justify-content: flex-end; gap: 12px;">
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="MudBlazor.Color.Secondary">
            @Localizer["Cancelar"]
        </MudButton>
        <MudButton OnClick="GuardarCambios"
                   Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   Disabled="@(!selectedSourceId.HasValue || string.IsNullOrWhiteSpace(selectedSensor) || string.IsNullOrWhiteSpace(addDesc) || string.IsNullOrWhiteSpace(addName))">
            @Localizer["GuardarCambios"]
        </MudButton>
    </div>
}

@if (!string.IsNullOrEmpty(selectedTipo) && selectedTipo == "Asset Manager")
{
    <!-- Campo Nombre -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Nombre"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField @bind-Value="addName" Placeholder="@Localizer["AgregarNombre"]"
                      Variant="Variant.Outlined"
                      Class="flex-grow-1 dark-field"
                      MaxLength="50"
                      Required="true" />
    </MudStack>

    <!-- Campo Descripción -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Descripcion"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField T="string"
                      @bind-Value="addDesc"
                      Placeholder="@Localizer["AgregarDescripcion"]"
                      Variant="Variant.Outlined"
                      TextFieldType="MudBlazor.TextFieldType.Multiline"
                      Lines="3"
                      Class="@($"flex-grow-1 dark-field mt-0 {(string.IsNullOrWhiteSpace(addDesc) ? "required-empty" : "")}")"
                      MaxLength="200"
                      Required="true" />
    </MudStack>

    <!-- Toggle de modo: Asset vs Event Task -->
    <MudStack Row Spacing="2" Class="mb-1 mx-4">
        <MudButton Variant="@(amMode == 2 ? Variant.Filled : Variant.Outlined)" Color="MudBlazor.Color.Primary" OnClick="() => SetAmMode(2)">Asset</MudButton>
        <MudButton Variant="@(amMode == 1 ? Variant.Filled : Variant.Outlined)" Color="MudBlazor.Color.Primary" OnClick="() => SetAmMode(1)">Event Task</MudButton>
    </MudStack>

    @if (amMode == 2)
    {
        <!-- Asset Manager: AssetType (req) -> Assets (multi, opcional) -->
        <MudStack Row Spacing="2" Class="mb-4 mx-4">
            <div style="width: 50%;">
                <MudSelect T="int?"
                           Value="@selectedAssetTypeId"
                           ValueChanged="OnAssetTypeChanged"
                           Variant="Variant.Outlined"
                           FullWidth="true"
                           Clearable
                           Label="Seleccionar tipo de Asset"
                           Class="dark-field"
                           Required="true">
                    @foreach (var t in assetTypes)
                    {
                        <MudSelectItem Value="@((int?)t.Id)">@t.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div style="width: 50%;">
                <MudSelect T="string"
                           SelectedValues="selectedAssetIds"
                           SelectedValuesChanged="OnSelectedAssetsChanged"
                           Variant="Variant.Outlined"
                           MultiSelection="true"
                           SelectAll="true"
                           SelectAllText="Seleccionar todos"
                           Clearable
                           FullWidth="true"
                           Disabled="@(!selectedAssetTypeId.HasValue)"
                           Label="Seleccionar Asset(s)"
                           Class="dark-field"
                           ToStringFunc="@(id => assets.FirstOrDefault(a => a.Id == id)?.Name ?? id)">
                    @foreach (var a in assets)
                    {
                        <MudSelectItem T="string" Value="@a.Id">@a.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </MudStack>
    }
    else if (amMode == 1)
    {
        <!-- Asset Manager: Event Task flow -->
        <MudStack Row Spacing="2" Class="mb-4 mx-4">
            <div style="width: 33.33%;">
                <MudSelect T="int?"
                           Value="@selectedTaskTypeId"
                           ValueChanged="OnTaskTypeChanged"
                           Variant="Variant.Outlined"
                           FullWidth="true"
                           Label="Seleccionar Task Type"
                           Clearable
                           Class="dark-field"
                           Required="true">
                    @foreach (var t in taskTypes)
                    {
                        <MudSelectItem Value="@((int?)t.Id)">@t.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div style="width: 33.33%;">
                <MudSelect T="int"
                           SelectedValues="selectedEventTaskInstanceIds"
                           SelectedValuesChanged="OnSelectedEventTaskInstancesChanged"
                           Variant="Variant.Outlined"
                           MultiSelection="true"
                           SelectAll="true"
                           SelectAllText="Seleccionar todos"
                           Clearable
                           FullWidth="true"
                           Disabled="@(!selectedTaskTypeId.HasValue)"
                           Label="Seleccionar Event Task Instance(s)"
                           Class="dark-field"
                           ToStringFunc="@(id => GetEventTaskInstanceDisplayName(id))">
                    @foreach (var e in eventTaskInstances)
                    {
                        <MudSelectItem T="int" Value="@e.Id">@GetEventTaskInstanceDisplayName(e.Id)</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div style="width: 33.33%;">
                <MudSelect T="int"
                           SelectedValues="selectedStockIds"
                           SelectedValuesChanged="OnSelectedStocksChanged"
                           Variant="Variant.Outlined"
                           MultiSelection="true"
                           Clearable
                           FullWidth="true"
                           Disabled="@(!EnableStocksSelect)"
                           Label="Seleccionar Stock(s)"
                           Class="dark-field"
                           ToStringFunc="@(id => stocks.FirstOrDefault(s => s.Id == id)?.Name ?? id.ToString())">
                    @foreach (var s in stocks)
                    {
                        <MudSelectItem T="int" Value="@s.Id">@s.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </MudStack>
    }

    <div class="mb-4 mx-4" style="display: flex; justify-content: flex-end; gap: 12px;">
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="MudBlazor.Color.Secondary">
            @Localizer["Cancelar"]
        </MudButton>
        <MudButton OnClick="GuardarCambiosAM"
                   Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   Disabled="@(!CanSaveAM)">
            @Localizer["GuardarCambios"]
        </MudButton>
    </div>
}

@if (!string.IsNullOrEmpty(selectedTipo) && selectedTipo == "Urban Monitor")
{
    <!-- Campo Nombre -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Nombre"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField @bind-Value="addName" Placeholder="@Localizer["AgregarNombre"]"
                      Variant="Variant.Outlined"
                      Class="flex-grow-1 dark-field"
                      MaxLength="50"
                      Required="true" />
    </MudStack>

    <!-- Campo Descripción -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Descripcion"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField T="string"
                      @bind-Value="addDesc"
                      Placeholder="@Localizer["AgregarDescripcion"]"
                      Variant="Variant.Outlined"
                      TextFieldType="MudBlazor.TextFieldType.Multiline"
                      Lines="3"
                      Class="@($"flex-grow-1 dark-field mt-0 {(string.IsNullOrWhiteSpace(addDesc) ? "required-empty" : "")}")"
                      MaxLength="200"
                      Required="true" />
    </MudStack>

    <!-- Tres selects: Zona, Eventos y Noticias -->
    <MudStack Row Spacing="2" Class="mb-4 mx-4">
        <!-- Zona -->
        <div style="width: 33.33%;">
            <MudSelect T="int?"
                       Value="@selectedZoneId"
                       ValueChanged="OnZoneChanged"
                       Variant="Variant.Outlined"
                       FullWidth="true"
                       Clearable
                       Label="Seleccionar Zona"
                       Class="dark-field"
                       Required="true">
                @foreach (var zone in zones)
                {
                    <MudSelectItem Value="@((int?)zone.Id)">@zone.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Eventos -->
        <div style="width: 33.33%;">
            <MudSelect T="int"
                       SelectedValues="selectedEventIds"
                       SelectedValuesChanged="OnSelectedEventsChanged"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       SelectAll="true"
                       SelectAllText="Seleccionar todos"
                       Clearable
                       FullWidth="true"
                       Disabled="@(!selectedZoneId.HasValue)"
                       Label="Seleccionar Evento(s)"
                       Class="dark-field"
                       ToStringFunc="@(id => events.FirstOrDefault(e => e.Id == id)?.Name ?? id.ToString())">
                @foreach (var evt in events)
                {
                    <MudSelectItem T="int" Value="@evt.Id">@evt.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Noticias -->
        <div style="width: 33.33%;">
            <MudSelect T="int"
                       SelectedValues="selectedNewsIds"
                       SelectedValuesChanged="OnSelectedNewsChanged"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       SelectAll="true"
                       SelectAllText="Seleccionar todos"
                       Clearable
                       FullWidth="true"
                       Disabled="@(!selectedZoneId.HasValue)"
                       Label="Seleccionar Noticia(s)"
                       Class="dark-field"
                       ToStringFunc="@(id => newsList.FirstOrDefault(n => n.Id == id)?.Title ?? id.ToString())">
                @foreach (var news in newsList)
                {
                    <MudSelectItem T="int" Value="@news.Id">@news.Title</MudSelectItem>
                }
            </MudSelect>
        </div>
    </MudStack>

    <div class="mb-4 mx-4" style="display: flex; justify-content: flex-end; gap: 12px;">
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="MudBlazor.Color.Secondary">
            @Localizer["Cancelar"]
        </MudButton>
        <MudButton OnClick="GuardarCambiosUM"
                   Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   Disabled="@(!CanSaveUM)">
            @Localizer["GuardarCambios"]
        </MudButton>
    </div>
}

@if (!string.IsNullOrEmpty(selectedTipo) && selectedTipo == "Event Manager")
{
    <!-- Campo Nombre -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Nombre"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField @bind-Value="addName" Placeholder="@Localizer["AgregarNombre"]"
                      Variant="Variant.Outlined"
                      Class="flex-grow-1 dark-field"
                      MaxLength="50"
                      Required="true" />
    </MudStack>

    <!-- Campo Descripción -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Descripcion"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField T="string"
                      @bind-Value="addDesc"
                      Placeholder="@Localizer["AgregarDescripcion"]"
                      Variant="Variant.Outlined"
                      TextFieldType="MudBlazor.TextFieldType.Multiline"
                      Lines="3"
                      Class="@($"flex-grow-1 dark-field mt-0 {(string.IsNullOrWhiteSpace(addDesc) ? "required-empty" : "")}")"
                      MaxLength="200"
                      Required="true" />
    </MudStack>

    <!-- Cuatro selects: Categoria, Eventos, Alertas y Extensiones -->
    <MudStack Row Spacing="2" Class="mb-4 mx-4">
        <!-- Categoria -->
        <div style="width: 25%;">
            <MudSelect T="int?"
                       Value="@selectedCategoryId"
                       ValueChanged="OnCategoryChanged"
                       Variant="Variant.Outlined"
                       FullWidth="true"
                       Clearable
                       Label="Seleccionar Categoria"
                       Class="dark-field"
                       Required="true">
                @foreach (var category in categories)
                {
                    <MudSelectItem Value="@((int?)category.Id)">@category.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Eventos -->
        <div style="width: 25%;">
            <MudSelect T="int"
                       SelectedValues="selectedEventEMIds"
                       SelectedValuesChanged="OnSelectedEventEMsChanged"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       SelectAll="true"
                       SelectAllText="Seleccionar todos"
                       Clearable
                       FullWidth="true"
                       Disabled="@(!selectedCategoryId.HasValue)"
                       Label="Seleccionar Evento(s)"
                       Class="dark-field"
                       ToStringFunc="@(id => eventsEM.FirstOrDefault(e => e.Id == id)?.Name ?? id.ToString())">
                @foreach (var evt in eventsEM)
                {
                    <MudSelectItem T="int" Value="@evt.Id">@evt.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Alertas -->
        <div style="width: 25%;">
            <MudSelect T="int"
                       SelectedValues="selectedAlertIds"
                       SelectedValuesChanged="OnSelectedAlertsChanged"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       SelectAll="true"
                       SelectAllText="Seleccionar todos"
                       Clearable
                       FullWidth="true"
                       Disabled="@(!selectedCategoryId.HasValue)"
                       Label="Seleccionar Alerta(s)"
                       Class="dark-field"
                       ToStringFunc="@(id => GetAlertDisplayName(id))">
                @foreach (var alert in alertsEM)
                {
                    <MudSelectItem T="int" Value="@alert.AlertId">@GetAlertDisplayName(alert.AlertId)</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Extensiones -->
        <div style="width: 25%;">
            <MudSelect T="int"
                       SelectedValues="selectedExtensionIds"
                       SelectedValuesChanged="OnSelectedExtensionsChanged"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       SelectAll="true"
                       SelectAllText="Seleccionar todos"
                       Clearable
                       FullWidth="true"
                       Disabled="@(!EnableExtensionsSelect)"
                       Label="Seleccionar Extension(es)"
                       Class="dark-field"
                       ToStringFunc="@(id => GetExtensionDisplayName(id))">
                @foreach (var ext in extensions)
                {
                    <MudSelectItem T="int" Value="@ext.Id">@GetExtensionDisplayName(ext.Id)</MudSelectItem>
                }
            </MudSelect>
        </div>
    </MudStack>

    <div class="mb-4 mx-4" style="display: flex; justify-content: flex-end; gap: 12px;">
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="MudBlazor.Color.Secondary">
            @Localizer["Cancelar"]
        </MudButton>
        <MudButton OnClick="GuardarCambiosEM"
                   Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   Disabled="@(!CanSaveEM)">
            @Localizer["GuardarCambios"]
        </MudButton>
    </div>
}

@code {
    [Parameter] public int id { get; set; }
    
    [SupplyParameterFromQuery(Name = "module")]
    public string? ModuleHint { get; set; }

    private string selectedTipo = "Insight Monitor";
    private List<string> tiposDataset = new() { "Insight Monitor", "Asset Manager", "Urban Monitor", "Event Manager" };

    // Listas dinámicas desde la API
    private List<Source> sources = new();
    private List<DeviceGroup> deviceGroups = new();
    private List<Device> devices = new();

    // Valores seleccionados (ahora son IDs)
    private int? selectedSourceId = null;
    private int? selectedGroupId = null;
    private HashSet<int> selectedDeviceIds = new();

    private string selectedSensor = string.Empty;
    private List<string> sensores = new();

    private string addName = string.Empty;
    private string addDesc = string.Empty;

    private bool cargando = true;
    private bool noEncontrado = false;

    // Credenciales del usuario / token logic from develop
    private string currentUsername = string.Empty;
    private string authToken = string.Empty;
    private string GetEncodedToken() => Uri.EscapeDataString(authToken ?? "");

    // AM UI State (kept from HEAD)
    // amMode: 1 = Event Task, 2 = Asset
    private int amMode = 2;

    // Asset flow
    private List<AssetTypeDto> assetTypes = new();
    private int? selectedAssetTypeId = null;
    private List<AssetDto> assets = new();
    private HashSet<string> selectedAssetIds = new();

    // Event Task flow
    private List<TaskTypeDto> taskTypes = new();
    private int? selectedTaskTypeId = null;
    private List<EventTaskInstanceDto> eventTaskInstances = new();
    private HashSet<int> selectedEventTaskInstanceIds = new();
    private List<EventTaskInstanceStockDto> stocks = new();
    private HashSet<int> selectedStockIds = new();

    // UM UI State
    private List<Zone> zones = new();
    private int? selectedZoneId = null;
    private List<Event> events = new();
    private HashSet<int> selectedEventIds = new();
    private List<News> newsList = new();
    private HashSet<int> selectedNewsIds = new();

    // EM UI State
    private List<CategoryDto> categories = new();
    private int? selectedCategoryId = null;
    private List<EventDto> eventsEM = new();
    private HashSet<int> selectedEventEMIds = new();
    private List<AlertDto> alertsEM = new();
    private HashSet<int> selectedAlertIds = new();
    private List<ExtensionDtoDup> extensions = new();
    private HashSet<int> selectedExtensionIds = new();

    private bool EnableStocksSelect => selectedEventTaskInstanceIds.Count == 1;

    private bool CanSaveUM
    {
        get
        {
            if (string.IsNullOrWhiteSpace(addName) || string.IsNullOrWhiteSpace(addDesc)) return false;
            return selectedZoneId.HasValue && (selectedEventIds.Count > 0 || selectedNewsIds.Count > 0);
        }
    }
    

    private bool CanSaveAM
    {
        get
        {
            if (string.IsNullOrWhiteSpace(addName) || string.IsNullOrWhiteSpace(addDesc)) return false;
            if (amMode == 2)
            {
                return selectedAssetTypeId.HasValue;
            }
            // Event Task
            return selectedTaskTypeId.HasValue;
        }
    }

    private bool EnableExtensionsSelect => selectedEventEMIds.Count == 1;

    private string GetExtensionDisplayName(int extensionId)
    {
        var ext = extensions.FirstOrDefault(e => e.Id == extensionId);
        if (ext == null) return extensionId.ToString();
        
        // Show ID and work zone name (most descriptive field for extensions)
        if (!string.IsNullOrWhiteSpace(ext.WorkZoneName))
            return $"#{ext.Id} {ext.WorkZoneName}";
        
        // Fallback to event name if work zone name is not available
        if (!string.IsNullOrWhiteSpace(ext.EventName))
            return $"#{ext.Id} {ext.EventName}";
        
        return $"#{ext.Id}";
    }

    private string GetAlertDisplayName(int alertId)
    {
        var alert = alertsEM.FirstOrDefault(a => a.AlertId == alertId);
        if (alert == null) return alertId.ToString();
        
        // Show ID and alert name
        if (!string.IsNullOrWhiteSpace(alert.AlertName))
            return $"#{alert.AlertId} {alert.AlertName}";
        
        return $"#{alert.AlertId}";
    }

    private string GetEventTaskInstanceDisplayName(int instanceId)
    {
        var instance = eventTaskInstances.FirstOrDefault(e => e.Id == instanceId);
        if (instance == null) return instanceId.ToString();
        
        // Show ID and subject
        if (!string.IsNullOrWhiteSpace(instance.Subject))
            return $"#{instance.Id} {instance.Subject}";
        
        // Fallback to EventTaskDto subject if instance subject is empty
        if (instance.EventTaskDto != null && !string.IsNullOrWhiteSpace(instance.EventTaskDto.Subject))
            return $"#{instance.Id} {instance.EventTaskDto.Subject}";
        
        return $"#{instance.Id}";
    }

    private bool CanSaveEM
    {
        get
        {
            if (string.IsNullOrWhiteSpace(addName) || string.IsNullOrWhiteSpace(addDesc)) return false;
            return selectedCategoryId.HasValue && (selectedEventEMIds.Count > 0 || selectedAlertIds.Count > 0);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            currentUsername = authState.User.Identity?.Name ?? "";

            authToken = await LocalStorage.GetItemAsync<string>("authToken") ?? "";

            if (string.IsNullOrEmpty(currentUsername) || string.IsNullOrEmpty(authToken))
            {
                noEncontrado = true;
                return;
            }

            // NO cargar nada aquí - solo cargaremos lo necesario después de saber el módulo
        }
        catch (Exception ex)
        {
            noEncontrado = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
