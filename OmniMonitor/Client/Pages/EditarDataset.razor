    private async Task LoadDataset()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;
            var token = await LocalStorage.GetItemAsync<string>("authToken") ?? "";

            if (string.IsNullOrEmpty(username))
            {
                noEncontrado = true;
                return;
            }

            bool datasetFound = false;

            // OPTIMIZATION: If no hint from URL, call the super-fast module identification endpoint
            if (string.IsNullOrEmpty(ModuleHint))
            {
                try
                {
                    var moduleResponse = await Http.GetAsync($"api/Dataset/GetDatasetModule?datasetId={id}&token={Uri.EscapeDataString(token)}");
                    if (moduleResponse.IsSuccessStatusCode)
                    {
                        var module = await moduleResponse.Content.ReadFromJsonAsync<string>();
                        if (!string.IsNullOrEmpty(module))
                        {
                            ModuleHint = module;
                            Console.WriteLine($"[PERF] Module identified in DB: {module}");
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[PERF] Error identifying module: {ex.Message}");
                }
            }

            // Si tenemos un hint del módulo, intentar cargar directamente desde ese módulo primero
            if (!string.IsNullOrEmpty(ModuleHint))
            {
                switch (ModuleHint)
                {
                    case "Insight Monitor":
                        datasetFound = await TryLoadAsInsightMonitor(token);
                        break;
                    case "Asset Manager":
                        datasetFound = await TryLoadAsAssetManager(token);
                        break;
                    case "Urban Monitor":
                        datasetFound = await TryLoadAsUrbanMonitor(token);
                        break;
                    case "Event Manager":
                        datasetFound = await TryLoadAsEventManager(token);
                        break;
                }

                // Si se encontró con el hint, terminamos aquí
                if (datasetFound)
                {
                    cargando = false;
                    StateHasChanged();
                    return;
                }
            }

            // Si no hay hint o no se encontró, intentar con todos los módulos
            if (!datasetFound)
            {
                datasetFound = await TryLoadAsInsightMonitor(token);
            }

            if (!datasetFound)
            {
                datasetFound = await TryLoadAsAssetManager(token);
            }

            if (!datasetFound)
            {
                datasetFound = await TryLoadAsUrbanMonitor(token);
            }

            if (!datasetFound)
            {
                datasetFound = await TryLoadAsEventManager(token);
            }

            if (!datasetFound)
            {
                noEncontrado = true;
            }
        }
        catch
        {
            noEncontrado = true;
        }
        finally
        {
            cargando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> TryLoadAsInsightMonitor(string token)
    {
        try
        {
            var response = await Http.GetAsync($"api/Dataset/GetDataset?datasetId={id}&token={Uri.EscapeDataString(token)}");
            if (response.IsSuccessStatusCode)
            {
                var existente = await response.Content.ReadFromJsonAsync<DatasetIM>();
                if (existente != null)
                {
                    selectedTipo = "Insight Monitor";
                    addName = existente.Name ?? string.Empty;
                    addDesc = existente.Description ?? string.Empty;
                    
                    selectedSourceId = existente.Id_Source;
                    selectedGroupId = existente.Id_Group;
                    selectedSensor = existente.SensorName ?? string.Empty;

                    selectedDeviceIds.Clear();
                    if (existente.DatasetDevices != null && existente.DatasetDevices.Any())
                    {
                        selectedDeviceIds = new HashSet<int>(existente.DatasetDevices.Select(dd => dd.Id_device));
                    }

                    // Cargar las listas necesarias en paralelo para mayor velocidad
                    await Task.WhenAll(
                        LoadSourcesAndGroups(),
                        LoadDevices(),
                        LoadSensors()
                    );
                    
                    return true;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading as IM: {ex.Message}");
        }
        return false;
    }

    private async Task<bool> TryLoadAsAssetManager(string token)
    {
        try
        {
            var responseAM = await Http.GetAsync($"api/DatasetAM/GetDatasetAMByIdForEdit?id={id}&token={Uri.EscapeDataString(token)}");
            if (responseAM.IsSuccessStatusCode)
            {
                var existenteAM = await responseAM.Content.ReadFromJsonAsync<DatasetAM>();
                if (existenteAM != null)
                {
                    selectedTipo = "Asset Manager";
                    addName = existenteAM.Nombre ?? string.Empty;
                    addDesc = existenteAM.Descripcion ?? string.Empty;
                    
                    amMode = existenteAM.Type_Dataset;

                    // Cargar solo las listas necesarias para AM
                    await InitializeAMLists();

                    if (amMode == 2)
                    {
                        selectedAssetTypeId = existenteAM.Id_Asset_Type;
                        if (selectedAssetTypeId.HasValue)
                        {
                            await LoadAssetsByType(selectedAssetTypeId.Value);
                        }
                        
                        if (existenteAM.Grupo_Asset != null && existenteAM.Grupo_Asset.Any())
                        {
                            selectedAssetIds = new HashSet<string>(existenteAM.Grupo_Asset.Select(da => da.Id_Asset));
                        }
                    }
                    else if (amMode == 1)
                    {
                        selectedTaskTypeId = existenteAM.Id_Event_Task;
                        if (selectedTaskTypeId.HasValue)
                        {
                            await LoadEventTaskInstancesByType(selectedTaskTypeId.Value);
                        }
                        
                        if (existenteAM.Grupo_Event_Task_Instance != null && existenteAM.Grupo_Event_Task_Instance.Any())
                        {
                            selectedEventTaskInstanceIds = new HashSet<int>(existenteAM.Grupo_Event_Task_Instance.Select(det => det.Id_Event_Task_Instance));
                            
                            if (EnableStocksSelect)
                            {
                                await LoadStocksForEventTaskInstance(selectedEventTaskInstanceIds.First());
                                
                                var firstInstance = existenteAM.Grupo_Event_Task_Instance.First();
                                if (firstInstance.Grupo_Stock != null && firstInstance.Grupo_Stock.Any())
                                {
                                    selectedStockIds = new HashSet<int>(firstInstance.Grupo_Stock.Select(ds => ds.Id_Stock));
                                }
                            }
                        }
                    }
                    
                    return true;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading as AM: {ex.Message}");
        }
        return false;
    }

    private async Task<bool> TryLoadAsUrbanMonitor(string token)
    {
        try
        {
            var responseUM = await Http.GetAsync($"api/DatasetUM/GetDatasetById?datasetId={id}&token={Uri.EscapeDataString(token)}");
            if (responseUM.IsSuccessStatusCode)
            {
                var existenteUM = await responseUM.Content.ReadFromJsonAsync<DatasetUM>();
                if (existenteUM != null)
                {
                    selectedTipo = "Urban Monitor";
                    addName = existenteUM.Name ?? string.Empty;
                    addDesc = existenteUM.Description ?? string.Empty;
                    
                    selectedZoneId = existenteUM.Id_Zone;
                    
                    // Cargar las listas necesarias en paralelo para mayor velocidad
                    var tasksToRun = new List<Task>();
                    tasksToRun.Add(InitializeUMLists());
                    
                    if (selectedZoneId.HasValue)
                    {
                        tasksToRun.Add(LoadEventsByZone(selectedZoneId.Value));
