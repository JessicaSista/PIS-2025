@page "/editarDataset/{id:int}"
@using OmniMonitor.Shared.Dtos
@using Microsoft.AspNetCore.Components
@inject NavigationManager Nav
@inject IJSRuntime JS
@using MudBlazor
@inject ISnackbar Snackbar

<PageTitle>Editar Dataset</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1 mt-2 mx-4" Style="color: #e1e6e7; font-weight: 500; font-family: Inter, Roboto, sans-serif;">
    Editar Dataset
</MudText>

<!-- Selector de tipo de dataset -->
<MudText Typo="Typo.h6" Class="mb-1 mx-4" Style="color: #E5EAEB;">Tipo de Dataset</MudText>
<MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
    <MudSelect T="string"
               @bind-Value="selectedTipo"
               Variant="Variant.Outlined"
               Class="flex-grow-1 dark-field"
               InputClass="dark-field-input"
               PopoverClass="dark-field-popover">
        @foreach (var tipo in tiposDataset)
        {
            <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
        }
    </MudSelect>
</MudStack>

<style>
/* Select y TextFields oscuros */
.dark-field .mud-input-root {
    background-color: #0F172A !important;
    color: #E5EAEB !important;
    border: 1px solid #334155 !important;
    border-radius: 6px;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
}

.dark-field .mud-input-input,
.dark-field .mud-select-value,
.dark-field .mud-select-text {
    color: #E5EAEB !important;
}

/* Placeholder y label */
.dark-field .mud-input-label,
.dark-field .mud-input-placeholder {
    color: #B0B6B6 !important;
}

/* Hover */
.dark-field .mud-input-root:hover {
    box-shadow: 0 0 6px #4A81E9;
    border-color: #4A81E9 !important;
}

/* Popover (dropdown) oscuro */
.dark-field-popover {
    background-color: #1E293B !important;
    color: #E5EAEB !important;
}

.dark-field-popover .mud-list-item {
    color: #E5EAEB !important;
}

.dark-field .mud-input > textarea.mud-input-root-outlined {
    margin-top: 0 !important;
    padding-top: 9px !important;
}
</style>

@if (cargando)
{
    <MudProgressCircular Class="mx-4" Indeterminate="true" Color="MudBlazor.Color.Primary" />
}
else if (noEncontrado)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mx-4 my-4">
        No se encontró el dataset solicitado.
    </MudAlert>
}
else
{
    <!-- Campo Nombre -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4" Style="color: #E5EAEB;">Nombre</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField @bind-Value="addName" Placeholder="Nombre del Dataset"
                      Variant="Variant.Outlined" 
                      Class="flex-grow-1 dark-field"/>
    </MudStack>

    <!-- Campo Descripción -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4" Style="color: #E5EAEB;">Descripción</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField T="string"
            @bind-Value="addDesc"
            Placeholder="Descripción"
            Variant="Variant.Outlined"
            TextFieldType="MudBlazor.TextFieldType.Multiline"
            Lines="3"
            Class="flex-grow-1 dark-field mt-0"
            MaxLength="200" />
    </MudStack>

    <!-- Tres selects en la misma línea: Fuente, Sensor y Dispositivo -->
    <MudStack Row Spacing="2" Class="mb-4 mx-4">
        <!-- Fuente -->
        <div style="width: 33%;">
            <MudSelect T="string" 
                       @bind-Value="selectedFuente" 
                       Variant="Variant.Outlined" 
                       Clearable 
                       FullWidth="true"
                       Label="Seleccionar Fuente"
                       Class="dark-field">
                @foreach (var fuente in fuentesModulo1)
                {
                    <MudSelectItem Value="@fuente">@fuente</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Sensor -->
        <div style="width: 33%;">
            <MudSelect T="string" 
                       @bind-Value="selectedSensor" 
                       Variant="Variant.Outlined" 
                       Clearable 
                       FullWidth="true"
                       Label="Seleccionar Sensor"
                       Class="dark-field">
                @foreach (var sensor in sensores)
                {
                    <MudSelectItem Value="@sensor">@sensor</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Dispositivo -->
        <div style="width: 33%;">
            <MudSelect T="string" 
                       @bind-Value="selectedDispositivo" 
                       Variant="Variant.Outlined" 
                       Clearable 
                       FullWidth="true"
                       Label="Seleccionar Dispositivo"
                       Class="dark-field">
                @foreach (var dispositivo in dispositivos)
                {
                    <MudSelectItem Value="@dispositivo">@dispositivo</MudSelectItem>
                }
            </MudSelect>
        </div>
    </MudStack>

    <div class="mb-4 mx-4" style="display: flex; justify-content: flex-end; gap: 12px;">
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="MudBlazor.Color.Secondary">
            Cancelar
        </MudButton>
        <MudButton OnClick="GuardarCambios" Variant="Variant.Filled" Color="MudBlazor.Color.Primary">
            Guardar Cambios
        </MudButton>
    </div>
}

@code {
    [Parameter] public int id { get; set; }

    private string selectedTipo = "Inside Monitor";
    private List<string> tiposDataset = new() { "Inside Monitor", "Modulo 2", "Modulo 3" };

    private string selectedFuente = string.Empty;
    private List<string> fuentesModulo1 = new() { "Fuente 1", "Fuente 2", "Fuente 3" };

    private string selectedSensor = string.Empty;
    private List<string> sensores = new() { "Sensor 1", "Sensor 2", "Sensor 3" };

    private string selectedDispositivo = string.Empty;
    private List<string> dispositivos = new() { "Dispositivo 1", "Dispositivo 2", "Dispositivo 3" };

    private string addName = string.Empty;
    private string addDesc = string.Empty;

    private bool cargando = true;
    private bool noEncontrado = false;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", "datasets");
            if (string.IsNullOrEmpty(json))
            {
                noEncontrado = true;
                return;
            }

            var lista = System.Text.Json.JsonSerializer.Deserialize<List<DatasetDto>>(json) ?? new();
            var existente = lista.FirstOrDefault(d => d.Id == id);
            if (existente == null)
            {
                noEncontrado = true;
                return;
            }

            // Poblar campos (básicos)
            addName = existente.Nombre ?? string.Empty;
            addDesc = existente.Descripcion ?? string.Empty;
            // selectedTipo/Fuente/Sensor/Dispositivo quedan a criterio (mock)
        }
        catch
        {
            noEncontrado = true;
        }
        finally
        {
            cargando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GuardarCambios()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", "datasets");
            var lista = string.IsNullOrEmpty(json)
                ? new List<DatasetDto>()
                : System.Text.Json.JsonSerializer.Deserialize<List<DatasetDto>>(json)!;

            var idx = lista.FindIndex(d => d.Id == id);
            if (idx >= 0)
            {
                lista[idx].Nombre = addName;
                lista[idx].Descripcion = addDesc;
                // Podrías persistir más campos si existieran en el modelo

                var nuevoJson = System.Text.Json.JsonSerializer.Serialize(lista);
                await JS.InvokeVoidAsync("localStorage.setItem", "datasets", nuevoJson);

                Snackbar.Add($"Dataset '{addName}' actualizado", Severity.Success, cfg =>
                {
                    cfg.SnackbarVariant = Variant.Filled;
                });

                Nav.NavigateTo("/datasets");
            }
            else
            {
                Snackbar.Add("No se encontró el dataset para actualizar", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudo actualizar el dataset: {ex.Message}", Severity.Error);
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/datasets");
    }
}
