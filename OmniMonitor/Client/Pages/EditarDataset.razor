@page "/editarDataset/{id:int}"
@using OmniMonitor.Shared.Dtos
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http
@using MudBlazor
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Editar Dataset</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1 mt-2 mx-4" Style="color: #e1e6e7; font-weight: 500; font-family: Inter, Roboto, sans-serif;">
    Editar Dataset
</MudText>

<!-- Selector de tipo de dataset -->
<MudText Typo="Typo.h6" Class="mb-1 mx-4" Style="color: #E5EAEB;">Tipo de Dataset</MudText>
<MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
    <MudSelect T="string"
               @bind-Value="selectedTipo"
               Variant="Variant.Outlined"
               Class="flex-grow-1 dark-field"
               InputClass="dark-field-input"
               PopoverClass="dark-field-popover">
        @foreach (var tipo in tiposDataset)
        {
            <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
        }
    </MudSelect>
</MudStack>

<style>
/* Select y TextFields oscuros */
.dark-field .mud-input-root {
    background-color: #0F172A !important;
    color: #E5EAEB !important;
    border: 1px solid #334155 !important;
    border-radius: 6px;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
}

.dark-field .mud-input-input,
.dark-field .mud-select-value,
.dark-field .mud-select-text {
    color: #E5EAEB !important;
}

/* Placeholder y label */
.dark-field .mud-input-label,
.dark-field .mud-input-placeholder {
    color: #B0B6B6 !important;
}

/* Hover */
.dark-field .mud-input-root:hover {
    box-shadow: 0 0 6px #4A81E9;
    border-color: #4A81E9 !important;
}

/* Popover (dropdown) oscuro */
.dark-field-popover {
    background-color: #1E293B !important;
    color: #E5EAEB !important;
}

.dark-field-popover .mud-list-item {
    color: #E5EAEB !important;
}

.dark-field .mud-input > textarea.mud-input-root-outlined {
    margin-top: 0 !important;
    padding-top: 9px !important;
}
</style>

@if (cargando)
{
    <MudProgressCircular Class="mx-4" Indeterminate="true" Color="MudBlazor.Color.Primary" />
}
else if (noEncontrado)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mx-4 my-4">
        No se encontró el dataset solicitado.
    </MudAlert>
}
else
{
    <!-- Campo Nombre -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4" Style="color: #E5EAEB;">Nombre</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField @bind-Value="addName" Placeholder="Nombre del Dataset"
                      Variant="Variant.Outlined" 
                      Class="flex-grow-1 dark-field"/>
    </MudStack>

    <!-- Campo Descripción -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4" Style="color: #E5EAEB;">Descripción</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField T="string"
            @bind-Value="addDesc"
            Placeholder="Descripción"
            Variant="Variant.Outlined"
            TextFieldType="MudBlazor.TextFieldType.Multiline"
            Lines="3"
            Class="flex-grow-1 dark-field mt-0"
            MaxLength="200" />
    </MudStack>

    <!-- Cuatro selects en la misma línea: Fuente, Grupo, Dispositivo y Sensor -->
    <MudStack Row Spacing="2" Class="mb-4 mx-4">
        <!-- Fuente -->
        <div style="width: 25%;">
            <MudSelect T="int?" 
                    Value="@selectedSourceId"
                    ValueChanged="@OnSourceChanged"
                    Variant="Variant.Outlined" 
                    FullWidth="true"
                    Label="Seleccionar Fuente *"
                    Class="dark-field"
                    Required="true">
                @foreach (var source in sources)
                {
                    <MudSelectItem Value="@((int?)source.Id)">@source.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Grupo -->
        <div style="width: 25%;">
            <MudSelect T="int?" 
                    Value="@selectedGroupId"
                    ValueChanged="@OnGroupChanged"
                    Variant="Variant.Outlined" 
                    Clearable 
                    FullWidth="true"
                    Label="Seleccionar Grupo"
                    Class="dark-field">
                @foreach (var group in deviceGroups)
                {
                    <MudSelectItem Value="@((int?)group.Id)">@group.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Dispositivo -->
        <div style="width: 25%;">
            <MudSelect T="int?" 
                    @bind-Value="selectedDeviceId"
                    Variant="Variant.Outlined" 
                    Clearable 
                    FullWidth="true"
                    Label="Seleccionar Dispositivo"
                    Class="dark-field">
                @foreach (var device in devices)
                {
                    <MudSelectItem Value="@((int?)device.Id)">@device.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Sensor -->
        <div style="width: 25%;">
            <MudSelect T="string" 
                       @bind-Value="selectedSensor" 
                       Variant="Variant.Outlined" 
                       Clearable 
                       FullWidth="true"
                       Label="Seleccionar Sensor"
                       Class="dark-field">
                @foreach (var sensor in sensores)
                {
                    <MudSelectItem Value="@sensor">@sensor</MudSelectItem>
                }
            </MudSelect>
        </div>
    </MudStack>

    <div class="mb-4 mx-4" style="display: flex; justify-content: flex-end; gap: 12px;">
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="MudBlazor.Color.Secondary">
            Cancelar
        </MudButton>
        <MudButton OnClick="GuardarCambios" Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Disabled="@(!selectedSourceId.HasValue)">
            Guardar Cambios
        </MudButton>
    </div>
}

@code {
    [Parameter] public int id { get; set; }

    private string selectedTipo = "Inside Monitor";
    private List<string> tiposDataset = new() { "Inside Monitor", "Modulo 2", "Modulo 3" };

    // Listas dinámicas desde la API
    private List<Source> sources = new();
    private List<DeviceGroup> deviceGroups = new();
    private List<Device> devices = new();

    // Valores seleccionados (ahora son IDs)
    private int? selectedSourceId = null;
    private int? selectedGroupId = null;
    private int? selectedDeviceId = null;
    
    private string selectedSensor = string.Empty;
    private List<string> sensores = new();

    private string addName = string.Empty;
    private string addDesc = string.Empty;

    private bool cargando = true;
    private bool noEncontrado = false;

    // Credenciales del usuario
    private string currentUsername = string.Empty;
    private string currentPassword = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            currentUsername = authState.User.Identity?.Name ?? "";
            currentPassword = "admin";

            if (string.IsNullOrEmpty(currentUsername))
            {
                noEncontrado = true;
                return;
            }

            // Cargar sources y groups al inicio
            await LoadSourcesAndGroups();
        }
        catch (Exception ex)
        {
            noEncontrado = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadDataset();
    }

    private async Task LoadDataset()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;

            if (string.IsNullOrEmpty(username))
            {
                noEncontrado = true;
                return;
            }

            // Cargar el dataset desde el backend
            var response = await Http.GetAsync($"api/Dataset/{id}/{username}");
            if (!response.IsSuccessStatusCode)
            {
                noEncontrado = true;
                return;
            }

            var existente = await response.Content.ReadFromJsonAsync<Dataset>();
            if (existente == null)
            {
                noEncontrado = true;
                return;
            }

            // Poblar campos básicos
            addName = existente.Name ?? string.Empty;
            addDesc = existente.Description ?? string.Empty;
            
            // Pre-seleccionar los valores de fuente, grupo, dispositivo
            selectedSourceId = existente.Id_Source;
            selectedGroupId = existente.Id_Group;
            selectedSensor = existente.SensorName ?? string.Empty;

            // IMPORTANTE: Establecer selectedDeviceId basado en DatasetDevices
            selectedDeviceId = null; // Inicializar como null por defecto
            
            if (existente.DatasetDevices != null && existente.DatasetDevices.Any())
            {
                selectedDeviceId = existente.DatasetDevices.First().Id_device;
            }

            // Cargar los devices según los filtros seleccionados
            await LoadDevices();
            
            // Cargar los sensores de la fuente seleccionada
            await LoadSensors();
        }
        catch
        {
            noEncontrado = true;
        }
        finally
        {
            cargando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadSourcesAndGroups()
    {
        try
        {
            var sourcesResponse = await Http.GetAsync($"api/SondaMain/sources?user={currentUsername}&password={currentPassword}");
            if (sourcesResponse.IsSuccessStatusCode)
            {
                sources = await sourcesResponse.Content.ReadFromJsonAsync<List<Source>>() ?? new List<Source>();
            }

            var groupsResponse = await Http.GetAsync($"api/SondaMain/groups?user={currentUsername}&password={currentPassword}");
            if (groupsResponse.IsSuccessStatusCode)
            {
                deviceGroups = await groupsResponse.Content.ReadFromJsonAsync<List<DeviceGroup>>() ?? new List<DeviceGroup>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar sources y grupos: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnSourceChanged(int? sourceId)
    {
        selectedSourceId = sourceId;
        await LoadDevices();
        await LoadSensors();
    }

    private async Task OnGroupChanged(int? groupId)
    {
        selectedGroupId = groupId;
        await LoadDevices();
    }

    private async Task LoadDevices()
    {
        try
        {
            List<Device>? devicesFromSource = null;
            List<Device>? devicesFromGroup = null;

            if (selectedSourceId.HasValue)
            {
                var sourceResponse = await Http.GetAsync($"api/SondaMain/devices/source/{selectedSourceId.Value}?user={currentUsername}&password={currentPassword}");
                if (sourceResponse.IsSuccessStatusCode)
                {
                    devicesFromSource = await sourceResponse.Content.ReadFromJsonAsync<List<Device>>();
                }
            }

            if (selectedGroupId.HasValue)
            {
                var groupResponse = await Http.GetAsync($"api/SondaMain/devices/group/{selectedGroupId.Value}?user={currentUsername}&password={currentPassword}");
                if (groupResponse.IsSuccessStatusCode)
                {
                    devicesFromGroup = await groupResponse.Content.ReadFromJsonAsync<List<Device>>();
                }
            }

            // INTERSECCIÓN
            if (devicesFromSource != null && devicesFromGroup != null)
            {
                var deviceIdsFromGroup = new HashSet<int>(devicesFromGroup.Select(d => d.Id));
                devices = devicesFromSource.Where(d => deviceIdsFromGroup.Contains(d.Id)).ToList();
            }
            else if (devicesFromSource != null)
            {
                devices = devicesFromSource;
            }
            else if (devicesFromGroup != null)
            {
                devices = devicesFromGroup;
            }
            else
            {
                var allDevicesResponse = await Http.GetAsync($"api/SondaMain/devices?page=1&user={currentUsername}&password={currentPassword}");
                if (allDevicesResponse.IsSuccessStatusCode)
                {
                    devices = await allDevicesResponse.Content.ReadFromJsonAsync<List<Device>>() ?? new List<Device>();
                }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar dispositivos: {ex.Message}", Severity.Error);
            devices = new List<Device>();
        }
    }

    // Cargar sensores de la fuente seleccionada
    private async Task LoadSensors()
    {
        try
        {
            sensores.Clear();
            selectedSensor = string.Empty;

            if (selectedSourceId.HasValue)
            {
                var sensorsResponse = await Http.GetAsync($"api/SondaMain/sensors/source/{selectedSourceId.Value}?user={currentUsername}&password={currentPassword}");
                if (sensorsResponse.IsSuccessStatusCode)
                {
                    sensores = await sensorsResponse.Content.ReadFromJsonAsync<List<string>>() ?? new List<string>();
                }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar sensores: {ex.Message}", Severity.Error);
            sensores = new List<string>();
        }
    }

    private async Task GuardarCambios()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;

            if (string.IsNullOrEmpty(username))
            {
                Snackbar.Add("No se pudo obtener el usuario actual", Severity.Warning);
                return;
            }

            if (!selectedSourceId.HasValue)
            {
                Snackbar.Add("Debe seleccionar una fuente", Severity.Warning);
                return;
            }

            var request = new CreateDatasetRequest
            {
                Name = addName,
                Username = username,
                Description = addDesc,
                IsDataset = "S",
                ContentType = "0",
                SourceId = selectedSourceId,
                GroupId = selectedGroupId,
                SensorName = selectedSensor,
                DeviceIds = selectedDeviceId.HasValue 
                    ? new List<int> { selectedDeviceId.Value } 
                    : null
            };

            var response = await Http.PutAsJsonAsync($"api/Dataset/{id}", request);

            if (response.IsSuccessStatusCode)
            {
                var updatedDataset = await response.Content.ReadFromJsonAsync<Dataset>();
                Snackbar.Add($"Dataset '{updatedDataset.Name}' actualizado", Severity.Success, cfg =>
                {
                    cfg.SnackbarVariant = Variant.Filled;
                });
                Nav.NavigateTo("/datasets");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al actualizar: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudo actualizar el dataset: {ex.Message}", Severity.Error);
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/datasets");
    }
}