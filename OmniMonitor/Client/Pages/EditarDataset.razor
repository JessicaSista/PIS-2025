    // ====== Event Manager Methods ======

    private async Task<bool> TryLoadAsEventManager(string token)
    {
        try
        {
            var responseEM = await Http.GetAsync($"api/DatasetEM/GetDatasetById?datasetId={id}&token={Uri.EscapeDataString(token)}");
            if (responseEM.IsSuccessStatusCode)
            {
                var existenteEM = await responseEM.Content.ReadFromJsonAsync<DatasetEM>();
                if (existenteEM != null)
                {
                    selectedTipo = "Event Manager";
                    addName = existenteEM.Name ?? string.Empty;
                    addDesc = existenteEM.Description ?? string.Empty;

                    // Load categories first
                    await InitializeEMLists();

                    // If there are existing selections, load them
                    if (existenteEM.DatasetEvents != null && existenteEM.DatasetEvents.Any())
                    {
                        selectedEventEMIds = new HashSet<int>(existenteEM.DatasetEvents.Select(de => de.Id_event));
                        
                        // Try to identify category from first event
                        var firstEventId = existenteEM.DatasetEvents.First().Id_event;
                        await TryIdentifyCategoryFromEvent(firstEventId);
                    }

                    if (existenteEM.DatasetAlerts != null && existenteEM.DatasetAlerts.Any())
                    {
                        selectedAlertIds = new HashSet<int>(existenteEM.DatasetAlerts.Select(da => da.Id_alert));
                        
                        // If category not identified from event, try from alert
                        if (!selectedCategoryId.HasValue)
                        {
                            var firstAlertId = existenteEM.DatasetAlerts.First().Id_alert;
                            await TryIdentifyCategoryFromAlert(firstAlertId);
                        }
                    }

                    if (existenteEM.DatasetExtensions != null && existenteEM.DatasetExtensions.Any())
                    {
                        selectedExtensionIds = new HashSet<int>(existenteEM.DatasetExtensions.Select(de => de.Id_extension));
                    }

                    return true;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading as EM: {ex.Message}");
        }
        return false;
    }

    private async Task TryIdentifyCategoryFromEvent(int eventId)
    {
        try
        {
            // Load all events for each category to find which one contains this event
            foreach (var category in categories)
            {
                await LoadEventsByCategory(category.Id);
                if (eventsEM.Any(e => e.Id == eventId))
                {
                    selectedCategoryId = category.Id;
                    await LoadAlertsByCategory(category.Id);
                    
                    // If only one event selected, load extensions
                    if (selectedEventEMIds.Count == 1)
                    {
                        await LoadExtensionsByEvent(selectedEventEMIds.First());
                    }
                    break;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error identifying category from event: {ex.Message}");
        }
    }

    private async Task TryIdentifyCategoryFromAlert(int alertId)
    {
        try
        {
            // Load all alerts for each category to find which one contains this alert
            foreach (var category in categories)
            {
                await LoadAlertsByCategory(category.Id);
                if (alertsEM.Any(a => a.AlertId == alertId))
                {
                    selectedCategoryId = category.Id;
                    await LoadEventsByCategory(category.Id);
                    break;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error identifying category from alert: {ex.Message}");
        }
    }

    private async Task InitializeEMLists()
    {
        try
        {
            var encodedToken = GetEncodedToken();
            Console.WriteLine($"[DEBUG EM] Token encoded: {encodedToken?.Substring(0, Math.Min(50, encodedToken?.Length ?? 0))}");

            // Load Categories (backend handles Sonda API pagination limitations)
            var url = $"api/SondaEM/category?page=1&pageSize=1000&token={encodedToken}";
            Console.WriteLine($"[DEBUG EM] Calling categories endpoint: {url}");
            
            var respCategories = await Http.GetAsync(url);
            Console.WriteLine($"[DEBUG EM] Categories response status: {respCategories.StatusCode}");
            
            if (respCategories.IsSuccessStatusCode)
            {
                categories = await respCategories.Content.ReadFromJsonAsync<List<CategoryDto>>() ?? new List<CategoryDto>();
                Console.WriteLine($"[DEBUG EM] Loaded {categories.Count} categories");
            }
            else
            {
                var error = await respCategories.Content.ReadAsStringAsync();
                Console.WriteLine($"[DEBUG EM] Categories error: {error}");
                ShowError($"Error al cargar categorías: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DEBUG EM] Exception: {ex.Message}");
            Console.WriteLine($"[DEBUG EM] Stack trace: {ex.StackTrace}");
            ShowError($"Error cargando Event Manager: {ex.Message}");
        }
    }

    private async Task OnCategoryChanged(int? categoryId)
    {
        selectedCategoryId = categoryId;
        selectedEventEMIds.Clear();
        selectedAlertIds.Clear();
        selectedExtensionIds.Clear();
        eventsEM.Clear();
        alertsEM.Clear();
        extensions.Clear();

        if (selectedCategoryId.HasValue)
        {
            await LoadEventsByCategory(selectedCategoryId.Value);
            await LoadAlertsByCategory(selectedCategoryId.Value);
        }

        StateHasChanged();
    }

    private async Task OnSelectedEventEMsChanged(IEnumerable<int> ids)
    {
        selectedEventEMIds = ids != null ? new HashSet<int>(ids) : new HashSet<int>();
