@page "/editarDataset/{id:int}"
@using OmniMonitor.Shared.Dtos
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Blazored.LocalStorage
@using OmniMonitor.Shared.Dtos.AM
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http
@using MudBlazor
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Datasets> Localizer
@inject ILocalStorageService LocalStorage


<PageTitle>Editar Dataset</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1 mt-2 mx-4" Style=" font-weight: 500; font-family: Inter, Roboto, sans-serif;">
    @Localizer["EditarDataset"]
</MudText>

<!-- Selector de tipo de dataset -->
<MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Modulo"]</MudText>
<MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
    <MudSelect T="string"
               @bind-Value="selectedTipo"
               Variant="Variant.Outlined"
               Class="flex-grow-1 dark-field"
               InputClass="dark-field-input"
               PopoverClass="dark-field-popover">
        @foreach (var tipo in tiposDataset)
        {
            <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
        }
    </MudSelect>
</MudStack>

@if (cargando)
{
    <MudProgressCircular Class="mx-4" Indeterminate="true" Color="MudBlazor.Color.Primary" />
}
else if (noEncontrado)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mx-4 my-4">
        No se encontró el dataset solicitado.
    </MudAlert>
}
else if (selectedTipo == "Inside Monitor")
{
    <!-- Campo Nombre -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Nombre"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField @bind-Value="addName" Placeholder="@Localizer["AgregarNombre"]"
                      Variant="Variant.Outlined"
                      Class="flex-grow-1 dark-field"
                      MaxLength="50"
                      Required="true" />
    </MudStack>

    <!-- Campo Descripción -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Descripcion"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField T="string"
                      @bind-Value="addDesc"
                      Placeholder="@Localizer["AgregarDescripcion"]"
                      Variant="Variant.Outlined"
                      TextFieldType="MudBlazor.TextFieldType.Multiline"
                      Lines="3"
                      Class="@($"flex-grow-1 dark-field mt-0 {(string.IsNullOrWhiteSpace(addDesc) ? "required-empty" : "")}")"
                      MaxLength="200"
                      Required="true" />
    </MudStack>

    <!-- Cuatro selects en la misma línea: Fuente, Grupo, Dispositivo y Sensor -->
    <MudStack Row Spacing="2" Class="mb-4 mx-4">
        <!-- Fuente -->
        <div style="width: 25%;">
            <MudSelect T="int?"
                       Value="@selectedSourceId"
                       ValueChanged="@OnSourceChanged"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarFuente"]"
                       Class="@($"dark-field")"
                       Required="true">
                @foreach (var source in sources)
                {
                    <MudSelectItem Value="@((int?)source.Id)">@source.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Grupo -->
        <div style="width: 25%;">
            <MudSelect T="int?"
                       Value="@selectedGroupId"
                       ValueChanged="@OnGroupChanged"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarGrupo"]"
                       Class="dark-field">
                @foreach (var group in deviceGroups)
                {
                    <MudSelectItem Value="@((int?)group.Id)">@group.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Dispositivo -->
        <div style="width: 25%;">
            <MudSelect T="int"
                       SelectedValues="selectedDeviceIds"
                       SelectedValuesChanged="OnSelectedDevicesChanged"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarDispositivo"]"
                       Class="dark-field"
                       ToStringFunc="@(id => devices.FirstOrDefault(d => d.Id == id)?.Name ?? id.ToString())">
                @foreach (var device in devices)
                {
                    <MudSelectItem T="int" Value="@device.Id">@device.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Sensor -->
        <div style="width: 25%;">
            <MudSelect T="string"
                       @bind-Value="selectedSensor"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarSensor"]"
                       Class="@($"dark-field")"
                       Required="true">
                @foreach (var sensor in sensores)
                {
                    <MudSelectItem Value="@sensor">@sensor</MudSelectItem>
                }
            </MudSelect>
        </div>
    </MudStack>

    <div class="mb-4 mx-4" style="display: flex; justify-content: flex-end; gap: 12px;">
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="MudBlazor.Color.Secondary">
            @Localizer["Cancelar"]
        </MudButton>
        <MudButton OnClick="GuardarCambios"
                   Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   Disabled="@(!selectedSourceId.HasValue || string.IsNullOrWhiteSpace(selectedSensor) || string.IsNullOrWhiteSpace(addDesc) || string.IsNullOrWhiteSpace(addName))">
            @Localizer["GuardarCambios"]
        </MudButton>
    </div>
}

@if (!string.IsNullOrEmpty(selectedTipo) && selectedTipo == "Asset Manager")
{
    <!-- Campo Nombre -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Nombre"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField @bind-Value="addName" Placeholder="@Localizer["AgregarNombre"]"
                      Variant="Variant.Outlined"
                      Class="flex-grow-1 dark-field"
                      MaxLength="50"
                      Required="true" />
    </MudStack>

    <!-- Campo Descripción -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Descripcion"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField T="string"
                      @bind-Value="addDesc"
                      Placeholder="@Localizer["AgregarDescripcion"]"
                      Variant="Variant.Outlined"
                      TextFieldType="MudBlazor.TextFieldType.Multiline"
                      Lines="3"
                      Class="@($"flex-grow-1 dark-field mt-0 {(string.IsNullOrWhiteSpace(addDesc) ? "required-empty" : "")}")"
                      MaxLength="200"
                      Required="true" />
    </MudStack>

    <!-- Toggle de modo: Asset vs Event Task -->
    <MudStack Row Spacing="2" Class="mb-1 mx-4">
        <MudButton Variant="@(amMode == 2 ? Variant.Filled : Variant.Outlined)" Color="MudBlazor.Color.Primary" OnClick="() => SetAmMode(2)">Asset</MudButton>
        <MudButton Variant="@(amMode == 1 ? Variant.Filled : Variant.Outlined)" Color="MudBlazor.Color.Primary" OnClick="() => SetAmMode(1)">Event Task</MudButton>
    </MudStack>

    @if (amMode == 2)
    {
        <!-- Asset Manager: AssetType (req) -> Assets (multi, opcional) -->
        <MudStack Row Spacing="2" Class="mb-4 mx-4">
            <div style="width: 50%;">
                <MudSelect T="int?"
                           Value="@selectedAssetTypeId"
                           ValueChanged="OnAssetTypeChanged"
                           Variant="Variant.Outlined"
                           FullWidth="true"
                           Clearable
                           Label="Seleccionar tipo de Asset"
                           Class="dark-field"
                           Required="true">
                    @foreach (var t in assetTypes)
                    {
                        <MudSelectItem Value="@((int?)t.Id)">@t.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div style="width: 50%;">
                <MudSelect T="string"
                           SelectedValues="selectedAssetIds"
                           SelectedValuesChanged="OnSelectedAssetsChanged"
                           Variant="Variant.Outlined"
                           MultiSelection="true"
                           SelectAll="true"
                           SelectAllText="Seleccionar todos"
                           Clearable
                           FullWidth="true"
                           Disabled="@(!selectedAssetTypeId.HasValue)"
                           Label="Seleccionar Asset(s)"
                           Class="dark-field"
                           ToStringFunc="@(id => assets.FirstOrDefault(a => a.Id == id)?.Name ?? id)">
                    @foreach (var a in assets)
                    {
                        <MudSelectItem T="string" Value="@a.Id">@a.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </MudStack>
    }
    else if (amMode == 1)
    {
        <!-- Asset Manager: Event Task flow -->
        <MudStack Row Spacing="2" Class="mb-4 mx-4">
            <div style="width: 33.33%;">
                <MudSelect T="int?"
                           Value="@selectedTaskTypeId"
                           ValueChanged="OnTaskTypeChanged"
                           Variant="Variant.Outlined"
                           FullWidth="true"
                           Label="Seleccionar Task Type"
                           Clearable
                           Class="dark-field"
                           Required="true">
                    @foreach (var t in taskTypes)
                    {
                        <MudSelectItem Value="@((int?)t.Id)">@t.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div style="width: 33.33%;">
                <MudSelect T="int"
                           SelectedValues="selectedEventTaskInstanceIds"
                           SelectedValuesChanged="OnSelectedEventTaskInstancesChanged"
                           Variant="Variant.Outlined"
                           MultiSelection="true"
                           SelectAll="true"
                           SelectAllText="Seleccionar todos"
                           Clearable
                           FullWidth="true"
                           Disabled="@(!selectedTaskTypeId.HasValue)"
                           Label="Seleccionar Event Task Instance(s)"
                           Class="dark-field"
                           ToStringFunc="@(id => {
                               var it = eventTaskInstances.FirstOrDefault(e => e.Id == id);
                               return it?.Subject ?? it?.EventTaskDto?.Subject ?? $"Instance {id}";
                           })">
                    @foreach (var e in eventTaskInstances)
                    {
                        <MudSelectItem T="int" Value="@e.Id">@(string.IsNullOrWhiteSpace(e.Subject) ? (e.EventTaskDto?.Subject ?? $"Instance {e.Id}") : e.Subject)</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div style="width: 33.33%;">
                <MudSelect T="int"
                           SelectedValues="selectedStockIds"
                           SelectedValuesChanged="OnSelectedStocksChanged"
                           Variant="Variant.Outlined"
                           MultiSelection="true"
                           Clearable
                           FullWidth="true"
                           Disabled="@(!EnableStocksSelect)"
                           Label="Seleccionar Stock(s)"
                           Class="dark-field"
                           ToStringFunc="@(id => stocks.FirstOrDefault(s => s.Id == id)?.Name ?? id.ToString())">
                    @foreach (var s in stocks)
                    {
                        <MudSelectItem T="int" Value="@s.Id">@s.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </MudStack>
    }

    <div class="mb-4 mx-4" style="display: flex; justify-content: flex-end; gap: 12px;">
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="MudBlazor.Color.Secondary">
            @Localizer["Cancelar"]
        </MudButton>
        <MudButton OnClick="GuardarCambiosAM"
                   Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   Disabled="@(!CanSaveAM)">
            @Localizer["GuardarCambios"]
        </MudButton>
    </div>
}

@code {
    [Parameter] public int id { get; set; }

    private string selectedTipo = "Inside Monitor";
    private List<string> tiposDataset = new() { "Inside Monitor", "Asset Manager" };

    // Listas dinámicas desde la API
    private List<Source> sources = new();
    private List<DeviceGroup> deviceGroups = new();
    private List<Device> devices = new();

    // Valores seleccionados (ahora son IDs)
    private int? selectedSourceId = null;
    private int? selectedGroupId = null;
    private HashSet<int> selectedDeviceIds = new();
    
    private string selectedSensor = string.Empty;
    private List<string> sensores = new();

    private string addName = string.Empty;
    private string addDesc = string.Empty;

    private bool cargando = true;
    private bool noEncontrado = false;

    // Credenciales del usuario
    private string currentUsername = string.Empty;
    private string currentPassword = string.Empty;
    private string? authToken = null;

    // AM UI State
    // amMode: 1 = Event Task, 2 = Asset
    private int amMode = 2;

    // Asset flow
    private List<AssetTypeDto> assetTypes = new();
    private int? selectedAssetTypeId = null;
    private List<AssetDto> assets = new();
    private HashSet<string> selectedAssetIds = new();

    // Event Task flow
    private List<TaskTypeDto> taskTypes = new();
    private int? selectedTaskTypeId = null;
    private List<EventTaskInstanceDto> eventTaskInstances = new();
    private HashSet<int> selectedEventTaskInstanceIds = new();
    private List<EventTaskInstanceStockDto> stocks = new();
    private HashSet<int> selectedStockIds = new();

    private bool EnableStocksSelect => selectedEventTaskInstanceIds.Count == 1;

    private bool CanSaveAM
    {
        get
        {
            if (string.IsNullOrWhiteSpace(addName) || string.IsNullOrWhiteSpace(addDesc)) return false;
            if (amMode == 2)
            {
                return selectedAssetTypeId.HasValue;
            }
            // Event Task
            return selectedTaskTypeId.HasValue;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            currentUsername = authState.User.Identity?.Name ?? "";
            currentPassword = "admin";
            authToken = await LocalStorage.GetItemAsync<string>("authToken");

            if (string.IsNullOrEmpty(currentUsername))
            {
                noEncontrado = true;
                return;
            }

            if (string.IsNullOrEmpty(authToken))
            {
                ShowError("No se encontró token de sesión. Vuelva a iniciar sesión.");
                noEncontrado = true;
                return;
            }

            // Cargar sources y groups al inicio
            await LoadSourcesAndGroups();
            await InitializeAMLists();
        }
        catch (Exception ex)
        {
            noEncontrado = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadDataset();
    }

    private async Task LoadDataset()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;

            if (string.IsNullOrEmpty(username))
            {
                noEncontrado = true;
                return;
            }

            // Primero intentar cargar como Dataset IM
            var responseIM = await Http.GetAsync($"api/Dataset/{id}/{username}");
            if (responseIM.IsSuccessStatusCode)
            {
                var existente = await responseIM.Content.ReadFromJsonAsync<DatasetIM>();
                if (existente != null)
                {
                    selectedTipo = "Inside Monitor";
                    // Poblar campos básicos
                    addName = existente.Name ?? string.Empty;
                    addDesc = existente.Description ?? string.Empty;
                    
                    // Pre-seleccionar los valores de fuente, grupo, dispositivo
                    selectedSourceId = existente.Id_Source;
                    selectedGroupId = existente.Id_Group;
                    selectedSensor = existente.SensorName ?? string.Empty;

                    // IMPORTANTE: Establecer selectedDeviceIds basado en DatasetDevices
                    selectedDeviceIds.Clear();
                    
                    if (existente.DatasetDevices != null && existente.DatasetDevices.Any())
                    {
                        selectedDeviceIds = new HashSet<int>(existente.DatasetDevices.Select(dd => dd.Id_device));
                    }

                    // Cargar los devices según los filtros seleccionados
                    await LoadDevices();
                    
                    // Cargar los sensores de la fuente seleccionada
                    await LoadSensors();
                    return;
                }
            }

            // Si no es IM, intentar cargar como Dataset AM
            var responseAM = await Http.GetAsync($"api/DatasetAM/{id}/{username}");
            if (responseAM.IsSuccessStatusCode)
            {
                var existenteAM = await responseAM.Content.ReadFromJsonAsync<DatasetAM>();
                if (existenteAM != null)
                {
                    selectedTipo = "Asset Manager";
                    // Poblar campos básicos
                    addName = existenteAM.Nombre ?? string.Empty;
                    addDesc = existenteAM.Descripcion ?? string.Empty;
                    
                    // Determinar el modo (Asset vs Event Task)
                    amMode = existenteAM.Type_Dataset;

                    if (amMode == 2)
                    {
                        // Asset mode
                        selectedAssetTypeId = existenteAM.Id_Asset_Type;
                        if (selectedAssetTypeId.HasValue)
                        {
                            await LoadAssetsByType(selectedAssetTypeId.Value);
                        }
                        
                        // Cargar los assets seleccionados
                        if (existenteAM.Grupo_Asset != null && existenteAM.Grupo_Asset.Any())
                        {
                            selectedAssetIds = new HashSet<string>(existenteAM.Grupo_Asset.Select(da => da.Id_Asset));
                        }
                    }
                    else if (amMode == 1)
                    {
                        // Event Task mode
                        selectedTaskTypeId = existenteAM.Id_Event_Task;
                        if (selectedTaskTypeId.HasValue)
                        {
                            await LoadEventTaskInstancesByType(selectedTaskTypeId.Value);
                        }
                        
                        // Cargar las event task instances seleccionadas
                        if (existenteAM.Grupo_Event_Task_Instance != null && existenteAM.Grupo_Event_Task_Instance.Any())
                        {
                            selectedEventTaskInstanceIds = new HashSet<int>(existenteAM.Grupo_Event_Task_Instance.Select(det => det.Id_Event_Task_Instance));
                            
                            // Si solo hay una instancia seleccionada, cargar stocks
                            if (EnableStocksSelect)
                            {
                                await LoadStocksForEventTaskInstance(selectedEventTaskInstanceIds.First());
                                
                                // Cargar los stocks seleccionados
                                var firstInstance = existenteAM.Grupo_Event_Task_Instance.First();
                                if (firstInstance.Grupo_Stock != null && firstInstance.Grupo_Stock.Any())
                                {
                                    selectedStockIds = new HashSet<int>(firstInstance.Grupo_Stock.Select(ds => ds.Id_Stock));
                                }
                            }
                        }
                    }
                    return;
                }
            }

            // Si no se encontró en ninguno
            noEncontrado = true;
        }
        catch
        {
            noEncontrado = true;
        }
        finally
        {
            cargando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadSourcesAndGroups()
    {
        try
        {
            var sourcesResponse = await Http.GetAsync($"api/SondaMain/sources?token={authToken}");
            if (sourcesResponse.IsSuccessStatusCode)
            {
                sources = await sourcesResponse.Content.ReadFromJsonAsync<List<Source>>() ?? new List<Source>();
            }

            var groupsResponse = await Http.GetAsync($"api/SondaMain/groups?token={authToken}");
            if (groupsResponse.IsSuccessStatusCode)
            {
                deviceGroups = await groupsResponse.Content.ReadFromJsonAsync<List<DeviceGroup>>() ?? new List<DeviceGroup>();
            }
        }
        catch (Exception ex)
        {
            ShowError($"{Localizer["ErrorCargaFuentes"]} {ex.Message}");
        }
    }

    // Cuando cambia la fuente seleccionada: limpiar grupo, dispositivos y sensor
    private async Task OnSourceChanged(int? sourceId)
    {
        // asigno nuevo source
        selectedSourceId = sourceId;

        // limpio dependencias
        selectedDeviceIds.Clear();
        selectedSensor = string.Empty;

        // recargo listas en base al nuevo source
        await LoadDevices();
        await LoadSensors();

        StateHasChanged();
    }

    // Cuando cambia el grupo seleccionado: limpiar dispositivos y sensor
    private async Task OnGroupChanged(int? groupId)
    {
        selectedGroupId = groupId;
        //se recargan los dispositivos porque se borra el "filtro" de grupo
        await LoadDevices();

        StateHasChanged();
    }

    // Cuando cambian los dispositivos seleccionados (multi-select)
    private Task OnSelectedDevicesChanged(IEnumerable<int> values)
    {
        selectedDeviceIds = values != null ? new HashSet<int>(values) : new HashSet<int>();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task LoadDevices()
    {
        try
        {
            List<Device>? devicesFromSource = null;
            List<Device>? devicesFromGroup = null;

            if (selectedSourceId.HasValue)
            {
                var sourceResponse = await Http.GetAsync($"api/SondaMain/devices/source/{selectedSourceId.Value}?token={authToken}");
                if (sourceResponse.IsSuccessStatusCode)
                {
                    devicesFromSource = await sourceResponse.Content.ReadFromJsonAsync<List<Device>>();
                }
            }

            if (selectedGroupId.HasValue)
            {
                var groupResponse = await Http.GetAsync($"api/SondaMain/devices/group/{selectedGroupId.Value}?token={authToken}");
                if (groupResponse.IsSuccessStatusCode)
                {
                    devicesFromGroup = await groupResponse.Content.ReadFromJsonAsync<List<Device>>();
                }
            }

            // INTERSECCIÓN
            if (devicesFromSource != null && devicesFromGroup != null)
            {
                var deviceIdsFromGroup = new HashSet<int>(devicesFromGroup.Select(d => d.Id));
                devices = devicesFromSource.Where(d => deviceIdsFromGroup.Contains(d.Id)).ToList();
            }
            else if (devicesFromSource != null)
            {
                devices = devicesFromSource;
            }
            else if (devicesFromGroup != null)
            {
                devices = devicesFromGroup;
            }
            else
            {
                var allDevicesResponse = await Http.GetAsync($"api/SondaMain/devices?page=1&token={authToken}");
                if (allDevicesResponse.IsSuccessStatusCode)
                {
                    devices = await allDevicesResponse.Content.ReadFromJsonAsync<List<Device>>() ?? new List<Device>();
                }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowError($"{Localizer["ErrorCargaDispositivos"]} {ex.Message}");
            devices = new List<Device>();
        }
    }

    // Cargar sensores de la fuente seleccionada
    private async Task LoadSensors()
    {
        try
        {
            // Guardar el sensor actualmente seleccionado
            var currentSelectedSensor = selectedSensor;
            
            sensores.Clear();

            if (selectedSourceId.HasValue)
            {
                var sensorsResponse = await Http.GetAsync($"api/SondaMain/sensors/source/{selectedSourceId.Value}?token={authToken}");
                if (sensorsResponse.IsSuccessStatusCode)
                {
                    sensores = await sensorsResponse.Content.ReadFromJsonAsync<List<string>>() ?? new List<string>();
                    
                    // Si el sensor previamente seleccionado existe en la nueva lista, mantenerlo seleccionado
                    if (!string.IsNullOrEmpty(currentSelectedSensor) && sensores.Contains(currentSelectedSensor))
                    {
                        selectedSensor = currentSelectedSensor;
                    }
                    else
                    {
                        selectedSensor = string.Empty;
                    }
                }
            }
            else
            {
                selectedSensor = string.Empty;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowError($"{Localizer["ErrorCargaSensores"]} {ex.Message}");
            sensores = new List<string>();
            selectedSensor = string.Empty;
        }
    }

    private async Task GuardarCambios()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;

            if (string.IsNullOrEmpty(username))
            {
                Snackbar.Add("No se pudo obtener el usuario actual", Severity.Warning);
                return;
            }

            if (!selectedSourceId.HasValue)
            {
                Snackbar.Add("Debe seleccionar una fuente", Severity.Warning);
                return;
            }

            if (string.IsNullOrWhiteSpace(selectedSensor))
            {
                Snackbar.Add("Debe seleccionar un sensor", Severity.Warning);
                return;
            }
            
            if (string.IsNullOrWhiteSpace(addDesc))
            {
                Snackbar.Add("La descripción es obligatoria", Severity.Warning);
                return;
            }
            
            if (string.IsNullOrWhiteSpace(addName))
            {
                Snackbar.Add("Error al actualizar el dataset: El nombre del dataset es obligatorio.", Severity.Warning);
                return;
            }

            var request = new CreateDatasetRequest
            {
                Name = addName,
                Username = username,
                Description = addDesc,
                IsDataset = "S",
                ContentType = "0",
                SourceId = selectedSourceId,
                GroupId = selectedGroupId,
                SensorName = selectedSensor,
                DeviceIds = selectedDeviceIds.Any() ? selectedDeviceIds.ToList() : null
            };

            var response = await Http.PutAsJsonAsync($"api/Dataset/{id}", request);

            if (response.IsSuccessStatusCode)
            {
                var updatedDataset = await response.Content.ReadFromJsonAsync<DatasetIM>();
                Snackbar.Add($"Dataset '{updatedDataset.Name}' {Localizer["Actualizado"]}", Severity.Success, cfg =>
                {
                    cfg.SnackbarVariant = Variant.Filled;
                });
                Nav.NavigateTo("/datasets");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add(error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Localizer["NoSePudoActualizar"]} {ex.Message}", Severity.Error);
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/datasets");
    }

    // ====== Asset Manager Methods ======

    private void SetAmMode(int mode)
    {
        if (amMode == mode) return;
        amMode = mode;
        // Reset selections when switching modes
        if (amMode == 2)
        {
            selectedTaskTypeId = null;
            selectedEventTaskInstanceIds.Clear();
            selectedStockIds.Clear();
            stocks.Clear();
        }
        else
        {
            selectedAssetTypeId = null;
            selectedAssetIds.Clear();
            assets.Clear();
        }
        StateHasChanged();
    }

    private async Task InitializeAMLists()
    {
        try
        {
            // Load Asset Types
            var respTypes = await Http.GetAsync($"api/SondaAM/asset/types?username={currentUsername}&password={currentPassword}");
            if (respTypes.IsSuccessStatusCode)
            {
                assetTypes = await respTypes.Content.ReadFromJsonAsync<List<AssetTypeDto>>() ?? new List<AssetTypeDto>();
            }

            // Load Task Types
            var respTaskTypes = await Http.GetAsync($"api/SondaAM/typeDtos?username={currentUsername}&password={currentPassword}");
            if (respTaskTypes.IsSuccessStatusCode)
            {
                taskTypes = await respTaskTypes.Content.ReadFromJsonAsync<List<TaskTypeDto>>() ?? new List<TaskTypeDto>();
            }
        }
        catch (Exception ex)
        {
            ShowError($"Error cargando Asset Manager: {ex.Message}");
        }
    }

    private async Task OnAssetTypeChanged(int? typeId)
    {
        selectedAssetTypeId = typeId;
        selectedAssetIds.Clear();
        assets.Clear();
        if (selectedAssetTypeId.HasValue)
        {
            await LoadAssetsByType(selectedAssetTypeId.Value);
        }
        StateHasChanged();
    }

    private Task OnSelectedAssetsChanged(IEnumerable<string> ids)
    {
        selectedAssetIds = ids != null ? new HashSet<string>(ids) : new HashSet<string>();
        return Task.CompletedTask;
    }

    private async Task LoadAssetsByType(int assetTypeId)
    {
        try
        {
            var url = $"api/SondaAM/asset/assets?assetTypeId={assetTypeId}&token={authToken}";
            var resp = await Http.GetAsync(url);
            if (resp.IsSuccessStatusCode)
            {
                assets = await resp.Content.ReadFromJsonAsync<List<AssetDto>>() ?? new List<AssetDto>();
            }
            else
            {
                assets = new List<AssetDto>();
            }
        }
        catch (Exception ex)
        {
            ShowError($"Error cargando assets: {ex.Message}");
        }
    }

    private async Task OnTaskTypeChanged(int? typeId)
    {
        selectedTaskTypeId = typeId;
        selectedEventTaskInstanceIds.Clear();
        selectedStockIds.Clear();
        eventTaskInstances.Clear();
        stocks.Clear();
        if (selectedTaskTypeId.HasValue)
        {
            await LoadEventTaskInstancesByType(selectedTaskTypeId.Value);
        }
        StateHasChanged();
    }

    private async Task OnSelectedEventTaskInstancesChanged(IEnumerable<int> ids)
    {
        selectedEventTaskInstanceIds = ids != null ? new HashSet<int>(ids) : new HashSet<int>();
        selectedStockIds.Clear();
        stocks.Clear();
        if (EnableStocksSelect)
        {
            var onlyId = selectedEventTaskInstanceIds.First();
            await LoadStocksForEventTaskInstance(onlyId);
        }
        StateHasChanged();
    }

    private Task OnSelectedStocksChanged(IEnumerable<int> ids)
    {
        selectedStockIds = ids != null ? new HashSet<int>(ids) : new HashSet<int>();
        return Task.CompletedTask;
    }

    private async Task LoadEventTaskInstancesByType(int taskTypeId)
    {
        try
        {
            var dates = Uri.EscapeDataString("1980-01-01T03:00:00,2050-10-31T03:00:00");
            var url = $"api/SondaAM/eventTaskInstances?dates={dates}&taskTypeId={taskTypeId}&username={currentUsername}&password={currentPassword}";
            var resp = await Http.GetAsync(url);
            if (resp.IsSuccessStatusCode)
            {
                eventTaskInstances = await resp.Content.ReadFromJsonAsync<List<EventTaskInstanceDto>>() ?? new List<EventTaskInstanceDto>();
            }
            else
            {
                eventTaskInstances = new List<EventTaskInstanceDto>();
            }
        }
        catch (Exception ex)
        {
            ShowError($"Error cargando event task instances: {ex.Message}");
        }
    }

    private async Task LoadStocksForEventTaskInstance(int eventTaskInstanceId)
    {
        try
        {
            var url = $"api/SondaAM/eventTaskInstance/stock/{eventTaskInstanceId}?token={authToken}";
            var resp = await Http.GetAsync(url);
            if (resp.IsSuccessStatusCode)
            {
                var stocksDto = await resp.Content.ReadFromJsonAsync<List<EventTaskInstanceStockDto>>() ?? new List<EventTaskInstanceStockDto>();
                stocks = stocksDto;
            }
            else
            {
                stocks = new List<EventTaskInstanceStockDto>();
            }
        }
        catch (Exception ex)
        {
            ShowError($"Error cargando stocks: {ex.Message}");
        }
    }

    private async Task GuardarCambiosAM()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;
            if (string.IsNullOrEmpty(username))
            {
                ShowError("No se pudo obtener el usuario actual");
                return;
            }
            if (string.IsNullOrWhiteSpace(addDesc))
            {
                ShowError("La descripción es obligatoria");
                return;
            }
            if (string.IsNullOrWhiteSpace(addName))
            {
                ShowError("Error al actualizar el dataset: El nombre del dataset es obligatorio.");
                return;
            }

            var request = new CreateDatasetAMRequest
            {
                Username = username,
                Nombre = addName,
                Descripcion = addDesc,
                IsDataset = "S",
                ContentType = "0",
                Type_Dataset = amMode,
                Id_Event_Task = amMode == 1 ? selectedTaskTypeId : null,
                Id_Asset_Type = amMode == 2 ? selectedAssetTypeId : null,
                Grupo_Event_Task_Instance_Ids = amMode == 1 && selectedEventTaskInstanceIds.Any() ? selectedEventTaskInstanceIds.ToList() : null,
                Grupo_Asset_Ids = amMode == 2 && selectedAssetIds.Any() ? selectedAssetIds.ToList() : null,
                StockIds = amMode == 1 && EnableStocksSelect && selectedStockIds.Any() ? selectedStockIds.ToList() : null
            };

            var resp = await Http.PutAsJsonAsync($"api/DatasetAM/{id}", request);
            if (resp.IsSuccessStatusCode)
            {
                var updated = await resp.Content.ReadFromJsonAsync<DatasetAM>();
                ShowSuccess($"Dataset '{updated?.Nombre}' {Localizer["Actualizado"]}");
                Nav.NavigateTo("/datasets");
            }
            else
            {
                var error = await resp.Content.ReadAsStringAsync();
                ShowError(error);
            }
        }
        catch (Exception ex)
        {
            ShowError($"No se pudo actualizar el dataset AM: {ex.Message}");
        }
    }

    private void ShowSuccess(string mensaje)
    {
        Snackbar.Add(mensaje, Severity.Success, config =>
        {
            config.SnackbarVariant = Variant.Filled;
            config.ShowCloseIcon = true;
            config.RequireInteraction = false;
            config.VisibleStateDuration = 2500;
            config.CloseAfterNavigation = false;
        });
    }

    private void ShowError(string mensaje)
    {
        Snackbar.Add(mensaje, Severity.Error, config =>
        {
            config.SnackbarVariant = Variant.Filled;
            config.ShowCloseIcon = true;
            config.RequireInteraction = false;
            config.VisibleStateDuration = 4000;
            config.CloseAfterNavigation = false;
        });
    }
