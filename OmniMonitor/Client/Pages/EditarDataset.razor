            }

            var groupsResponse = await Http.GetAsync($"api/SondaMain/groups?token={encodedToken}");
            Console.WriteLine($"[DEBUG EditarDataset] Groups response status: {groupsResponse.StatusCode}");
            
            if (groupsResponse.IsSuccessStatusCode)
            {
                deviceGroups = await groupsResponse.Content.ReadFromJsonAsync<List<DeviceGroup>>() ?? new List<DeviceGroup>();
                Console.WriteLine($"[DEBUG EditarDataset] Loaded {deviceGroups.Count} groups");
            }
            else
            {
                var error = await groupsResponse.Content.ReadAsStringAsync();
                Console.WriteLine($"[DEBUG EditarDataset] Groups error: {error}");
                Snackbar.Add($"Error al cargar grupos: {error}", Severity.Error);
