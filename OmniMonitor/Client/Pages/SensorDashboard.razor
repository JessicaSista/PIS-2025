@page "/sensor-dashboard"
@using ApexCharts
@using MudBlazor
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http

<PageTitle>Sensor Dashboard</PageTitle>

<h1>Sensor Data Dashboard</h1>
<p>This dashboard displays the latest environmental sensor reading.</p>

@if (!chartInitialized)
{
    <p><em>Loading chart...</em></p>
}
else
{
    <ApexChart TItem="SensorChartData" Title="Latest environmental Sensor Reading"
                Height="400"      
                Width="800">
        <ApexPointSeries TItem="SensorChartData"
                         Items="chartData"
                         Name="Sensor Readings"
                         SeriesType="SeriesType.Bar"
                         XValue="e => e.Label"
                         YValue="e => e.Value" />
    </ApexChart>

    <MudContainer Class="mt-4" MaxWidth="MaxWidth.False">
        
        @if (!graficasCreadas.Any())
        {
            <!-- Estado inicial - Agregar primera gráfica -->
            <div style="display: flex; justify-content: center; align-items: center; min-height: 60vh;">
                <MudPaper Class="pa-8 text-center" 
                         Style="border: 2px dashed #666; cursor: pointer; max-width: 400px;" 
                         Elevation="0"
                         @onclick="AbrirSelector">
                    <MudIcon Icon="@Icons.Material.Filled.Add" 
                            Style="font-size: 48px; color: #999; margin-bottom: 16px;" />
                    <MudText Typo="Typo.h5" Style="margin-bottom: 8px;">
                        Agregar Nueva Gráfica
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color: #999;">
                        Haz clic para crear una nueva visualización de datos
                    </MudText>
                </MudPaper>
            </div>
        }
        else
        {
            <!-- Gráficas existentes -->
            <MudText Typo="Typo.h4" Class="mb-4" Style="color: white;">Tus Gráficas</MudText>
            
            <MudGrid>
                @foreach (var grafica in graficasCreadas)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Style="border: 1px solid #444;">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <div style="display: flex; justify-content: space-between; align-items: center;">
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <MudButton Color="@ObtenerColorFuncion(grafica.TipoFuncion)" 
                                                       Variant="Variant.Filled"
                                                       StartIcon="@ObtenerIconoFuncion(grafica.TipoFuncion)"
                                                       Class="pa-1"
                                                       Style="min-width: auto; height: 24px;">
                                                @ObtenerNombreFuncion(grafica.TipoFuncion)
                                            </MudButton>
                                            <MudIcon Icon="@ObtenerIconoGrafica(grafica.TipoGrafica)" 
                                                    Style="color: #999;" />
                                            <MudText Typo="Typo.body2" Style="color: white;">
                                                @grafica.Formula
                                            </MudText>
                                        </div>
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Style="color: #999;"
                                                       OnClick="() => EliminarGrafica(grafica.Id)" />
                                    </div>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <!-- AQUÍ VA LA GRÁFICA REAL -->
                                <Grafica TipoFuncion="@grafica.TipoFuncion" TipoGrafica="@grafica.TipoGrafica" />
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
                
                <!-- Botón para agregar más -->
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudPaper Class="pa-4 text-center" 
                             Style="border: 2px dashed #666; cursor: pointer; height: 500px; display: flex; align-items: center; justify-content: center;" 
                             Elevation="0"
                             @onclick="AbrirSelector">
                        <div>
                            <MudIcon Icon="@Icons.Material.Filled.Add" 
                                    Style="font-size: 32px; color: #999; margin-bottom: 8px;" />
                            <MudText Typo="Typo.body2">
                                Agregar Gráfica
                            </MudText>
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }

    </MudContainer>

    <!-- Modal selector con Overlay -->
    <MudOverlay Visible="mostrarSelector" DarkBackground="true" ZIndex="9999">
        <div style="display: flex; justify-content: center; align-items: center; height: 100vh; padding: 20px;"
             @onclick:stopPropagation="true">
            <MudPaper Class="pa-6" Style="max-width: 800px; width: 100%; max-height: 90vh; overflow-y: auto;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <MudText Typo="Typo.h5">Crear Nueva Gráfica</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" 
                                  Style="color: #999;"
                                  OnClick="CerrarSelector" />
                </div>
                
                <MudText Typo="Typo.h6" Class="mb-4" Style="color: #585858;">
                    Selecciona el tipo de función y gráfica
                </MudText>
                
                <MudGrid>
                    @foreach (var funcion in tiposFuncion)
                    {
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle1" Class="mb-2">
                                @funcion.Nombre (@funcion.Formula)
                            </MudText>
                            
                            @foreach (var tipoGraf in tiposGrafica)
                            {
                                <MudButton Variant="Variant.Outlined" 
                                          FullWidth="true"
                                          Class="mb-2"
                                          StartIcon="@ObtenerIconoFuncion(funcion.Id)"
                                          EndIcon="@ObtenerIconoGrafica(tipoGraf.Id)"
                                          Style="border-color: #666;"
                                          OnClick="() => CrearGrafica(funcion.Id, tipoGraf.Id)">
                                    @funcion.Nombre - @tipoGraf.Nombre
                                </MudButton>
                            }
                        </MudItem>
                    }
                </MudGrid>
                
                <div style="margin-top: 20px; text-align: right;">
                    <MudButton Variant="Variant.Text" 
                              Style="color: #999;"
                              OnClick="CerrarSelector">
                        Cancelar
                    </MudButton>
                </div>
            </MudPaper>
        </div>
    </MudOverlay>
}

<!-- Componente Grafica Embebido -->
@functions {
    public class DataPoint
    {
        public double X { get; set; }
        public double Y { get; set; }
    }
}

@code {
    // Código del dashboard de sensores
    private bool chartInitialized = false;
    private List<SensorChartData> chartData = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSensorData();
        chartInitialized = true;
    }

    private async Task LoadSensorData()
    {
        try
        {
            var readings = await Http.GetFromJsonAsync<SensorClimax[]>("SensorClimax");

            if (readings != null && readings.Any())
            {
                var last = readings.Last();

                chartData = new List<SensorChartData>
                {
                    new SensorChartData { Label = "Temperature (°C)", Value = last.Temperatura },
                    new SensorChartData { Label = "Humidity (%)", Value = last.Humedad },
                    new SensorChartData { Label = "CO2 (ppm)", Value = last.Co2 },
                    new SensorChartData { Label = "Light (lux)", Value = last.NivleDeBrillo },
                    new SensorChartData { Label = "Power (W)", Value = last.Potencia },
                    new SensorChartData { Label = "Noise (dB)", Value = last.NivelDeRuido },
                    new SensorChartData { Label = "Soil Moisture (%)", Value = last.HumedadDelSuelo },
                    new SensorChartData { Label = "Soil Temp (°C)", Value = last.TemperaturaDelSuelo }
                };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading sensor data: {ex.Message}");
        }
    }

    public class SensorChartData
    {
        public string Label { get; set; } = string.Empty;
        public decimal Value { get; set; }
    }

    // Código del selector de gráficas
    private bool mostrarSelector = false;
    private List<GraficaCreada> graficasCreadas = new();
    
    private readonly List<TipoFuncion> tiposFuncion = new()
    {
        new() { Id = "lineal", Nombre = "Lineal", Formula = "f(x) = x" },
        new() { Id = "cuadratica", Nombre = "Cuadrática", Formula = "f(x) = x²" },
        new() { Id = "exponencial", Nombre = "Exponencial", Formula = "f(x) = 2^x" }
    };

    private readonly List<TipoGrafica> tiposGrafica = new()
    {
        new() { Id = "linea", Nombre = "Línea" },
        new() { Id = "barras", Nombre = "Barras" }
    };

    private void AbrirSelector()
    {
        mostrarSelector = true;
    }

    private void CerrarSelector()
    {
        mostrarSelector = false;
    }

    private void CrearGrafica(string tipoFuncion, string tipoGrafica)
    {
        var funcion = tiposFuncion.First(f => f.Id == tipoFuncion);
        var grafica = tiposGrafica.First(g => g.Id == tipoGrafica);
        
        var nuevaGrafica = new GraficaCreada
        {
            Id = Guid.NewGuid(),
            TipoFuncion = tipoFuncion,
            TipoGrafica = tipoGrafica,
            Nombre = $"{funcion.Nombre} - {grafica.Nombre}",
            Formula = funcion.Formula
        };

        graficasCreadas.Add(nuevaGrafica);
        CerrarSelector();
    }

    private void EliminarGrafica(Guid id)
    {
        graficasCreadas.RemoveAll(g => g.Id == id);
    }

    private MudBlazor.Color ObtenerColorFuncion(string tipoFuncion) => tipoFuncion switch
    {
        "lineal" => MudBlazor.Color.Primary,
        "cuadratica" => MudBlazor.Color.Success,
        "exponencial" => MudBlazor.Color.Secondary,
        _ => MudBlazor.Color.Default
    };

    private string ObtenerIconoFuncion(string tipoFuncion) => tipoFuncion switch
    {
        "lineal" => Icons.Material.Filled.TrendingUp,
        "cuadratica" => Icons.Material.Filled.ShowChart,
        "exponencial" => Icons.Material.Filled.Bolt,
        _ => Icons.Material.Filled.Functions
    };

    private string ObtenerIconoGrafica(string tipoGrafica) => tipoGrafica switch
    {
        "linea" => Icons.Material.Filled.Timeline,
        "barras" => Icons.Material.Filled.BarChart,
        _ => Icons.Material.Filled.Analytics
    };

    private string ObtenerNombreFuncion(string tipoFuncion) => tipoFuncion switch
    {
        "lineal" => "L",
        "cuadratica" => "C", 
        "exponencial" => "E",
        _ => "?"
    };

    public class GraficaCreada
    {
        public Guid Id { get; set; }
        public string TipoFuncion { get; set; } = "";
        public string TipoGrafica { get; set; } = "";
        public string Nombre { get; set; } = "";
        public string Formula { get; set; } = "";
    }

    public class TipoFuncion
    {
        public string Id { get; set; } = "";
        public string Nombre { get; set; } = "";
        public string Formula { get; set; } = "";
    }

    public class TipoGrafica
    {
        public string Id { get; set; } = "";
        public string Nombre { get; set; } = "";
    }
}

<!-- Componente Grafica Embebido -->
<div style="display: none;">
@{
    RenderFragment<(string TipoFuncion, string TipoGrafica)> Grafica = context =>
    @<div>
        @{
            var data = new List<DataPoint>();
            var nombreFuncion = "";
            var tipoGraficaEnum = SeriesType.Line;

            // Configurar tipo de gráfica
            tipoGraficaEnum = context.TipoGrafica.ToLower() == "barras" ? SeriesType.Bar : SeriesType.Line;

            // Generar datos según el tipo de función
            switch (context.TipoFuncion.ToLower())
            {
                case "lineal":
                    nombreFuncion = "f(x) = x";
                    for (int x = -5; x <= 5; x++)
                    {
                        data.Add(new DataPoint { X = x, Y = x });
                    }
                    break;
                    
                case "exponencial":
                    nombreFuncion = "f(x) = 2^x";
                    for (int x = -3; x <= 5; x++)
                    {
                        data.Add(new DataPoint { X = x, Y = Math.Pow(2, x) });
                    }
                    break;
                    
                default: // cuadratica
                    nombreFuncion = "f(x) = x²";
                    for (int x = -5; x <= 5; x++)
                    {
                        data.Add(new DataPoint { X = x, Y = x * x });
                    }
                    break;
            }
        }

        <ApexChart TItem="DataPoint" Height="350">
            <ApexPointSeries TItem="DataPoint"
                           Items="data"
                           Name="@nombreFuncion"
                           SeriesType="@tipoGraficaEnum"
                           XValue="@(e => (decimal)e.X)"
                           YValue="@(e => (decimal)e.Y)" />
        </ApexChart>
    </div>;
}
</div>