@page "/sensor-dashboard"
@using ApexCharts
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http

<PageTitle>Sensor Dashboard</PageTitle>

<h1>Sensor Data Dashboard</h1>
<p>This dashboard displays the latest environmental sensor reading.</p>

@if (!chartInitialized)
{
    <p><em>Loading chart...</em></p>
}
else
{
    <ApexChart TItem="SensorChartData" Title="Latest environmental Sensor Reading"
                Height="400"      
                Width="800">      >
        <ApexPointSeries TItem="SensorChartData"
                         Items="chartData"
                         Name="Sensor Readings"
                         SeriesType="SeriesType.Bar"
                         XValue="e => e.Label"
                         YValue="e => e.Value" />
    </ApexChart>
}

@code {
    private bool chartInitialized = false;

    private List<SensorChartData> chartData = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSensorData();
        chartInitialized = true;
    }

    private async Task LoadSensorData()
    {
        try
        {
            // Traemos todas las lecturas del endpoint
            var readings = await Http.GetFromJsonAsync<SensorClimax[]>("SensorClimax");

            if (readings != null && readings.Any())
            {
                var last = readings.Last(); // Tomamos la última lectura

                // Transformamos a chartData
                chartData = new List<SensorChartData>
                {
                    new SensorChartData { Label = "Temperature (°C)", Value = last.Temperatura },
                    new SensorChartData { Label = "Humidity (%)", Value = last.Humedad },
                    new SensorChartData { Label = "CO2 (ppm)", Value = last.Co2 },
                    new SensorChartData { Label = "Light (lux)", Value = last.NivleDeBrillo },
                    new SensorChartData { Label = "Power (W)", Value = last.Potencia },
                    new SensorChartData { Label = "Noise (dB)", Value = last.NivelDeRuido },
                    new SensorChartData { Label = "Soil Moisture (%)", Value = last.HumedadDelSuelo },
                    new SensorChartData { Label = "Soil Temp (°C)", Value = last.TemperaturaDelSuelo }
                };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading sensor data: {ex.Message}");
        }
    }

    // Clase para ApexCharts
    public class SensorChartData
    {
        public string Label { get; set; } = string.Empty;
        public decimal Value { get; set; }
    }
}
