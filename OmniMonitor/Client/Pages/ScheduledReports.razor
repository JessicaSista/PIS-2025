@page "/reportes-programados"
@attribute [Authorize]
@using MudBlazor
@using OmniMonitor.Shared.Dtos
@using OmniMonitor.Client.Shared
@using Microsoft.Extensions.Localization
@using System.Globalization
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<ScheduledReports> Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer

<PageTitle>@Localizer["ScheduledReportsTitle"]</PageTitle>

<MudStack Row Justify="Justify.SpaceBetween" Class="mt-2 mx-4">
    <MudStack>
        <MudText Typo="Typo.h4" Class="page-title" Style="margin: 0;">
            @Localizer["ScheduledReportsTitle"]
        </MudText>
    </MudStack>
    <MudStack Row Spacing="2">
        <AddButton OnClick="OpenCreateDialog" Disabled="_loading">
            @Localizer["NewScheduleButton"]
        </AddButton>
    </MudStack>
</MudStack>

<MudStack Justify="Justify.SpaceBetween" Class="mx-4">
    <MudText Typo="Typo.body1" Class="mb-4 page-subtitle">
        @Localizer["ScheduledReportsSubtitle"]
    </MudText>
</MudStack>

<MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 ml-4 mr-6">
    <MudTextField @bind-Value="_search" 
                  Immediate="true" 
                  Placeholder="@Localizer["SearchPlaceholder"]" 
                  Variant="Variant.Outlined" 
                  Adornment="Adornment.Start" 
                  AdornmentIcon="@Icons.Material.Filled.Search" 
                  Class="flex-grow-1" />
</MudStack>

<MudContainer Fixed="true" Class="pl-4 pr-6">
    <MudPaper Elevation="0" Class="pa-0">
        <MudTable Items="_filtered" Hover="true" Dense="true" Bordered="false" Striped="false" Loading="_loading" CanExpand="false">
            <ToolBarContent>
                <MudText Typo="Typo.subtitle2">@Localizer["TotalCount", _items.Count]</MudText>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>@Localizer["HeaderReport"]</MudTh>
                <MudTh>@Localizer["HeaderFrequency"]</MudTh>
                <MudTh>@Localizer["HeaderHour"]</MudTh>
                <MudTh>@Localizer["HeaderNextSend"]</MudTh>
                <MudTh>@Localizer["HeaderRecipients"]</MudTh>
                <MudTh>@Localizer["HeaderActions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Reporte">@GetReportName(context.ReportId)</MudTd>
                <MudTd DataLabel="Frecuencia">@GetFrequencyDisplay(context)</MudTd>
                <MudTd DataLabel="Hora">@GetHourDisplay(context)</MudTd>
                <MudTd DataLabel="Próximo envío">@GetNextSendDisplay(context)</MudTd>
                <MudTd DataLabel="Destinatarios">@(context.Recipients?.Count ?? 0)</MudTd>
                
                <MudTd DataLabel="Acciones" @onclick:stopPropagation="true">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="MudBlazor.Color.Error" OnClick="() => ConfirmDelete(context)" />
                </MudTd>
            </RowTemplate>
            
            
            @* <ChildRowContent>
                <MudPaper Class="pa-3" Elevation="0">
                    <MudText Typo="Typo.subtitle2">Destinatarios</MudText>
                    @if (context.Recipients != null && context.Recipients.Any())
                    {
                        <MudChipSet T="string" ReadOnly="true" Dense="true">
                            @foreach (var mail in context.Recipients)
                            {
                                <MudChip T="string" Value="@mail">@mail</MudChip>
                            }
                        </MudChipSet>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Sin destinatarios</MudText>
                    }
                </MudPaper>
            </ChildRowContent> *@
            
            <NoRecordsContent>
                <MudText Typo="Typo.subtitle1" Align="MudBlazor.Align.Center" Style="color:#667d8a">@Localizer["NoSchedules"]</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudContainer>

<style>
    /* Estilos para cursor e inhabilitar selección de texto */
    .mud-table-row {
        user-select: none; 
        -moz-user-select: none;
        -webkit-user-select: none;
        cursor: default;
    }
    .mud-table-row > td:last-child {
        cursor: default;
    }
</style>

@code {
    private List<ScheduledReportResponse> _items = new();
    private string _search = string.Empty;
    private bool _loading = true;
    private Dictionary<int, string> _reportNames = new();
    // private HashSet<int> _expanded = new(); 

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private IEnumerable<ScheduledReportResponse> _filtered =>
        string.IsNullOrWhiteSpace(_search)
            ? _items
            : _items.Where(x =>
                (x.Subject?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Message?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.ScheduleType?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.TimeZone?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Recipients != null && x.Recipients.Any(r => r.Contains(_search, StringComparison.OrdinalIgnoreCase)))
            );

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateScheduledReportDialog>(Localizer["NewScheduleDialogTitle"], options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is bool ok && ok)
        {
            await Cargar();
        }
    }

    private async Task Cargar()
    {
        _loading = true;
        try
        {
            var resp = await Http.GetAsync("/api/reports/scheduled-reports");
            if (resp.IsSuccessStatusCode)
            {
                var data = await resp.Content.ReadFromJsonAsync<List<ScheduledReportResponse>>();
                _items = data ?? new List<ScheduledReportResponse>();

                await EnsureReportNamesLoaded();
            }
            else if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Snackbar.Add(SharedLocalizer["SessionExpired"], Severity.Warning);
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                var error = await resp.Content.ReadAsStringAsync();
                Snackbar.Add(string.Format(SharedLocalizer["LoadErrorFormat"], resp.StatusCode), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(SharedLocalizer["LoadExceptionFormat"], ex.Message), Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private string GetFrequencyDisplay(ScheduledReportResponse item)
    {
        if (string.Equals(item.ScheduleType, "Weekly", StringComparison.OrdinalIgnoreCase))
        {
            var token = (item.AdvancedRule ?? string.Empty).Trim().ToUpperInvariant();
            var dayKey = $"Day_{token}";
            var dayText = SharedLocalizer[dayKey];
            return !string.IsNullOrWhiteSpace(token) && !string.Equals(dayText, dayKey, StringComparison.Ordinal)
                ? string.Format(SharedLocalizer["EachDay"], dayText)
                : SharedLocalizer["FrequencyWeekly"];
        }
        if (string.Equals(item.ScheduleType, "Monthly", StringComparison.OrdinalIgnoreCase))
        {
            if (int.TryParse(item.AdvancedRule, out var dayNum) && dayNum >= 1 && dayNum <= 31)
                return string.Format(SharedLocalizer["EachMonthDay"], dayNum);
            return SharedLocalizer["FrequencyMonthly"];
        }
        if (string.Equals(item.ScheduleType, "Daily", StringComparison.OrdinalIgnoreCase))
            return SharedLocalizer["FrequencyDaily"];
        return "-";
    }

    private string GetHourDisplay(ScheduledReportResponse item)
    {
        if (!string.IsNullOrWhiteSpace(item.SendAtLocalTime))
            return $"{item.SendAtLocalTime} ({item.TimeZone})";
        if (item.IntervalMinutes.HasValue)
            return $"Cada {item.IntervalMinutes} min";
        if (!string.IsNullOrWhiteSpace(item.AdvancedRule))
            return item.AdvancedRule;
        return "-";
    }

    private string GetNextSendDisplay(ScheduledReportResponse item)
    {
        try
        {
            var tz = GetTimeZone(item.TimeZone);
            var nowTz = TimeZoneInfo.ConvertTime(DateTime.UtcNow, tz);

            if (!string.IsNullOrWhiteSpace(item.SendAtLocalTime) && TimeSpan.TryParse(item.SendAtLocalTime, out var sendTs))
            {
                var candidate = new DateTime(nowTz.Year, nowTz.Month, nowTz.Day, sendTs.Hours, sendTs.Minutes, 0, DateTimeKind.Unspecified);
                
                // Lógica de cálculo (omitiendo la complejidad completa del semanal/mensual basado en AdvancedRule)
                if (string.Equals(item.ScheduleType, "Daily", StringComparison.OrdinalIgnoreCase))
                {
                    if (candidate <= nowTz) candidate = candidate.AddDays(1);
                }
                else if (string.Equals(item.ScheduleType, "Weekly", StringComparison.OrdinalIgnoreCase))
                {
                    // Asume que la lógica de Weekly Day of Week está en otra parte o en el servidor
                    if (candidate <= nowTz) candidate = candidate.AddDays(7);
                }
                else if (string.Equals(item.ScheduleType, "Monthly", StringComparison.OrdinalIgnoreCase))
                {
                    // Asume que la lógica de Monthly Day of Month está en otra parte o en el servidor
                    if (candidate <= nowTz) candidate = candidate.AddMonths(1);
                }
                
                var candidateUtc = TimeZoneInfo.ConvertTimeToUtc(candidate, tz);
                return candidateUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture);
            }

            if (string.Equals(item.ScheduleType, "EveryNMinutes", StringComparison.OrdinalIgnoreCase) && item.IntervalMinutes.HasValue)
            {
                var nextUtc = DateTime.UtcNow.AddMinutes(item.IntervalMinutes.Value);
                return nextUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture);
            }

            return "-";
        }
        catch
        {
            return "-";
        }
    }

    private static TimeZoneInfo GetTimeZone(string? tzId)
    {
        if (!string.IsNullOrWhiteSpace(tzId))
        {
            try { return TimeZoneInfo.FindSystemTimeZoneById(tzId); }
            catch { }
        }
        return TimeZoneInfo.Local;
    }

    private async Task EnsureReportNamesLoaded()
    {
        try
        {
            var missingIds = _items.Select(i => i.ReportId).Where(id => !_reportNames.ContainsKey(id)).Distinct().ToList();
            if (missingIds.Count == 0) return;

            // Se asume que el DTO PaginatedReportDto contiene los Items necesarios.
            var resp = await Http.GetAsync("/api/reports/GetAllReportsPaginated?page=1&pageSize=1000");
            if (resp.IsSuccessStatusCode)
            {
                var page = await resp.Content.ReadFromJsonAsync<PaginatedReportDto>(); 
                if (page?.Items != null)
                {
                    foreach (var r in page.Items)
                    {
                        if (!_reportNames.ContainsKey(r.Id))
                            _reportNames[r.Id] = r.Name ?? $"Reporte {r.Id}";
                    }
                }
            }
        }
        catch { }
    }

    private string GetReportName(int id)
    {
        if (_reportNames.TryGetValue(id, out var name)) return name;
        return $"Reporte {id}";
    }

    private async Task ConfirmDelete(ScheduledReportResponse item)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            SharedLocalizer["DeleteScheduleTitle"],
            (MarkupString)string.Format(SharedLocalizer["DeleteScheduleConfirmHtml"], item.Id),
            yesText: SharedLocalizer["DeleteButton"],
            cancelText: SharedLocalizer["CancelButton"],
            options: new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall }
        );

        if (confirm == true)
        {
            await Eliminar(item);
        }
    }

    private async Task Eliminar(ScheduledReportResponse item)
    {
        try
        {
            var resp = await Http.DeleteAsync($"/api/reports/scheduled-reports/{item.Id}");
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add(SharedLocalizer["ScheduleDeleted"], Severity.Success);
                await Cargar();
            }
            else
            {
                var error = await resp.Content.ReadAsStringAsync();
                Snackbar.Add(string.Format(SharedLocalizer["DeleteErrorFormat"], resp.StatusCode), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(SharedLocalizer["DeleteExceptionFormat"], ex.Message), Severity.Error);
        }
    }


