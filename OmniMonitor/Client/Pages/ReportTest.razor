@page "/report-builder"
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@using System.Text.Json
@using System.ComponentModel.DataAnnotations

<div class="container mx-auto p-4 md:p-8">
    <header class="text-center mb-8">
        <h1 class="text-4xl font-bold text-gray-800">Panel de Control de Reportes</h1>
        <p class="text-gray-600 mt-2">Crea Joins, construye reportes y adeles los joins que necesites.</p>
    </header>

    <!-- Session Token Card -->
    <div class="card mb-8 max-w-xl mx-auto">
        <h2 class="text-2xl font-semibold mb-4 text-gray-700">Autenticación</h2>
        <div class="flex items-end space-x-2">
            <div class="flex-grow">
                <label for="session-token" class="form-label">Token de Sesión (de Local Storage)</label>
                <InputText @bind-Value="sessionToken" id="session-token" class="form-input font-mono bg-gray-100" placeholder="El token se cargará aquí..." readonly />
            </div>
            <button class="btn btn-secondary" @onclick="LoadData">Cargar Datos</button>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <!-- Columna de Joins -->
        <div class="lg:col-span-1 space-y-6">
            <div class="card">
                <h2 class="text-2xl font-semibold mb-4 text-gray-700">1. Configuraciones de Join</h2>
                <div class="space-y-3 max-h-96 overflow-y-auto pr-2">
                    @if (joins.Any())
                    {
                        @foreach (var join in joins)
                        {
                            <div class="p-3 border rounded-md bg-gray-50">
                                <p class="font-semibold">@join.Name (ID: @join.Id)</p>
                                <p class="text-sm text-gray-600">@join.LeftOperand.EntityName -> @join.RightOperand.EntityName</p>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-gray-500">No se han encontrado Joins.</p>
                    }
                </div>
            </div>
            <div class="card">
                <h3 class="text-xl font-semibold mb-4 text-gray-700">Crear Nuevo Join</h3>
                <EditForm Model="@newJoin" OnValidSubmit="HandleCreateJoin" class="space-y-4">
                    <DataAnnotationsValidator />
                    <!-- Campos del formulario de Join -->
                    <InputText @bind-Value="newJoin.Name" class="form-input" placeholder="Nombre del Join" />
                    <!-- Operandos... -->
                    <div class="grid grid-cols-2 gap-4 mt-4">
                        <div>
                            <h4 class="font-medium text-gray-600">Operando Izquierdo</h4>
                            <InputSelect @bind-Value="newJoin.LeftOperand.ModuleType" class="form-input mt-2">
                                @foreach (var val in Enum.GetValues(typeof(ModuleType)))
                                {
                                    <option value="@val">@val</option>
                                }
                            </InputSelect>
                            <InputNumber @bind-Value="newJoin.LeftOperand.DatasetId" class="form-input mt-2" placeholder="ID Dataset" />
                            <InputSelect @bind-Value="newJoin.LeftOperand.EntityName" class="form-input mt-2">
                                @foreach (var val in Enum.GetValues(typeof(EntityName)))
                                {
                                    <option value="@val">@val</option>
                                }
                            </InputSelect>
                            <InputText @bind-Value="newJoin.LeftOperand.JoinPropertyName" class="form-input mt-2" placeholder="Propiedad del Join" />
                            <InputSelect @bind-Value="newJoin.LeftOperand.JoinPropertyType" class="form-input mt-2">
                                <option value="string">String</option>
                                <option value="int">Integer</option>
                            </InputSelect>
                        </div>
                        <div>
                            <h4 class="font-medium text-gray-600">Operando Derecho</h4>
                            <InputSelect @bind-Value="newJoin.RightOperand.ModuleType" class="form-input mt-2">
                                @foreach (var val in Enum.GetValues(typeof(ModuleType)))
                                {
                                    <option value="@val">@val</option>
                                }
                            </InputSelect>
                            <InputNumber @bind-Value="newJoin.RightOperand.DatasetId" class="form-input mt-2" placeholder="ID Dataset" />
                            <InputSelect @bind-Value="newJoin.RightOperand.EntityName" class="form-input mt-2">
                                @foreach (var val in Enum.GetValues(typeof(EntityName)))
                                {
                                    <option value="@val">@val</option>
                                }
                            </InputSelect>
                            <InputText @bind-Value="newJoin.RightOperand.JoinPropertyName" class="form-input mt-2" placeholder="Propiedad del Join" />
                            <InputSelect @bind-Value="newJoin.RightOperand.JoinPropertyType" class="form-input mt-2">
                                <option value="string">String</option>
                                <option value="int">Integer</option>
                            </InputSelect>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-full mt-4">Crear Join</button>
                </EditForm>
            </div>
        </div>

        <!-- Columna de Reportes -->
        <div class="lg:col-span-1 space-y-6">
            <div class="card">
                <h2 class="text-2xl font-semibold mb-4 text-gray-700">2. Reportes</h2>
                <div class="space-y-3 max-h-96 overflow-y-auto pr-2">
                    @if (reports.Any())
                    {
                        @foreach (var report in reports)
                        {
                            <div class="p-3 border rounded-md @(selectedReport?.Id == report.Id ? "bg-blue-100 border-blue-400" : "bg-gray-50")">
                                <p class="font-semibold">@report.Name (ID: @report.Id)</p>
                                <div class="mt-2 space-x-2">
                                    <button class="btn btn-sm btn-secondary" @onclick="() => SelectReport(report)">Añadir Joins</button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-gray-500">No se han encontrado Reportes.</p>
                    }
                </div>
            </div>
            <div class="card">
                <h3 class="text-xl font-semibold mb-4 text-gray-700">Crear Nuevo Reporte</h3>
                <EditForm Model="@newReport" OnValidSubmit="HandleCreateReport" class="space-y-4">
                    <DataAnnotationsValidator />
                    <InputText @bind-Value="newReport.Name" class="form-input" placeholder="Nombre del Reporte" />
                    <InputText @bind-Value="newReport.Username" class="form-input" placeholder="Username" />
                    <button type="submit" class="btn btn-primary w-full">Crear Reporte</button>
                </EditForm>
            </div>
        </div>

        <!-- Columna de Acción / Resultados -->
        <div class="lg:col-span-1">
            <div class="card sticky top-8">
                <h2 class="text-2xl font-semibold mb-4 text-gray-700">3. Añadir Join al Reporte</h2>
                @if (selectedReport != null)
                {
                    <p class="mb-4">Añadiendo a: <strong class="text-blue-600">@selectedReport.Name</strong></p>
                    <div class="space-y-3 max-h-64 overflow-y-auto p-2 border rounded-md">
                        @if (joins.Any())
                        {
                            @foreach (var join in joins)
                            {
                                <div class="flex items-center justify-between p-2 hover:bg-gray-100 rounded-md">
                                    <label class="min-w-0 flex-1 text-gray-700">@join.Name</label>
                                    <button class="btn btn-sm btn-success" @onclick="() => HandleAddJoinToReport(join.Id)">Añadir</button>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-gray-500">No hay Joins disponibles para añadir.</p>
                        }
                    </div>
                    <button class="btn btn-secondary w-full mt-4" @onclick="() => selectedReport = null">Cancelar</button>
                }
                else
                {
                    <p class="text-gray-500">Selecciona un reporte de la lista para empezar a añadirle joins.</p>
                }

                <h2 class="text-2xl font-semibold mt-6 mb-4 text-gray-700">Resultados</h2>
                <div class="bg-gray-800 text-white rounded-md p-4 h-64 overflow-y-auto font-mono text-sm">
                    <pre><code>@resultJson</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* ... (El CSS es el mismo que en las versiones anteriores) ... */
    .card { background-color: white; border-radius: 0.5rem; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1); padding: 1.5rem; }
    .btn { padding: 0.5rem 1rem; border-radius: 0.375rem; font-weight: 600; color: white; transition: background-color 200ms; }
    .btn-primary { background-color: #2563eb; } .btn-primary:hover { background-color: #1d4ed8; }
    .btn-secondary { background-color: #6b7280; } .btn-secondary:hover { background-color: #4b5563; }
    .btn-success { background-color: #16a34a; } .btn-success:hover { background-color: #15803d; }
    .btn-sm { padding: 0.25rem 0.75rem; font-size: 0.875rem; }
    .form-input { margin-top: 0.25rem; display: block; width: 100%; border-radius: 0.375rem; border: 1px solid #d1d5db; padding: 0.5rem; }
    .form-label { display: block; font-size: 0.875rem; font-weight: 500; color: #374151; }
</style>


@code {
    private const string ApiBaseUrl = "api/reports";

    private string sessionToken = "";
    private List<CrossModuleJoinDto> joins = new();
    private List<Report> reports = new();
    private CreateJoinRequestDto newJoin = new();
    private CreateEmptyReportRequestDto newReport = new();
    private Report? selectedReport;
    private string resultJson = "Los resultados de las operaciones aparecerán aquí...";

    protected override async Task OnInitializedAsync()
    {
        await LoadTokenFromLocalStorage();
        if (!string.IsNullOrWhiteSpace(sessionToken))
        {
            await LoadData();
        }
    }

    private async Task LoadTokenFromLocalStorage()
    {
        try
        {
            sessionToken = await LocalStorage.GetItemAsync<string>("authToken") ?? "";
        }
        catch { }
    }

    private async Task LoadData()
    {
        await LoadTokenFromLocalStorage();
        if (string.IsNullOrWhiteSpace(sessionToken))
        {
            DisplayResult(new { Error = "El token de sesión es necesario para cargar los datos." });
            return;
        }
        await LoadReports();
        await LoadJoins();
        StateHasChanged();
    }

    private async Task LoadReports()
    {
        try
        {
            var fetchedReports = await Http.GetFromJsonAsync<List<Report>>($"{ApiBaseUrl}/by-user");
            if (fetchedReports != null) reports = fetchedReports;
        }
        catch (Exception ex) { DisplayResult(new { Error = "Error al cargar reportes.", ex.Message }); }
    }

    private async Task LoadJoins()
    {
        try
        {
            var fetchedJoins = await Http.GetFromJsonAsync<List<CrossModuleJoinDto>>($"{ApiBaseUrl}/joins/by-user");
            if (fetchedJoins != null) joins = fetchedJoins;
        }
        catch (Exception ex) { DisplayResult(new { Error = "Error al cargar joins.", ex.Message }); }
    }

    // --- Event Handlers ---
    private async Task HandleCreateJoin()
    {
        if (string.IsNullOrWhiteSpace(sessionToken)) { DisplayResult(new { Error = "Se requiere token." }); return; }
        try
        {
            var response = await Http.PostAsJsonAsync($"{ApiBaseUrl}/joins", newJoin);
            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<CrossModuleJoin>();
                DisplayResult(new { Success = "Join creado!", Response = created });
                newJoin = new();
                await LoadJoins();
            }
            else { DisplayResult(new { Error = "Fallo al crear el join.", Details = await response.Content.ReadAsStringAsync() }); }
        }
        catch (Exception ex) { DisplayResult(new { Error = ex.Message }); }
    }

    private async Task HandleCreateReport()
    {
        // Este endpoint no requiere token según tu controlador
        try
        {
            var response = await Http.PostAsJsonAsync(ApiBaseUrl, newReport);
            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<Report>();
                DisplayResult(new { Success = "Reporte creado!", Response = created });
                newReport = new();
                await LoadReports();
            }
            else { DisplayResult(new { Error = "Fallo al crear el reporte.", Details = await response.Content.ReadAsStringAsync() }); }
        }
        catch (Exception ex) { DisplayResult(new { Error = ex.Message }); }
    }

    private void SelectReport(Report report)
    {
        selectedReport = report;
        resultJson = $"Seleccionado '{report.Name}'. Ahora puedes añadirle joins desde el panel de la derecha.";
    }

    private async Task HandleAddJoinToReport(int joinId)
    {
        if (selectedReport == null || string.IsNullOrWhiteSpace(sessionToken))
        {
            DisplayResult(new { Error = "Por favor, selecciona un reporte y asegñrate de que el token está cargado." });
            return;
        }

        var joinRequest = new ReportJoinItemDto { CrossModuleJoinId = joinId, ExecutionOrder = 1 };

        try
        {
            var response = await Http.PostAsJsonAsync($"{ApiBaseUrl}/{selectedReport.Id}/joins", joinRequest);
            if (response.IsSuccessStatusCode)
            {
                var link = await response.Content.ReadFromJsonAsync<ReportJoin>();
                DisplayResult(new { Success = $"Join {joinId} añadido al reporte {selectedReport.Name}!", Response = link });
            }
            else { DisplayResult(new { Error = "Fallo al añadir el join.", Details = await response.Content.ReadAsStringAsync() }); }
        }
        catch (Exception ex) { DisplayResult(new { Error = ex.Message }); }
    }

    private void DisplayResult(object data) => resultJson = JsonSerializer.Serialize(data, new JsonSerializerOptions { WriteIndented = true });

    public class JoinOperandDto { public ModuleType ModuleType { get; set; } public int DatasetId { get; set; } public EntityName EntityName { get; set; } public string JoinPropertyName { get; set; } = ""; public string JoinPropertyType { get; set; } = "string"; }
    public class CreateJoinRequestDto { public string Name { get; set; } = ""; public JoinType JoinType { get; set; } = JoinType.Inner; public JoinOperandDto LeftOperand { get; set; } = new(); public JoinOperandDto RightOperand { get; set; } = new(); }
    public class CrossModuleJoinDto { public int Id { get; set; } public string Name { get; set; } public JoinType JoinType { get; set; } public JoinOperandDto LeftOperand { get; set; } public JoinOperandDto RightOperand { get; set; } }
    public class ReportJoinItemDto { public int CrossModuleJoinId { get; set; } public int ExecutionOrder { get; set; } }
    public class CreateEmptyReportRequestDto { [Required] public string Name { get; set; } = ""; public string? Description { get; set; } [Required] public string Username { get; set; } = ""; }
    public class Report { public int Id { get; set; } public string Name { get; set; } public string? Description { get; set; } }
    public class ReportJoin { public int ReportId { get; set; } public int CrossModuleJoinId { get; set; } public int ExecutionOrder { get; set; } }
    public enum ModuleType { InsightMonitor, UrbanMonitor, EventManager, AssetManager }
    public enum EntityName { Device, Sensor, Source, Group, Event, News, Alert, Resource, Asset, Stock }
    public enum JoinType { Inner, LeftOuter, RightOuter }
}
