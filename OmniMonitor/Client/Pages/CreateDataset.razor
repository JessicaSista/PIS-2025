@code {
    private string selectedTipo = "Insight Monitor";
    private List<string> tiposDataset = new() { "Insight Monitor", "Asset Manager", "Urban Monitor", "Event Manager" };

    private List<Source> sources = new();
    private List<DeviceGroup> deviceGroups = new();
    private List<Device> devices = new();

    private int? selectedSourceId = null;
    private int? selectedGroupId = null;
    private HashSet<int> selectedDeviceIds = new();

    private string selectedSensor = string.Empty;
    private List<string> sensores = new();

    private string addName = string.Empty;
    private string addDesc = string.Empty;

    private string currentUsername = string.Empty;
    private string authToken = string.Empty;

    private string GetEncodedToken() => Uri.EscapeDataString(authToken ?? "");

    // AM UI State
    // amMode: 1 = Event Task, 2 = Asset, 3 = Stock
    private int amMode = 2;
    
    // Filtros para AM
    private List<FilterCondition> amFilters = new();
    private List<PropiedadEntidadDto> availableAttributes = new();

    // Asset flow
    private List<AssetTypeDto> assetTypes = new();
    private int? selectedAssetTypeId = null;
    private List<AssetDto> assets = new();
    private HashSet<string> selectedAssetIds = new();

    // Event Task flow
    private List<TaskTypeDto> taskTypes = new();
    private int? selectedTaskTypeId = null;
    private List<EventTaskInstanceDto> eventTaskInstances = new();
    private HashSet<int> selectedEventTaskInstanceIds = new();
    private List<EventTaskInstanceStockDto> stocks = new();
    private HashSet<int> selectedStockIds = new();

    // UM UI State
    // umMode: 1 = Eventos, 2 = Noticias
    private int umMode = 1;
    
    // Filtros para UM
    private List<FilterCondition> umFilters = new();
    private List<PropiedadEntidadDto> umAvailableAttributes = new();

    // EM UI State
    // emMode: 1 = Alertas, 2 = Eventos, 3 = Extensiones
    private int emMode = 1;
    
    // Filtros para EM
    private List<FilterCondition> emFilters = new();
    private List<PropiedadEntidadDto> emAvailableAttributes = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            currentUsername = authState.User.Identity?.Name ?? "";

            authToken = await LocalStorage.GetItemAsync<string>("authToken") ?? "";

            if (string.IsNullOrEmpty(currentUsername) || string.IsNullOrEmpty(authToken))
            {
                ShowError(@Localizer["ErrorUsuario"]);
                return;
            }

            if (string.IsNullOrEmpty(authToken))
            {
                ShowError("No se encontró token de sesión. Vuelva a iniciar sesión.");
                return;
            }

            await LoadSourcesAndGroups();
            await InitializeAMLists();
            await InitializeUMLists();
            await InitializeEMLists();
        }
        catch (Exception ex)
        {
            ShowError($"{Localizer["ErrorInicializar"]} {ex.Message}");
        }
    }

    private async Task OnTipoChanged(string? tipo)
    {
        selectedTipo = tipo ?? "Insight Monitor";
        
        // Cargar atributos cuando se selecciona UM o EM
        if (selectedTipo == "Urban Monitor")
        {
            await LoadUmAvailableAttributes();
        }
        else if (selectedTipo == "Event Manager")
        {
            await LoadEmAvailableAttributes();
        }
        
        StateHasChanged();
    }

    private async Task SetAmMode(int mode)
    {
        if (amMode == mode) return;
        amMode = mode;
        // Reset filtros y atributos cuando cambia el modo
        amFilters.Clear();
        availableAttributes.Clear();
        
        // Cargar atributos disponibles para la entidad seleccionada
        await LoadAvailableAttributes();
        
        StateHasChanged();
    }
    
    private async Task LoadAvailableAttributes()
    {
        try
        {
            var entidadId = amMode switch
            {
                1 => 1, // EventTaskInstance
                2 => 2, // Asset
                3 => 3, // Stock
                _ => 2
            };
            
            var url = $"api/DatasetFilter/FiltrarPorModuloYEntidad?modulo=AM&entidadId={entidadId}";
            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                availableAttributes = await response.Content.ReadFromJsonAsync<List<PropiedadEntidadDto>>() ?? new List<PropiedadEntidadDto>();
            }
        }
        catch (Exception ex)
        {
            ShowError($"Error cargando atributos: {ex.Message}");
            availableAttributes = new List<PropiedadEntidadDto>();
        }
    }
    
    private async Task OpenFilterModal()
    {
        if (availableAttributes.Count == 0)
        {
            await LoadAvailableAttributes();
        }
        
        var parameters = new DialogParameters<FilterModal>
        {
            { x => x.AvailableAttributes, availableAttributes },
            { x => x.Modulo, "AM" },
            { x => x.EntidadId, amMode switch { 1 => 1, 2 => 2, 3 => 3, _ => 2 } },
            { x => x.Token, authToken }
        };
        
        var options = new DialogOptions 
        { 
            MaxWidth = MaxWidth.Medium, 
            FullWidth = true,
            CloseButton = true
        };
        
        var dialog = await DialogService.ShowAsync<FilterModal>("Crear Filtro", parameters, options);
        var result = await dialog.Result;
        
        if (!result.Canceled && result.Data is FilterCondition filter)
        {
            amFilters.Add(filter);
            StateHasChanged();
        }
    }
    
    private void RemoveFilter(FilterCondition filter)
    {
        amFilters.Remove(filter);
        StateHasChanged();
    }
    
    private string GetFilterTypeDisplayName(FilterType type)
    {
        return type switch
        {
            FilterType.Equals => "=",
            FilterType.NotEquals => "≠",
            FilterType.GreaterThan => ">",
            FilterType.LessThan => "<",
            FilterType.Contains => "contiene",
            FilterType.StartsWith => "comienza con",
            FilterType.EndsWith => "termina con",
            FilterType.In => "en",
            FilterType.Between => "entre",
            _ => type.ToString()
        };
    }
    
    private string GetFilterValueDisplay(FilterCondition filter)
    {
        if (filter.Condition == null)
            return "";
            
        if (filter.Type == FilterType.Between)
        {
            // Manejar array de fechas o números
            if (filter.Condition is System.Text.Json.JsonElement je && je.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                var arr = je.EnumerateArray().ToArray();
                if (arr.Length >= 2)
                {
                    var from = arr[0].GetRawText().Trim('"');
                    var to = arr[1].GetRawText().Trim('"');
                    // Intentar parsear como fecha
                    if (DateTime.TryParse(from, out var fromDate) && DateTime.TryParse(to, out var toDate))
                    {
                        return $"{fromDate:dd/MM/yyyy} y {toDate:dd/MM/yyyy}";
                    }
                    return $"{from} y {to}";
                }
            }
            else if (filter.Condition is Array arr && arr.Length >= 2)
            {
                var from = arr.GetValue(0);
                var to = arr.GetValue(1);
                if (from is DateTime fromDate && to is DateTime toDate)
                {
                    return $"{fromDate:dd/MM/yyyy} y {toDate:dd/MM/yyyy}";
                }
                return $"{from} y {to}";
            }
            else if (filter.Condition is IEnumerable<object> enumerable)
            {
                var list = enumerable.ToList();
                if (list.Count >= 2)
                {
                    var from = list[0];
                    var to = list[1];
                    if (from is DateTime fromDate && to is DateTime toDate)
                    {
                        return $"{fromDate:dd/MM/yyyy} y {toDate:dd/MM/yyyy}";
                    }
                    return $"{from} y {to}";
                }
            }
            return filter.Condition.ToString() ?? "";
        }
        else if (filter.Type == FilterType.In)
        {
            if (filter.Condition is List<object> list)
            {
                return $"({string.Join(", ", list)})";
            }
            return filter.Condition.ToString() ?? "";
        }
        else
        {
            // Para fechas individuales, formatear correctamente
            if (filter.ValueType == FilterValueType.Date && filter.Condition is DateTime dt)
            {
                return dt.ToString("dd/MM/yyyy");
            }
            return filter.Condition.ToString() ?? "";
        }
    }
    
    private RenderFragment RenderFilterDisplay(FilterCondition filter) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.OpenElement(1, "strong");
        builder.AddContent(2, filter.AttributeName);
        builder.CloseElement();
        builder.AddContent(3, " ");
        builder.AddContent(4, GetFilterTypeDisplayName(filter.Type));
        builder.AddContent(5, " ");
        builder.AddContent(6, GetFilterValueDisplay(filter));
        builder.CloseElement();
    };
    
    //Cargar sources y groups desde la API
    private async Task LoadSourcesAndGroups()
    {
        try
        {
            // Codificar el token para URL por si tiene caracteres especiales
            var encodedToken = GetEncodedToken();

            var sourcesResponse = await Http.GetAsync($"api/SondaMain/sources");
            if (sourcesResponse.IsSuccessStatusCode)
            {
                sources = await sourcesResponse.Content.ReadFromJsonAsync<List<Source>>() ?? new List<Source>();
            }
            else
            {
                var error = await sourcesResponse.Content.ReadAsStringAsync();
                ShowError($"Error al cargar fuentes: {error}");
            }

            var groupsResponse = await Http.GetAsync($"api/SondaMain/groups");

