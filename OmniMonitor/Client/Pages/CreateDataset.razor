@page "/crearDataset"
@using OmniMonitor.Shared.Dtos
@using Microsoft.AspNetCore.Components.Authorization
@using Blazored.LocalStorage
@using OmniMonitor.Shared.Dtos.AM
@using OmniMonitor.Shared.Dtos.EM
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http
@using MudBlazor
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Datasets> Localizer
@inject ILocalStorageService LocalStorage

<PageTitle>Crear Dataset</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1 mt-2 mx-4" Style=" font-weight: 500; font-family: Inter, Roboto, sans-serif;">
    @Localizer["CrearDataset"]
</MudText>


<!-- Selector de tipo de dataset -->
<MudText Typo="Typo.h6" Class="mb-1 mx-4" >@Localizer["Modulo"]</MudText>
<MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
    <MudSelect T="string"
               @bind-Value="selectedTipo"
               Variant="Variant.Outlined"
               Class="flex-grow-1 dark-field"
               InputClass="dark-field-input"
               PopoverClass="dark-field-popover">
        @foreach (var tipo in tiposDataset)
        {
            <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
        }
    </MudSelect>
</MudStack>

@if (!string.IsNullOrEmpty(selectedTipo) && selectedTipo == "Insight Monitor")
{
    <!-- Campo Nombre -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4" >@Localizer["Nombre"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField @bind-Value="addName" 
                      Placeholder="@Localizer["AgregarNombre"]"
                      Variant="Variant.Outlined"
                      Class="flex-grow-1 dark-field"
                      MaxLength="50"
                      Required="true" />
    </MudStack>

    <!-- Campo Descripción -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4" >@Localizer["Descripcion"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField T="string"
                      @bind-Value="addDesc"
                      Placeholder="@Localizer["AgregarDescripcion"]"
                      Variant="Variant.Outlined"
                      Lines="3"
                      Class='@($"flex-grow-1 dark-field mt-0 {(string.IsNullOrWhiteSpace(addDesc) ? "required-empty" : "")}")'
                      MaxLength="200"
                      Required="true" />
    </MudStack>


    <!-- Cuatro selects en la misma línea: Fuente, Grupo, Dispositivo y Sensor -->
    <MudStack Row Spacing="2" Class="mb-4 mx-4">

        <!-- Fuente -->
        <div style="width: 25%;">
            <MudSelect T="int?"
                       Value="@selectedSourceId"
                       ValueChanged="@OnSourceChanged"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarFuente"]"
                       Class="@($"dark-field")"
                       Required="true">
                @foreach (var source in sources)
                {
                    <MudSelectItem Value="@((int?)source.Id)">@source.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Grupo -->
        <div style="width: 25%;">
            <MudSelect T="int?"
                       Value="@selectedGroupId"
                       ValueChanged="@OnGroupChanged"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarGrupo"]"
                       Class="dark-field">
                @foreach (var group in deviceGroups)
                {
                    <MudSelectItem Value="@((int?)group.Id)">@group.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
           <!--SelectedValuesChanged="OnSelectedDevicesChanged"-->
        <!-- Dispositivo -->
        <div style="width: 25%;">
            <MudSelect T="int"
                       SelectedValues="selectedDeviceIds"
                       SelectedValuesChanged="OnSelectedDevicesChanged"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       Clearable
                       SelectAll="true" 
                       SelectAllText="Seleccionar todos"
                       FullWidth="true"
                       Label="@Localizer["SeleccionarDispositivo"]"
                       Class="dark-field"
                       Disabled="@(!selectedSourceId.HasValue)"
                       ToStringFunc="@(id => devices.FirstOrDefault(d => d.Id == id)?.Name ?? id.ToString())">
                @foreach (var device in devices)
                {
                    <MudSelectItem T="int" Value="@device.Id">@device.Name</MudSelectItem>
                }
            </MudSelect>

        </div>

        <!-- Sensor -->
        <div style="width: 25%;">
            <MudSelect T="string"
                       @bind-Value="selectedSensor"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarSensor"]"
                       Class="@($"dark-field")"
                       Disabled="@(!selectedSourceId.HasValue)"
                       Required="true">
                @foreach (var sensor in sensores)
                {
                    <MudSelectItem Value="@sensor">@sensor</MudSelectItem>
                }
            </MudSelect>
        </div>
    </MudStack>

    <div class="mb-4 mx-4" style="display: flex; justify-content: flex-end;">
        <MudButton OnClick="GuardarDataset"
                   Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   Disabled="@(! selectedSourceId.HasValue || string.IsNullOrWhiteSpace(selectedSensor) || string.IsNullOrWhiteSpace(addDesc) || string.IsNullOrWhiteSpace(addName) )">
            @Localizer["GuardarDataset"]
        </MudButton>

    </div>
}

@if (!string.IsNullOrEmpty(selectedTipo) && selectedTipo == "Asset Manager")
{
    <!-- Campo Nombre -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4" >@Localizer["Nombre"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField @bind-Value="addName" Placeholder="@Localizer["AgregarNombre"]"
                      Variant="Variant.Outlined"
                      Class="flex-grow-1 dark-field"
                      MaxLength="50"
                      Required="true" />
    </MudStack>

    <!-- Campo Descripción -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4" >@Localizer["Descripcion"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField T="string"
                      @bind-Value="addDesc"
                      Placeholder="@Localizer["AgregarDescripcion"]"
                      Variant="Variant.Outlined"
                      Lines="3"
                      Class="@($"flex-grow-1 dark-field mt-0 {(string.IsNullOrWhiteSpace(addDesc) ? "required-empty" : "")}")"
                      MaxLength="200"
                      Required="true" />
    </MudStack>

    <!-- Toggle de modo: Asset vs Event Task -->
    <MudStack Row Spacing="2" Class="mb-1 mx-4">
        <MudButton Variant="@(amMode == 2 ? Variant.Filled : Variant.Outlined)" Color="MudBlazor.Color.Primary" OnClick="() => SetAmMode(2)">Asset</MudButton>
        <MudButton Variant="@(amMode == 1 ? Variant.Filled : Variant.Outlined)" Color="MudBlazor.Color.Primary" OnClick="() => SetAmMode(1)">Event Task</MudButton>
    </MudStack>

    @if (amMode == 2)
    {
        <!-- Asset Manager: AssetType (req) -> Assets (multi, opcional) -->
        <MudStack Row Spacing="2" Class="mb-4 mx-4">
            <div style="width: 50%;">
                <MudSelect T="int?"
                           Value="@selectedAssetTypeId"
                           ValueChanged="OnAssetTypeChanged"
                           Variant="Variant.Outlined"
                           FullWidth="true"
                           Clearable
                           Label="@Localizer["SeleccionarTipoAsset"]"
                           Class="dark-field"
                           Required="true">
                    @foreach (var t in assetTypes)
                    {
                        <MudSelectItem Value="@((int?)t.Id)">@t.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div style="width: 50%;">
                <MudSelect T="string"
                           SelectedValues="selectedAssetIds"
                           SelectedValuesChanged="OnSelectedAssetsChanged"
                           Variant="Variant.Outlined"
                           MultiSelection="true"
                           SelectAll="true" 
                           SelectAllText="@Localizer["SeleccionarTodos"]"
                           Clearable
                           FullWidth="true"
                           Disabled="@(!selectedAssetTypeId.HasValue)"
                           Label="@Localizer["SeleccionarAsset"]"
                           Class="dark-field"
                           Required="true"
                           ToStringFunc="@(id => assets.FirstOrDefault(a => a.Id == id)?.Name ?? id)">
                    @foreach (var a in assets)
                    {
                        <MudSelectItem T="string" Value="@a.Id">@a.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </MudStack>
    }
    else if (amMode == 1)
    {
        <!-- Asset Manager: Event Task flow -->
        <MudStack Row Spacing="2" Class="mb-4 mx-4">
            <div style="width: 33.33%;">
                <MudSelect T="int?"
                           Value="@selectedTaskTypeId"
                           ValueChanged="OnTaskTypeChanged"
                           Variant="Variant.Outlined"
                           FullWidth="true"
                           Label="@Localizer["SeleccionarTaskType"]"
                           Clearable
                           Class="dark-field"
                           Required="true">
                    @foreach (var t in taskTypes)
                    {
                        <MudSelectItem Value="@((int?)t.Id)">@t.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div style="width: 33.33%;">
                <MudSelect T="int"
                           SelectedValues="selectedEventTaskInstanceIds"
                           SelectedValuesChanged="OnSelectedEventTaskInstancesChanged"
                           Variant="Variant.Outlined"
                           MultiSelection="true"
                           SelectAll="true" 
                           SelectAllText="@Localizer["SeleccionarTodos"]"
                           Clearable
                           FullWidth="true"
                           Disabled="@(!selectedTaskTypeId.HasValue)"
                           Label="@Localizer["SeleccionarEventTaskInstance"]"
                           Class="dark-field"
                           ToStringFunc="@(id => GetEventTaskInstanceDisplayName(id))">
                    @foreach (var e in eventTaskInstances)
                    {
                        <MudSelectItem T="int" Value="@e.Id">@GetEventTaskInstanceDisplayName(e.Id)</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div style="width: 33.33%;">
                <MudSelect T="int"
                           SelectedValues="selectedStockIds"
                           SelectedValuesChanged="OnSelectedStocksChanged"
                           Variant="Variant.Outlined"
                           MultiSelection="true"
                           Clearable
                           FullWidth="true"
                           Disabled="@(!EnableStocksSelect)"
                           Label="@Localizer["SeleccionarStock"]"
                           Class="dark-field"
                           ToStringFunc="@(id => stocks.FirstOrDefault(s => s.Id == id)?.Name ?? id.ToString())">
                    @foreach (var s in stocks)
                    {
                        <MudSelectItem T="int" Value="@s.Id">@s.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </MudStack>
    }

    <div class="mb-4 mx-4" style="display: flex; justify-content: flex-end;">
        <MudButton OnClick="GuardarDatasetAM"
                   Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   Disabled="@(!CanSaveAM)">
            @Localizer["GuardarDataset"]
        </MudButton>
    </div>
}

@if (!string.IsNullOrEmpty(selectedTipo) && selectedTipo == "Urban Monitor")
{
    <!-- Campo Nombre -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Nombre"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField @bind-Value="addName" Placeholder="@Localizer["AgregarNombre"]"
                      Variant="Variant.Outlined"
                      Class="flex-grow-1 dark-field"
                      MaxLength="50"
                      Required="true" />
    </MudStack>

    <!-- Campo Descripción -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Descripcion"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField T="string"
                      @bind-Value="addDesc"
                      Placeholder="@Localizer["AgregarDescripcion"]"
                      Variant="Variant.Outlined"
                      TextFieldType="MudBlazor.TextFieldType.Multiline"
                      Lines="3"
                      Class="@($"flex-grow-1 dark-field mt-0 {(string.IsNullOrWhiteSpace(addDesc) ? "required-empty" : "")}")"
                      MaxLength="200"
                      Required="true" />
    </MudStack>

    <!-- Tres selects: Zona, Eventos y Noticias -->
    <MudStack Row Spacing="2" Class="mb-4 mx-4">
        <!-- Zona -->
        <div style="width: 33.33%;">
            <MudSelect T="int?"
                       Value="@selectedZoneId"
                       ValueChanged="OnZoneChanged"
                       Variant="Variant.Outlined"
                       FullWidth="true"
                       Clearable
                       Label="@Localizer["SeleccionarZona"]"
                       Class="dark-field"
                       Required="true">
                @foreach (var zone in zones)
                {
                    <MudSelectItem Value="@((int?)zone.Id)">@zone.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Eventos -->
        <div style="width: 33.33%;">
            <MudSelect T="int"
                       SelectedValues="selectedEventIds"
                       SelectedValuesChanged="OnSelectedEventsChanged"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       SelectAll="true"
                       SelectAllText="@Localizer["SeleccionarTodos"]"
                       Clearable
                       FullWidth="true"
                       Disabled="@(!selectedZoneId.HasValue)"
                       Label="@Localizer["SeleccionarEvento"]"
                       Class="dark-field"
                       ToStringFunc="@(id => events.FirstOrDefault(e => e.Id == id)?.Name ?? id.ToString())">
                @foreach (var evt in events)
                {
                    <MudSelectItem T="int" Value="@evt.Id">@evt.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Noticias -->
        <div style="width: 33.33%;">
            <MudSelect T="int"
                       SelectedValues="selectedNewsIds"
                       SelectedValuesChanged="OnSelectedNewsChanged"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       SelectAll="true"
                       SelectAllText="@Localizer["SeleccionarTodos"]"
                       Clearable
                       FullWidth="true"
                       Disabled="@(!selectedZoneId.HasValue)"
                       Label="@Localizer["SeleccionarNoticia"]"
                       Class="dark-field"
                       ToStringFunc="@(id => newsList.FirstOrDefault(n => n.Id == id)?.Title ?? id.ToString())">
                @foreach (var news in newsList)
                {
                    <MudSelectItem T="int" Value="@news.Id">@news.Title</MudSelectItem>
                }
            </MudSelect>
        </div>
    </MudStack>

    <div class="mb-4 mx-4" style="display: flex; justify-content: flex-end;">
        <MudButton OnClick="GuardarDatasetUM"
                   Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   Disabled="@(!CanSaveUM)">
            @Localizer["GuardarDataset"]
        </MudButton>
    </div>
}

@if (!string.IsNullOrEmpty(selectedTipo) && selectedTipo == "Event Manager")
{
    <!-- Campo Nombre -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Nombre"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField @bind-Value="addName" Placeholder="@Localizer["AgregarNombre"]"
                      Variant="Variant.Outlined"
                      Class="flex-grow-1 dark-field"
                      MaxLength="50"
                      Required="true" />
    </MudStack>

    <!-- Campo Descripción -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Descripcion"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField T="string"
                      @bind-Value="addDesc"
                      Placeholder="@Localizer["AgregarDescripcion"]"
                      Variant="Variant.Outlined"
                      TextFieldType="MudBlazor.TextFieldType.Multiline"
                      Lines="3"
                      Class="@($"flex-grow-1 dark-field mt-0 {(string.IsNullOrWhiteSpace(addDesc) ? "required-empty" : "")}")"
                      MaxLength="200"
                      Required="true" />
    </MudStack>

    <!-- Cuatro selects: Categoria, Eventos, Alertas y Extensiones -->
    <MudStack Row Spacing="2" Class="mb-4 mx-4">
        <!-- Categoria -->
        <div style="width: 25%;">
            <MudSelect T="int?"
                       Value="@selectedCategoryId"
                       ValueChanged="OnCategoryChanged"
                       Variant="Variant.Outlined"
                       FullWidth="true"
                       Clearable
                       Label="@Localizer["SeleccionarCategoria"]"
                       Class="dark-field"
                       Required="true">
                @foreach (var category in categories)
                {
                    <MudSelectItem Value="@((int?)category.Id)">@category.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Eventos -->
        <div style="width: 25%;">
            <MudSelect T="int"
                       SelectedValues="selectedEventEMIds"
                       SelectedValuesChanged="OnSelectedEventEMsChanged"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       SelectAll="true"
                       SelectAllText="@Localizer["SeleccionarTodos"]"
                       Clearable
                       FullWidth="true"
                       Disabled="@(!selectedCategoryId.HasValue)"
                       Label="@Localizer["SeleccionarEvento"]"
                       Class="dark-field"
                       ToStringFunc="@(id => eventsEM.FirstOrDefault(e => e.Id == id)?.Name ?? id.ToString())">
                @foreach (var evt in eventsEM)
                {
                    <MudSelectItem T="int" Value="@evt.Id">@evt.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Alertas -->
        <div style="width: 25%;">
            <MudSelect T="int"
                       SelectedValues="selectedAlertIds"
                       SelectedValuesChanged="OnSelectedAlertsChanged"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       SelectAll="true"
                       SelectAllText="@Localizer["SeleccionarTodos"]"
                       Clearable
                       FullWidth="true"
                       Disabled="@(!selectedCategoryId.HasValue)"
                       Label="@Localizer["SeleccionarAlerta"]"
                       Class="dark-field"
                       ToStringFunc="@(id => GetAlertDisplayName(id))">
                @foreach (var alert in alertsEM)
                {
                    <MudSelectItem T="int" Value="@alert.AlertId">@GetAlertDisplayName(alert.AlertId)</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Extensiones -->
        <div style="width: 25%;">
            <MudSelect T="int"
                       SelectedValues="selectedExtensionIds"
                       SelectedValuesChanged="OnSelectedExtensionsChanged"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       SelectAll="true"
                       SelectAllText="@Localizer["SeleccionarTodos"]"
                       Clearable
                       FullWidth="true"
                       Disabled="@(!EnableExtensionsSelect)"
                       Label="@Localizer["SeleccionarExtension"]"
                       Class="dark-field"
                       ToStringFunc="@(id => GetExtensionDisplayName(id))">
                @foreach (var ext in extensions)
                {
                    <MudSelectItem T="int" Value="@ext.Id">@GetExtensionDisplayName(ext.Id)</MudSelectItem>
                }
