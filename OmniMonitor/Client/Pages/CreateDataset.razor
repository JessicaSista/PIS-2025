    </MudStack>

    <div class="mb-4 mx-4" style="display: flex; justify-content: flex-end;">
        <MudButton OnClick="GuardarDatasetEM"
                   Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   Disabled="@(!CanSaveEM)">
            @Localizer["GuardarDataset"]
        </MudButton>
    </div>
}

@code {
    private string selectedTipo = "Insight Monitor";
    private List<string> tiposDataset = new() { "Insight Monitor", "Asset Manager", "Urban Monitor", "Event Manager" };

    private List<Source> sources = new();
    private List<DeviceGroup> deviceGroups = new();
    private List<Device> devices = new();

    private int? selectedSourceId = null;
    private int? selectedGroupId = null;
    private HashSet<int> selectedDeviceIds = new();

    private string selectedSensor = string.Empty;
    private List<string> sensores = new();

    private string addName = string.Empty;
    private string addDesc = string.Empty;

    private string currentUsername = string.Empty;
    private string authToken = string.Empty;

    private string GetEncodedToken() => Uri.EscapeDataString(authToken ?? "");

    // AM UI State
    // amMode: 1 = Event Task, 2 = Asset
    private int amMode = 2;

    // Asset flow
    private List<AssetTypeDto> assetTypes = new();
    private int? selectedAssetTypeId = null;
    private List<AssetDto> assets = new();
    private HashSet<string> selectedAssetIds = new();

    // Event Task flow
    private List<TaskTypeDto> taskTypes = new();
    private int? selectedTaskTypeId = null;
    private List<EventTaskInstanceDto> eventTaskInstances = new();
    private HashSet<int> selectedEventTaskInstanceIds = new();
    private List<EventTaskInstanceStockDto> stocks = new();
    private HashSet<int> selectedStockIds = new();

    // UM UI State
    private List<Zone> zones = new();
    private int? selectedZoneId = null;
    private List<Event> events = new();
    private HashSet<int> selectedEventIds = new();
    private List<News> newsList = new();
    private HashSet<int> selectedNewsIds = new();

    // EM UI State
    private List<CategoryDto> categories = new();
    private int? selectedCategoryId = null;
    private List<EventDto> eventsEM = new();
    private HashSet<int> selectedEventEMIds = new();
    private List<AlertDto> alertsEM = new();
    private HashSet<int> selectedAlertIds = new();
    private List<ExtensionDtoDup> extensions = new();
    private HashSet<int> selectedExtensionIds = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            currentUsername = authState.User.Identity?.Name ?? "";

            authToken = await LocalStorage.GetItemAsync<string>("authToken") ?? "";

            if (string.IsNullOrEmpty(currentUsername) || string.IsNullOrEmpty(authToken))
            {
                ShowError(@Localizer["ErrorUsuario"]);
                return;
            }

            if (string.IsNullOrEmpty(authToken))
            {
                ShowError("No se encontró token de sesión. Vuelva a iniciar sesión.");
                return;
            }

            await LoadSourcesAndGroups();
            await InitializeAMLists();
            await InitializeUMLists();
            await InitializeEMLists();
        }
        catch (Exception ex)
        {
            ShowError($"{Localizer["ErrorInicializar"]} {ex.Message}");
        }
    }

    private void SetAmMode(int mode)
    {
        if (amMode == mode) return;
        amMode = mode;
        // Reset selections when switching modes
        if (amMode == 2)
        {
            selectedTaskTypeId = null;
            selectedEventTaskInstanceIds.Clear();
            selectedStockIds.Clear();
            stocks.Clear();
        }
        else
        {
            selectedAssetTypeId = null;
            selectedAssetIds.Clear();
            assets.Clear();
        }
        StateHasChanged();
    }

    //Cargar sources y groups desde la API
    private async Task LoadSourcesAndGroups()
    {
        try
        {
            Console.WriteLine($"[DEBUG] Token length: {authToken?.Length ?? 0}");
            Console.WriteLine($"[DEBUG] Token (first 50 chars): {authToken?.Substring(0, Math.Min(50, authToken?.Length ?? 0))}...");

            // Codificar el token para URL por si tiene caracteres especiales
            var encodedToken = GetEncodedToken();

            var sourcesResponse = await Http.GetAsync($"api/SondaMain/sources");
            Console.WriteLine($"[DEBUG] Sources response status: {sourcesResponse.StatusCode}");
            if (sourcesResponse.IsSuccessStatusCode)
            {
                sources = await sourcesResponse.Content.ReadFromJsonAsync<List<Source>>() ?? new List<Source>();
                Console.WriteLine($"[DEBUG] Loaded {sources.Count} sources");
            }
            else
            {
                var error = await sourcesResponse.Content.ReadAsStringAsync();
                Console.WriteLine($"[DEBUG] Sources error: {error}");
                ShowError($"Error al cargar fuentes: {error}");
            }

            var groupsResponse = await Http.GetAsync($"api/SondaMain/groups");
            Console.WriteLine($"[DEBUG] Groups response status: {groupsResponse.StatusCode}");

            if (groupsResponse.IsSuccessStatusCode)
            {
                deviceGroups = await groupsResponse.Content.ReadFromJsonAsync<List<DeviceGroup>>() ?? new List<DeviceGroup>();
                Console.WriteLine($"[DEBUG] Loaded {deviceGroups.Count} groups");
            }
            else
            {
                var error = await groupsResponse.Content.ReadAsStringAsync();
                Console.WriteLine($"[DEBUG] Groups error: {error}");
                ShowError($"Error al cargar grupos: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DEBUG] Exception in LoadSourcesAndGroups: {ex.Message}");
            Console.WriteLine($"[DEBUG] Stack trace: {ex.StackTrace}");
            ShowError($"{Localizer["ErrorCargaFuentes"]} {ex.Message}");
        }
    }

    // Cuando cambia la fuente seleccionada: limpiar grupo, dispositivos y sensor
    private async Task OnSourceChanged(int? sourceId)
    {
        // asigno nuevo source
        selectedSourceId = sourceId;

        // limpio todas las dependencias
        selectedGroupId = null;
        selectedDeviceIds.Clear();
        selectedSensor = string.Empty;
        devices.Clear();
        sensores.Clear();

        // solo recargo si hay una fuente seleccionada
        if (selectedSourceId.HasValue)
        {
            await LoadDevices();
            await LoadSensors();
        }

        StateHasChanged();
    }

    private bool CanSaveAM
    {
        get
        {
            if (string.IsNullOrWhiteSpace(addName) || string.IsNullOrWhiteSpace(addDesc)) return false;
