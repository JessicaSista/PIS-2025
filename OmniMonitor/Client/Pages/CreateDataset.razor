    // Cargar devices con intersección de filtros
    private async Task LoadDevices()
    {
        try
        {
            List<Device>? devicesFromSource = null;
            List<Device>? devicesFromGroup = null;

            // Si hay source seleccionado, obtener sus devices
            if (selectedSourceId.HasValue)
            {
                var sourceResponse = await Http.GetAsync($"api/SondaMain/devices/source/{selectedSourceId.Value}");
                if (sourceResponse.IsSuccessStatusCode)
                {
                    devicesFromSource = await sourceResponse.Content.ReadFromJsonAsync<List<Device>>();
                }
            }

            // Si hay group seleccionado, obtener sus devices
            if (selectedGroupId.HasValue)
            {
                var groupResponse = await Http.GetAsync($"api/SondaMain/devices/group/{selectedGroupId.Value}");
                if (groupResponse.IsSuccessStatusCode)
                {
                    devicesFromGroup = await groupResponse.Content.ReadFromJsonAsync<List<Device>>();
                }
            }

            // INTERSECCIÓN: Si hay ambos filtros, mostrar solo devices que están en ambos
            if (devicesFromSource != null && devicesFromGroup != null)
            {
                var deviceIdsFromGroup = new HashSet<int>(devicesFromGroup.Select(d => d.Id));
                devices = devicesFromSource.Where(d => deviceIdsFromGroup.Contains(d.Id)).ToList();
            }
            else if (devicesFromSource != null)
            {
                devices = devicesFromSource;
            }
            else if (devicesFromGroup != null)
            {
                devices = devicesFromGroup;
            }
            else
            {
                // Si no hay filtros, mostrar todos los devices
                var allDevicesResponse = await Http.GetAsync($"api/SondaMain/devices");
                if (allDevicesResponse.IsSuccessStatusCode)
                {
                    devices = await allDevicesResponse.Content.ReadFromJsonAsync<List<Device>>() ?? new List<Device>();
                }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowError($"{Localizer["ErrorCargaDispositivos"]} {ex.Message}");
            devices = new List<Device>();
        }
    }

    // Cargar sensores de la fuente seleccionada o dispositivos seleccionados
    private async Task LoadSensors()
    {
        try
        {
            // Guardar el sensor actualmente seleccionado
            var currentSelectedSensor = selectedSensor;

            sensores.Clear();

            if (selectedSourceId.HasValue)
            {
                // Si hay dispositivos seleccionados, obtener sensores solo de esos dispositivos
                if (selectedDeviceIds.Any())
                {
                    var sensorsResponse = await Http.PostAsJsonAsync($"api/SondaMain/sensors/devices", selectedDeviceIds.ToList());
                    if (sensorsResponse.IsSuccessStatusCode)
                    {
                        sensores = await sensorsResponse.Content.ReadFromJsonAsync<List<string>>() ?? new List<string>();
                    }
                }
                else
                {
                    // Si no hay dispositivos seleccionados, obtener todos los sensores de la fuente
                    var sensorsResponse = await Http.GetAsync($"api/SondaMain/sensors/source/{selectedSourceId.Value}");
                    if (sensorsResponse.IsSuccessStatusCode)
                    {
                        sensores = await sensorsResponse.Content.ReadFromJsonAsync<List<string>>() ?? new List<string>();
                    }
                }

                // Si el sensor previamente seleccionado existe en la nueva lista, mantenerlo seleccionado
                if (!string.IsNullOrEmpty(currentSelectedSensor) && sensores.Contains(currentSelectedSensor))
                {
                    selectedSensor = currentSelectedSensor;
                }
                else
                {
                    selectedSensor = string.Empty;
                }
            }
            else
            {
                selectedSensor = string.Empty;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowError($"{Localizer["ErrorCargaSensores"]} {ex.Message}");
            sensores = new List<string>();
            selectedSensor = string.Empty;
        }
    }

