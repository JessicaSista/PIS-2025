            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;
            if (string.IsNullOrEmpty(username))
            {
                ShowError("No se pudo obtener el usuario actual");
                return;
            }
            if (string.IsNullOrWhiteSpace(addDesc))
            {
                ShowError("La descripción es obligatoria");
                return;
            }
            if (string.IsNullOrWhiteSpace(addName))
            {
                ShowError("Error al crear el dataset: El nombre del dataset es obligatorio.");
                return;
            }
            if (!selectedCategoryId.HasValue)
            {
                ShowError("Debe seleccionar una categoria");
                return;
            }

            var request = new CreateDatasetEMRequest
            {
                Username = username,
                Name = addName,
                Description = addDesc,
                IsDataset = "S",
                ContentType = "0",
                CategoryIds = selectedCategoryId.HasValue ? new List<int> { selectedCategoryId.Value } : null,
                EventIds = selectedEventEMIds.Any() ? selectedEventEMIds.ToList() : null,
                AlertIds = selectedAlertIds.Any() ? selectedAlertIds.ToList() : null,
                ExtensionIds = selectedExtensionIds.Any() ? selectedExtensionIds.ToList() : null
            };

            var resp = await Http.PostAsJsonAsync($"api/DatasetEM", request);
            if (resp.IsSuccessStatusCode)
            {
                var created = await resp.Content.ReadFromJsonAsync<DatasetEM>();
                ShowSuccess($"'{created?.Name}' {Localizer["DatasetCreadoExito"]}");
            }
            else
            {
                var error = await resp.Content.ReadAsStringAsync();
                ShowError(error);
            }
        }
        catch (Exception ex)
        {
            ShowError($"No se pudo crear el dataset EM: {ex.Message}");
        }
    }
        private static Dictionary<string, string> ParseQueryString(string? query)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrEmpty(query)) return result;
        var q = query.StartsWith("?") ? query.Substring(1) : query;
        foreach (var pair in q.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split('=', 2);
            var key = Uri.UnescapeDataString(kv[0]);
            var value = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : string.Empty;
            result[key] = value;
        }
        return result;
    }

    private string? GetQueryParam(string key)
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var dict = ParseQueryString(uri.Query);
        return dict.TryGetValue(key, out var v) ? v : null;
    }
