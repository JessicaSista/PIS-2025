@page "/items"
@using OmniMonitor.Shared
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http

<PageTitle>Item List</PageTitle>

<MudText Typo="Typo.h3">Items List</MudText>
<MudText Typo="Typo.body1">This component displays all records from the database.</MudText>

<MudTable Items="items" Hover="true" Bordered="true" Striped="true">
    <HeaderContent>
        <MudTh>Id</MudTh>
        <MudTh>Name</MudTh>
        <MudTh>Age</MudTh>
        <MudTh>Score</MudTh>
        <MudTh>Alias</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Id</MudTd>
        <MudTd>@context.Nombre</MudTd>
        <MudTd>@context.Edad</MudTd>
        <MudTd>@context.Millones</MudTd>
        <MudTd>@context.NombreRapero</MudTd>
        <MudTd>
            <MudButton Variant="Variant.Text" Color="MudBlazor.Color.Primary" Href="@($"/items/{context.Id}")">
                View Details
            </MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private Rapero[]? items;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            items = await Http.GetFromJsonAsync<Rapero[]>("Marruno");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading items: {ex.Message}");
        }
    }
}
