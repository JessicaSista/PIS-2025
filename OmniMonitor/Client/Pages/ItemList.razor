@page "/items"
@using OmniMonitor.Shared
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http

<PageTitle>Item List</PageTitle>

<MudText Typo="Typo.h3">Items List</MudText>
<MudText Typo="Typo.body1">This component displays all records from the database.</MudText>

<MudTable Items="items" Hover="true" Bordered="true" Striped="true">
    <HeaderContent>
        <MudTh>Id</MudTh>
        <MudTh>Nombre</MudTh>
        <MudTh>Cantidad</MudTh>
        <MudTh>Precio</MudTh>
        <MudTh>Categoria</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Id</MudTd>
        <MudTd>@context.Nombre</MudTd>
        <MudTd>@context.Cantidad</MudTd>
        <MudTd>@context.Precio</MudTd>
        <MudTd>@context.Categoria</MudTd>
        <MudTd>
            <MudButton Variant="Variant.Text" Color="MudBlazor.Color.Primary" Href="@($"/items/{context.Id}")">
                View Details
            </MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private Item[]? items; 

    protected override async Task OnInitializedAsync()
    {
        try
        {
            items = await Http.GetFromJsonAsync<Item[]>("Item");
        }
        catch (Exception ex)
        {
        }
    }
}
