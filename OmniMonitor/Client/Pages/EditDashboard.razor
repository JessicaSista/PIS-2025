        // {
        //     foreach (var card in cardsData)
        //     {
        //         var (Id, Type, AnchoSm, AnchoMd, AnchoLg, Alto) = card;
        //         Console.WriteLine($"  Id: {Id}, Type: {Type} Sm: {AnchoSm}, Md: {AnchoMd}, Lg: {AnchoLg}, Alto: {Alto}");
        //     }
        // }
        // else
        // {
        //     Console.WriteLine("  (Lista de tarjetas vacía)");
