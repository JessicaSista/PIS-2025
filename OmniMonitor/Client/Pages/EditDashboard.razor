        //     Se utiliza el descarte (_) para imprimir todos los campos de la tupla.
        //     var (Id, Type, AnchoSm, AnchoMd, AnchoLg, Alto) = card;
        //     Console.WriteLine($"  Id: {Id}, Sm: {AnchoSm}, Md: {AnchoMd}, Lg: {AnchoLg}, Alto: {Alto}");
