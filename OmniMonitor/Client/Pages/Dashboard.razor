@page "/dashboard"
@using OmniMonitor.Client.Shared
@inject HttpClient Http

<h2>Dashboard</h2>

<button @onclick="() => showModal = true">Agregar Card</button>

<CardCreateModal Visible="showModal" OnSave="AgregarCard" />

<div class="dashboard">
    @foreach (var card in cards)
    {
        <CardComponent Config="card" />
    }
</div>

@code {
    private bool showModal = false;
    private List<CardConfig> cards = new();

    private void AgregarCard(CardConfig newCard)
    {
        // newCard ya es una copia desde el modal (si seguiste el cambio), pero podemos clonar de nuevo si querés:
        var serialized = System.Text.Json.JsonSerializer.Serialize(newCard);
        var copy = System.Text.Json.JsonSerializer.Deserialize<CardConfig>(serialized);
        if (copy != null) cards.Add(copy);

        showModal = false;
        StateHasChanged();
    }


}
