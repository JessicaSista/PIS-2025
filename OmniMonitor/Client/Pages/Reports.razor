@page "/reportes"
@attribute [Authorize]
@using MudBlazor
@using OmniMonitor.Client.Shared
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.Extensions.Localization
@using OmniMonitor.Shared.Dtos
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject NavigationManager NavigationManager
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject IStringLocalizer<Reports> Localizer
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@Localizer["Reportes"]</PageTitle>


<!-- Header -->
<MudStack Row Justify="Justify.SpaceBetween" Class="mt-2 mx-4">
    <MudStack>
        <MudText Typo="Typo.h4" Style="color: var(--text-primary); font-weight: 500; font-family: Inter, Roboto, sans-serif;">
            @Localizer["Title"]
        </MudText>
    </MudStack>
    <AddButton OnClick="CrearReporte">
        @Localizer["NewReportButton"]
    </AddButton>
</MudStack>

<MudStack Justify="Justify.SpaceBetween" Class="mx-4">
    <MudText Typo="Typo.body1" Class="mb-4" Style="color:var(--textColor-2); font-family: Inter, Roboto, sans-serif;">
        @Localizer["Description"]
    </MudText>
</MudStack>



<MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 ml-4 mr-6">
    <MudTextField @bind-Value="_searchText"
                  Immediate="true"
                  Placeholder="@Localizer["SearchPlaceholder"]"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="flex-grow-1" />
</MudStack>

<!-- Reports grid -->
<MudContainer Class="pl-4 pr-6 mx-0">
    <MudGrid Spacing="3">
        @if (_isLoading == true)
        {
            @*

            @for (int i = 0; i < 8; i++)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard>
                        <MudCardContent>
                            <MudSkeleton Height="150px" Width="100%" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }

            *@
        }
        else if (!_reportesFiltrados.Any())
        {
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1" Align="MudBlazor.Align.Center" Style="color:#667d8a">
                    @Localizer["NoReports"]
                </MudText>
            </MudItem>
        }
        else
        {
            @foreach (var reporte in _reportesFiltrados)
            {
                <MudItem xs="12" sm="6" md="4">
                    <div style="position: relative;">
                        <ReportCardComponent Reporte="reporte"
                                             OnNavigate="@NavigateToEditarReporte" />

                        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                 AnchorOrigin="Origin.TopRight"
                                 TransformOrigin="Origin.TopRight"
                                 Class="position-absolute"
                                 Style="position:absolute; top:8px; right:8px;">

                            <MudMenuItem OnClick="@(() => EditarReporte(reporte.Id))">
                                @Localizer["EditAction"]
                            </MudMenuItem>

                            <MudMenuItem OnClick="@(() => ConfirmarEliminarReporte(reporte.Id))">
                                @Localizer["DeleteAction"]
                            </MudMenuItem>
                        </MudMenu>
                    </div>
                </MudItem>
            }
        }
        @if (_totalPages > 1)
        {
            <MudItem lg="12" md="12" xs="12">
                <MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-6 mb-4">
                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowLeft"
                                   Disabled="@(!_hasPreviousPage)"
                                   OnClick="@(() => GoToPage(1))"
                                   Size="MudBlazor.Size.Small"
                                   Color="MudBlazor.Color.Primary" />

                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                   Disabled="@(!_hasPreviousPage)"
                                   OnClick="@(() => GoToPage(_currentPage - 1))"
                                   Size="MudBlazor.Size.Small"
                                   Color="MudBlazor.Color.Primary" />

                    <MudText Typo="Typo.body2" Class="mx-3">
                        @Localizer["Page"] @_currentPage @Localizer["ofPreposition"] @_totalPages
                    </MudText>

                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                   Disabled="@(!_hasNextPage)"
                                   OnClick="@(() => GoToPage(_currentPage + 1))"
                                   Size="MudBlazor.Size.Small"
                                   Color="MudBlazor.Color.Primary" />

                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight"
                                   Disabled="@(!_hasNextPage)"
                                   OnClick="@(() => GoToPage(_totalPages))"
                                   Size="MudBlazor.Size.Small"
                                   Color="MudBlazor.Color.Primary" />
                </MudStack>

                <MudStack Row Justify="Justify.Center" Class="mb-4">
                    <MudText Typo="Typo.caption" Style="color: #a5a8b5;">
                        @Localizer["Showing"] @_reportes.Count @Localizer["ofPreposition"] @_totalCount
                    </MudText>
                </MudStack>
            </MudItem>
        }
    </MudGrid>

</MudContainer>

@code {
    private const int DescriptionMaxLength = 250;
    private string _searchText = "";
    private List<ReporteDto> _reportes = new();
    private bool _isLoading = true;

    private int _currentPage = 1;
    private int _pageSize = 9;
    private int _totalPages = 0;
    private int _totalCount = 0;
    private bool _hasPreviousPage = false;
    private bool _hasNextPage = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CargarReportes();

            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
            if (!string.IsNullOrEmpty(uri.Query))
            {
                var query = uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
                foreach (var q in query)
                {
                    var kv = q.Split('=', 2);
                    if (kv.Length == 2 && kv[0] == "snackbar")
                    {
                        var mensaje = Uri.UnescapeDataString(kv[1]);
                        Snackbar.Add(mensaje, Severity.Success, config =>
                        {
                            config.SnackbarVariant = Variant.Filled;
                            config.Action = "OK";
                            config.ActionColor = MudBlazor.Color.Primary;
                        });
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al inicializar: {ex.Message}", Severity.Error);
        }
    }

    private IEnumerable<ReporteDto> _reportesFiltrados =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _reportes
            : _reportes.Where(r => r.Nombre.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    private Task NavigateToEditarReporte(int id)
    {
        NavigationManager.NavigateTo($"editarReporte/{id}");
        return Task.CompletedTask;
    }

    private async Task EditarReporte(int id)
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (string.IsNullOrEmpty(token))
            {
                Snackbar.Add("No se encontró el token de autenticación", Severity.Error);
                return;
            }

            var response = await Http.GetAsync($"api/reports/{id}");
            if (!response.IsSuccessStatusCode)
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al cargar el reporte: {errorBody}", Severity.Error);
                return;
            }

            var report = await response.Content.ReadFromJsonAsync<Report>();
            if (report == null)
            {
                Snackbar.Add("No se encontró la información del reporte", Severity.Error);
                return;
            }

            var parameters = new DialogParameters
            {
                ["Username"] = report.Username ?? string.Empty,
                ["IsEditMode"] = true,
                ["ReportId"] = report.Id,
                ["InitialName"] = report.Name ?? string.Empty,
                ["InitialDescription"] = report.Description ?? string.Empty,
                ["ExistingNames"] = _reportes
                    .Where(r => r.Id != id)
                    .Select(r => r.Nombre ?? string.Empty)
                    .ToList()
            };

            var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
            var dialog = await DialogService.ShowAsync<CreateReportDialog>(Localizer["EditDialogTitle"].Value, parameters, options);
            var result = await dialog.Result;

            if (result == null || result.Canceled || result.Data is not CreateReportDialog.ReportDialogResult editResult)
            {
                return;
            }

            var trimmedName = editResult.Name.Trim();
            var normalizedDescription = NormalizeDescription(editResult.Description);

            var currentName = report.Name ?? string.Empty;
            var currentDescriptionNormalized = NormalizeDescription(report.Description);
            var hasNameChange = !string.Equals(currentName, trimmedName, StringComparison.Ordinal);
            var hasDescriptionChange = !string.Equals(currentDescriptionNormalized, normalizedDescription, StringComparison.Ordinal);

            if (hasNameChange || hasDescriptionChange)
            {
                var jsonConfig = string.IsNullOrWhiteSpace(report.JSON_config) ? "{}" : report.JSON_config;
                var updateRequest = new UpdateReportRequestDto
                {
                    Name = trimmedName,
                    Description = string.IsNullOrEmpty(normalizedDescription) ? null : normalizedDescription,
                    JSON_config = jsonConfig
                };

                var updateResponse = await Http.PutAsJsonAsync($"api/reports/UpdateReport?id={editResult.ReportId}", updateRequest);
                if (updateResponse.IsSuccessStatusCode)
                {
                    Snackbar.Add("Reporte actualizado correctamente", Severity.Success);
                    await CargarReportes();
                }
                else
                {
                    var updateError = await updateResponse.Content.ReadAsStringAsync();
                    Snackbar.Add($"Error al actualizar el reporte: {updateError}", Severity.Error);
                    return;
                }
            }

            NavigationManager.NavigateTo($"editarReporte/{id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al editar el reporte: {ex.Message}", Severity.Error);
        }
    }

    private async Task ConfirmarEliminarReporte(int id)
    {
        var reporte = _reportes.FirstOrDefault(r => r.Id == id);
        if (reporte == null)
        {
            Snackbar.Add("No se encontró el reporte seleccionado.", Severity.Warning);
            return;
        }

        const string titulo = "Confirmar eliminación";
        var mensajeMarkup = (MarkupString)$"¿Desea eliminar el reporte <b>{reporte.Nombre}</b>?";

        bool? confirm = await DialogService.ShowMessageBox(
            titulo,
            mensajeMarkup,
            yesText: "Eliminar",
            cancelText: "Cancelar",
            options: new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall }
        );

        if (confirm == true)
        {
            await EliminarReporte(reporte);
        }
    }

    private async Task EliminarReporte(ReporteDto reporte)
    {
        if (reporte == null)
        {
            return;
        }

        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (string.IsNullOrEmpty(token))
            {
                Snackbar.Add("No se encontró el token de autenticación", Severity.Error);
                return;
            }

            var response = await Http.DeleteAsync($"api/Reports/DeleteReport?id={reporte.Id}");

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Reporte eliminado correctamente", Severity.Success);
                if(_reportes.Count == 1 && _currentPage > 1)
                {
                    _currentPage--;
                }
                await CargarReportes();
                await GuardarReportes();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al eliminar el reporte: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar el reporte: {ex.Message}", Severity.Error);
        }
    }

    private void VerReporte(int id)
    {
        NavigationManager.NavigateTo($"/reporte/{id}");
    }

    private async Task GuardarReportes()
    {
        try
        {
            var reportesJson = JsonSerializer.Serialize(_reportes);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "reportes", reportesJson);
        }
        catch (Exception ex)
        {
        }
    }

    private async Task CargarReportes()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;

            if (string.IsNullOrEmpty(username))
            {
                Snackbar.Add(Localizer["ErrorUsuario"], Severity.Warning);
                _reportes = new List<ReporteDto>();
                return;
            }

            var response = await Http.GetAsync($"/api/reports/GetAllReportsPaginated?page={_currentPage}&pageSize={_pageSize}");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PaginatedReportDto>();
                if(result != null)
                {
                    _totalCount = result.TotalCount;
                    _totalPages = result.TotalPages;
                    _currentPage = result.Page;
                    _hasPreviousPage = result.HasPreviousPage;
                    _hasNextPage = result.HasNextPage;

                    _reportes = result.Items.Select(d => new ReporteDto
                        {
                            Id = d.Id,
                            Nombre = d.Name,
                            Descripcion = d.Description ?? string.Empty
                        }).ToList() ?? new List<ReporteDto>();
                }

            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Snackbar.Add("Sesión expirada. Por favor, inicia sesión nuevamente.", Severity.Warning);
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al cargar los reportes: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar los reportes: {ex.Message}", Severity.Error);
            _reportes = new List<ReporteDto>();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CrearReporte()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;

            if (string.IsNullOrEmpty(username))
            {
                Snackbar.Add(Localizer["ErrorUsuario"], Severity.Error);
                return;
            }

            var parameters = new DialogParameters
            {
                ["Username"] = username,
                ["ExistingNames"] = (_reportes ?? new List<ReporteDto>())
                    .Select(r => r.Nombre ?? string.Empty)
                    .ToList()
            };

            var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

            var dialog = await DialogService.ShowAsync<CreateReportDialog>(Localizer["CreateDialogTitle"].Value, parameters, options);
            var result = await dialog.Result;
            if (result == null)
            {
                return;
            }

            if (!result.Canceled)
            {
                if (result.Data is int reportId)
                {
                    try
                    {
                        await CargarReportes();
                        NavigationManager.NavigateTo($"editarReporte/{reportId}");
                    }
                    catch (Exception loadEx)
                    {
                        NavigationManager.NavigateTo($"editarReporte/{reportId}");
                    }
                }
                else
                {
                    await CargarReportes();
                }
            }
            else
            {
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al crear el reporte: {ex.Message}", Severity.Error);
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > _totalPages) return;
        _currentPage = page;
        await CargarReportes();
    }

    private static string NormalizeDescription(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var trimmed = value.Trim();
        return trimmed.Length <= DescriptionMaxLength ? trimmed : trimmed[..DescriptionMaxLength];
    }
}
