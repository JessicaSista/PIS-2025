@page "/sonda-test-kpi4"
@using OmniMonitor.Shared.Dtos
@using System.Net.Http.Json
@using Blazored.LocalStorage
@inject HttpClient Http
@inject ILocalStorageService LocalStorage

<h3>Probar todos los KPIs del usuario</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="GetAllKpis" disabled="@isLoading">
        @(isLoading ? "Cargando..." : "Obtener todos los KPIs")
    </button>
</div>

@if (isLoading)
{
    <p><em>Cargando...</em></p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (kpiResponses != null && kpiResponses.Any())
{
    <div class="list-group">
        @foreach (var kpi in kpiResponses)
        {
            <div class="list-group-item mb-2">
                <h5>@kpi.Name</h5>
                <p><b>Descripción:</b> @kpi.Description</p>
                <p><b>Tipo:</b> @kpi.Type</p>
                <p><b>Unidad:</b> @kpi.Unit</p>
                <p><b>Color:</b> <span style="color:@kpi.ActualColor">@kpi.ActualColor</span></p>
                <p><b>Valor:</b> @kpi.Value</p>
            </div>
        }
    </div>
}
else
{
    <p>No hay KPIs calculados.</p>
}

@code {
    private List<KpiResponse>? kpiResponses;
    private bool isLoading = false;
    private string? errorMessage;

    private async Task GetAllKpis()
    {
        isLoading = true;
        errorMessage = null;
        kpiResponses = null;

        try
        {
            var response = await Http.GetAsync("/api/kpi/kpis");
            if (response.IsSuccessStatusCode)
            {
                kpiResponses = await response.Content.ReadFromJsonAsync<List<KpiResponse>>();
            }
            else
            {
                errorMessage = $"Error {response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
