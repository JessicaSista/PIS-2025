@page "/crearDataset"
@using OmniMonitor.Shared.Dtos
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http
@using MudBlazor
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Datasets> Localizer


<PageTitle>Crear Dataset</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1 mt-2 mx-4" Style=" font-weight: 500; font-family: Inter, Roboto, sans-serif;">
    @Localizer["CrearDataset"]
</MudText>


<!-- Selector de tipo de dataset -->
<MudText Typo="Typo.h6" Class="mb-1 mx-4" >@Localizer["Modulo"]</MudText>
<MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
    <MudSelect T="string"
               @bind-Value="selectedTipo"
               Variant="Variant.Outlined"
               Class="flex-grow-1 dark-field"
               InputClass="dark-field-input"
               PopoverClass="dark-field-popover">
        @foreach (var tipo in tiposDataset)
        {
            <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
        }
    </MudSelect>
</MudStack>

@if (!string.IsNullOrEmpty(selectedTipo) && selectedTipo == "Inside Monitor")
{
    <!-- Campo Nombre -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4" >@Localizer["Nombre"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField @bind-Value="addName" Placeholder="@Localizer["AgregarNombre"]"
                      Variant="Variant.Outlined"
                      Class="flex-grow-1 dark-field"
                      MaxLength="50"
                      Required="true" />
    </MudStack>

    <!-- Campo Descripción -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4" >@Localizer["Descripcion"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField T="string"
                      @bind-Value="addDesc"
                      Placeholder="@Localizer["AgregarDescripcion"]"
                      Variant="Variant.Outlined"
                      TextFieldType="MudBlazor.TextFieldType.Multiline"
                      Lines="3"
                      Class="@($"flex-grow-1 dark-field mt-0 {(string.IsNullOrWhiteSpace(addDesc) ? "required-empty" : "")}")"
                      MaxLength="200"
                      Required="true" />
    </MudStack>


    <!-- Cuatro selects en la misma línea: Fuente, Grupo, Dispositivo y Sensor -->
    <MudStack Row Spacing="2" Class="mb-4 mx-4">

        <!-- Fuente -->
        <div style="width: 25%;">
            <MudSelect T="int?"
                       Value="@selectedSourceId"
                       ValueChanged="@OnSourceChanged"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarFuente"]"
                       Class="@($"dark-field")"
                       Required="true">
                @foreach (var source in sources)
                {
                    <MudSelectItem Value="@((int?)source.Id)">@source.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Grupo -->
        <div style="width: 25%;">
            <MudSelect T="int?"
                       Value="@selectedGroupId"
                       ValueChanged="@OnGroupChanged"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarGrupo"]"
                       Class="dark-field">
                @foreach (var group in deviceGroups)
                {
                    <MudSelectItem Value="@((int?)group.Id)">@group.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
           <!--SelectedValuesChanged="OnSelectedDevicesChanged"-->
        <!-- Dispositivo -->
        <div style="width: 25%;">
            <MudSelect T="int"
                       SelectedValues="selectedDeviceIds"
                       SelectedValuesChanged="OnSelectedDevicesChanged"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarDispositivo"]"
                       Class="dark-field">
                @foreach (var device in devices)
                {
                    <MudSelectItem T="int" Value="@device.Id">@device.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Sensor -->
        <div style="width: 25%;">
            <MudSelect T="string"
                       @bind-Value="selectedSensor"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarSensor"]"
                       Class="@($"dark-field")"
                       Required="true">
                @foreach (var sensor in sensores)
                {
                    <MudSelectItem Value="@sensor">@sensor</MudSelectItem>
                }
            </MudSelect>
        </div>
    </MudStack>

    <div class="mb-4 mx-4" style="display: flex; justify-content: flex-end;">
        <MudButton OnClick="GuardarDataset"
                   Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   Disabled="@(! selectedSourceId.HasValue || string.IsNullOrWhiteSpace(selectedSensor) || string.IsNullOrWhiteSpace(addDesc) || string.IsNullOrWhiteSpace(addName) )">
            @Localizer["GuardarDataset"]
        </MudButton>

    </div>
}

@code {
    private string selectedTipo = "Inside Monitor";
    private List<string> tiposDataset = new() { "Inside Monitor", "Modulo 2", "Modulo 3" };

    private List<Source> sources = new();
    private List<DeviceGroup> deviceGroups = new();
    private List<Device> devices = new();

    private int? selectedSourceId = null;
    private int? selectedGroupId = null;
    private HashSet<int> selectedDeviceIds = new();

    private string selectedSensor = string.Empty;
    private List<string> sensores = new();

    private string addName = string.Empty;
    private string addDesc = string.Empty;

    private string currentUsername = string.Empty;
    private string currentPassword = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            currentUsername = authState.User.Identity?.Name ?? "";
            currentPassword = "admin"; 

            if (string.IsNullOrEmpty(currentUsername))
            {
                ShowError(@Localizer["ErrorUsuario"]);
                return;
            }

            await LoadSourcesAndGroups();
        }
        catch (Exception ex)
        {
            ShowError($"{Localizer["ErrorInicializar"]} {ex.Message}");
        }
    }

    //Cargar sources y groups desde la API
    private async Task LoadSourcesAndGroups()
    {
        try
        {
            var sourcesResponse = await Http.GetAsync($"api/SondaMain/sources?user={currentUsername}&password={currentPassword}");
            if (sourcesResponse.IsSuccessStatusCode)
            {
                sources = await sourcesResponse.Content.ReadFromJsonAsync<List<Source>>() ?? new List<Source>();
            }

            var groupsResponse = await Http.GetAsync($"api/SondaMain/groups?user={currentUsername}&password={currentPassword}");
            if (groupsResponse.IsSuccessStatusCode)
            {
                deviceGroups = await groupsResponse.Content.ReadFromJsonAsync<List<DeviceGroup>>() ?? new List<DeviceGroup>();
            }
        }
        catch (Exception ex)
        {
            ShowError($"{Localizer["ErrorCargaFuentes"]} {ex.Message}");
        }
    }

    // Cuando cambia la fuente seleccionada: limpiar grupo, dispositivos y sensor
    private async Task OnSourceChanged(int? sourceId)
    {
        // asigno nuevo source
        selectedSourceId = sourceId;

        // limpio dependencias
        selectedDeviceIds.Clear();
        selectedSensor = string.Empty;

        // recargo listas en base al nuevo source
        await LoadDevices();
        await LoadSensors();

        StateHasChanged();
    }

    // Cuando cambia el grupo seleccionado: limpiar dispositivos y sensor
    private async Task OnGroupChanged(int? groupId)
    {
        selectedGroupId = groupId;
        //se recargan los dispositivos porque se borra el "filtro" de grupo
        await LoadDevices();

        StateHasChanged();
    }

    // Cuando cambian los dispositivos seleccionados (multi-select)
    private Task OnSelectedDevicesChanged(IEnumerable<int> values)
    {
        selectedDeviceIds = values != null ? new HashSet<int>(values) : new HashSet<int>();
        StateHasChanged();
        return Task.CompletedTask;
    }

    //Cuando cambia el sensor
    private Task OnSensorChanged(string sensor)
    {
        selectedSensor = sensor ?? string.Empty;
        return Task.CompletedTask;
    }
    // Cargar devices con intersección de filtros
    private async Task LoadDevices()
    {
        try
        {
            List<Device>? devicesFromSource = null;
            List<Device>? devicesFromGroup = null;

            // Si hay source seleccionado, obtener sus devices
            if (selectedSourceId.HasValue)
            {
                var sourceResponse = await Http.GetAsync($"api/SondaMain/devices/source/{selectedSourceId.Value}?user={currentUsername}&password={currentPassword}");
                if (sourceResponse.IsSuccessStatusCode)
                {
                    devicesFromSource = await sourceResponse.Content.ReadFromJsonAsync<List<Device>>();
                }
            }

            // Si hay group seleccionado, obtener sus devices
            if (selectedGroupId.HasValue)
            {
                var groupResponse = await Http.GetAsync($"api/SondaMain/devices/group/{selectedGroupId.Value}?user={currentUsername}&password={currentPassword}");
                if (groupResponse.IsSuccessStatusCode)
                {
                    devicesFromGroup = await groupResponse.Content.ReadFromJsonAsync<List<Device>>();
                }
            }

            // INTERSECCIÓN: Si hay ambos filtros, mostrar solo devices que están en ambos
            if (devicesFromSource != null && devicesFromGroup != null)
            {
                var deviceIdsFromGroup = new HashSet<int>(devicesFromGroup.Select(d => d.Id));
                devices = devicesFromSource.Where(d => deviceIdsFromGroup.Contains(d.Id)).ToList();
            }
            else if (devicesFromSource != null)
            {
                devices = devicesFromSource;
            }
            else if (devicesFromGroup != null)
            {
                devices = devicesFromGroup;
            }
            else
            {
                // Si no hay filtros, mostrar todos los devices
                var allDevicesResponse = await Http.GetAsync($"api/SondaMain/devices?page=1&user={currentUsername}&password={currentPassword}");
                if (allDevicesResponse.IsSuccessStatusCode)
                {
                    devices = await allDevicesResponse.Content.ReadFromJsonAsync<List<Device>>() ?? new List<Device>();
                }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowError($"{Localizer["ErrorCargaDispositivos"]} {ex.Message}");
            devices = new List<Device>();
        }
    }

    // Cargar sensores de la fuente seleccionada
    private async Task LoadSensors()
    {
        try
        {
            // Guardar el sensor actualmente seleccionado
            var currentSelectedSensor = selectedSensor;
            
            sensores.Clear();

            if (selectedSourceId.HasValue)
            {
                var sensorsResponse = await Http.GetAsync($"api/SondaMain/sensors/source/{selectedSourceId.Value}?user={currentUsername}&password={currentPassword}");
                if (sensorsResponse.IsSuccessStatusCode)
                {
                    sensores = await sensorsResponse.Content.ReadFromJsonAsync<List<string>>() ?? new List<string>();
                    
                    // Si el sensor previamente seleccionado existe en la nueva lista, mantenerlo seleccionado
                    if (!string.IsNullOrEmpty(currentSelectedSensor) && sensores.Contains(currentSelectedSensor))
                    {
                        selectedSensor = currentSelectedSensor;
                    }
                    else
                    {
                        selectedSensor = string.Empty;
                    }
                }
            }
            else
            {
                selectedSensor = string.Empty;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowError($"{Localizer["ErrorCargaSensores"]} {ex.Message}");
            sensores = new List<string>();
            selectedSensor = string.Empty;
        }
    }

    private async Task GuardarDataset()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;

            if (string.IsNullOrEmpty(username))
            {
                ShowError("No se pudo obtener el usuario actual");
                return;
            }

            if (!selectedSourceId.HasValue)
            {
                ShowError(@Localizer["DebeFuente"]);
                return;
            }

            if (string.IsNullOrWhiteSpace(selectedSensor))
            {
                ShowError("Debe seleccionar un sensor");
                return;
            }
            if (string.IsNullOrWhiteSpace(addDesc))
            {
                ShowError("La descripción es obligatoria");
                return;
            }
            if (string.IsNullOrWhiteSpace(addName))
            {
                ShowError("Error al crear el dataset: El nombre del dataset es obligatorio.");
                return;
            }

            var request = new CreateDatasetRequest
            {
                Name = addName,
                Username = username,
                Description = addDesc,
                IsDataset = "S",
                ContentType = "0",
                SourceId = selectedSourceId,
                GroupId = selectedGroupId,
                SensorName = selectedSensor,
                DeviceIds = selectedDeviceIds.Any() ? selectedDeviceIds.ToList() : null
            };

            var response = await Http.PostAsJsonAsync("api/Dataset", request);

            if (response.IsSuccessStatusCode)
            {
                var newDataset = await response.Content.ReadFromJsonAsync<Dataset>();
                ShowSuccess($"'{newDataset.Name}' {Localizer["DatasetCreadoExito"]}");
                Nav.NavigateTo("/datasets");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ShowError(error);
            }
        }
        catch (Exception ex)
        {
            ShowError($"{Localizer["NoSePudoCrear"]} {ex.Message}");
        }
    }

    private void ShowSuccess(string mensaje)
    {
        Snackbar.Add(mensaje, Severity.Success, config =>
        {
            config.SnackbarVariant = Variant.Filled;
            config.ShowCloseIcon = true;
            config.RequireInteraction = false;
            config.VisibleStateDuration = 2500;
            config.CloseAfterNavigation = false;
        });
    }

    private void ShowError(string mensaje)
    {
        Snackbar.Add(mensaje, Severity.Error, config =>
        {
            config.SnackbarVariant = Variant.Filled;
            config.ShowCloseIcon = true;
            config.RequireInteraction = false;
            config.VisibleStateDuration = 4000;
            config.CloseAfterNavigation = false;
        });
    }
}