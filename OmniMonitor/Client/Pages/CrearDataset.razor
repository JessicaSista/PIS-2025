@page "/crearDataset"
@using OmniMonitor.Shared.Dtos
@inject NavigationManager Nav
@inject IJSRuntime JS
@using MudBlazor
@inject ISnackbar Snackbar

<PageTitle>Crear Dataset</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1 mt-2 mx-4" Style="color: #E5EAEB; font-weight: bold;">
    Crear Dataset
</MudText>
<MudText Typo="Typo.body1" Class="mb-4 mx-4" Style="color: #9ca3af">
    Tipo de Dataset
</MudText>

<!-- Selector de tipo de dataset -->
<MudStack Row Justify="Justify.SpaceBetween" Class="mb-8 mx-4">
    <MudSelect T="string"
               @bind-Value="selectedTipo"
               Variant="Variant.Outlined"
               Class="flex-grow-1 dark-field"
               InputClass="dark-field-input"
               PopoverClass="dark-field-popover">
        @foreach (var tipo in tiposDataset)
        {
            <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
        }
    </MudSelect>
</MudStack>

<style>
/* Select y TextFields oscuros */
.dark-field .mud-input-root {
    background-color: #0F172A !important;
    color: #E5EAEB !important;
    border: 1px solid #334155 !important;
    border-radius: 6px;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
}

.dark-field .mud-input-input,
.dark-field .mud-select-value,
.dark-field .mud-select-text {
    color: #E5EAEB !important;
}

/* Placeholder y label */
.dark-field .mud-input-label,
.dark-field .mud-input-placeholder {
    color: #B0B6B6 !important;
}

/* Hover */
.dark-field .mud-input-root:hover {
    box-shadow: 0 0 6px #4A81E9;
    border-color: #4A81E9 !important;
}

/* Popover (dropdown) oscuro */
.dark-field-popover {
    background-color: #1E293B !important;
    color: #E5EAEB !important;
}

.dark-field-popover .mud-list-item {
    color: #E5EAEB !important;
}

.dark-field .mud-input > textarea.mud-input-root-outlined {
    margin-top: 0 !important;
    padding-top: 9px !important;
}
</style>

@if (!string.IsNullOrEmpty(selectedTipo) && selectedTipo == "Inside Monitor")
{
    <!-- Campo Nombre -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4" Style="color: #E5EAEB;">Nombre</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-8 mx-4">
        <MudTextField @bind-Value="addName" Placeholder="Agregar Nombre"
                      Variant="Variant.Outlined" 
                      Class="flex-grow-1 dark-field"/>
    </MudStack>

    <!-- Campo Descripción -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4" Style="color: #E5EAEB;">Descripción</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-8 mx-4">
        <MudTextField T="string"
            @bind-Value="addDesc"
            Placeholder="Agregar Descripción"
            Variant="Variant.Outlined"
            TextFieldType="MudBlazor.TextFieldType.Multiline"
            Lines="3"
            Class="flex-grow-1 dark-field mt-0"
            MaxLength="200" />
    </MudStack>

    <!-- Tres selects en la misma línea: Fuente, Sensor y Dispositivo -->
    <MudStack Row Spacing="2" Class="mb-8 mx-4">

        <!-- Fuente -->
        <div style="width: 33%;">
            <MudSelect T="string" 
                       @bind-Value="selectedFuente" 
                       Variant="Variant.Outlined" 
                       Clearable 
                       FullWidth="true"
                       Label="Seleccionar Fuente"
                       Class="dark-field">
                @foreach (var fuente in fuentesModulo1)
                {
                    <MudSelectItem Value="@fuente">@fuente</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Sensor -->
        <div style="width: 33%;">
            <MudSelect T="string" 
                       @bind-Value="selectedSensor" 
                       Variant="Variant.Outlined" 
                       Clearable 
                       FullWidth="true"
                       Label="Seleccionar Sensor"
                       Class="dark-field">
                @foreach (var sensor in sensores)
                {
                    <MudSelectItem Value="@sensor">@sensor</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Dispositivo -->
        <div style="width: 33%;">
            <MudSelect T="string" 
                       @bind-Value="selectedDispositivo" 
                       Variant="Variant.Outlined" 
                       Clearable 
                       FullWidth="true"
                       Label="Seleccionar Dispositivo"
                       Class="dark-field">
                @foreach (var dispositivo in dispositivos)
                {
                    <MudSelectItem Value="@dispositivo">@dispositivo</MudSelectItem>
                }
            </MudSelect>
        </div>
    </MudStack>

    <div class="mb-8 mx-4" style="display: flex; justify-content: flex-end;">
        <MudButton OnClick="GuardarDataset" Variant="Variant.Filled" Color="MudBlazor.Color.Primary">
            Guardar Dataset
        </MudButton>
    </div>
}

@code {
    private string selectedTipo = "Inside Monitor";
    private List<string> tiposDataset = new() { "Inside Monitor", "Modulo 2", "Modulo 3" };

    private string selectedFuente = string.Empty;
    private List<string> fuentesModulo1 = new() { "Fuente 1", "Fuente 2", "Fuente 3" };

    private string selectedSensor = string.Empty;
    private List<string> sensores = new() { "Sensor 1", "Sensor 2", "Sensor 3" };

    private string selectedDispositivo = string.Empty;
    private List<string> dispositivos = new() { "Dispositivo 1", "Dispositivo 2", "Dispositivo 3" };

    private string addName = string.Empty;
    private string addDesc = string.Empty;

    private async Task GuardarDataset()
    {
        try
        {
            var nuevo = new DatasetDto
            {
                Id = (int)DateTimeOffset.Now.ToUnixTimeSeconds(),
                Nombre = addName,
                Descripcion = addDesc,
                FechaCreacion = DateTime.Now
            };

            var json = await JS.InvokeAsync<string>("localStorage.getItem", "datasets");
            var lista = string.IsNullOrEmpty(json)
                ? new List<DatasetDto>()
                : System.Text.Json.JsonSerializer.Deserialize<List<DatasetDto>>(json)!;

            lista.Add(nuevo);

            var nuevoJson = System.Text.Json.JsonSerializer.Serialize(lista);
            await JS.InvokeVoidAsync("localStorage.setItem", "datasets", nuevoJson);

            // Mostrar snackbar de éxito con solo cruz
            ShowSuccess($"Dataset '{nuevo.Nombre}' creado exitosamente");

            // Navegar luego del snackbar (opcional)
            Nav.NavigateTo("/datasets");
        }
        catch (Exception ex)
        {
            ShowError($"No se pudo crear el dataset: {ex.Message}");
        }
    }

    private void ShowSuccess(string mensaje)
    {
        Snackbar.Add(mensaje, Severity.Success, config =>
        {
            config.SnackbarVariant = Variant.Filled;
            config.ShowCloseIcon = true;       // solo la cruz
            config.RequireInteraction = false;  // se cierra automáticamente
            config.VisibleStateDuration = 2500; // ms
            config.CloseAfterNavigation = false;
        });
    }

    private void ShowError(string mensaje)
    {
        Snackbar.Add(mensaje, Severity.Error, config =>
        {
            config.SnackbarVariant = Variant.Filled;
            config.ShowCloseIcon = true;
            config.RequireInteraction = false;
            config.VisibleStateDuration = 4000; // ms
            config.CloseAfterNavigation = false;
        });
    }
}
