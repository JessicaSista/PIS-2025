@page "/crearDataset"
@using OmniMonitor.Shared.Dtos
@using Microsoft.AspNetCore.Components.Authorization
@using Blazored.LocalStorage
@using OmniMonitor.Shared.Dtos.AM
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http
@using MudBlazor
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Datasets> Localizer
@inject ILocalStorageService LocalStorage

<PageTitle>Crear Dataset</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1 mt-2 mx-4" Style=" font-weight: 500; font-family: Inter, Roboto, sans-serif;">
    @Localizer["CrearDataset"]
</MudText>

<!-- Selector de tipo de dataset -->
<MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Modulo"]</MudText>
<MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
    <MudSelect T="string"
               @bind-Value="selectedTipo"
               Variant="Variant.Outlined"
               Class="flex-grow-1 dark-field"
               InputClass="dark-field-input"
               PopoverClass="dark-field-popover">
        @foreach (var tipo in tiposDataset)
        {
            <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
        }
    </MudSelect>
</MudStack>

@if (!string.IsNullOrEmpty(selectedTipo) && selectedTipo == "Insight Monitor")
{
    <!-- Nombre -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Nombre"]</MudText>
    <MudStack Row Class="mb-4 mx-4">
        <MudTextField @bind-Value="addName"
                      Placeholder="@Localizer["AgregarNombre"]"
                      Variant="Variant.Outlined"
                      Class="flex-grow-1 dark-field"
                      MaxLength="50"
                      Required="true" />
    </MudStack>

    <!-- Descripción -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Descripcion"]</MudText>
    <MudStack Row Class="mb-4 mx-4">
        <MudTextField T="string"
                      @bind-Value="addDesc"
                      Placeholder="@Localizer["AgregarDescripcion"]"
                      Variant="Variant.Outlined"
                      TextFieldType="MudBlazor.TextFieldType.Multiline"
                      Lines="3"
                      Class="@($"flex-grow-1 dark-field mt-0 {(string.IsNullOrWhiteSpace(addDesc) ? "required-empty" : "")}")"
                      MaxLength="200"
                      Required="true" />
    </MudStack>

    <!-- Fuente / Grupo / Dispositivos / Sensor -->
    <MudStack Row Spacing="2" Class="mb-4 mx-4">
        <!-- Fuente -->
        <div style="width: 25%;">
            <MudSelect T="int?"
                       Value="@selectedSourceId"
                       ValueChanged="OnSourceChanged"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarFuente"]"
                       Class="dark-field"
                       Required="true">
                @foreach (var source in sources)
                {
                    <MudSelectItem Value="@((int?)source.Id)">@source.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Grupo -->
        <div style="width: 25%;">
            <MudSelect T="int?"
                       Value="@selectedGroupId"
                       ValueChanged="OnGroupChanged"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarGrupo"]"
                       Class="dark-field">
                @foreach (var group in deviceGroups)
                {
                    <MudSelectItem Value="@((int?)group.Id)">@group.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Dispositivo -->
        <div style="width: 25%;">
            <MudSelect T="int"
                       SelectedValues="selectedDeviceIds"
                       SelectedValuesChanged="OnSelectedDevicesChanged"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       Clearable
                       SelectAll="true"
                       SelectAllText="Seleccionar todos"
                       FullWidth="true"
                       Label="@Localizer["SeleccionarDispositivo"]"
                       Class="dark-field"
                       Disabled="@(!selectedSourceId.HasValue)"
                       ToStringFunc="@(id => devices.FirstOrDefault(d => d.Id == id)?.Name ?? id.ToString())">
                @foreach (var device in devices)
                {
                    <MudSelectItem T="int" Value="@device.Id">@device.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Sensor -->
        <div style="width: 25%;">
            <MudSelect T="string"
                       @bind-Value="selectedSensor"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarSensor"]"
                       Class="dark-field"
                       Disabled="@(!selectedSourceId.HasValue)"
                       Required="true">
                @foreach (var sensor in sensores)
                {
                    <MudSelectItem Value="@sensor">@sensor</MudSelectItem>
                }
            </MudSelect>
        </div>
    </MudStack>

    <div class="mb-4 mx-4" style="display: flex; justify-content: flex-end;">
        <MudButton OnClick="GuardarDataset"
                   Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   Disabled="@(! selectedSourceId.HasValue || string.IsNullOrWhiteSpace(selectedSensor) || string.IsNullOrWhiteSpace(addDesc) || string.IsNullOrWhiteSpace(addName))">
            @Localizer["GuardarDataset"]
        </MudButton>
    </div>
}

@code {
    private string selectedTipo = "Insight Monitor";
    private List<string> tiposDataset = new() { "Insight Monitor", "Asset Manager" };

    private List<Source> sources = new();
    private List<DeviceGroup> deviceGroups = new();
    private List<Device> devices = new();
    private List<string> sensores = new();

    private int? selectedSourceId = null;
    private int? selectedGroupId = null;
    private HashSet<int> selectedDeviceIds = new();

    private string selectedSensor = string.Empty;
    private string addName = string.Empty;
    private string addDesc = string.Empty;

    private string currentUsername = string.Empty;
    private string authToken = string.Empty;

    private string GetEncodedToken() => Uri.EscapeDataString(authToken ?? "");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            currentUsername = authState.User.Identity?.Name ?? "";
            authToken = await LocalStorage.GetItemAsync<string>("authToken") ?? "";

            if (string.IsNullOrEmpty(currentUsername) || string.IsNullOrEmpty(authToken))
            {
                ShowError(@Localizer["ErrorUsuario"]);
                return;
            }

            await LoadSourcesAndGroups();
        }
        catch (Exception ex)
        {
            ShowError($"{Localizer["ErrorInicializar"]} {ex.Message}");
        }
    }

    private async Task LoadSourcesAndGroups()
    {
        try
        {
            var encodedToken = GetEncodedToken();

            var sourcesResponse = await Http.GetAsync($"api/SondaMain/sources?token={encodedToken}");
            if (sourcesResponse.IsSuccessStatusCode)
            {
                sources = await sourcesResponse.Content.ReadFromJsonAsync<List<Source>>() ?? new();
            }

            var groupsResponse = await Http.GetAsync($"api/SondaMain/groups?token={encodedToken}");
            if (groupsResponse.IsSuccessStatusCode)
            {
                deviceGroups = await groupsResponse.Content.ReadFromJsonAsync<List<DeviceGroup>>() ?? new();
            }
        }
        catch (Exception ex)
        {
            ShowError($"{Localizer["ErrorCargaFuentes"]} {ex.Message}");
        }
    }

    private async Task OnSourceChanged(int? sourceId)
    {
        selectedSourceId = sourceId;
        selectedGroupId = null;
        selectedDeviceIds.Clear();
        selectedSensor = string.Empty;
        devices.Clear();
        sensores.Clear();

        if (selectedSourceId.HasValue)
        {
            await LoadDevices();
            await LoadSensors();
        }

        StateHasChanged();
    }

    private async Task OnGroupChanged(int? groupId)
    {
        selectedGroupId = groupId;
        selectedDeviceIds.Clear();
        selectedSensor = string.Empty;
        await LoadDevices();
        StateHasChanged();
    }

    private async Task OnSelectedDevicesChanged(IEnumerable<int> values)
    {
        selectedDeviceIds = values != null ? new HashSet<int>(values) : new HashSet<int>();
        await LoadSensors();
        StateHasChanged();
    }

    private async Task LoadDevices()
    {
        try
        {
            var encodedToken = GetEncodedToken();
            var url = $"api/SondaMain/devices/source/{selectedSourceId.Value}?token={encodedToken}";
            if (selectedGroupId.HasValue)
                url += $"&groupId={selectedGroupId.Value}";

            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                devices = await response.Content.ReadFromJsonAsync<List<Device>>() ?? new();
            }
            else
            {
                devices.Clear();
            }
        }
        catch (Exception ex)
        {
            ShowError($"Error cargando dispositivos: {ex.Message}");
        }
    }

    private async Task LoadSensors()
    {
        try
        {
            var encodedToken = GetEncodedToken();
            var url = $"api/SondaMain/sensors?sourceId={selectedSourceId}&token={encodedToken}";

            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                sensores = await response.Content.ReadFromJsonAsync<List<string>>() ?? new();
            }
            else
            {
                sensores.Clear();
            }
        }
        catch (Exception ex)
        {
            ShowError($"Error cargando sensores: {ex.Message}");
        }
    }

    private void ShowError(string message) => Snackbar.Add(message, Severity.Error);
    private void ShowSuccess(string message) => Snackbar.Add(message, Severity.Success);

    private Task GuardarDataset()
    {
        // Implementar POST al endpoint correspondiente
        ShowSuccess("Dataset guardado correctamente (ejemplo).");
        return Task.CompletedTask;
    }
}
