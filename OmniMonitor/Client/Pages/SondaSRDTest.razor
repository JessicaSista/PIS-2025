@page "/delete-scheduled-report"
@using System.Net.Http.Json
@inject HttpClient Http

<h3>Programaciones de Reportes</h3>

@if (ScheduledReports == null)
{
    <p>Cargando...</p>
}
else if (ScheduledReports.Count == 0)
{
    <p>No hay programaciones activas.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Reporte</th>
                <th>Horario</th>
                <th>Tipo</th>
                <th>Emails</th>
                <th>Cantidad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sr in ScheduledReports)
            {
                <tr>
                    <td>@sr.Id</td>
                    <td>@sr.ReportId</td>
                    <td>@sr.SendAtLocalTime</td>
                    <td>@sr.ScheduleType</td>
                    <td>@string.Join(", ", sr.Recipients)</td>
                    <td>@sr.Recipients.Count</td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />

<h3>Buscar programación por ID</h3>

<div class="mb-3">
    <label>Id de la programación:</label>
    <InputNumber @bind-Value="SearchId" class="form-control" />
</div>

<button class="btn btn-primary" @onclick="HandleSearch">Buscar</button>

@if (SearchResultMessage != null)
{
    <div class="alert alert-info mt-2">@SearchResultMessage</div>
}

@if (SearchedReport != null)
{
    <div class="card mt-3">
        <div class="card-body">
            <h5>ID: @SearchedReport.Id</h5>
            <p><strong>Reporte:</strong> @SearchedReport.ReportId</p>
            <p><strong>Horario:</strong> @SearchedReport.SendAtLocalTime</p>
            <p><strong>Tipo:</strong> @SearchedReport.ScheduleType</p>
            <p><strong>Emails:</strong> @string.Join(", ", SearchedReport.Recipients)</p>
        </div>
    </div>
}

<hr />

<h3>Eliminar Programación de Reporte</h3>

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="alert alert-info">@StatusMessage</div>
}

<div class="mb-3">
    <label>Id de la programación:</label>
    <InputNumber @bind-Value="ReportIdToDelete" class="form-control" />
</div>

<button class="btn btn-danger" @onclick="HandleDelete">Eliminar</button>

@code {
    private int ReportIdToDelete;
    private string StatusMessage;

    private int SearchId;
    private string? SearchResultMessage;
    private ScheduledReportResponse? SearchedReport;

    private List<ScheduledReportResponse> ScheduledReports;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ScheduledReports = await Http.GetFromJsonAsync<List<ScheduledReportResponse>>(
                "api/Reports/scheduled-reports"
            );
        }
        catch
        {
            ScheduledReports = new List<ScheduledReportResponse>();
        }
    }

    private async Task HandleSearch()
    {
        SearchResultMessage = null;
        SearchedReport = null;

        if (SearchId <= 0)
        {
            SearchResultMessage = "Ingresa un Id válido.";
            return;
        }

        try
        {
            SearchedReport = await Http.GetFromJsonAsync<ScheduledReportResponse?>(
                $"api/Reports/scheduled-reports/{SearchId}"
            );

            if (SearchedReport == null)
                SearchResultMessage = $"No se encontró la programación con Id {SearchId}.";
        }
        catch
        {
            SearchResultMessage = "Error al buscar la programación.";
        }
    }

    private async Task HandleDelete()
    {
        if (ReportIdToDelete <= 0)
        {
            StatusMessage = "Ingresa un Id válido.";
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/Reports/scheduled-reports/{ReportIdToDelete}");

            if (response.IsSuccessStatusCode)
            {
                StatusMessage = $"Programación con Id {ReportIdToDelete} eliminada correctamente.";

                // refrescar la grilla
                ScheduledReports = await Http.GetFromJsonAsync<List<ScheduledReportResponse>>(
                    "api/Reports/scheduled-reports"
                );

                ReportIdToDelete = 0;
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                if (error != null && error.ContainsKey("message"))
                    StatusMessage = $"Error: {error["message"]}";
                else
                    StatusMessage = "Error desconocido al eliminar la programación.";
            }
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error inesperado: {ex.Message}";
        }
    }

    public class ScheduledReportResponse
    {
        public int Id { get; set; }
        public int ReportId { get; set; }
        public string ScheduleType { get; set; }
        public string SendAtLocalTime { get; set; }
        public List<string> Recipients { get; set; }
    }
}
