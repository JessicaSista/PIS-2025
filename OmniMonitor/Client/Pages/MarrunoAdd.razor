@page "/marrunoPage-add"
@using OmniMonitor.Shared
@inject HttpClient Http
@using MudBlazor
@using OmniMonitor.Shared.Dtos

<PageTitle>Agregar Rapero</PageTitle>

<MudText Typo="Typo.h3">Agregar Rapero</MudText>

<MudForm @ref="form" Validated="OnValidSubmit">
    <MudTextField @bind-Value="nuevo.Nombre" Label="Nombre" Required="true" />
    <MudTextField @bind-Value="nuevo.Edad" Label="Edad" Required="true" Type="number" />
    <MudTextField @bind-Value="nuevo.Millones" Label="Millones" Required="true" Type="number" />
    <MudTextField @bind-Value="nuevo.NombreRapero" Label="Nombre Rapero" Required="true" />

    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="Enviar">Enviar</MudButton>
</MudForm>

@if (mensaje != null)
{
    <MudAlert Severity="Severity.Success">@mensaje</MudAlert>
}

@code {
    private Rapero nuevo = new Rapero();
    private MudForm? form;
    private string? mensaje;

    private async Task Enviar()
    {
        if (form != null)
        {
            await form.Validate();
            var response = await Http.PostAsJsonAsync("Marruno", nuevo);

            if (response.IsSuccessStatusCode)
            {
                mensaje = "Rapero agregado exitosamente!";
                // Limpiar formulario
                nuevo = new Rapero();
                form.ResetValidation();
            }
            else
            {
                mensaje = "Error al agregar Rapero.";
            }
        }
    }
}
