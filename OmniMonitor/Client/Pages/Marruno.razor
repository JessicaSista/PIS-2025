@page "/marrunoPage"
@using OmniMonitor.Shared
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http

<PageTitle>Prueba</PageTitle>

<MudText Typo="Typo.h3">PÁGINA DE PRUEBA</MudText>
<MudText Typo="Typo.body1">PROBANDO</MudText>

<MudTable Items="raperos" Hover="true" Bordered="true" Striped="true">
    <HeaderContent>
        <MudTh>Id</MudTh>
        <MudTh>Nombre</MudTh>
        <MudTh>Edad</MudTh>
        <MudTh>Balas Recibidas</MudTh>
        <MudTh>Nombre Rapero</MudTh>
        <MudTh>Acciones</MudTh> <!-- Columna de botones -->
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Id</MudTd>
        <MudTd>@context.Nombre</MudTd>
        <MudTd>@context.Edad</MudTd>
        <MudTd>@context.Millones</MudTd>
        <MudTd>@context.NombreRapero</MudTd>
        <MudTd>
            <!-- Botón que navega a la página detalle -->
            <MudButton Variant="Variant.Text" Color="MudBlazor.Color.Primary" Href="@($"/marrunoPage/{context.Id}")">
                    Ver detalle
                </MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private Rapero[]? raperos;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            raperos = await Http.GetFromJsonAsync<Rapero[]>("Marruno");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar: {ex.Message}");
        }
    }
}
