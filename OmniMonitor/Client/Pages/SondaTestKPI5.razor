@page "/sonda-test-kpi5"
@using OmniMonitor.Shared.Dtos
@using System.Net.Http.Json
@using Blazored.LocalStorage
@inject HttpClient Http
@inject ILocalStorageService LocalStorage

<h3>Test KPI - Editar y Eliminar</h3>

<div class="card mb-4">
    <div class="card-header">
        <h4>Editar KPI</h4>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <span class="input-group-text">KPI ID:</span>
            <input type="number" class="form-control" @bind="editKpiId" />
        </div>

        <div class="mb-3">
            <span class="input-group-text">Nuevo Nombre:</span>
            <input type="text" class="form-control" @bind="editName" />
        </div>

        <div class="mb-3">
            <span class="input-group-text">Nueva Métrica:</span>
            <input type="text" class="form-control" @bind="editMetric" />
        </div>

        <div class="mb-3">
            <span class="input-group-text">Nuevas Unidades:</span>
            <input type="text" class="form-control" @bind="editUnits" />
        </div>

        <div class="mb-3">
            <span class="input-group-text">Nueva Descripción:</span>
            <textarea class="form-control" rows="2" @bind="editDescription"></textarea>
        </div>

        <button class="btn btn-primary" @onclick="EditKpi" disabled="@isEditing">
            @if (isEditing)
            {
                <span>Editando...</span>
            }
            else
            {
                <span>Editar KPI</span>
            }
        </button>

        @if (!string.IsNullOrEmpty(editResult))
        {
            <div class="mt-2 alert alert-info">@editResult</div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h4>Eliminar KPI</h4>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <span class="input-group-text">KPI ID:</span>
            <input type="number" class="form-control" @bind="deleteKpiId" />
        </div>

        <button class="btn btn-danger" @onclick="DeleteKpi" disabled="@isDeleting">
            @if (isDeleting)
            {
                <span>Eliminando...</span>
            }
            else
            {
                <span>Eliminar KPI</span>
            }
        </button>

        @if (!string.IsNullOrEmpty(deleteResult))
        {
            <div class="mt-2 alert alert-info">@deleteResult</div>
        }
    </div>
</div>

@code {
    private int editKpiId;
    private string editName = string.Empty;
    private string editMetric = string.Empty;
    private string editUnits = string.Empty;
    private string editDescription = string.Empty;
    private bool isEditing = false;
    private string? editResult;

    private int deleteKpiId;
    private bool isDeleting = false;
    private string? deleteResult;

    private async Task EditKpi()
    {
        isEditing = true;
        editResult = null;

        try
        {
            var kpiRequest = new KpiRequest
            {
                Name = string.IsNullOrWhiteSpace(editName) ? null : editName,
                Metric = string.IsNullOrWhiteSpace(editMetric) ? null : editMetric,
                Unit = string.IsNullOrWhiteSpace(editUnits) ? null : editUnits,
                Description = string.IsNullOrWhiteSpace(editDescription) ? null : editDescription
            };

            var response = await Http.PatchAsJsonAsync($"api/KPI/{editKpiId}", kpiRequest);

            if (response.IsSuccessStatusCode)
            {
                var updatedKpi = await response.Content.ReadFromJsonAsync<Kpi>();
                editResult = $"? KPI actualizado: {updatedKpi?.Name} ({updatedKpi?.Metric})";
            }
            else
            {
                editResult = $"? Error al editar KPI: {response.ReasonPhrase}";
            }
        }
        catch (Exception ex)
        {
            editResult = $"?? Error al editar KPI: {ex.Message}";
        }
        finally
        {
            isEditing = false;
        }
    }

    private async Task DeleteKpi()
    {
        isDeleting = true;
        deleteResult = null;

        try
        {
            var response = await Http.DeleteAsync($"api/KPI/{deleteKpiId}");

            if (response.IsSuccessStatusCode)
            {
                deleteResult = $"??? KPI con ID {deleteKpiId} eliminado correctamente.";
            }
            else
            {
                deleteResult = $"? Error al eliminar KPI: {response.ReasonPhrase}";
            }
        }
        catch (Exception ex)
        {
            deleteResult = $"?? Error al eliminar KPI: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
        }
    }
}
