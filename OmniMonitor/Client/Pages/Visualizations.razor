    <MudTabs Elevation="2" Rounded="true" PanelClass="mt-6" ActivePanelIndexChanged="@((index) => _activeTabIndex = index)" KeepPanelsAlive="true">

        <MudTabPanel Text="@Localizer["KPIs"]">
