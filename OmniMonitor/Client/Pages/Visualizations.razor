            await CargarKpisAsync();

            await CargarChartsAsync();

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error inicializando visualizaciones: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }



    private async Task OpenDialogCreateVisualization()
    {
        // If we're returning from dataset creation flow, bypass chooser and open the creation card directly
        var returnTo = GetQueryParam("returnTo");
        if (string.Equals(returnTo, "VisualizationCreate", StringComparison.OrdinalIgnoreCase))
        {
            await OpenDialogCreateVisualizationCard();
            return;
        }
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small };

        var dialogRef = await DialogService.ShowAsync<SelectVisualizationTypeDialog>(Localizer["NewVisualization"], options);

        var result = await dialogRef.Result;

        if (result is not null && result.Data is int intValue)
        {
            if (intValue == 1)
            {
                await CargarChartsAsync();
                Console.WriteLine("Gráficas cargadas después de crear una nueva.");
                StateHasChanged();
            }
            else if (intValue == 2)
            {
                await CargarKpisAsync();
                Console.WriteLine("KPI cargados después de crear uno nuevo.");
                StateHasChanged();
            }
            else {
                Console.WriteLine("Tipo de visualización desconocido seleccionado.");
            }
        }
        else {
            Console.WriteLine("null or non int.");
        }
        
    }


