    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_kpis.Count > 0)
        {
            await JS.InvokeVoidAsync("equalizeCardHeights");
        }
    }

    private async Task OpenDialogCreateVisualizationCard()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var returnTo = GetQueryParam("returnTo");
        var newDatasetIdStr = GetQueryParam("newDatasetId");
        DialogParameters parameters = new DialogParameters
        {
            ["ReturnTo"] = returnTo,
            ["NewDatasetId"] = int.TryParse(newDatasetIdStr, out var nid) ? nid : (int?)null
        };
        await DialogService.ShowAsync<CreateVisualizationCard>(Localizer["NewVisualization"], parameters, options);
    }

    private async Task CargarChartsAsync()
    {
        AuthenticationState? authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _authenticatedUser = authState.User.Identity?.Name ?? string.Empty;
        string token = await LocalStorage.GetItemAsync<string>("authToken");

        HttpResponseMessage? response = await Http.GetAsync($"api/Visualizacion/GetAllVisualizaciones?token=" + token);

        if (response.IsSuccessStatusCode)
        {
            List<Visualizacion>? visualizacionesFromApi = await response.Content.ReadFromJsonAsync<List<Visualizacion>>();
            _charts.Clear();
            if (visualizacionesFromApi != null)
            {
                foreach (var visualization in visualizacionesFromApi)
                {
                    _charts.Add((visualization.IdVisualizacion,visualization.Nombre));
                }
            }
        }
    }


    private async Task CargarKpisAsync()
    {
        try
        {
            string token = await LocalStorage.GetItemAsync<string>("authToken");
            var response = await Http.GetAsync($"api/KPI/kpis?token={token}");
            if (response.IsSuccessStatusCode)
            {
                List<KpiResponse>? kpisFromApi = await response.Content.ReadFromJsonAsync<List<KpiResponse>>();
                _kpis.Clear();
                if (kpisFromApi != null)
                {
                    foreach (var kpi in kpisFromApi)
                    {
                        _kpis.Add((kpi.Id, kpi.Name));
                    }
                }
            }
            else
            {
                Console.WriteLine("Error cargando KPIs: " + await response.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando KPIs: {ex.Message}");
        }
    }


    private async Task HandleReturnToVisualizationCreateAsync()
    {
        try
        {
            var returnTo = GetQueryParam("returnTo");
            if (string.Equals(returnTo, "VisualizationCreate", StringComparison.OrdinalIgnoreCase))
            {
                await OpenDialogCreateVisualizationCard();
            }
        }
        catch { }
    }

    private static Dictionary<string, string> ParseQueryString(string? query)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrEmpty(query)) return result;
        var q = query.StartsWith("?") ? query.Substring(1) : query;
        foreach (var pair in q.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split('=', 2);
            var key = Uri.UnescapeDataString(kv[0]);
            var value = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : string.Empty;
            result[key] = value;
        }
        return result;
    }

    private string? GetQueryParam(string key)
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var dict = ParseQueryString(uri.Query);
        return dict.TryGetValue(key, out var v) ? v : null;
    }
