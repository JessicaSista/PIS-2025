@page "/visualizaciones"
@attribute [Authorize]

@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HttpClient Http
@inject IStringLocalizer<Visualizations> Localizer
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject OmniMonitor.Client.Services.ThemeService ThemeService

@using OmniMonitor.Shared.Dtos
@using System.Text.Json
@using Blazored.LocalStorage
@using System.Globalization
@using Microsoft.Extensions.Localization
@using System.Net;
@using System.Net.Http.Json;
<style>
    .tab-toggle-container {
        display: inline-flex;
        border-radius: 9999px;
        overflow: hidden;
    }

    .tab-toggle-btn {
        color: var(--text-primary);
        text-transform: capitalize;
        padding: 6px 14px;
        border: 1px solid color-mix(in srgb, var(--text-primary) 15%, transparent);
        background-color: transparent;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .tab-toggle-btn:hover {
            background-color: color-mix(in srgb, var(--card) 60%, transparent);
        }

        .tab-toggle-btn.left {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
            border-right: none;
            border-top-left-radius: 9999px;
            border-bottom-left-radius: 9999px;
        }

        .tab-toggle-btn.right {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
            border-top-right-radius: 9999px;
            border-bottom-right-radius: 9999px;
        }

        .tab-toggle-btn.active {
            background-color: color-mix(in srgb, var(--card) 80%, transparent);
            color: var(--text-primary);
            font-weight: 600;
        }

</style>


<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
    <MudItem Class="d-flex justify-space-between mb-4">
        <MudText Typo="Typo.h4" Style="color: var(--text-primary);">@Localizer["Titulo"]</MudText>
        <AddButton OnClick="OpenDialogCreateVisualization">@Localizer["AgregarVisualizacion"]</AddButton>
    </MudItem>

    <!-- Selector superior con buscador y tabs -->
    <MudItem Class="d-flex align-center justify-space-between mt-4 mb-4">
        <div class="d-flex align-center">
            <!-- Buscador -->
            <MudTextField Immediate="true"
                          DebounceInterval="300"
                          Value="_searchQuery"
                          ValueChanged="@(EventCallback.Factory.Create<string>(this, OnSearchChanged))"
                          ValueExpression="() => _searchQuery"
                          Placeholder="@GetSearchPlaceholder()"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="width: 400px; margin-right: 16px;" />

            <!-- Tabs pequeñas tipo toggle -->
            <div class="tab-toggle-container">
                <MudButton Variant="Variant.Text"
                           Size="MudBlazor.Size.Small"
                           Class="@($"tab-toggle-btn left {(_activeTabIndex == 0 ? "active" : "")}")"
                           OnClick="@(() => SetActiveTab(0))">
                    @Localizer["KPIs"]
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Size="MudBlazor.Size.Small"
                           Class="@($"tab-toggle-btn right {(_activeTabIndex == 1 ? "active" : "")}")"
                           OnClick="@(() => SetActiveTab(1))">
                    @Localizer["Graficas"]
                </MudButton>
            </div>
        </div>
    </MudItem>


    <MudGrid Spacing="4">
        <!-- Contenido KPIs -->
        @if (_isLoadingKpis)
        {
            @* 
            @for (int i = 0; i < 3; i++)
            {
                <MudItem xs="12" sm="6" md="3" lg="3" Class="@(_activeTabIndex != 0 ? "d-none" : "")">
                    <MudPaper Class="pa-4" Style="height: 200px;">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100%" />
                    </MudPaper>
                </MudItem>
            }
            *@
        }
        else if (_kpiCards.Any())
        {
            @foreach (var card in _kpiCards)
            {
                <MudItem xs="12" sm="6" md="3" lg="3" @key="@($"kpi-card-{card.Info.Id}")" Class="@(_activeTabIndex != 0 ? "d-none" : "")">
                    <div style="position: relative;">
                        @if (card.Data != null)
                        {
                            <KpiCard Kpi="card.Data" />
                        }
                        else
                        {
                            var previewKpi = new KpiResponse
                            {
                                Id = card.Info.Id,
                                Name = card.Info.Name,
                                Description = card.Info.Description,
                                ActualColor = card.Info.DefaultColor ?? "#00FFE7",
                                Unit = "x",
                                Value = null
                            };
                            <KpiCard Kpi="previewKpi">
                                <ValueTemplate>
                                    <div style="display:flex; align-items:center; min-height:48px;">
                                        <MudButton Variant="Variant.Filled"
                                                   Disabled="@card.IsLoading"
                                                   OnClick="@(() => LoadKpiDataAsync(card))"
                                                   EndIcon="@Icons.Material.Filled.CloudDownload"
                                                   Style="@GetKpiLoadButtonStyle(card)">
                                            @if (card.IsLoading)
                                            {
                                                <MudProgressCircular Class="ms-n1" Size="MudBlazor.Size.Small" Indeterminate="true" />
                                                <MudText Class="ms-2">@Localizer["LoadingData"]</MudText>
                                            }
                                            else
                                            {
                                                @Localizer["LoadData"]
                                            }
                                        </MudButton>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(card.Error))
                                    {
                                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Error">
                                            @card.Error
                                        </MudText>
                                    }
                                </ValueTemplate>
                            </KpiCard>
                        }

                        <MudMenu AnchorOrigin="Origin.TopRight"
                                 TransformOrigin="Origin.TopRight"
                                 Class="position-absolute"
                                 Style="position:absolute; top:8px; right:8px; z-index:10; background-color:transparent;">

                            <ActivatorContent>
                                <MudIconButton Icon="@Icons.Material.Filled.MoreVert"
                                               Style="@GetKpiMenuIconStyle(card)" />
                            </ActivatorContent>

                            <ChildContent>
                                <MudMenuItem OnClick="@(() => EditarKpi(card))">
                                    <MudText Typo="Typo.body2">@Localizer["Editar"]</MudText>
                                </MudMenuItem>

                                <MudMenuItem OnClick="@(() => ConfirmEliminarKpi(card))">
                                    <MudText Typo="Typo.body2" Color="MudBlazor.Color.Error">@Localizer["Eliminar"]</MudText>
                                </MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                    </div>
                </MudItem>
            }

            @if (_kpiTotalPages > 1)
            {
                <MudItem lg="12" md="12" xs="12" Class="@(_activeTabIndex != 0 ? "d-none" : "")">
                    <MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-4 mb-2">
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowLeft"
                                       Disabled="@(!_kpiHasPreviousPage)"
                                       OnClick="@(() => GoToKpiPage(1))"
                                       Size="MudBlazor.Size.Small"
                                       Color="MudBlazor.Color.Primary" />

                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                       Disabled="@(!_kpiHasPreviousPage)"
                                       OnClick="@(() => GoToKpiPage(_kpiCurrentPage - 1))"
                                       Size="MudBlazor.Size.Small"
                                       Color="MudBlazor.Color.Primary" />

                        <MudText Typo="Typo.body2" Class="mx-3">
                            @Localizer["Página"] @_kpiCurrentPage @Localizer["de"] @_kpiTotalPages
                        </MudText>

                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                       Disabled="@(!_kpiHasNextPage)"
                                       OnClick="@(() => GoToKpiPage(_kpiCurrentPage + 1))"
                                       Size="MudBlazor.Size.Small"
                                       Color="MudBlazor.Color.Primary" />

                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight"
                                       Disabled="@(!_kpiHasNextPage)"
                                       OnClick="@(() => GoToKpiPage(_kpiTotalPages))"
                                       Size="MudBlazor.Size.Small"
                                       Color="MudBlazor.Color.Primary" />
                    </MudStack>

                    <MudStack Row Justify="Justify.Center" Class="mb-4">
                        <MudText Typo="Typo.caption" Style="color: #a5a8b5;">
                            @Localizer["Mostrando"] @_kpiCards.Count @Localizer["de"] @_kpiTotalCount
                        </MudText>
                    </MudStack>
                </MudItem>
            }
        }
        else
        {
            <MudItem xs="12" Class="@(_activeTabIndex != 0 ? "d-none" : "")">
                <MudText Typo="Typo.subtitle1" Align="MudBlazor.Align.Center" Style="color:#667d8a">
                    @Localizer["NoKpisAvailable"]
                </MudText>
            </MudItem>
        }

        <!-- Contenido Charts -->
        @if (_isLoadingCharts)
        {
            @* 
            @for (int i = 0; i < 3; i++)
            {
                <MudItem xs="12" sm="12" md="6" lg="4" Class="@(_activeTabIndex != 1 ? "d-none" : "")">
                    <MudPaper Class="pa-4" Style="height: 400px;">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100%" />
                    </MudPaper>
                </MudItem>
            }
            *@
        }
        else if (_charts != null && _charts.Any())
        {
            @foreach (Visualizacion visualization in _charts
                    .Where(v => string.IsNullOrWhiteSpace(_searchQuery) ||
                    v.Nombre.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)))
            {

                <MudItem xs="12" sm="12" md="6" lg="4" @key="@($"V{visualization.IdVisualizacion}_1")" Class="@(_activeTabIndex != 1 ? "d-none" : "")">
                    <MudPaper Class="pa-4" Style="background-color: var(--card);">
                        <MudCard Elevation="0" Style="background-color: transparent; height: 450px">

                            <ChartViewer OnDeleted="@(id => OnVisualizationDeleted(id))" visualization=@visualization VisualizationId="@visualization.IdVisualizacion" ShowIcon="true" ShowLastUpdatedInfo="true" ShowDatasetsInfo="true" retrieveOnInitialized="false" showCustomizationIcon="true" />

                        </MudCard>
                    </MudPaper>
                </MudItem>

            }
            @if (_totalPages > 1)
            {
                <MudItem lg="12" md="12" xs="12">
                    <MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-6 mb-4">
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowLeft"
                                       Disabled="@(!_hasPreviousPage)"
                                       OnClick="@(() => GoToChartPage(1))"
                                       Size="MudBlazor.Size.Small"
                                       Color="MudBlazor.Color.Primary" />

                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                       Disabled="@(!_hasPreviousPage)"
                                       OnClick="@(() => GoToChartPage(_currentPage - 1))"
                                       Size="MudBlazor.Size.Small"
                                       Color="MudBlazor.Color.Primary" />

                        <MudText Typo="Typo.body2" Class="mx-3">
                            @Localizer["Página"] @_currentPage @Localizer["de"] @_totalPages
                        </MudText>

                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                       Disabled="@(!_hasNextPage)"
                                       OnClick="@(() => GoToChartPage(_currentPage + 1))"
                                       Size="MudBlazor.Size.Small"
                                       Color="MudBlazor.Color.Primary" />

                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight"
                                       Disabled="@(!_hasNextPage)"
                                       OnClick="@(() => GoToChartPage(_totalPages))"
                                       Size="MudBlazor.Size.Small"
                                       Color="MudBlazor.Color.Primary" />
                    </MudStack>

                    <MudStack Row Justify="Justify.Center" Class="mb-4">
                        <MudText Typo="Typo.caption" Style="color: #a5a8b5;">
                            @Localizer["Mostrando"] @_charts.Count @Localizer["de"] @_totalCount
                        </MudText>
                    </MudStack>
                </MudItem>
            }
        }
        else
        {
            <MudItem xs="12" Class="@(_activeTabIndex != 1 ? "d-none" : "")">
                <MudText Typo="Typo.subtitle1" Align="MudBlazor.Align.Center" Style="color:#667d8a">
                    @Localizer["NoChartAvailable"]
                </MudText>
            </MudItem>
        }
    </MudGrid>



</MudContainer>


@code {
    private string _searchQuery = "";
    private class KpiCardModel
    {
        public KpiSimpleDto Info { get; set; } = new();
        public KpiResponse? Data { get; set; }
        public bool IsLoading { get; set; }
        public string? Error { get; set; }
    }

    private List<Visualizacion> _charts = new();
    private List<KpiCardModel> _kpiCards = new();
    private bool _isLoadingKpis = false;
    private bool _isLoadingCharts = false;
    private int _activeTabIndex = 1;

    private int _kpiCurrentPage = 1;
    private int _kpiPageSize = 8;
    private int _kpiTotalPages = 0;
    private int _kpiTotalCount = 0;
    private bool _kpiHasPreviousPage = false;
    private bool _kpiHasNextPage = false;

    private int _currentPage = 1;
    private int _pageSize = 9;
    private int _totalPages = 0;
    private int _totalCount = 0;
    private bool _hasPreviousPage = false;
    private bool _hasNextPage = false;

    protected override async Task OnInitializedAsync()
    {
        // Restaurar pestaña activa desde local storage (0 = KPIs, 1 = Gráficas)
        try
        {
            var stored = await LocalStorage.GetItemAsync<int?>("visualizations_active_tab");
            if (stored.HasValue && (stored.Value == 0 || stored.Value == 1))
            {
                _activeTabIndex = stored.Value;
            }
        }
        catch
        {
            _activeTabIndex = 1;
        }

        _isLoadingKpis = _isLoadingCharts = true;
        await LoadAllAsync();
    }

    private void SetActiveTab(int index)
    {
        _activeTabIndex = index;
        // Persistir selección de pestaña
        _ = LocalStorage.SetItemAsync("visualizations_active_tab", _activeTabIndex);
        if (_activeTabIndex == 0 && !_kpiCards.Any() && !_isLoadingKpis)
        {
            _ = LoadKpisPage(true);
        }
        StateHasChanged();

    }

    private const string KpiIconLightColor = "#f5f5f5";
    private const string KpiIconDarkColor = "#111111";

    private async Task LoadAllAsync()
    {
        try
        {
            _isLoadingKpis = _isLoadingCharts = true;
            await Task.WhenAll(LoadKpisPage(true), CargarChartsAsync());
        }
        finally
        {
            _isLoadingKpis = _isLoadingCharts = false;
            StateHasChanged();
        }
    }

    private string GetKpiLoadButtonStyle(KpiCardModel card)
    {
        // Usar el mismo color base que pinta la card: ActualColor si hay datos, DefaultColor si está en preview
        var rawColor = card.Data?.ActualColor ?? card.Info.DefaultColor ?? "#00FFE7";
        var baseColor = NormalizeHex(rawColor);

        string bg;
        string fg;

        if (IsNearWhiteHex(baseColor))
        {
            // Fondo casi blanco → botón gris suave y texto oscuro fijo
            bg = "rgba(0,0,0,0.08)";
            fg = "#111111";
        }
        else
        {
            // Aclarar el color base mezclándolo manualmente con blanco
            var (lr, lg, lb) = LightenColor(baseColor, 0.4);
            bg = $"rgb({lr},{lg},{lb})";

            // Calcular luminancia del color aclarado para decidir color de texto
            var dark = IsDarkFromRgb(lr, lg, lb);
            fg = dark ? "#ffffff" : "#111111";
        }

        return $"background-color:{bg}; color:{fg};";
    }

    private static string NormalizeHex(string hex)
    {
        if (string.IsNullOrWhiteSpace(hex)) return "#00FFE7";
        if (!hex.StartsWith("#")) hex = "#" + hex;
        if (hex.Length == 4)
        {
            hex = "#" + string.Concat(hex.AsSpan(1).ToString().Select(c => $"{c}{c}"));
        }
        return hex;
    }

    private static bool IsDarkHex(string hex)
    {
        try
        {
            hex = NormalizeHex(hex);
            int r = Convert.ToInt32(hex.Substring(1, 2), 16);
            int g = Convert.ToInt32(hex.Substring(3, 2), 16);
            int b = Convert.ToInt32(hex.Substring(5, 2), 16);
            double luminance = (0.299 * r + 0.587 * g + 0.114 * b);
            return luminance < 128;
        }
        catch
        {
            return false;
        }
    }

    private static bool IsNearWhiteHex(string hex)
    {
        try
        {
            hex = NormalizeHex(hex);
            int r = Convert.ToInt32(hex.Substring(1, 2), 16);
            int g = Convert.ToInt32(hex.Substring(3, 2), 16);
            int b = Convert.ToInt32(hex.Substring(5, 2), 16);
            return r > 230 && g > 230 && b > 230;
        }
        catch
        {
            return false;
        }
    }

    private static (int r, int g, int b) LightenColor(string hex, double factor)
    {
        hex = NormalizeHex(hex);
        int r = Convert.ToInt32(hex.Substring(1, 2), 16);
        int g = Convert.ToInt32(hex.Substring(3, 2), 16);
        int b = Convert.ToInt32(hex.Substring(5, 2), 16);

        int lr = (int)Math.Round(r + (255 - r) * factor);
        int lg = (int)Math.Round(g + (255 - g) * factor);
        int lb = (int)Math.Round(b + (255 - b) * factor);

        lr = Math.Clamp(lr, 0, 255);
        lg = Math.Clamp(lg, 0, 255);
        lb = Math.Clamp(lb, 0, 255);

        return (lr, lg, lb);
    }

    private static bool IsDarkFromRgb(int r, int g, int b)
    {
        double luminance = (0.299 * r + 0.587 * g + 0.114 * b);
        return luminance < 140;
    }

    private string GetKpiMenuIconStyle(KpiCardModel card)
    {
        // Usar el mismo color que se aplica al fondo de la card:
        // - Si ya se cargaron datos, usamos ActualColor del KPI.
        // - Si todavía está en modo "preview", usamos el DefaultColor.
        var rawColor = card.Data?.ActualColor ?? card.Info.DefaultColor ?? "#00FFE7";
        var baseColor = NormalizeHex(rawColor);
        var isDarkBg = IsDarkHex(baseColor);

        // Si el color del KPI es oscuro -> icono claro; si el color es claro -> icono oscuro.
        string color = isDarkBg ? KpiIconLightColor : KpiIconDarkColor;

        return $"color:{color};";
    }

    private async Task LoadKpisPage(bool resetPage = false)
    {
        if (resetPage)
        {
            _kpiCurrentPage = 1;
        }

        try
        {
            _isLoadingKpis = true;
            var queryParam = string.IsNullOrWhiteSpace(_searchQuery)
                ? string.Empty
                : $"&query={Uri.EscapeDataString(_searchQuery)}";

            var response = await Http.GetAsync($"api/Kpi/GetAllKpiDtoPaginated?page={_kpiCurrentPage}&pageSize={_kpiPageSize}{queryParam}");
            if (response.IsSuccessStatusCode)
            {
                var payload = await response.Content.ReadFromJsonAsync<KpiSimplePaginatedResponse>();
                if (payload != null)
                {
                    if (payload.TotalPages > 0 && _kpiCurrentPage > payload.TotalPages)
                    {
                        _kpiCurrentPage = payload.TotalPages;
                        await LoadKpisPage();
                        return;
                    }

                    _kpiCards = payload.Items.Select(item => new KpiCardModel { Info = item }).ToList();
                    _kpiTotalPages = payload.TotalPages;
                    _kpiTotalCount = payload.TotalCount;
                    _kpiHasPreviousPage = payload.HasPreviousPage;
                    _kpiHasNextPage = payload.HasNextPage;
                    _kpiCurrentPage = payload.Page;
                }
                else
                {
                    ResetKpiListing();
                }
            }
            else
            {
                ResetKpiListing();
            }
        }
        catch
        {
            ResetKpiListing();
        }
        finally
        {
            _isLoadingKpis = false;
        }
    }

    private async Task CargarChartsAsync()
    {
        try
        {
            _isLoadingCharts = true;
            var response = await Http.GetAsync($"/api/Visualizacion/GetAllVisualizacionesPaginated?page={_currentPage}&pageSize={_pageSize}");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PaginatedVisualizacionDto>();
                if (result != null)
                {
                    _totalCount = result.TotalCount;
                    _totalPages = result.TotalPages;
                    _currentPage = result.Page;
                    _hasPreviousPage = result.HasPreviousPage;
                    _hasNextPage = result.HasNextPage;

                    _charts = result.Items;
                }
            }
        }
        catch (Exception ex)
        {
            _charts = new();
        }
        finally
        {
            _isLoadingCharts = false;
        }
    }

    private async Task OpenDialogCreateVisualization()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small };
        var dialogRef = await DialogService.ShowAsync<SelectVisualizationTypeDialog>(Localizer["NewVisualization"], options);
        var result = await dialogRef.Result;

        if (result?.Data is int type)
        {
            if (type == 1)
                await CargarChartsAsync();
            else if (type == 2)
                await LoadKpisPage();

            StateHasChanged();
        }
    }

    private string GetSearchPlaceholder()
    {
        return _activeTabIndex == 0 ? Localizer["BuscarKpiPlaceholder"] : Localizer["BuscarGraficaPlaceholder"];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_kpiCards.Any())
        {
            await JS.InvokeVoidAsync("equalizeCardHeights");
        }

        if (firstRender)
        {
            var returnTo = GetQueryParam("returnTo");
            if (string.Equals(returnTo, "VisualizationCreate", StringComparison.OrdinalIgnoreCase))
            {
                await Task.Yield();
                await OpenDialogCreateVisualizationCard();
            }
            else if (System.String.Equals(returnTo, "VisualizationEdit"))
            {
                await Task.Yield();
                System.Int32 newDatasetId = System.Int32.Parse(GetQueryParam("newDatasetId"));
                System.String newDatasetModule = GetQueryParam("newDatasetModule");

                Nav.NavigateTo($"/visualizaciones");

                DialogOptions? options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium };
                DialogParameters parameters = new DialogParameters { ["restore"] = true, ["NewDatasetId"] = newDatasetId, ["NewDatasetModule"] = newDatasetModule };
                IDialogReference? dialog = await DialogService.ShowAsync<EditVisualizationDialog>("Editar Visualización", parameters, options);
                DialogResult? result = await dialog.Result;

                if (result != null && !result.Canceled)
                {
                    Snackbar.Add("Visualización actualizada", Severity.Success);
                }
            }
        }
    }

    private async Task OpenDialogCreateVisualizationCard()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var returnTo = GetQueryParam("returnTo");
        var newDatasetIdStr = GetQueryParam("newDatasetId");
        var newDatasetModule = GetQueryParam("newDatasetModule");
        DialogParameters parameters = new DialogParameters
        {
            ["ReturnTo"] = returnTo,
            ["NewDatasetId"] = int.TryParse(newDatasetIdStr, out var ndid) ? ndid : (int?)null,
            ["NewDatasetModule"] = string.IsNullOrWhiteSpace(newDatasetModule) ? null : newDatasetModule
        };
        var dialogRef = await DialogService.ShowAsync<CreateVisualizationCard>(Localizer["NewVisualization"], parameters, options);
        // Do not clean or override the URL here. The dialog handles navigation/cleanup on Submit/Cancel.
        await dialogRef.Result;

        await LoadKpisPage();
        StateHasChanged();
    }

    private static Dictionary<string, string> ParseQueryString(string? query)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrEmpty(query)) return result;
        var q = query.StartsWith("?") ? query.Substring(1) : query;
        foreach (var pair in q.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split('=', 2);
            var key = Uri.UnescapeDataString(kv[0]);
            var value = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : string.Empty;
            result[key] = value;
        }
        return result;
    }

    private string? GetQueryParam(string key)
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var dict = ParseQueryString(uri.Query);
        return dict.TryGetValue(key, out var v) ? v : null;
    }

    private async Task OnSearchChanged(string value)
    {
        _searchQuery = value;
        await LoadKpisPage(resetPage: true);
        StateHasChanged();
    }

    private async Task LoadKpiDataAsync(KpiCardModel card)
    {
        if (card == null || card.IsLoading) return;

        card.IsLoading = true;
        card.Error = null;
        try
        {
            var response = await Http.GetAsync($"api/KPI/{card.Info.Id}");
            if (response.IsSuccessStatusCode)
            {
                card.Data = await response.Content.ReadFromJsonAsync<KpiResponse>();
            }
            else
            {
                card.Error = Localizer["ErrorLoadingKpi"];
            }
        }
        catch
        {
            card.Error = Localizer["ErrorLoadingKpi"];
        }
        finally
        {
            card.IsLoading = false;
            StateHasChanged();
        }
    }

    private void ResetKpiListing()
    {
        _kpiCards = new();
        _kpiTotalPages = 0;
        _kpiTotalCount = 0;
        _kpiHasPreviousPage = false;
        _kpiHasNextPage = false;
    }

    private async Task GoToKpiPage(int page)
    {
        if (page < 1 || (_kpiTotalPages > 0 && page > _kpiTotalPages)) return;
        _kpiCurrentPage = page;
        await LoadKpisPage();
    }

    private async Task EditarKpi(KpiCardModel card)
    {
        if (card == null) return;

        if (card.Data == null)
        {
            await LoadKpiDataAsync(card);
            if (card.Data == null)
            {
                Snackbar.Add(Localizer["ErrorLoadingKpi"], Severity.Error);
                return;
            }
        }

        var parameters = new DialogParameters
        {
            ["ExistingKpi"] = new KpiResponse
            {
                Id = card.Data.Id,
                Name = card.Data.Name,
                Description = card.Data.Description,
                ActualColor = card.Data.ActualColor
            }
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialogRef = await DialogService.ShowAsync<EditKpiCard>(
            "Editar KPI", parameters, options);

        var result = await dialogRef.Result;

        if (!result.Canceled)
        {
            card.Data = null;
            await LoadKpiDataAsync(card);
            StateHasChanged();
        }
    }

    private async Task ConfirmEliminarKpi(KpiCardModel card)
    {
        if (card is null) return;

        var titulo = Localizer["Confirmación"];
        var mensaje = (MarkupString)string.Format(
            Localizer["PreguntaEliminar1"],
            $"<b>{card.Data?.Name ?? card.Info.Name}</b>"
        );

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall };

        bool? result = await DialogService.ShowMessageBox(
            titulo,
            mensaje,
            yesText: Localizer["Eliminar"],
            cancelText: Localizer["Cancelar"],
            options: options
        );

        if (result != true)
            return;

        await EliminarKpiAsync(card.Info.Id);

        await LoadKpisPage();
    }

    private async Task EliminarKpiAsync(int kpiId)
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");

            var url = $"api/KPI/{kpiId}";
            var response = await Http.DeleteAsync(url);

            if (response.IsSuccessStatusCode)
            {
                await LoadKpisPage();
                Snackbar.Add(Localizer["KpiDeletedSuccess"], Severity.Success);
            }
            else if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                Snackbar.Add(Localizer["NoPermission"], Severity.Error);
            }
            else if (response.StatusCode == HttpStatusCode.NotFound)
            {
                Snackbar.Add(Localizer["KpiNotFound"], Severity.Warning);
                await LoadKpisPage();
            }
            else if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                var txt = await response.Content.ReadAsStringAsync();
                Snackbar.Add(txt, Severity.Error);
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add(Localizer["KpiDeletedError"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(Localizer["InternError"], Severity.Error);
        }
    }

    private async Task OnVisualizationDeleted(System.Int32 deletedId)
    {
        _charts.RemoveAll(c => c.IdVisualizacion == deletedId);
        if(_charts.Count == 0 && _hasPreviousPage)
        {
            _currentPage--;
        }
        await CargarChartsAsync();
    }

    private async Task GoToChartPage(int page)
    {
        if (page < 1 || page > _totalPages) return;
        _currentPage = page;
        await CargarChartsAsync();
    }
}
