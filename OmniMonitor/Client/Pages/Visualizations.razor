@page "/visualizaciones"
@attribute [Authorize]

@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HttpClient Http
@inject IStringLocalizer<Visualizations> Localizer
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JS
@inject NavigationManager Nav

@using OmniMonitor.Shared.Dtos
@using System.Text.Json
@using Blazored.LocalStorage
@using System.Globalization
@using Microsoft.Extensions.Localization

<style>
    .tab-toggle-container {
        display: inline-flex;
        border-radius: 9999px; 
        overflow: hidden;
    }

    .tab-toggle-btn {
        color: var(--text-primary);
        text-transform: capitalize;
        padding: 6px 14px;
        border: 1px solid color-mix(in srgb, var(--text-primary) 15%, transparent);
        background-color: transparent;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .tab-toggle-btn:hover {
            background-color: color-mix(in srgb, var(--card) 60%, transparent);
        }

        /* Izquierdo: redondeado solo a la izquierda */
        .tab-toggle-btn.left {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
            border-right: none;
            border-top-left-radius: 9999px;
            border-bottom-left-radius: 9999px;
        }

        /* Derecho: redondeado solo a la derecha */
        .tab-toggle-btn.right {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
            border-top-right-radius: 9999px;
            border-bottom-right-radius: 9999px;
        }

        /* Estado activo */
        .tab-toggle-btn.active {
            background-color: color-mix(in srgb, var(--card) 80%, transparent);
            color: var(--text-primary);
            font-weight: 600;
        }

</style>


<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
    <MudItem Class="d-flex justify-space-between mb-4">
        <MudText Typo="Typo.h4" Style="color: var(--text-primary);">@Localizer["Titulo"]</MudText>
        <AddButton OnClick="OpenDialogCreateVisualization">@Localizer["AgregarVisualizacion"]</AddButton>
    </MudItem>

    <!-- Selector superior con buscador y tabs -->
    <MudItem Class="d-flex align-center justify-space-between mt-4 mb-4">
        <div class="d-flex align-center">
            <!-- Buscador -->
            <MudTextField Immediate="true"
                          @bind-Value="_searchQuery"
                          Placeholder="@GetSearchPlaceholder()"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="width: 400px; margin-right: 16px;" />

            @* <!-- Tabs pequeñas tipo toggle -->
            <div class="tab-toggle-container">
                <MudButton Variant="Variant.Text"
                           Size="MudBlazor.Size.Small"
                           Class="@($"tab-toggle-btn left {(_activeTabIndex == 0 ? "active" : "")}")"
                           OnClick="@(() => SetActiveTab(0))">
                    @Localizer["KPIs"]
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Size="MudBlazor.Size.Small"
                           Class="@($"tab-toggle-btn right {(_activeTabIndex == 1 ? "active" : "")}")"
                           OnClick="@(() => SetActiveTab(1))">
                    @Localizer["Gráficas"]
                </MudButton>
            </div> *@



        </div>
    </MudItem>


    <MudTabs Elevation="2" Rounded="true" PanelClass="mt-6" ActivePanelIndexChanged="@((index) => _activeTabIndex = index)" KeepPanelsAlive="true">

        <MudTabPanel Text="@Localizer["KPIs"]">
            <MudGrid Spacing="4">
                @if (_isLoadingKpis)
                {
                    @for (int i = 0; i < 3; i++)
                    {
                        <MudItem xs="12" sm="12" md="6" lg="4">
                            <MudPaper Class="pa-4" Style="height: 200px;">
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100%" />
                            </MudPaper>
                        </MudItem>
                    }
                }
                else if (_kpis != null && _kpis.Any())
                {
                    @foreach (var kpi in _kpis
                                    .Where(v => string.IsNullOrWhiteSpace(_searchQuery) ||
                                    v.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)))
                    {
                        <MudItem xs="12" sm="6" md="3" lg="3" @key="@($"KPI_{kpi.Id}")">
                            <KpiViewer Kpi="kpi" />
                        </MudItem>
                    }
                }
                else
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1" Align="MudBlazor.Align.Center" Style="color:#667d8a">
                            @Localizer["NoKpisAvailable"]
                        </MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="@Localizer["Gráficas"]">
            <MudGrid Spacing="4">
                @if (_isLoadingCharts)
                {
                    @for (int i = 0; i < 3; i++)
                    {
                        <MudItem xs="12" sm="12" md="6" lg="4">
                            <MudPaper Class="pa-4" Style="height: 400px;">
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100%" />
                            </MudPaper>
                        </MudItem>
                    }
                }
                else if (_charts != null && _charts.Any())
                {
                    @foreach (var (chartId, chartName) in _charts
                                    .Where(v => string.IsNullOrWhiteSpace(_searchQuery) ||
                                    v.Nombre.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)))
                    {

                        @* JsonDocument design = JsonDocument.Parse(visualization.JsonDesign); *@
                        @* var datasetNames = string.Join(", ", visualization.GrupoDatasets.Select(gd => gd.Dataset.Name)); *@
                        @* var chartType = design.RootElement.GetProperty("ChartType").ToString(); *@
                        @* var visualizationData = GetVisualizationData(visualization.IdVisualizacion); *@

                        @* 
                    <MudItem xs="12" sm="12" md="6" lg="4">
                        <VisualizationCard visualizationTitle="@visualization.Nombre"
                                           visualizationDatasets="@datasetNames"
                                           lastUpdated="@DateTime.Now.ToString("g")"
                                           dataCharts="@visualizationData"
                                           chartType="@chartType" />
                    </MudItem> *@

                        <MudItem xs="12" sm="12" md="6" lg="4" @key="@($"V{chartId}_1")">
                            <MudPaper Class="pa-4" Style="background-color: var(--card);">
                                <MudCard Elevation="0" Style="background-color: transparent; height: 450px">


                                    <ChartViewer VisualizationId="@chartId" ShowIcon="true" ShowDatasetsInfo="true" ShowLastUpdatedInfo="true" />


                                </MudCard>
                            </MudPaper>
                        </MudItem>



                    }
                }
                else
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1" Align="MudBlazor.Align.Center" Style="color:#667d8a">
                            @Localizer["NoChartAvailable"]
                        </MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudTabPanel>

    </MudTabs>

   

</MudContainer>


@code {
    private string _searchQuery = "";
    private List<(int Id, string Nombre)> _charts = new();
    private List<KpiResponse> _kpis = new(); 
    private bool _isLoadingKpis = false;
    private bool _isLoadingCharts = false;
    private int _activeTabIndex = 0;

    protected override async Task OnInitializedAsync()
    {
        _isLoadingKpis = _isLoadingCharts = true;
        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        try
        {
            _isLoadingKpis = _isLoadingCharts = true;
            await Task.WhenAll(CargarKpisAsync(), CargarChartsAsync());
        }
        finally
        {
            _isLoadingKpis = _isLoadingCharts = false;
            StateHasChanged();
        }
    }


    private async Task CargarKpisAsync()
    {
        try
        {
            _isLoadingKpis = true;
            string token = await LocalStorage.GetItemAsync<string>("authToken");
            var response = await Http.GetAsync($"api/KPI/kpis?token={token}");
            if (response.IsSuccessStatusCode)
            {
                var kpisFromApi = await response.Content.ReadFromJsonAsync<List<KpiResponse>>();
                _kpis = kpisFromApi ?? new();
            }
            else
            {
                _kpis = new();
            }
        }
        finally
        {
            _isLoadingKpis = false;
        }
    }

    private async Task CargarChartsAsync()
    {
        try
        {
            _isLoadingCharts = true;
            string token = await LocalStorage.GetItemAsync<string>("authToken");
            var response = await Http.GetAsync($"api/Visualizacion/GetAllVisualizaciones?token={token}");
            if (response.IsSuccessStatusCode)
            {
                var chartsFromApi = await response.Content.ReadFromJsonAsync<List<Visualizacion>>();
                _charts = chartsFromApi?.Select(v => (v.IdVisualizacion, v.Nombre)).ToList() ?? new();
            }
        }
        finally
        {
            _isLoadingCharts = false;
        }
    }

    private async Task OpenDialogCreateVisualization()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small };
        var dialogRef = await DialogService.ShowAsync<SelectVisualizationTypeDialog>(Localizer["NewVisualization"], options);
        var result = await dialogRef.Result;

        if (result?.Data is int type)
        {
            if (type == 1)
                await CargarChartsAsync();
            else if (type == 2)
                await CargarKpisAsync();

            StateHasChanged();
        }
    }


    private string GetSearchPlaceholder()
    {
        return _activeTabIndex == 0 ? Localizer["BuscarKpiPlaceholder"] : Localizer["BuscarGraficaPlaceholder"];
    }

