<style>
    .tab-toggle-container {
        display: inline-flex;
        border-radius: 9999px; 
        overflow: hidden;
    }

    .tab-toggle-btn {
        color: var(--text-primary);
        text-transform: capitalize;
        padding: 6px 14px;
        border: 1px solid color-mix(in srgb, var(--text-primary) 15%, transparent);
        background-color: transparent;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .tab-toggle-btn:hover {
            background-color: color-mix(in srgb, var(--card) 60%, transparent);
        }

        /* Izquierdo: redondeado solo a la izquierda */
        .tab-toggle-btn.left {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
            border-right: none;
            border-top-left-radius: 9999px;
            border-bottom-left-radius: 9999px;
        }

        /* Derecho: redondeado solo a la derecha */
        .tab-toggle-btn.right {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
            border-top-right-radius: 9999px;
            border-bottom-right-radius: 9999px;
        }

        /* Estado activo */
        .tab-toggle-btn.active {
            background-color: color-mix(in srgb, var(--card) 80%, transparent);
            color: var(--text-primary);
            font-weight: 600;
        }

</style>


<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
