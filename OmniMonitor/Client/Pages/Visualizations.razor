@page "/visualizaciones"
@attribute [Authorize]

@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HttpClient Http
@inject IStringLocalizer<Visualizations> Localizer
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ISnackbar Snackbar

@using OmniMonitor.Shared.Dtos
@using System.Text.Json
@using Blazored.LocalStorage
@using System.Globalization
@using Microsoft.Extensions.Localization
@using System.Net;
@using System.Net.Http.Json;
<style>
    .tab-toggle-container {
        display: inline-flex;
        border-radius: 9999px;
        overflow: hidden;
    }

    .tab-toggle-btn {
        color: var(--text-primary);
        text-transform: capitalize;
        padding: 6px 14px;
        border: 1px solid color-mix(in srgb, var(--text-primary) 15%, transparent);
        background-color: transparent;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .tab-toggle-btn:hover {
            background-color: color-mix(in srgb, var(--card) 60%, transparent);
        }

        .tab-toggle-btn.left {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
            border-right: none;
            border-top-left-radius: 9999px;
            border-bottom-left-radius: 9999px;
        }

        .tab-toggle-btn.right {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
            border-top-right-radius: 9999px;
            border-bottom-right-radius: 9999px;
        }

        .tab-toggle-btn.active {
            background-color: color-mix(in srgb, var(--card) 80%, transparent);
            color: var(--text-primary);
            font-weight: 600;
        }

</style>


<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
    <MudItem Class="d-flex justify-space-between mb-4">
        <MudText Typo="Typo.h4" Style="color: var(--text-primary);">@Localizer["Titulo"]</MudText>
        <AddButton OnClick="OpenDialogCreateVisualization">@Localizer["AgregarVisualizacion"]</AddButton>
    </MudItem>

    <!-- Selector superior con buscador y tabs -->
    <MudItem Class="d-flex align-center justify-space-between mt-4 mb-4">
        <div class="d-flex align-center">
            <!-- Buscador -->
            <MudTextField Immediate="true"
                          @bind-Value="_searchQuery"
                          Placeholder="@GetSearchPlaceholder()"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="width: 400px; margin-right: 16px;" />

            <!-- Tabs pequeñas tipo toggle -->
            <div class="tab-toggle-container">
                <MudButton Variant="Variant.Text"
                           Size="MudBlazor.Size.Small"
                           Class="@($"tab-toggle-btn left {(_activeTabIndex == 0 ? "active" : "")}")"
                           OnClick="@(() => SetActiveTab(0))">
                    @Localizer["KPIs"]
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Size="MudBlazor.Size.Small"
                           Class="@($"tab-toggle-btn right {(_activeTabIndex == 1 ? "active" : "")}")"
                           OnClick="@(() => SetActiveTab(1))">
                    @Localizer["Gráficas"]
                </MudButton>
            </div>
        </div>
    </MudItem>


    <MudGrid Spacing="4">
        <!-- Contenido KPIs -->
        @if (_isLoadingKpis)
        {
            @* 
            @for (int i = 0; i < 3; i++)
            {
                <MudItem xs="12" sm="6" md="3" lg="3" Class="@(_activeTabIndex != 0 ? "d-none" : "")">
                    <MudPaper Class="pa-4" Style="height: 200px;">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100%" />
                    </MudPaper>
                </MudItem>
            }
            *@
        }
        else if (_kpis != null && _kpis.Any())
        {
            @foreach (var kpi in _kpis
                    .Where(v => string.IsNullOrWhiteSpace(_searchQuery) ||
                    v.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)))
            {
                <MudItem xs="12" sm="6" md="3" lg="3" @key="kpi" Class="@(_activeTabIndex != 0 ? "d-none" : "")">
                    <div style="position: relative;">
                        <!-- KPI Card -->
                        <KpiCard Kpi="kpi" />
                        <!-- Menu -->
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                 AnchorOrigin="Origin.TopRight"
                                 TransformOrigin="Origin.TopRight"
                                 Class="position-absolute"
                                 Style="position:absolute; top:8px; right:8px; z-index:10; background-color:transparent;">

                            <MudMenuItem OnClick="@(() => EditarKpi(kpi))">
                                @Localizer["Editar"]
                            </MudMenuItem>

                            <MudMenuItem OnClick="@(() => ConfirmEliminarKpi(kpi))">
                                @Localizer["Eliminar"]
                            </MudMenuItem>
                        </MudMenu>
                    </div>
                </MudItem>

            }
        }
        else
        {
            <MudItem xs="12" Class="@(_activeTabIndex != 0 ? "d-none" : "")">
                <MudText Typo="Typo.subtitle1" Align="MudBlazor.Align.Center" Style="color:#667d8a">
                    @Localizer["NoKpisAvailable"]
                </MudText>
            </MudItem>
        }

        <!-- Contenido Charts -->
        @if (_isLoadingCharts)
        {
            @* 
            @for (int i = 0; i < 3; i++)
            {
                <MudItem xs="12" sm="12" md="6" lg="4" Class="@(_activeTabIndex != 1 ? "d-none" : "")">
                    <MudPaper Class="pa-4" Style="height: 400px;">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100%" />
                    </MudPaper>
                </MudItem>
            }
            *@
        }
        else if (_charts != null && _charts.Any())
        {
            @foreach (Visualizacion visualization in _charts
                    .Where(v => string.IsNullOrWhiteSpace(_searchQuery) ||
                    v.Nombre.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)))
            {

                <MudItem xs="12" sm="12" md="6" lg="4" @key="@($"V{visualization.IdVisualizacion}_1")" Class="@(_activeTabIndex != 1 ? "d-none" : "")">
                    <MudPaper Class="pa-4" Style="background-color: var(--card);">
                        <MudCard Elevation="0" Style="background-color: transparent; height: 450px">

                            <ChartViewer OnDeleted="@(id => OnVisualizationDeleted(id))" Visualization=@visualization VisualizationId="@visualization.IdVisualizacion" ShowIcon="true" ShowLastUpdatedInfo="true" ShowDatasetsInfo="true" retrieveOnInitialized="false" showCustomizationIcon="true" />

                        </MudCard>
                    </MudPaper>
                </MudItem>

            }
            @if (_totalPages > 1)
            {
                <MudItem lg="12" md="12" xs="12">
                    <MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-6 mb-4">
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowLeft"
                                       Disabled="@(!_hasPreviousPage)"
                                       OnClick="@(() => GoToPage(1))"
                                       Size="MudBlazor.Size.Small"
                                       Color="MudBlazor.Color.Primary" />

                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                       Disabled="@(!_hasPreviousPage)"
                                       OnClick="@(() => GoToPage(_currentPage - 1))"
                                       Size="MudBlazor.Size.Small"
                                       Color="MudBlazor.Color.Primary" />

                        <MudText Typo="Typo.body2" Class="mx-3">
                            @Localizer["Página"] @_currentPage @Localizer["de"] @_totalPages
                        </MudText>

                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                       Disabled="@(!_hasNextPage)"
                                       OnClick="@(() => GoToPage(_currentPage + 1))"
                                       Size="MudBlazor.Size.Small"
                                       Color="MudBlazor.Color.Primary" />

                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight"
                                       Disabled="@(!_hasNextPage)"
                                       OnClick="@(() => GoToPage(_totalPages))"
                                       Size="MudBlazor.Size.Small"
                                       Color="MudBlazor.Color.Primary" />
                    </MudStack>

                    <MudStack Row Justify="Justify.Center" Class="mb-4">
                        <MudText Typo="Typo.caption" Style="color: #a5a8b5;">
                            @Localizer["Mostrando"] @_charts.Count @Localizer["de"] @_totalCount
                        </MudText>
                    </MudStack>
                </MudItem>
            }
        }
        else
        {
            <MudItem xs="12" Class="@(_activeTabIndex != 1 ? "d-none" : "")">
                <MudText Typo="Typo.subtitle1" Align="MudBlazor.Align.Center" Style="color:#667d8a">
                    @Localizer["NoChartAvailable"]
                </MudText>
            </MudItem>
        }
    </MudGrid>



</MudContainer>


@code {
    private string _searchQuery = "";
    private List<Visualizacion> _charts = new();
    private List<KpiResponse> _kpis = new();
    private bool _isLoadingKpis = false;
    private bool _isLoadingCharts = false;
    private int _activeTabIndex = 1;

    private int _currentPage = 1;
    private int _pageSize = 9;
    private int _totalPages = 0;
    private int _totalCount = 0;
    private bool _hasPreviousPage = false;
    private bool _hasNextPage = false;

    protected override async Task OnInitializedAsync()
    {
        _isLoadingKpis = _isLoadingCharts = true;
        await LoadAllAsync();
    }

    private void SetActiveTab(int index)
    {
        _activeTabIndex = index;
        StateHasChanged();

    }

    private async Task LoadAllAsync()
    {
        try
        {
            _isLoadingKpis = _isLoadingCharts = true;
            await Task.WhenAll(CargarKpisAsync(), CargarChartsAsync());
        }
        finally
        {
            _isLoadingKpis = _isLoadingCharts = false;
            StateHasChanged();
        }
    }

    private async Task CargarKpisAsync()
    {
        try
        {
            _isLoadingKpis = true;
            var url = "api/KPI/kpis";

            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var kpisFromApi = await response.Content.ReadFromJsonAsync<List<KpiResponse>>();
                _kpis = kpisFromApi ?? new();
            }
            else
            {
                _kpis = new();
            }
        }
        catch (Exception ex)
        {
            _kpis = new();
        }
        finally
        {
            _isLoadingKpis = false;
        }
    }

    private async Task CargarChartsAsync()
    {
        try
        {
            _isLoadingCharts = true;
            var response = await Http.GetAsync($"/api/Visualizacion/GetAllVisualizacionesPaginated?page={_currentPage}&pageSize={_pageSize}");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PaginatedVisualizacionDto>();
                if (result != null)
                {
                    _totalCount = result.TotalCount;
                    _totalPages = result.TotalPages;
                    _currentPage = result.Page;
                    _hasPreviousPage = result.HasPreviousPage;
                    _hasNextPage = result.HasNextPage;

                    _charts = result.Items;
                }
            }
        }
        catch (Exception ex)
        {
            _charts = new();
        }
        finally
        {
            _isLoadingCharts = false;
        }
    }

    private async Task OpenDialogCreateVisualization()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small };
        var dialogRef = await DialogService.ShowAsync<SelectVisualizationTypeDialog>(Localizer["NewVisualization"], options);
        var result = await dialogRef.Result;

        if (result?.Data is int type)
        {
            if (type == 1)
                await CargarChartsAsync();
            else if (type == 2)
                await CargarKpisAsync();

            StateHasChanged();
        }
    }

    private string GetSearchPlaceholder()
    {
        return _activeTabIndex == 0 ? Localizer["BuscarKpiPlaceholder"] : Localizer["BuscarGraficaPlaceholder"];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_kpis.Count > 0)
        {
            await JS.InvokeVoidAsync("equalizeCardHeights");
        }

        if (firstRender)
        {
            var returnTo = GetQueryParam("returnTo");
            if (string.Equals(returnTo, "VisualizationCreate", StringComparison.OrdinalIgnoreCase))
            {
                await Task.Yield();
                await OpenDialogCreateVisualizationCard();
            }
            else if (System.String.Equals(returnTo, "VisualizationEdit"))
            {
                await Task.Yield();
                System.Int32 newDatasetId = System.Int32.Parse(GetQueryParam("newDatasetId"));
                System.String newDatasetModule = GetQueryParam("newDatasetModule");

                Nav.NavigateTo($"/visualizaciones");

                DialogOptions? options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium };
                DialogParameters parameters = new DialogParameters { ["restore"] = true, ["NewDatasetId"] = newDatasetId, ["NewDatasetModule"] = newDatasetModule };
                IDialogReference? dialog = await DialogService.ShowAsync<EditVisualizationDialog>("Editar Visualización", parameters, options);
                DialogResult? result = await dialog.Result;

                if (result != null && !result.Canceled)
                {
                    Snackbar.Add("Visualización actualizada", Severity.Success);
                }
            }
        }
    }

    private async Task OpenDialogCreateVisualizationCard()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var returnTo = GetQueryParam("returnTo");
        var newDatasetIdStr = GetQueryParam("newDatasetId");
        var newDatasetModule = GetQueryParam("newDatasetModule");
        DialogParameters parameters = new DialogParameters
        {
            ["ReturnTo"] = returnTo,
            ["NewDatasetId"] = int.TryParse(newDatasetIdStr, out var ndid) ? ndid : (int?)null,
            ["NewDatasetModule"] = string.IsNullOrWhiteSpace(newDatasetModule) ? null : newDatasetModule
        };
        var dialogRef = await DialogService.ShowAsync<CreateVisualizationCard>(Localizer["NewVisualization"], parameters, options);
        // Do not clean or override the URL here. The dialog handles navigation/cleanup on Submit/Cancel.
        await dialogRef.Result;

        await CargarKpisAsync();
        StateHasChanged();
    }

    private static Dictionary<string, string> ParseQueryString(string? query)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrEmpty(query)) return result;
        var q = query.StartsWith("?") ? query.Substring(1) : query;
        foreach (var pair in q.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split('=', 2);
            var key = Uri.UnescapeDataString(kv[0]);
            var value = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : string.Empty;
            result[key] = value;
        }
        return result;
    }

    private string? GetQueryParam(string key)
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var dict = ParseQueryString(uri.Query);
        return dict.TryGetValue(key, out var v) ? v : null;
    }

    private async Task EditarKpi(KpiResponse kpi)
    {

        var parameters = new DialogParameters
        {
            ["ExistingKpi"] = new KpiResponse
            {
                Id = kpi.Id,
                Name = kpi.Name,
                Description = kpi.Description,
                ActualColor = kpi.ActualColor
            }
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialogRef = await DialogService.ShowAsync<EditKpiCard>(
            "Editar KPI", parameters, options);

        var result = await dialogRef.Result;


        if (!result.Canceled)
        {
            await CargarKpisAsync();
            StateHasChanged();
        }

    }

    private async Task ConfirmEliminarKpi(KpiResponse kpi)
    {
        if (kpi is null) return;

        var titulo = Localizer["Confirmación"];
        var mensaje = (MarkupString)string.Format(
            Localizer["PreguntaEliminar1"],
            $"<b>{kpi.Name}</b>"
        );

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall };

        bool? result = await DialogService.ShowMessageBox(
            titulo,
            mensaje,
            yesText: Localizer["Eliminar"],
            cancelText: Localizer["Cancelar"],
            options: options
        );

        if (result != true)
            return;

        await EliminarKpiAsync(kpi.Id);

        StateHasChanged();
    }

    private async Task EliminarKpiAsync(int kpiId)
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");

            var url = $"api/KPI/{kpiId}";
            var response = await Http.DeleteAsync(url);

            if (response.IsSuccessStatusCode)
            {
                await CargarKpisAsync();
                Snackbar.Add(Localizer["KpiDeletedSuccess"], Severity.Success);
            }
            else if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                Snackbar.Add(Localizer["NoPermission"], Severity.Error);
            }
            else if (response.StatusCode == HttpStatusCode.NotFound)
            {
                Snackbar.Add(Localizer["KpiNotFound"], Severity.Warning);
                await CargarKpisAsync();
            }
            else if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                var txt = await response.Content.ReadAsStringAsync();
                Snackbar.Add(txt, Severity.Error);
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add(Localizer["KpiDeletedError"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(Localizer["InternError"], Severity.Error);
        }
    }

    private async Task OnVisualizationDeleted(System.Int32 deletedId)
    {
        _charts.RemoveAll(c => c.IdVisualizacion == deletedId);
        if(_charts.Count == 0 && _hasPreviousPage)
        {
            _currentPage--;
        }
        await CargarChartsAsync();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > _totalPages) return;
        _currentPage = page;
        await CargarChartsAsync();
    }
}
