@page "/kpi-test"
@using OmniMonitor.Shared.Dtos
@using OmniMonitor.Shared.Dtos.KpiDtos
@inject HttpClient Http
@inject ISnackbar Snackbar
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Página de Prueba de KPIs</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Panel de Prueba de KPIs</MudText>

<MudGrid>
    <!-- Columna para Calcular KPI -->
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Calcular KPI</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (isLoadingDatasets)
                {
                    <div class="d-flex justify-center">
                        <MudProgressCircular Indeterminate="true" />
                        <MudText Class="ms-2">Cargando datasets...</MudText>
                    </div>
                }
                else
                {
                    <MudStack Spacing="3">
                        
                        <MudSelect T="int" @bind-Value="SelectedDatasetId" Label="Dataset" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var dataset in availableDatasets)
                            {
                                <MudSelectItem Value="@dataset.Id">@dataset.Name - @dataset.Description</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="string" @bind-Value="kpiRequest.MetricType" Label="Tipo de Métrica" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var metric in availableMetrics)
                            {
                                <MudSelectItem Value="@metric">@GetMetricLabel(metric)</MudSelectItem>
                            }
                        </MudSelect>

                        <MudDatePicker @bind-Date="dateFrom" Label="Fecha Desde" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudDatePicker @bind-Date="dateTo" Label="Fecha Hasta" Variant="Variant.Outlined" Margin="Margin.Dense" />

                        <MudSelect T="string" @bind-Value="kpiRequest.FieldName" Label="Campo (Opcional)" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var field in availableFields)
                            {
                                <MudSelectItem Value="@field">@field</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="string" @bind-Value="kpiRequest.FormatType" Label="Formato" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@("number")">Número</MudSelectItem>
                            <MudSelectItem Value="@("percentage")">Porcentaje</MudSelectItem>
                        </MudSelect>

                        <MudButton OnClick="CalculateKpi" 
                                   Variant="Variant.Filled" 
                                   Color="MudBlazor.Color.Primary" 
                                   FullWidth="true"
                                   Disabled="@(string.IsNullOrEmpty(username) || kpiRequest.DatasetId == 0 || string.IsNullOrEmpty(kpiRequest.MetricType))">
                            Calcular KPI
                        </MudButton>
                    </MudStack>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Columna para Mostrar Resultado -->
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Resultado del KPI</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (isCalculating)
                {
                    <div class="d-flex justify-center">
                        <MudProgressCircular Indeterminate="true" />
                        <MudText Class="ms-2">Calculando KPI...</MudText>
                    </div>
                }
                else if (kpiResult != null)
                {
                    <MudStack Spacing="2">
                        <MudPaper Class="pa-4" Elevation="2">
                            <MudText Typo="Typo.h4" Color="MudBlazor.Color.Primary">@kpiResult.FormattedValue</MudText>
                            <MudText Typo="Typo.subtitle1">@kpiResult.MetricType</MudText>
                        </MudPaper>

                        <MudExpansionPanels MultiExpansion="true">
                            <MudExpansionPanel>
                                <TitleContent>
                                    <div style="display: flex; align-items: center;">
                                        <MudIcon Icon="Icons.Material.Filled.Info" class="mr-3"></MudIcon>
                                        <MudText>Detalles del KPI</MudText>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <MudStack Spacing="1">
                                        <MudText><strong>Valor:</strong> @kpiResult.Value</MudText>
                                        <MudText><strong>Formato:</strong> @kpiResult.FormatType</MudText>
                                        <MudText><strong>Campo:</strong> @(kpiResult.FieldName ?? "N/A")</MudText>
                                        <MudText><strong>Calculado:</strong> @kpiResult.CalculatedAt.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                                    </MudStack>
                                </ChildContent>
                            </MudExpansionPanel>

                            <MudExpansionPanel>
                                <TitleContent>
                                    <div style="display: flex; align-items: center;">
                                        <MudIcon Icon="Icons.Material.Filled.Dataset" class="mr-3"></MudIcon>
                                        <MudText>Información del Dataset</MudText>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <MudStack Spacing="1">
                                        <MudText><strong>ID:</strong> @kpiResult.DatasetInfo.DatasetId</MudText>
                                        <MudText><strong>Nombre:</strong> @kpiResult.DatasetInfo.DatasetName</MudText>
                                        <MudText><strong>Tipo:</strong> @kpiResult.DatasetInfo.DatasetType</MudText>
                                        <MudText><strong>Usuario:</strong> @kpiResult.DatasetInfo.Username</MudText>
                                        <MudText><strong>Descripción:</strong> @(kpiResult.DatasetInfo.Description ?? "N/A")</MudText>
                                    </MudStack>
                                </ChildContent>
                            </MudExpansionPanel>

                            <MudExpansionPanel>
                                <TitleContent>
                                    <div style="display: flex; align-items: center;">
                                        <MudIcon Icon="Icons.Material.Filled.TrendingUp" class="mr-3"></MudIcon>
                                        <MudText>Comparación</MudText>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <MudStack Spacing="1">
                                        <MudText><strong>Valor Anterior:</strong> @(kpiResult.Comparison?.PreviousValue ?? "N/A")</MudText>
                                        <MudText><strong>Diferencia %:</strong> @(kpiResult.Comparison?.PercentageDifference.ToString("F2") ?? "N/A")%</MudText>
                                        <MudText><strong>Diferencia Absoluta:</strong> @(kpiResult.Comparison?.AbsoluteDifference.ToString() ?? "N/A")</MudText>
                                    </MudStack>
                                </ChildContent>
                            </MudExpansionPanel>
                        </MudExpansionPanels>

                        <MudDivider />

                        <MudButton OnClick="ClearResult" 
                                   Variant="Variant.Outlined" 
                                   Color="MudBlazor.Color.Secondary" 
                                   StartIcon="Icons.Material.Filled.Clear">
                            Limpiar Resultado
                        </MudButton>
                    </MudStack>
                }
                else
                {
                    <MudAlert Severity="Severity.Info">
                        Selecciona los parámetros y haz clic en "Calcular KPI" para ver el resultado aquí.
                    </MudAlert>
                }

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-4">
                        <strong>Error:</strong> @errorMessage
                    </MudAlert>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<!-- Sección de Datasets Disponibles -->
<MudCard Class="mt-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Datasets Disponibles</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudButton OnClick="LoadDatasets" 
                       Variant="Variant.Text" 
                       Color="MudBlazor.Color.Primary" 
                       StartIcon="Icons.Material.Filled.Refresh">
                Recargar
            </MudButton>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        @if (availableDatasets.Any())
        {
            <MudTable Items="@availableDatasets" Dense="true" Hover="true" Striped="true">
                <HeaderContent>
                    <MudTh>ID</MudTh>
                    <MudTh>Nombre</MudTh>
                    <MudTh>Tipo</MudTh>
                    <MudTh>Descripción</MudTh>
                    <MudTh>Usuario</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="ID">@context.Id</MudTd>
                    <MudTd DataLabel="Nombre">@context.Name</MudTd>
                    <MudTd DataLabel="Tipo">@(context.ContentType ?? "N/A")</MudTd>
                    <MudTd DataLabel="Descripción">@(context.Description ?? "N/A")</MudTd>
                    <MudTd DataLabel="Usuario">@context.Username</MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudAlert Severity="Severity.Info">
                No hay datasets disponibles o aún no se han cargado.
            </MudAlert>
        }
    </MudCardContent>
</MudCard>

<MudCard Class="mt-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Todos los KPIs del usuario</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudButton OnClick="LoadAllKpis" Variant="Variant.Text" Color="MudBlazor.Color.Primary" StartIcon="Icons.Material.Filled.Refresh">
                Recargar KPIs
            </MudButton>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        @if (allKpis.Any())
        {
            <MudTable Items="@allKpis" Dense="true" Hover="true" Striped="true">
                <HeaderContent>
                    <MudTh>ID</MudTh>
                    <MudTh>Nombre</MudTh>
                    <MudTh>Métrica</MudTh>
                    <MudTh>Valor</MudTh>
                    <MudTh>Fecha</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="ID">@context.DatasetInfo.DatasetId</MudTd>
                    <MudTd DataLabel="Nombre">@context.DatasetInfo.DatasetName</MudTd>
                    <MudTd DataLabel="Métrica">@context.MetricType</MudTd>
                    <MudTd DataLabel="Valor">@context.FormattedValue</MudTd>
                    <MudTd DataLabel="Fecha">@context.CalculatedAt.ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudAlert Severity="Severity.Info">No hay KPIs calculados para este usuario.</MudAlert>
        }
    </MudCardContent>
</MudCard>

<MudCard Class="mt-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Buscar KPI por ID</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudTextField @bind-Value="searchKpiId" Label="ID del KPI" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudButton OnClick="LoadKpiById" Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Disabled="@(searchKpiId <= 0)">
            Buscar
        </MudButton>
        @if (searchedKpi != null)
        {
            <MudPaper Class="pa-4 mt-4" Elevation="2">
                <MudText Typo="Typo.h6">Resultado</MudText>
                <MudText><strong>ID:</strong> @searchedKpi.DatasetInfo.DatasetId</MudText>
                <MudText><strong>Nombre:</strong> @searchedKpi.DatasetInfo.DatasetName</MudText>
                <MudText><strong>Métrica:</strong> @searchedKpi.MetricType</MudText>
                <MudText><strong>Valor:</strong> @searchedKpi.FormattedValue</MudText>
                <MudText><strong>Fecha:</strong> @searchedKpi.CalculatedAt.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
            </MudPaper>
        }
        else if (searchedKpiError != null)
        {
            <MudAlert Severity="Severity.Error">@searchedKpiError</MudAlert>
        }
    </MudCardContent>
</MudCard>

@code {
    private string username = "admin";
    private CalculateKpiRequest kpiRequest = new();
    private KpiResponse? kpiResult;
    private List<Dataset> availableDatasets = new();
    private bool isCalculating = false;
    private bool isLoadingDatasets = true;
    private string errorMessage = string.Empty;
    private DateTime? dateFrom = DateTime.Now.AddDays(-7);
    private DateTime? dateTo = DateTime.Now;
    private List<KpiResponse> allKpis = new();
    private int searchKpiId = 0;
    private KpiResponse? searchedKpi;
    private string? searchedKpiError;
    private List<string> availableFields = new();
    private List<string> availableMetrics = new();

    protected override async Task OnInitializedAsync()
    {
        // Configurar valores por defecto
        kpiRequest.DatasetType = "IM";
        kpiRequest.MetricType = "count";
        kpiRequest.FormatType = "number";
        
        // Obtener usuario autenticado
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.Name is not null)
            {
                username = authState.User.Identity.Name;
            }
        }
        catch
        {
            // Si falla, usar "admin" por defecto
        }

        await LoadDatasets();
    }

    private async Task LoadDatasets()
    {
        isLoadingDatasets = true;
        errorMessage = string.Empty;
        
        try
        {
            var response = await Http.GetAsync($"api/Dataset/user/{username}");
            
            if (response.IsSuccessStatusCode)
            {
                availableDatasets = await response.Content.ReadFromJsonAsync<List<Dataset>>() ?? new List<Dataset>();
                Snackbar.Add($"Cargados {availableDatasets.Count} datasets", Severity.Success);
            }
            else
            {
                errorMessage = $"Error al cargar datasets: {response.StatusCode}";
                Snackbar.Add(errorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar datasets: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isLoadingDatasets = false;
        }
    }

    private async Task CalculateKpi()
    {
        isCalculating = true;
        errorMessage = string.Empty;
        kpiResult = null;

        try
        {
            // Configurar fechas
            kpiRequest.DateFrom = dateFrom ?? DateTime.Now.AddDays(-7);
            kpiRequest.DateTo = dateTo ?? DateTime.Now;

            var response = await Http.PostAsJsonAsync($"api/Kpi/calculate/{username}", kpiRequest);

            if (response.IsSuccessStatusCode)
            {
                kpiResult = await response.Content.ReadFromJsonAsync<KpiResponse>();
                Snackbar.Add("KPI calculado exitosamente", Severity.Success);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error al calcular KPI: {response.StatusCode} - {errorContent}";
                Snackbar.Add(errorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al calcular KPI: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isCalculating = false;
        }
    }

    private void ClearResult()
    {
        kpiResult = null;
        errorMessage = string.Empty;
    }

    private async Task LoadAllKpis()
    {
        try
        {
            var response = await Http.GetAsync($"api/Kpi/all/{username}");
            if (response.IsSuccessStatusCode)
            {
                allKpis = await response.Content.ReadFromJsonAsync<List<KpiResponse>>() ?? new List<KpiResponse>();
                Snackbar.Add($"Cargados {allKpis.Count} KPIs", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Error al cargar KPIs: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar KPIs: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadKpiById()
    {
        searchedKpi = null;
        searchedKpiError = null;
        try
        {
            var response = await Http.GetAsync($"api/Kpi/{searchKpiId}/{username}");
            if (response.IsSuccessStatusCode)
            {
                searchedKpi = await response.Content.ReadFromJsonAsync<KpiResponse>();
                if (searchedKpi == null)
                    searchedKpiError = "No se encontró el KPI.";
            }
            else
            {
                searchedKpiError = $"Error al buscar KPI: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            searchedKpiError = $"Error al buscar KPI: {ex.Message}";
        }
    }

    private void OnDatasetChanged(int datasetId)
    {
        var dataset = availableDatasets.FirstOrDefault(d => d.Id == datasetId);
        availableFields.Clear();
        availableMetrics.Clear();
        if (dataset != null)
        {
            var type = (dataset.ContentType ?? "").ToUpper();
            if (type == "IM")
            {
                availableFields.AddRange(new[] { "temperatura", "presion", "humedad" });
                availableMetrics.AddRange(new[] { "count", "sensor_data_points", "active_devices" });
            }
            else if (type == "EM")
            {
                availableFields.AddRange(new[] { "estado", "origen", "categoria" });
                availableMetrics.AddRange(new[] { "alert_count", "event_count", "count" });
            }
            else if (type == "UM")
            {
                availableFields.AddRange(new[] { "zona", "noticia", "evento" });
                availableMetrics.AddRange(new[] { "zone_count", "news_count", "event_count", "count" });
            }
            else
            {
                availableFields.Add("N/A");
                availableMetrics.Add("count");
            }
        }
    }

    // Actualizar el select de campos cuando cambie el dataset
    private int _selectedDatasetId;
    private int SelectedDatasetId
    {
        get => _selectedDatasetId;
        set
        {
            _selectedDatasetId = value;
            kpiRequest.DatasetId = value;
            OnDatasetChanged(value);
        }
    }

    private string GetMetricLabel(string metric)
    {
        return metric switch
        {
            "count" => "Count - Conteo",
            "sensor_data_points" => "Sensor Data Points (IM)",
            "active_devices" => "Active Devices (IM)",
            "alert_count" => "Alert Count (EM)",
            "event_count" => "Event Count (EM/UM)",
            "zone_count" => "Zone Count (UM)",
            "news_count" => "News Count (UM)",
            _ => metric
        };
    }
}