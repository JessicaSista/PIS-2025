@page "/test-links"
@using OmniMonitor.Shared.Dtos
@using Blazored.LocalStorage
@inject HttpClient Http
@inject ILocalStorageService LocalStorage

<MudStack Class="pa-6" Spacing="2">
	<MudText Typo="Typo.h5">Generar enlaces de prueba</MudText>
	<MudStack Row Spacing="2">
		<MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="CreatePublicAsync" Disabled="@isSending">
			Crear enlace público
		</MudButton>
		<MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Secondary" OnClick="CreatePrivateAsync" Disabled="@isSending">
			Crear enlace privado con contraseña
		</MudButton>
	</MudStack>

	@if (!string.IsNullOrEmpty(resultMessage))
	{
		<MudAlert Severity="Severity.Info">@resultMessage</MudAlert>
	}
</MudStack>

@code {
	private bool isSending;
	private string? resultMessage;
	private string? token;

	private async Task CreatePublicAsync()
	{
		await CreateShareAsync(new ShareRequestDto
		{
			Visibility = "public",
			ExpiresAt = DateTime.UtcNow.Date.AddDays(1)
		});
	}

	private async Task CreatePrivateAsync()
	{
		await CreateShareAsync(new ShareRequestDto
		{
			Visibility = "private",
			ExpiresAt = DateTime.UtcNow.Date.AddDays(1),
			Password = "1234"
		});
	}

	private async Task CreateShareAsync(ShareRequestDto request)
	{
		isSending = true;
		resultMessage = null;

		try
		{
			token ??= await LocalStorage.GetItemAsync<string>("authToken");
			if (string.IsNullOrWhiteSpace(token))
			{
				resultMessage = "No se encontró token de autenticación en el navegador.";
				return;
			}

			var response = await Http.PostAsJsonAsync($"api/Dashboard/createShare/1/share?token={Uri.EscapeDataString(token)}", request);
			if (response.IsSuccessStatusCode)
			{
				var share = await response.Content.ReadFromJsonAsync<ShareResponseDto>();
				resultMessage = share != null
					? $"Slug: {share.Slug} | Visibilidad: {share.Visibility}"
					: "Enlace creado";
			}
			else
			{
				resultMessage = $"Error al crear enlace: {response.StatusCode}";
			}
		}
		catch (Exception ex)
		{
			resultMessage = $"Error: {ex.Message}";
		}
		finally
		{
			isSending = false;
		}
	}
}
