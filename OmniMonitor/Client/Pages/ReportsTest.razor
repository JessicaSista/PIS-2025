@page "/report-manager"
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@using System.Text.Json
@using System.ComponentModel.DataAnnotations

<div class="container mx-auto p-4 md:p-8">
    <header class="text-center mb-8">
        <h1 class="text-4xl font-bold text-gray-800">Panel de Pruebas de API de Reportes</h1>
        <p class="text-gray-600 mt-2">Una página simple con botones para probar cada endpoint.</p>
    </header>

    <!-- Session Token Card -->
    <div class="card mb-8 max-w-xl mx-auto">
        <h2 class="text-2xl font-semibold mb-4 text-gray-700">Autenticación</h2>
        <div class="flex items-end space-x-2">
            <div class="flex-grow">
                <label for="session-token" class="form-label">Token de Sesión</label>
                <InputText @bind-Value="sessionToken" id="session-token" class="form-input font-mono bg-gray-100" placeholder="El token se cargará aquí..." readonly />
            </div>
            <button class="btn btn-secondary" @onclick="LoadTokenFromLocalStorage">Cargar Token</button>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- Columna de Acciones -->
        <div class="space-y-6">
            <!-- Acciones de Joins -->
            <div class="card">
                <h2 class="text-2xl font-semibold mb-4 text-gray-700">Acciones de Joins</h2>
                <div class="space-y-4">
                    <button class="btn btn-primary w-full" @onclick="HandleCreateJoin">1. Crear un Join de Prueba</button>
                    <button class="btn btn-secondary w-full" @onclick="HandleListJoins">2. Listar Joins del Usuario</button>
                </div>
            </div>

            <!-- Acciones de Reportes -->
            <div class="card">
                <h2 class="text-2xl font-semibold mb-4 text-gray-700">Acciones de Reportes</h2>
                <div class="space-y-4">
                    <button class="btn btn-primary w-full" @onclick="HandleCreateReport">3. Crear un Reporte de Prueba</button>
                    <button class="btn btn-secondary w-full" @onclick="HandleListReports">4. Listar Reportes del Usuario</button>

                    <hr class="my-4" />

                    <div class="flex items-end space-x-2">
                        <div class="flex-grow">
                            <label class="form-label">ID del Reporte</label>
                            <InputNumber @bind-Value="reportIdForAction" class="form-input" />
                        </div>
                        <button class="btn btn-success" @onclick="HandleCreateAndAddJoinToReport">5. Crear y Añadir Join de Prueba</button>
                    </div>

                    <div class="flex items-end space-x-2">
                        <div class="flex-grow">
                            <label class="form-label">ID del Reporte a Ejecutar</label>
                            <InputNumber @bind-Value="reportIdToExecute" class="form-input" />
                        </div>
                        <button class="btn btn-success" @onclick="ExecuteReport">6. Ejecutar Reporte</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna de Resultados -->
        <div class="lg:col-span-1">
            <div class="card sticky top-8">
                <h2 class="text-2xl font-semibold mb-4 text-gray-700">Resultados de la API</h2>
                <div class="bg-gray-800 text-white rounded-md p-4 min-h-[30rem] overflow-y-auto font-mono text-sm">
                    <pre><code>@resultJson</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        background-color: white;
        border-radius: 0.5rem;
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        padding: 1.5rem;
    }

    .btn {
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        font-weight: 600;
        color: white;
        transition: background-color 200ms;
    }

    .btn-primary {
        background-color: #2563eb;
    }

        .btn-primary:hover {
            background-color: #1d4ed8;
        }

    .btn-secondary {
        background-color: #6b7280;
    }

        .btn-secondary:hover {
            background-color: #4b5563;
        }

    .btn-success {
        background-color: #16a34a;
    }

        .btn-success:hover {
            background-color: #15803d;
        }

    .form-input {
        margin-top: 0.25rem;
        display: block;
        width: 100%;
        border-radius: 0.375rem;
        border: 1px solid #d1d5db;
        padding: 0.5rem;
    }

    .form-label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        color: #374151;
    }
</style>


@code {
    private const string ApiBaseUrl = "api/reports";

    // --- State Variables ---
    private string sessionToken = "";
    private string resultJson = "Los resultados de las operaciones aparecerán aquí...";
    private int reportIdForAction;
    private int reportIdToExecute;

    // --- Lifecycle and Data Loading ---
    protected override async Task OnInitializedAsync()
    {
        await LoadTokenFromLocalStorage();
    }

    private async Task LoadTokenFromLocalStorage()
    {
        try { sessionToken = await LocalStorage.GetItemAsync<string>("authToken") ?? ""; } catch { }
        StateHasChanged();
    }

    // --- Action Handlers ---
    private async Task HandleCreateJoin()
    {
        if (string.IsNullOrWhiteSpace(sessionToken)) { DisplayResult(new { Error = "Se requiere token." }); return; }

        var testJoin = new CreateJoinRequestDto
        {
            Name = "Join de Prueba - Devices",
            JoinType = JoinType.Inner,
            LeftOperand = new JoinOperandDto { ModuleType = ModuleType.InsightMonitor, DatasetId = 3, EntityName = EntityName.Device, JoinPropertyName = "Id"},
            RightOperand = new JoinOperandDto { ModuleType = ModuleType.InsightMonitor, DatasetId = 3, EntityName = EntityName.Device, JoinPropertyName = "Id"}
        };

        await PostRequest($"{ApiBaseUrl}/joins?token={sessionToken}", testJoin, "Join de Prueba Creado");
    }

    private async Task HandleListJoins()
    {
        await GetRequest($"{ApiBaseUrl}/joins/by-user?token={sessionToken}", "Lista de Joins");
    }

    private async Task HandleCreateReport()
    {
        var testReport = new CreateReportRequestDto
        {
            Name = "Reporte de Prueba General",
            Username = "admin",
            JSON_config = "{ \"sources\": [] }"
        };

        await PostRequest(ApiBaseUrl, testReport, "Reporte de Prueba Creado");
    }

    private async Task HandleListReports()
    {
        await GetRequest($"{ApiBaseUrl}/by-user?token={sessionToken}", "Lista de Reportes");
    }

    // --- FUNCIÓN MODIFICADA ---
    private async Task HandleCreateAndAddJoinToReport()
    {

        // Crea un Join de prueba para añadirlo
        var joinToCreateAndAdd = new CreateJoinRequestDto
        {
            Name = $"Join para Reporte {reportIdForAction} - {DateTime.Now.Ticks}",
            JoinType = JoinType.Inner,
            LeftOperand = new JoinOperandDto { ModuleType = ModuleType.InsightMonitor, DatasetId = 3, EntityName = EntityName.Device, JoinPropertyName = "Id" },
            RightOperand = new JoinOperandDto { ModuleType = ModuleType.InsightMonitor, DatasetId = 3, EntityName = EntityName.Device, JoinPropertyName = "Id" }
        };

        // Llama al nuevo endpoint del controlador
        await PostRequest($"{ApiBaseUrl}/2/joins/create-and-add?token={sessionToken}", joinToCreateAndAdd, $"Nuevo Join añadido al Reporte {reportIdForAction}");
    }

    private async Task ExecuteReport()
    {
        await GetRequest($"{ApiBaseUrl}/2/execute?token={sessionToken}", $"Ejecución del Reporte {reportIdToExecute}");
    }

    // --- Generic API Call Helpers ---
    private async Task GetRequest(string url, string successMessage)
    {
        if (string.IsNullOrWhiteSpace(sessionToken)) { DisplayResult(new { Error = "Se requiere token." }); return; }
        try
        {
            var result = await Http.GetFromJsonAsync<object>(url);
            DisplayResult(new { Message = successMessage, Response = result });
        }
        catch (Exception ex) { DisplayResult(new { Error = $"Fallo en GET {url}", ex.Message }); }
    }

    private async Task PostRequest<T>(string url, T payload, string successMessage)
    {
        try
        {
            var response = await Http.PostAsJsonAsync(url, payload);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<object>();
                DisplayResult(new { Message = successMessage, Response = result });
            }
            else { DisplayResult(new { Error = $"Fallo en POST {url}", Details = await response.Content.ReadAsStringAsync() }); }
        }
        catch (Exception ex) { DisplayResult(new { Error = $"Fallo en POST {url}", ex.Message }); }
    }

    private void DisplayResult(object data) => resultJson = JsonSerializer.Serialize(data, new JsonSerializerOptions { WriteIndented = true });

    // --- DTOs and Enums ---
    public class JoinOperandDto { public ModuleType ModuleType { get; set; } public int DatasetId { get; set; } public EntityName EntityName { get; set; } public string JoinPropertyName { get; set; } = ""; }
    public class CreateJoinRequestDto { public string Name { get; set; } = ""; public JoinType JoinType { get; set; } = JoinType.Inner; public JoinOperandDto LeftOperand { get; set; } = new(); public JoinOperandDto RightOperand { get; set; } = new(); }
    public class ReportJoinItemDto { public int CrossModuleJoinId { get; set; } public int ExecutionOrder { get; set; } }
    public class CreateReportRequestDto { [Required] public string Name { get; set; } = ""; public string? Description { get; set; } [Required] public string Username { get; set; } = ""; public string JSON_config { get; set; } = ""; }
    public enum ModuleType { InsightMonitor, UrbanMonitor, EventManager, AssetManager }
    public enum EntityName { Device, Sensor, Source, Group, Event, News, Alert, Resource, Asset, Stock }
    public enum JoinType { Inner, LeftOuter, RightOuter }
}

