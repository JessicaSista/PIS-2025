    protected override async Task OnInitializedAsync()
    {
        JoinDto.ResetIdCounter();

        string? token = null;
        Report? currentReport = null;

        try
        {
            if (ReportId <= 0)
            {
                NavigationManager.NavigateTo("/reportes");
                return;
            }

            token = await LocalStorage.GetItemAsync<string>("authToken");
            if (string.IsNullOrEmpty(token))
            {
                Snackbar.Add("No se encontró el token de autenticación", Severity.Error);
                return;
            }

            await LoadAvailableJoinsAsync(token);

            // Cargar detalles del reporte (nombre/descripcion)
            var reportResp = await Http.GetAsync($"api/reports/{ReportId}?token={token}");
            if (reportResp.IsSuccessStatusCode)
            {
                currentReport = await reportResp.Content.ReadFromJsonAsync<Report>();
                if (currentReport != null)
                {
                    reportName = currentReport.Name ?? string.Empty;
                    reportDescription = currentReport.Description ?? string.Empty;
                }
            }

            // Cargar datasets
            var response = await Http.GetAsync($"api/Dataset/user?token={token}");

            if (response.IsSuccessStatusCode)
            {
                var datasetsFromApi = await response.Content.ReadFromJsonAsync<List<DatasetIM>>();
                
                // Convertir DatasetIM a DatasetDto
                datasets = datasetsFromApi?.Select(d => new DatasetDto
                {
                    Id = d.Id,
                    Nombre = d.Name,
                    Descripcion = d.Description ?? "Sin descripción" // Handle null values
                }).ToList() ?? new List<DatasetDto>();
            }
            else
            {
                Snackbar.Add("Error al cargar los datasets", Severity.Error);
            }

            // Inicializar la lista filtrada
            filteredDatasets = datasets.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar los datos: {ex.Message}", Severity.Error);
        }

        _nextFilterId = 1;

        if (currentReport != null && !string.IsNullOrEmpty(token))
        {
            await RestoreReportConfigurationAsync(currentReport, token);

            if (!string.IsNullOrWhiteSpace(currentReport.JSON_config))
            {
                await ExecuteReportPreviewAsync(token);
            }
        }
    }

