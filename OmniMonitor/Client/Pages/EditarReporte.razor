    // --- Generar JSON de configuración ---
    private async Task GenerarJsonConfig()
    {
        try
        {
            // Tomar columnas visibles
            var visibleColumns = availableColumns.Where(c => c.IsVisible).ToList();

            if (!selectedDatasets.Any())
            {
                Snackbar.Add("Seleccione al menos un dataset antes de guardar.", Severity.Warning);
                return;
            }

            if (!visibleColumns.Any())
            {
                Snackbar.Add("Seleccione al menos una columna visible antes de guardar.", Severity.Warning);
                return;
            }

            var sources = new List<object>();

            var joinGroups = visibleColumns
                .Where(c => c.IsJoin && c.JoinId.HasValue)
                .GroupBy(c => c.JoinId!.Value);

            foreach (var group in joinGroups)
            {
                var columns = group.Select(c =>
                {
                    var alias = string.IsNullOrWhiteSpace(c.DisplayName) ? c.PropertyName : c.DisplayName;
                    var attribute = $"{c.Entity}_{c.PropertyName}";
                    return new Dictionary<string, string>
                    {
                        ["attribute"] = attribute,
                        ["as"] = alias
                    };
                }).ToList();

                sources.Add(new
                {
                    sourceType = "join",
                    sourceId = group.Key,
                    columns
                });
            }

            var datasetGroups = visibleColumns
                .Where(c => !c.IsJoin)
                .GroupBy(c => c.DatasetId);

            foreach (var group in datasetGroups)
            {
                var columns = group.Select(c =>
                {
                    var alias = string.IsNullOrWhiteSpace(c.DisplayName) ? c.PropertyName : c.DisplayName;
                    var attribute = $"{c.Entity}_{c.PropertyName}";
                    return new Dictionary<string, string>
                    {
                        ["attribute"] = attribute,
                        ["as"] = alias
                    };
                }).ToList();

                if (!columns.Any())
                {
                    continue;
                }

                var entity = group.First().Entity;

                sources.Add(new
                {
                    sourceType = "dataset",
                    sourceModule = "InsightMonitor",
                    sourceId = group.Key,
                    entityName = entity.ToString(),
                    columns
                });
            }

            if (!sources.Any())
            {
                Snackbar.Add("No se encontraron columnas visibles para generar el reporte.", Severity.Warning);
                return;
            }

            var payload = new
            {
                sources = sources
            };

            var json = JsonSerializer.Serialize(payload, new JsonSerializerOptions
            {
                WriteIndented = true
            });

            // Guardar en backend (UpdateReport) y luego ejecutar
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (string.IsNullOrEmpty(token))
            {
                Snackbar.Add("No se encontró el token de autenticación", Severity.Error);
                return;
            }

            isSaving = true;
            StateHasChanged();

            var url = $"api/reports/UpdateReport?id={ReportId}&name={Uri.EscapeDataString(reportName ?? string.Empty)}&description={Uri.EscapeDataString(reportDescription ?? string.Empty)}&JSON_config={Uri.EscapeDataString(json)}&token={Uri.EscapeDataString(token)}";
            // No más logs de URL/token
            var putResp = await Http.PutAsync(url, null);
            isSaving = false;

            if (!putResp.IsSuccessStatusCode)
            {
                var err = await putResp.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al guardar el reporte: {putResp.StatusCode}", Severity.Error);
                Logger?.LogWarning("[EditarReporte] UpdateReport falló con estado {StatusCode}. Body: {Body}", putResp.StatusCode, err);
                return;
            }

            Snackbar.Add("Reporte guardado correctamente", Severity.Success);
            Logger?.LogInformation("[EditarReporte] UpdateReport completado correctamente");

            await ExecuteReportPreviewAsync(token);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error generando el JSON: {ex.Message}", Severity.Error);
        }
    }

    private async Task ExecuteReportPreviewAsync(string token)
    {
        try
        {
            isExecuting = true;
            executeRows.Clear();
            executeColumns.Clear();
            StateHasChanged();

            var execUrl = $"api/reports/{ReportId}/execute?id={ReportId}&token={Uri.EscapeDataString(token)}";
            var execResp = await Http.GetAsync(execUrl);
            isExecuting = false;

            if (!execResp.IsSuccessStatusCode)
            {
                var err = await execResp.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al ejecutar el reporte: {execResp.StatusCode}", Severity.Error);
                Logger?.LogWarning("[EditarReporte] ExecuteReport falló con estado {StatusCode}. Body: {Body}", execResp.StatusCode, err);
                return;
            }

            var execText = await execResp.Content.ReadAsStringAsync();

            try
            {
                using var doc = JsonDocument.Parse(execText);
                if (doc.RootElement.ValueKind == JsonValueKind.Array)
                {
                    var columns = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    foreach (var el in doc.RootElement.EnumerateArray())
                    {
                        if (el.ValueKind != JsonValueKind.Object)
                        {
                            continue;
                        }

                        var row = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
                        foreach (var prop in el.EnumerateObject())
                        {
                            columns.Add(prop.Name);
                            row[prop.Name] = prop.Value.ValueKind switch
                            {
                                JsonValueKind.String => prop.Value.GetString(),
                                JsonValueKind.Number => prop.Value.ToString(),
                                JsonValueKind.True => "true",
                                JsonValueKind.False => "false",
                                JsonValueKind.Null => null,
                                _ => prop.Value.ToString()
                            };
                        }
                        executeRows.Add(row);
                    }

                    executeColumns = columns.OrderBy(c => c).ToList();
                }
                else
                {
                    Snackbar.Add("La respuesta de ejecución no es una lista", Severity.Warning);
                }
            }
            catch (Exception ex)
            {
                Logger?.LogError(ex, "[EditarReporte] Error al procesar respuesta de ExecuteReport");
                Snackbar.Add("Error al procesar la respuesta de ejecución", Severity.Error);
            }
            finally
            {
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            isExecuting = false;
            Logger?.LogError(ex, "[EditarReporte] Error ejecutando vista previa del reporte");
            Snackbar.Add($"Error al ejecutar el reporte: {ex.Message}", Severity.Error);
            StateHasChanged();
        }
    }

