@page "/editarReporte/{ReportId:int}"
@attribute [Authorize]
@using System.Text.Json
@using System.Text.Json.Serialization
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http
@using MudBlazor
@using OmniMonitor.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Datasets> Localizer
@inject ILogger<EditarReporte> Logger



<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">

    <MudStack Class="mb-6">
        <MudText Typo="Typo.h4">@(!string.IsNullOrWhiteSpace(reportName) ? reportName : "Reporte")</MudText>
        <MudGrid Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudItem>
                <MudText Typo="Typo.body1">@(!string.IsNullOrWhiteSpace(reportDescription) ? reportDescription : "Sin descripción")</MudText>
            </MudItem>
            <MudItem>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Share" Size="MudBlazor.Size.Small" Style="border-color: var(--mud-palette-lines-default);">Compartir</MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PictureAsPdf" Size="MudBlazor.Size.Small" Style="border-color: var(--mud-palette-lines-default);">PDF</MudButton>
                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small" Disabled="@isSaving" OnClick="GenerarJsonConfig">
                        @(isSaving ? "Guardando..." : "Guardar Reporte")
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudStack>


    <MudGrid Spacing="4">

        <MudItem Xs="12" Sm="5" Md="4">
            <MudPaper Class="pa-4" Elevation="2" Style="height: 75vh; overflow-y: auto;">
                
                <div class="tab-button-grid mb-4">
                    <MudButton Class="tab-button"
                               Variant="@GetButtonVariant("datasets")"
                               Color="@GetButtonColor("datasets")"
                               OnClick="@(() => SetActiveTab("datasets"))"
                               Style="@GetButtonStyle("datasets")">
                        <div style="display:flex; flex-direction:column; align-items:center;">
                            <MudIcon Icon="@Icons.Material.Filled.Dataset" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Medium" />
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Primary" Class="mt-1" Style="font-weight:bold;">
                                Datasets
                            </MudText>
                        </div>
                    </MudButton>

                    <MudButton Class="tab-button"
                               Variant="@GetButtonVariant("joins")"
                               Color="@GetButtonColor("joins")"
                               OnClick="@(() => SetActiveTab("joins"))"
                               Style="@GetButtonStyle("joins")">
                        <div style="display:flex; flex-direction:column; align-items:center;">
                            <MudIcon Icon="@Icons.Material.Filled.JoinInner" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Medium" />
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Primary" Class="mt-1" Style="font-weight:bold;">
                                Joins
                            </MudText>
                        </div>
                    </MudButton>

                    <MudButton Class="tab-button"
                               Variant="@GetButtonVariant("columnas")"
                               Color="@GetButtonColor("columnas")"
                               OnClick="@(() => SetActiveTab("columnas"))"
                               Style="@GetButtonStyle("columnas")">
                        <div style="display:flex; flex-direction:column; align-items:center;">
                            <MudIcon Icon="@Icons.Material.Filled.ViewColumn" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Medium" />
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Primary" Class="mt-1" Style="font-weight:bold;">
                                Columnas
                            </MudText>
                        </div>
                    </MudButton>

                    <MudButton Class="tab-button"
                               Variant="@GetButtonVariant("filtros")"
                               Color="@GetButtonColor("filtros")"
                               OnClick="@(() => SetActiveTab("filtros"))"
                               Style="@GetButtonStyle("filtros")">
                        <div style="display:flex; flex-direction:column; align-items:center;">
                            <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Medium" />
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Primary" Class="mt-1" Style="font-weight:bold;">
                                Filtros
                            </MudText>
                        </div>
                    </MudButton>
                </div>



                @if (activeTab == "datasets")
                {   
                    <MudText Typo="Typo.h6" Class="mb-2">Datasets Seleccionados</MudText>
                    
                    @if (selectedDatasets.Any())
                    {
                        @foreach (var dataset in selectedDatasets)
                        {
                            <MudCard Outlined="true" Class="mb-4">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.body1">@dataset.Nombre</MudText>
                                        <MudChip T="object" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small">
                                            @(dataset.Descripcion ?? "Sin descripción")
                                        </MudChip>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        <MudIconButton 
                                            Icon="@Icons.Material.Filled.Close" 
                                            Size="MudBlazor.Size.Small"
                                            OnClick="@(() => ToggleDatasetSelection(dataset))" />
                                    </CardHeaderActions>
                                </MudCardHeader>
                                <MudCardContent>
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        <MudText Typo="Typo.caption" Class="mr-2">Entidad</MudText>
                                        <MudSelect T="EntityName" Dense="true" Value="@GetSelectedEntity(dataset.Id)" ValueChanged="@(e => OnEntityChanged(dataset, e))">
                                            @foreach (var e in entityOptions)
                                            {
                                                <MudSelectItem Value="@e">@e.ToString()</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        }
                    }
                    else
                    {
                        <MudText Class="mb-4" Color="MudBlazor.Color.Secondary">No hay datasets seleccionados</MudText>
                    }

                    <MudDivider Class="my-4" />

                    <MudText Typo="Typo.h6" Class="mb-2">Datasets Disponibles</MudText>
                    <MudTextField 
                        T="string" 
                        Value="@searchText"
                        ValueChanged="@(newValue => { searchText = newValue; FilterDatasets(); })"
                        Immediate="true"
                        Placeholder="Buscar Datasets..." 
                        Adornment="Adornment.Start" 
                        AdornmentIcon="@Icons.Material.Filled.Search" 
                        IconSize="MudBlazor.Size.Small" 
                        Class="mb-4" 
                        Variant="Variant.Outlined" 
                        Margin="Margin.Dense" />

                    @if (filteredDatasets.Any(d => !IsSelected(d)))
                    {
                        <MudList T="DatasetDto" Dense="true">
                            @foreach (var dataset in filteredDatasets.Where(d => !IsSelected(d)))
                            {
                                <MudListItem 
                                    T="DatasetDto"
                                    OnClick="@(() => ToggleDatasetSelection(dataset))"
                                    Style="cursor: pointer;">
                                    <MudText>@dataset.Nombre</MudText>
                                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">
                                        @(dataset.Descripcion ?? "Sin descripción")
                                    </MudText>
                                </MudListItem>
                            }
                        </MudList>
                    }
                    else if (!string.IsNullOrWhiteSpace(searchText))
                    {
                        <MudText>No se encontraron datasets que coincidan con la búsqueda</MudText>
                    }
                    else
                    {
                        <MudText>No hay datasets disponibles</MudText>
                    }
                }

                @if (activeTab == "joins")
                {
                    <MudGrid Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudItem>
                            <MudText Typo="Typo.body1">Configurar Joins</MudText>
                        </MudItem>
                        <MudItem>
                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Outlined"
                                            StartIcon="@Icons.Material.Filled.Add"
                                            Size="MudBlazor.Size.Small"
                                            OnClick="AgregarJoin"
                                            Style="border-color: var(--mud-palette-lines-default);">
                                    Agregar Join
                                </MudButton>
                            </MudStack>
                        </MudItem>
                    </MudGrid>

                    <MudStack Spacing="3" Class="mt-4">
                    @if (joins.Count > 0)
                    {
                        @foreach (var join in joins)
                        {
                            <MudPaper @key="join.Id" Class="pa-4" Elevation="1">
                                <MudGrid Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudItem>
                                        <MudText Typo="Typo.subtitle2">Join #@join.Id</MudText>
                                    </MudItem>
                                    <MudItem>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="MudBlazor.Color.Error"
                                                    OnClick="@(() => EliminarJoin(join))" />
                                    </MudItem>
                                </MudGrid>

                                <MudGrid Spacing="2" Class="mt-2">
                                    <MudItem Xs="12" Sm="6">
                                        <MudSelect T="string" Label="Dataset Izquierdo" Value="@join.LeftDataset"
                                                  ValueChanged="@(value => { join.LeftDataset = value; UpdateJoinFields(join); })">
                                            @foreach (var dataset in selectedDatasets)
                                            {
                                                <MudSelectItem Value="@dataset.Nombre">@dataset.Nombre</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>

                                    <MudItem Xs="12" Sm="6">
                                        <MudSelect T="string" Label="Campo de Unión (Izquierdo)" @bind-Value="join.LeftField">
                                            @if (!string.IsNullOrEmpty(join.LeftDataset))
                                            {
                                                var leftProps = GetEntityPropertyNamesForDatasetName(join.LeftDataset);
                                                foreach (var p in leftProps)
                                                {
                                                    <MudSelectItem Value="@p">@p</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                    </MudItem>

                                    <MudItem Xs="12" Sm="6">
                                        <MudSelect T="string" Label="Tipo de Comparación" @bind-Value="join.Comparison">
                                            <MudSelectItem Value="@("Equal")">Igual a (=)</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>

                                    <MudItem Xs="12" Sm="6">
                                        <MudSelect T="string" Label="Tipo de Join" @bind-Value="join.JoinType">
                                            <MudSelectItem Value="@("Inner")">Inner Join</MudSelectItem>
                                            <MudSelectItem Value="@("LeftOuter")">Left Outer</MudSelectItem>
                                            <MudSelectItem Value="@("RightOuter")">Right Outer</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>

                                    <MudItem Xs="12" Sm="6">
                                        <MudSelect T="string" Label="Dataset Derecho" Value="@join.RightDataset"
                                                  ValueChanged="@(value => { join.RightDataset = value; UpdateJoinFields(join); })">
                                            @foreach (var dataset in selectedDatasets.Where(d => d.Nombre != join.LeftDataset))
                                            {
                                                <MudSelectItem Value="@dataset.Nombre">@dataset.Nombre</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>

                                    <MudItem Xs="12" Sm="6">
                                        <MudSelect T="string" Label="Campo de Unión (Derecho)" @bind-Value="join.RightField">
                                            @if (!string.IsNullOrEmpty(join.RightDataset))
                                            {
                                                var rightProps = GetEntityPropertyNamesForDatasetName(join.RightDataset);
                                                foreach (var p in rightProps)
                                                {
                                                    <MudSelectItem Value="@p">@p</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                    </MudItem>
                                </MudGrid>

                                
                            </MudPaper>
                        }
                    }
                    </MudStack>
                    @if (joins.Any())
                    {
                        <MudButton 
                            Variant="Variant.Filled" 
                            Color="MudBlazor.Color.Primary" 
                            OnClick="AplicarJoins" 
                            Class="mt-4">
                            Aplicar Joins
                        </MudButton>
                    }
                }
                @if (activeTab == "columnas")
                {
                    <MudToolBar Dense="true" DisableGutters="true" Class="mb-4">
                        <MudText Typo="Typo.body1">Columnas a mostrar</MudText>
                        <MudSpacer />
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Outlined"
                                    Size="MudBlazor.Size.Small"
                                    OnClick="SelectAllColumns"
                                    Style="border-color: var(--mud-palette-lines-default);">
                                Todas
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                    Size="MudBlazor.Size.Small"
                                    OnClick="DeselectAllColumns"
                                    Style="border-color: var(--mud-palette-lines-default);">
                                Ninguna
                            </MudButton>
                        </MudStack>
                    </MudToolBar>

                    <MudPaper Class="pa-4 mb-4" Elevation="1">
                        @if (selectedDatasets.Any())
                        {
                            if (HasJoinColumns)
                            {
                                foreach (var join in joins.Where(j => j.ServerJoinId.HasValue))
                                {
                                    var joinName = GetJoinDisplayName(join.ServerJoinId!.Value);
                                    var columnsForJoin = availableColumns
                                        .Where(c => c.DatasetName == joinName)
                                        .ToList();

                                    if (!columnsForJoin.Any())
                                    {
                                        continue;
                                    }

                                    <MudText Typo="Typo.h6" Class="mb-2 mt-4">@joinName</MudText>
                                    <MudGrid Spacing="2">
                                        @foreach (var column in columnsForJoin)
                                        {
                                            <MudItem Xs="12" Sm="12" Md="12">
                                                <MudCheckBox T="bool"
                                                             Label="@column.DisplayName"
                                                             Checked="@column.IsVisible"
                                                             @onclick="@(() => ToggleColumnVisibility(column))"
                                                             Dense="true" />
                                            </MudItem>
                                        }
                                    </MudGrid>
                                }
                            }
                            else
                            {
                                foreach (var dataset in selectedDatasets)
                                {
                                    var columnsForDataset = availableColumns
                                        .Where(c => c.DatasetName == dataset.Nombre)
                                        .ToList();

                                    if (!columnsForDataset.Any())
                                    {
                                        continue;
                                    }

                                    <MudText Typo="Typo.h6" Class="mb-2 mt-4">@dataset.Nombre</MudText>
                                    <MudGrid Spacing="2">
                                        @foreach (var column in columnsForDataset)
                                        {
                                            <MudItem Xs="12" Sm="12" Md="12">
                                                <MudCheckBox T="bool"
                                                             Label="@column.DisplayName"
                                                             Checked="@column.IsVisible"
                                                             @onclick="@(() => ToggleColumnVisibility(column))"
                                                             Dense="true" />
                                            </MudItem>
                                        }
                                    </MudGrid>
                                }
                            }
                        }

                        else
                        {
                            <MudText>Selecciona al menos un dataset para ver las columnas disponibles</MudText>
                        }
                    </MudPaper>
                }

                @if (activeTab == "filtros")
                {
                    <MudGrid Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudItem>
                            <MudText Typo="Typo.body1">Filtros por columna</MudText>
                        </MudItem>
                        <MudItem>
                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Outlined"
                                            StartIcon="@Icons.Material.Filled.Add"
                                            Size="MudBlazor.Size.Small"
                                            OnClick="AgregarFiltro"
                                            Style="border-color: var(--mud-palette-lines-default);">
                                    Agregar Filtro
                                </MudButton>
                            </MudStack>
                        </MudItem>
                    </MudGrid>

                    <MudStack Spacing="3" Class="mt-4">
                    @if (filters.Count > 0)
                    {
                        @foreach (var filter in filters)
                        {
                            <MudPaper @key="filter.Id" Class="pa-4" Elevation="1">
                                <MudGrid Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudItem>
                                        <MudText Typo="Typo.subtitle2">Filtro #@filter.Id</MudText>
                                    </MudItem>
                                    <MudItem>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="MudBlazor.Color.Error"
                                                    OnClick="@(() => EliminarFiltro(filter))" />
                                    </MudItem>
                                </MudGrid>

                                <MudGrid Spacing="2" Class="mt-2">
                                     <MudItem Xs="12" Sm="6">
                                        <MudSelect T="string" Label="Columna" @bind-Value="filter.Column" PopoverClass="wider-popover">
                                            @foreach (var column in availableColumns.Where(c => c.IsVisible))
                                            {
                                                <MudSelectItem Value="@column.Name">@column.DisplayName</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>

                                    <MudItem Xs="12" Sm="6">
                                        <MudSelect T="string" Label="Operador" @bind-Value="filter.Operator">
                                            <MudSelectItem Value="@("=")">Igual a (=)</MudSelectItem>
                                            <MudSelectItem Value="@(">")">Mayor a (&gt;)</MudSelectItem>
                                            <MudSelectItem Value="@("<")">Menor a (&lt;)</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>

                                    <MudItem Xs="12">
                                        <MudTextField T="string" Label="Valor" @bind-Value="filter.Value" Clearable="true" />
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        }
                    }
                    </MudStack>
                }
            </MudPaper>
        </MudItem>

        <MudItem Xs="12" Sm="7" Md="8">
            <MudPaper Class="pa-4" Elevation="2" Style="height: 75vh; overflow:auto;">
                @if (isExecuting)
                {
                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height:100%">
                        <MudProgressCircular Color="MudBlazor.Color.Primary" />
                        <MudText Class="mt-2">Ejecutando reporte...</MudText>
                    </MudStack>
                }
                else if (executeRows.Any())
                {
                    <MudTable Items="@executeRows" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>#</MudTh>
                            @foreach (var col in executeColumns)
                            {
                                <MudTh>@col</MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="#">@(executeRows.IndexOf(context) + 1)</MudTd>
                            @foreach (var col in executeColumns)
                            {
                                <MudTd DataLabel="@col">@((context.TryGetValue(col, out var val) ? val : null))</MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.h6" Color="MudBlazor.Color.Secondary">
                        Vista previa
                    </MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    public class ColumnDefinition
    {
        public string Name { get; set; } = string.Empty; // Initialize to avoid null
        public string DisplayName { get; set; } = string.Empty; // Initialize to avoid null
        public string DatasetName { get; set; } = string.Empty; // Initialize to avoid null
        public bool IsVisible { get; set; } = false;
        public int DatasetId { get; set; }
        public EntityName Entity { get; set; } = EntityName.Device;
        public string PropertyName { get; set; } = string.Empty;
        public bool IsJoin { get; set; }
        public int? JoinId { get; set; }
    }

    private List<ColumnDefinition> availableColumns = new();

    private readonly EntityName[] entityOptions = new[] { EntityName.Device, EntityName.Source, EntityName.Group, EntityName.Sensor };

    [Parameter]
    public int ReportId { get; set; }
    private static int _nextFilterId = 1;
    private int currentPage = 1;
    private const int pageSize = 10; 
    private Dictionary<int, DatasetIM> selectedDatasetsIM = new();
    private Dictionary<int, EntityName> selectedEntities = new();
    private List<DatasetDto> selectedDatasets = new();
    private List<DatasetDto> datasets = new();
    private List<DatasetDto> filteredDatasets = new();
    private string reportName = string.Empty;
    private string reportDescription = string.Empty;
    private bool isSaving = false;
    private bool isExecuting = false;
    private List<Dictionary<string, string?>> executeRows = new();
    private List<string> executeColumns = new();
    private List<CrossModuleJoinDto> userJoins = new();
    private bool HasJoinColumns => availableColumns.Any(c => c.IsJoin);
    
    private async Task ToggleDatasetSelection(DatasetDto dataset)
    {
        try
        {
            if (selectedDatasets.Any(d => d.Id == dataset.Id))
            {
                // If removing a dataset, clear any joins that reference it
                var joinsToRemove = joins
                    .Where(j => j.LeftDataset == dataset.Nombre || j.RightDataset == dataset.Nombre)
                    .ToList();
                
                foreach (var join in joinsToRemove)
                {
                    joins.Remove(join);
                }
                
                selectedDatasets.RemoveAll(d => d.Id == dataset.Id);
                selectedDatasetsIM.Remove(dataset.Id);
                
                if (!selectedDatasets.Any())
                {
                    availableColumns.Clear();
                    filters.Clear();
                }
                else if (activeTab == "columnas")
                {
                    UpdateAvailableColumns();
                }
            }
            else
            {
                selectedDatasets.Add(dataset);

                // Cargar detalles del dataset (opcional) para soporte de columnas/joins
                var token = await LocalStorage.GetItemAsync<string>("authToken");
                var responseDataset = !string.IsNullOrEmpty(token)
                    ? await Http.GetAsync($"api/Dataset/GetDataset?datasetId={dataset.Id}&token={token}")
                    : null;

                if (responseDataset != null && responseDataset.IsSuccessStatusCode)
                {
                    var datasetIM = await responseDataset.Content.ReadFromJsonAsync<DatasetIM>();
                    if (datasetIM != null)
                    {
                        selectedDatasetsIM[dataset.Id] = datasetIM;
                    }
                }
            }
            FilterDatasets();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar el dataset: {ex.Message}", Severity.Error);
            Logger?.LogError(ex, "ToggleDatasetSelection error");
        }
        finally
        {
            StateHasChanged();
        }

    }


    private bool IsSelected(DatasetDto dataset)
    {
        return selectedDatasets.Any(d => d.Id == dataset.Id);
    }

    private string _searchText = string.Empty;

    private string searchText
    {
        get => _searchText;
        set
        {
            _searchText = value ?? string.Empty;
            FilterDatasets();
        }
    }

    private void FilterDatasets()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredDatasets = datasets.ToList();
            return;
        }

        var normalizedSearch = NormalizeText(searchText);

        filteredDatasets = datasets
            .Where(d => NormalizeText(d.Nombre).Contains(normalizedSearch))
            .OrderByDescending(d => NormalizeText(d.Nombre) == normalizedSearch) 
            .ThenByDescending(d => NormalizeText(d.Nombre).StartsWith(normalizedSearch)) 
            .ThenBy(d => NormalizeText(d.Nombre).IndexOf(normalizedSearch)) 
            .ThenBy(d => d.Nombre) 
            .ToList();
    }

    private string NormalizeText(string text)
    {
        if (string.IsNullOrEmpty(text))
            return string.Empty;

        var formD = text.Trim().ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD);
        var withoutDiacritics = new string(formD.Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark).ToArray());

        withoutDiacritics = withoutDiacritics
            .Replace(" ", string.Empty)
            .Replace("ñ", "n")
            .Replace("₀", "0").Replace("₁", "1").Replace("₂", "2").Replace("₃", "3").Replace("₄", "4")
            .Replace("₅", "5").Replace("₆", "6").Replace("₇", "7").Replace("₈", "8").Replace("₉", "9");

        return withoutDiacritics.Normalize(System.Text.NormalizationForm.FormC);
    }

    public class JoinDto
    {
        private static int nextId = 1;
        public int Id { get; set; }
        // ID del join creado en el backend (CrossModuleJoin.Id). Null si aún no fue persistido
        public int? ServerJoinId { get; set; }
        public string LeftDataset { get; set; } = "Dataset 1";
        public string LeftField { get; set; } = "ID";
