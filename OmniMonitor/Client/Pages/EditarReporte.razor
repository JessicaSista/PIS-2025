    private IEnumerable<string> GetEntityPropertyNamesForDatasetName(string datasetName)
    {
        var ds = selectedDatasets.FirstOrDefault(d => d.Nombre == datasetName);
        if (ds == null) return Enumerable.Empty<string>();
        var entity = GetSelectedEntity(ds.Id);
        return GetEntityPropertyNames(entity);
    }

    private static IEnumerable<string> GetEntityPropertyNames(EntityName entity)
    {
        Type? t = entity switch
        {
            EntityName.Device => typeof(Device),
            EntityName.Source => typeof(Source),
            EntityName.Group => typeof(DeviceGroup),
            EntityName.Sensor => typeof(Sensor),
            _ => null
        };

        if (t == null) return Array.Empty<string>();

        // Tomar propiedades públicas simples (excluir colecciones complejas)
        return t.GetProperties(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance)
            .Where(p => IsSimplePropertyType(p.PropertyType))
            .Select(p => p.Name)
            .ToList();
    }

    private static bool IsSimplePropertyType(Type type)
    {
        if (type.IsGenericType && typeof(System.Collections.IEnumerable).IsAssignableFrom(type))
            return false; // excluir listas y colecciones
        if (type == typeof(string)) return true;
        if (type.IsPrimitive) return true;
        if (type == typeof(decimal) || type == typeof(DateTime) || type == typeof(DateTimeOffset)) return true;
        if (Nullable.GetUnderlyingType(type) is Type inner)
            return IsSimplePropertyType(inner);
        return false;
    }

    private void UpdateJoinFields(JoinDto join)
    {
        // Limpiar los campos de unión al cambiar el dataset
        if (string.IsNullOrEmpty(join.LeftDataset) || string.IsNullOrEmpty(join.RightDataset))
        {
            join.LeftField = string.Empty; // Use empty string instead of null
            join.RightField = string.Empty; // Use empty string instead of null
        }
        StateHasChanged();
    }
