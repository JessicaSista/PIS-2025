@page "/user-management"
@using OmniMonitor.Client.Services
@using OmniMonitor.Shared.Dtos
@inject IAuthService AuthService
@inject IAuthorizationService AuthorizationService
@inject ILogger<UserManagement> Logger

<PageTitle>Gestión de Usuarios</PageTitle>

<div class="container mt-4">
    <h2>Gestión de Usuarios</h2>
    
    @if (!AuthService.IsAuthenticated)
    {
        <div class="alert alert-warning">
            <h4>Acceso Requerido</h4>
            <p>Debes iniciar sesión para acceder a esta página.</p>
            <a href="/login" class="btn btn-primary">Iniciar Sesión</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <h3>Información del Usuario Actual</h3>
                <div class="card">
                    <div class="card-body">
                        <p><strong>Usuario:</strong> @AuthService.CurrentUser?.Username</p>
                        <p><strong>Roles:</strong> @string.Join(", ", AuthService.CurrentUserRoles ?? new List<string>())</p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <h3>Permisos del Usuario</h3>
                <div class="card">
                    <div class="card-body">
                        @if (userPermissions != null)
                        {
                            @foreach (var permission in userPermissions)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span>@permission.Name</span>
                                    <span class="badge bg-success">@permission.Description</span>
                                </div>
                            }
                        }
                        else
                        {
                            <p>Cargando permisos...</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <h3>Funcionalidades Disponibles</h3>
                
                <!-- Ver usuarios - Solo administradores -->
                <RequirePermission PermissionName="Ver Usuarios">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Ver Usuarios</h5>
                            <p class="card-text">Tienes permiso para ver la lista de usuarios.</p>
                            <button class="btn btn-primary" @onclick="ViewUsers">Ver Usuarios</button>
                        </div>
                    </div>
                </RequirePermission>

                <!-- Crear usuarios - Solo administradores -->
                <RequirePermission PermissionName="Crear Usuarios">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Crear Usuario</h5>
                            <p class="card-text">Tienes permiso para crear nuevos usuarios.</p>
                            <button class="btn btn-success" @onclick="CreateUser">Crear Usuario</button>
                        </div>
                    </div>
                </RequirePermission>

                <!-- Gestionar sensores - Solo administradores -->
                <RequirePermission PermissionName="Configurar Sensores">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Configurar Sensores</h5>
                            <p class="card-text">Tienes permiso para configurar sensores.</p>
                            <button class="btn btn-warning" @onclick="ConfigureSensors">Configurar Sensores</button>
                        </div>
                    </div>
                </RequirePermission>

                <!-- Ver sensores - Todos los usuarios autenticados -->
                <RequirePermission PermissionName="Ver Sensores">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Ver Sensores</h5>
                            <p class="card-text">Tienes permiso para ver datos de sensores.</p>
                            <button class="btn btn-info" @onclick="ViewSensors">Ver Sensores</button>
                        </div>
                    </div>
                </RequirePermission>

                <!-- Funcionalidad solo para administradores usando roles -->
                <RequireRole RoleName="Administrador">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Panel de Administración</h5>
                            <p class="card-text">Solo los administradores pueden ver este panel.</p>
                            <button class="btn btn-danger" @onclick="OpenAdminPanel">Abrir Panel de Admin</button>
                        </div>
                    </div>
                </RequireRole>

                <!-- Funcionalidad solo para visitantes -->
                <RequireRole RoleName="Visitante">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Panel de Visitante</h5>
                            <p class="card-text">Solo los visitantes pueden ver este panel.</p>
                            <button class="btn btn-secondary" @onclick="OpenVisitorPanel">Abrir Panel de Visitante</button>
                        </div>
                    </div>
                </RequireRole>
            </div>
        </div>
    }
</div>

@code {
    private List<Permission>? userPermissions;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated)
        {
            await LoadUserPermissions();
        }
    }

    private async Task LoadUserPermissions()
    {
        try
        {
            userPermissions = await AuthorizationService.GetUserPermissionsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando permisos del usuario");
        }
    }

    private void ViewUsers()
    {
        // Implementar lógica para ver usuarios
        Logger.LogInformation("Usuario solicitó ver usuarios");
    }

    private void CreateUser()
    {
        // Implementar lógica para crear usuario
        Logger.LogInformation("Usuario solicitó crear usuario");
    }

    private void ConfigureSensors()
    {
        // Implementar lógica para configurar sensores
        Logger.LogInformation("Usuario solicitó configurar sensores");
    }

    private void ViewSensors()
    {
        // Implementar lógica para ver sensores
        Logger.LogInformation("Usuario solicitó ver sensores");
    }

    private void OpenAdminPanel()
    {
        // Implementar lógica para panel de administración
        Logger.LogInformation("Usuario solicitó abrir panel de administración");
    }

    private void OpenVisitorPanel()
    {
        // Implementar lógica para panel de visitante
        Logger.LogInformation("Usuario solicitó abrir panel de visitante");
    }
}
