@page "/datasets"
@attribute [Authorize]
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http
@using MudBlazor
@using OmniMonitor.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Datasets> Localizer

<PageTitle>Datasets</PageTitle>

    <MudStack Row Justify="Justify.SpaceBetween" Class="mt-2 mx-4">
        <MudStack>
            <MudText Typo="Typo.h4" Style=" font-weight: 500; font-family: Inter, Roboto, sans-serif;">Datasets</MudText>
        </MudStack>
        <AddButton OnClick="CrearDataset">
            @Localizer["CrearDataset"]
        </AddButton>
    </MudStack>
    <MudStack Justify="Justify.SpaceBetween" Class="mx-4">
        <MudText Typo="Typo.body1" Class="mb-4" Style="color: #a5a8b5; font-family: Inter, Roboto, sans-serif;">@Localizer["Gestiona"]</MudText>
    </MudStack>


<MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 ml-4 mr-6">
    <MudTextField @bind-Value="searchText"
                  Immediate="true"
                  Placeholder="@Localizer["Buscar"]"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="flex-grow-1 mr-3" />

    <MudButton Variant="Variant.Outlined"
               Color="MudBlazor.Color.Secondary"
               StartIcon="@Icons.Material.Filled.FilterList"
               Class="filter-button">
        <span class="button-text-filter">@Localizer["Filtros"]</span>
    </MudButton>
</MudStack>

<style>
    @@media (max-width: 768px) {
        .button-text-filter {
            display: none !important;
            width: 0 !important;
            padding: 0 !important;
            margin: 0 !important;
        }
 
        .filter-button .mud-button-icon-start,
        .filter-button .mud-button-icon-start svg {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            margin: 0 auto !important;
        }
    }
</style>

<MudContainer Fixed="true" Class="pl-4 pr-6">
    <MudGrid GutterSize="3">
        @foreach (var dataset in filteredDatasets)
        {
            <MudItem xs="12" sm="6" md="4">
                <div style="position: relative;">
                    <DatasetCardComponent Dataset="dataset"
                                          Description="@dataset.Descripcion"
                                          OnClick="@(() => EditarDataset(dataset))" />

                    <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                             AnchorOrigin="Origin.TopRight"
                             TransformOrigin="Origin.TopRight"
                             Class="position-absolute"
                             Style="position:absolute; top:8px; right:8px;">

                        <MudMenuItem OnClick="@(() => EditarDataset(dataset))">
                            @Localizer["Editar"]
                        </MudMenuItem>

                        <MudMenuItem OnClick="@(() => ConfirmEliminar(dataset))">
                            @Localizer["Eliminar"]
                        </MudMenuItem>
                    </MudMenu>
                </div>
            </MudItem>
        }
    </MudGrid>
</MudContainer>



@code {
    private List<DatasetDto> datasets = new();
    private List<DatasetDto> filteredDatasets = new();

    // Propiedad con setter que dispara la búsqueda en el backend
    private string _searchText = string.Empty;
    private string searchText
    {
        get => _searchText;
        set
        {
            _searchText = value ?? string.Empty;
            _ = Task.Run(async () => await SearchDatasets());
        }
    }

    private void EditarDataset(DatasetDto dataset)
    {
        if (dataset is null) return;
        NavigationManager.NavigateTo($"/editarDataset/{dataset.Id}");
    }

    private async Task ConfirmEliminar(DatasetDto dataset)
    {
        if (dataset is null) return;
        var titulo = Localizer["Confirmación"];
        var mensaje = (MarkupString)string.Format(
            Localizer["PreguntaEliminar1"],
            $"<b>{dataset.Nombre}</b>"
        );

        bool? result = await DialogService.ShowMessageBox(
            titulo,
            mensaje,
            yesText: Localizer["Eliminar"],
            cancelText: Localizer["Cancelar"],
            options: new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall }
        );

        if (result == true)
        {
            try
            {
                // Obtener el usuario actual
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var username = authState.User.Identity?.Name;

                if (string.IsNullOrEmpty(username))
                {
                    Snackbar.Add(Localizer["ErrorUsuario"], Severity.Warning);
                    return;
                }

                // Eliminar desde el backend
                var response = await Http.DeleteAsync($"api/Dataset/{dataset.Id}/{username}");
                if (response.IsSuccessStatusCode)
                {
                    // Recargar la lista de datasets desde el backend
                    await LoadDatasets();
                    Snackbar.Add($"'{dataset.Nombre}' { Localizer["Eliminado"]}", Severity.Success, config =>
                    {
                        config.SnackbarVariant = Variant.Filled;
                    });
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"{Localizer["ErrorEliminar"]} {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"{Localizer["ErrorEliminar"]} {ex.Message}", Severity.Error);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Obtener el usuario actual de la sesión
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;

            Console.WriteLine($"DEBUG: Username obtenido: '{username}'");

            if (string.IsNullOrEmpty(username))
            {
                Snackbar.Add(@Localizer["ErrorUsuario"] , Severity.Warning);
                filteredDatasets = new List<DatasetDto>();
                return;
            }

            // Cargar datasets iniciales desde el backend (sin filtro)
            await LoadDatasets();

            // Mostrar snackbar si viene mensaje por query string
            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
            if (!string.IsNullOrEmpty(uri.Query))
            {
                var query = uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
                foreach (var q in query)
                {
                    var kv = q.Split('=', 2);
                    if (kv.Length == 2 && kv[0] == "snackbar")
                    {
                        var mensaje = Uri.UnescapeDataString(kv[1]);
                        Snackbar.Add(mensaje, Severity.Success, config =>
                        {
                            config.SnackbarVariant = Variant.Filled;
                            config.Action = "OK";
                            config.ActionColor = MudBlazor.Color.Primary;
                        });
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Localizer["ErrorInicializar"]} {ex.Message}", Severity.Error);
            datasets = new List<DatasetDto>();
            filteredDatasets = new List<DatasetDto>();
        }
    }

    private async Task LoadDatasets()
    {
        try
        {
            // Obtener el usuario actual de la sesión
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;

            if (string.IsNullOrEmpty(username))
            {
                Snackbar.Add(@Localizer["ErrorUsuario"], Severity.Warning);
                filteredDatasets = new List<DatasetDto>();
                return;
            }

            // Cargar datasets desde el backend
            var response = await Http.GetAsync($"api/Dataset/user/{username}");
            
            Console.WriteLine($"DEBUG: Status Code: {response.StatusCode}");
            
            if (response.IsSuccessStatusCode)
            {
                var datasetsFromApi = await response.Content.ReadFromJsonAsync<List<Dataset>>();
                
                Console.WriteLine($"DEBUG: Datasets recibidos: {datasetsFromApi?.Count ?? 0}");
                
                // Convertir Dataset a DatasetDto
                datasets = datasetsFromApi?.Select(d => new DatasetDto
                {
                    Id = d.Id,
                    Nombre = d.Name,
                    Descripcion = d.Description
                }).ToList() ?? new List<DatasetDto>();

                filteredDatasets = datasets.ToList();
                StateHasChanged();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"DEBUG: Error response: {errorContent}");
                Snackbar.Add($"{Localizer["ErrorCarga"]} {response.StatusCode}", Severity.Error);
                
                datasets = new List<DatasetDto>();
                filteredDatasets = new List<DatasetDto>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Localizer["ErrorCarga"]} {ex.Message}", Severity.Error);
            datasets = new List<DatasetDto>();
            filteredDatasets = new List<DatasetDto>();
        }
    }

    private async Task SearchDatasets()
    {
        try
        {
            // Obtener el usuario actual de la sesión
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;

            if (string.IsNullOrEmpty(username))
            {
                return;
            }

            // Construir URL con parámetro de búsqueda
            var url = $"api/Dataset/user/{username}";
            if (!string.IsNullOrWhiteSpace(searchText))
            {
                url += $"?search={Uri.EscapeDataString(searchText)}";
            }

            // Realizar búsqueda en el backend
            var response = await Http.GetAsync(url);
            
            if (response.IsSuccessStatusCode)
            {
                var datasetsFromApi = await response.Content.ReadFromJsonAsync<List<Dataset>>();
                
                // Convertir Dataset a DatasetDto
                filteredDatasets = datasetsFromApi?.Select(d => new DatasetDto
                {
                    Id = d.Id,
                    Nombre = d.Name,
                    Descripcion = d.Description
                }).ToList() ?? new List<DatasetDto>();

                // Invocar StateHasChanged en el contexto de la UI
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"DEBUG: Error en búsqueda: {errorContent}");
                Snackbar.Add($"{Localizer["ErrorCarga"]} {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Localizer["ErrorCarga"]} {ex.Message}", Severity.Error);
        }
    }


    private void CrearDataset()
    {
        NavigationManager.NavigateTo("/crearDataset");
    }

   
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (datasets.Count > 0)
        {
            await JS.InvokeVoidAsync("equalizeCardHeights");
        }
    }
}
