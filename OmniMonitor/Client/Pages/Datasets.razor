@page "/datasets"
@attribute [Authorize]
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http
@using MudBlazor
@using OmniMonitor.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Datasets> Localizer

<PageTitle>Datasets</PageTitle>

    <MudStack Row Justify="Justify.SpaceBetween" Class="mt-2 mx-4">
        <MudStack>
            <MudText Typo="Typo.h4" Style=" font-weight: 500; font-family: Inter, Roboto, sans-serif;">Datasets</MudText>
        </MudStack>
        <AddButton OnClick="CrearDataset">
            @Localizer["CrearDataset"]
        </AddButton>
    </MudStack>
    <MudStack Justify="Justify.SpaceBetween" Class="mx-4">
        <MudText Typo="Typo.body1" Class="mb-4" Style="color: #a5a8b5; font-family: Inter, Roboto, sans-serif;">@Localizer["Gestiona"]</MudText>
    </MudStack>


<MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 ml-4 mr-6">
    <MudTextField @bind-Value="searchText"
                  Immediate="true"
                  Placeholder="@Localizer["Buscar"]"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="flex-grow-1 mr-3" />
    <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Secondary" StartIcon="@Icons.Material.Filled.FilterList">
        @Localizer["Filtros"]
    </MudButton>
</MudStack>

<MudContainer Fixed="true" Class="pl-4 pr-6">
    <MudGrid GutterSize="3">
        @foreach (var dataset in filteredDatasets)
        {
            <MudItem xs="12" sm="6" md="4">
                <div style="position: relative;">
                    <DatasetCardComponent
                        Dataset="dataset"
                        Description="@dataset.Descripcion"
                        OnClick="@(() => EditarDataset(dataset))" />

                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.TopRight"
                             Class="position-absolute" Style="position:absolute; top:8px; right:8px;">
                        <MudMenuItem OnClick="@(() => EditarDataset(dataset))">Editar</MudMenuItem>
                        <MudMenuItem OnClick="@(() => ConfirmEliminar(dataset))">Eliminar</MudMenuItem>
                    </MudMenu>
                </div>
            </MudItem>
        }
    </MudGrid>
</MudContainer>


@code {
    private List<DatasetDto> datasets = new();
    private List<DatasetDto> filteredDatasets = new();

    // Propiedad con setter que dispara el filtrado
    private string _searchText = string.Empty;
    private string searchText
    {
        get => _searchText;
        set
        {
            _searchText = value ?? string.Empty;
            FilterDatasets();
        }
    }

    private void EditarDataset(DatasetDto dataset)
    {
        if (dataset is null) return;
        NavigationManager.NavigateTo($"/editarDataset/{dataset.Id}");
    }

    private async Task ConfirmEliminar(DatasetDto dataset)
    {
        if (dataset is null) return;
        bool? result = await DialogService.ShowMessageBox(
            "Confirmación",
            (MarkupString)$"¿Eliminar '<b>{dataset.Nombre}</b>' Dataset?",
            yesText: "Eliminar",
            cancelText: "Cancelar",
            options: new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall }
        );

        if (result == true)
        {
            try
            {
                // Obtener el usuario actual
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var username = authState.User.Identity?.Name;

                if (string.IsNullOrEmpty(username))
                {
                    Snackbar.Add("No se pudo obtener el usuario actual", Severity.Warning);
                    return;
                }

                // Eliminar desde el backend
                var response = await Http.DeleteAsync($"api/Dataset/{dataset.Id}/{username}");
                if (response.IsSuccessStatusCode)
                {
                    datasets.RemoveAll(d => d.Id == dataset.Id);
                    filteredDatasets.RemoveAll(d => d.Id == dataset.Id);
                    Snackbar.Add($"Dataset '{dataset.Nombre}' eliminado", Severity.Success, config =>
                    {
                        config.SnackbarVariant = Variant.Filled;
                    });
                    StateHasChanged();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Error al eliminar: {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al eliminar el dataset: {ex.Message}", Severity.Error);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Obtener el usuario actual de la sesión
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;

            Console.WriteLine($"DEBUG: Username obtenido: '{username}'");

            if (string.IsNullOrEmpty(username))
            {
                Snackbar.Add("No se pudo obtener el usuario actual", Severity.Warning);
                filteredDatasets = new List<DatasetDto>();
                return;
            }

            // Cargar datasets desde el backend
            var response = await Http.GetAsync($"api/Dataset/user/{username}");
            
            // ⬇️ AGREGAR AQUÍ
            Console.WriteLine($"DEBUG: Status Code: {response.StatusCode}");
            
            if (response.IsSuccessStatusCode)
            {
                var datasetsFromApi = await response.Content.ReadFromJsonAsync<List<Dataset>>();
                
                // ⬇️ AGREGAR AQUÍ
                Console.WriteLine($"DEBUG: Datasets recibidos: {datasetsFromApi?.Count ?? 0}");
                
                // Convertir Dataset a DatasetDto
                datasets = datasetsFromApi?.Select(d => new DatasetDto
                {
                    Id = d.Id,
                    Nombre = d.Name,
                    Descripcion = d.Description
                }).ToList() ?? new List<DatasetDto>();
            }
            else
            {
                // ⬇️ REEMPLAZAR estas 2 líneas
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"DEBUG: Error response: {errorContent}");
                Snackbar.Add($"Error al cargar los datasets: {response.StatusCode}", Severity.Error);
                // ⬆️ Por esta línea antigua: Snackbar.Add("Error al cargar los datasets", Severity.Error);
                
                datasets = new List<DatasetDto>();
            }


            // Inicializar la lista filtrada
            filteredDatasets = datasets.ToList();

            // Mostrar snackbar si viene mensaje por query string
            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
            if (!string.IsNullOrEmpty(uri.Query))
            {
                var query = uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
                foreach (var q in query)
                {
                    var kv = q.Split('=', 2);
                    if (kv.Length == 2 && kv[0] == "snackbar")
                    {
                        var mensaje = Uri.UnescapeDataString(kv[1]);
                        Snackbar.Add(mensaje, Severity.Success, config =>
                        {
                            config.SnackbarVariant = Variant.Filled;
                            config.Action = "OK";
                            config.ActionColor = MudBlazor.Color.Primary;
                        });
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al inicializar: {ex.Message}", Severity.Error);
            datasets = new List<DatasetDto>();
            filteredDatasets = new List<DatasetDto>();
        }
    }

    private void FilterDatasets()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredDatasets = datasets.ToList();
            return;
        }

        var normalizedSearch = NormalizeText(searchText);

        filteredDatasets = datasets
            .Where(d => NormalizeText(d.Nombre).Contains(normalizedSearch))
            .OrderByDescending(d => NormalizeText(d.Nombre) == normalizedSearch) // exactos primero
            .ThenByDescending(d => NormalizeText(d.Nombre).StartsWith(normalizedSearch)) // luego prefijo
            .ThenBy(d => NormalizeText(d.Nombre).IndexOf(normalizedSearch)) // luego por posición de coincidencia
            .ThenBy(d => d.Nombre) // estable
            .ToList();
    }

    private string NormalizeText(string text)
    {
        if (string.IsNullOrEmpty(text))
            return string.Empty;

        // 1) Normalizar a FormD y remover diacríticos (acentos)
        var formD = text.Trim().ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD);
        var withoutDiacritics = new string(formD.Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark).ToArray());

        // 2) Reemplazos adicionales: espacios fuera, ñ->n, subíndices -> dígitos normales
        withoutDiacritics = withoutDiacritics
            .Replace(" ", string.Empty)
            .Replace("ñ", "n")
            .Replace("₀", "0").Replace("₁", "1").Replace("₂", "2").Replace("₃", "3").Replace("₄", "4")
            .Replace("₅", "5").Replace("₆", "6").Replace("₇", "7").Replace("₈", "8").Replace("₉", "9");

        // 3) Normalizar de vuelta a FormC
        return withoutDiacritics.Normalize(System.Text.NormalizationForm.FormC);
    }


    private void CrearDataset()
    {
        NavigationManager.NavigateTo("/crearDataset");
    }

   
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (datasets.Count > 0)
        {
            await JS.InvokeVoidAsync("equalizeCardHeights");
        }
    }
}
