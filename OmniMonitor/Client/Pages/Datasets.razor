@page "/datasets"
@attribute [Authorize]
@implements IDisposable
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http
@using MudBlazor
@using Blazored.LocalStorage
@using OmniMonitor.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Datasets> Localizer
@inject ILocalStorageService LocalStorage

<PageTitle>Datasets</PageTitle>

    <MudStack Row Justify="Justify.SpaceBetween" Class="mt-2 mx-4">
        <MudStack>
            <MudText Typo="Typo.h4" Style=" font-weight: 500; font-family: Inter, Roboto, sans-serif;">Datasets</MudText>
        </MudStack>
        <AddButton OnClick="CrearDataset">
            @Localizer["CrearDataset"]
        </AddButton>
    </MudStack>
    <MudStack Justify="Justify.SpaceBetween" Class="mx-4">
        <MudText Typo="Typo.body1" Class="mb-4" Style="color: #a5a8b5; font-family: Inter, Roboto, sans-serif;">@Localizer["Gestiona"]</MudText>
    </MudStack>


<MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 ml-4 mr-6">
    <MudTextField @bind-Value="searchText"
                  Immediate="true"
                  Placeholder="@Localizer["Buscar"]"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="flex-grow-1 mr-3" />

    <MudButton Variant="Variant.Outlined"
               Color="MudBlazor.Color.Secondary"
               StartIcon="@Icons.Material.Filled.FilterList"
               Class="filter-button">
        <span class="button-text-filter">@Localizer["Filtros"]</span>
    </MudButton>
</MudStack>

<style>
    @@media (max-width: 768px) {
        .button-text-filter {
            display: none !important;
            width: 0 !important;
            padding: 0 !important;
            margin: 0 !important;
        }
 
        .filter-button .mud-button-icon-start,
        .filter-button .mud-button-icon-start svg {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            margin: 0 auto !important;
        }
    }
</style>

<MudContainer Fixed="true" Class="pl-4 pr-6">
    <MudGrid GutterSize="3">
        @foreach (var dataset in filteredDatasets)
        {
            <MudItem xs="12" sm="6" md="4">
                <div style="position: relative;">
                    <DatasetCardComponent Dataset="dataset"
                                          Description="@dataset.Descripcion"
                                          OnClick="@(() => EditarDataset(dataset))" />

                    <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                             AnchorOrigin="Origin.TopRight"
                             TransformOrigin="Origin.TopRight"
                             Class="position-absolute"
                             Style="position:absolute; top:8px; right:8px;">

                        <MudMenuItem OnClick="@(() => EditarDataset(dataset))">
                            @Localizer["Editar"]
                        </MudMenuItem>

                        <MudMenuItem OnClick="@(() => ConfirmEliminar(dataset))">
                            @Localizer["Eliminar"]
                        </MudMenuItem>
                    </MudMenu>
                </div>
            </MudItem>
        }
    </MudGrid>
</MudContainer>



@code {
    private List<DatasetDto> datasets = new();
    private List<DatasetDto> filteredDatasets = new();
    private System.Threading.Timer? _debounceTimer;

    // Propiedad con setter que dispara el filtrado con debounce
    private string _searchText = string.Empty;
    private string searchText
    {
        get => _searchText;
        set
        {
            _searchText = value ?? string.Empty;
            
            // Cancelar el timer anterior si existe
            _debounceTimer?.Dispose();
            
            // Crear un nuevo timer que ejecutará la búsqueda después de 500ms
            _debounceTimer = new System.Threading.Timer(_ =>
            {
                InvokeAsync(async () => await LoadDatasetsAsync());
            }, null, 500, Timeout.Infinite);
        }
    }

    private void EditarDataset(DatasetDto dataset)
    {
        if (dataset is null) return;
        // Pasar el módulo como parámetro de query para carga más rápida
        NavigationManager.NavigateTo($"/editarDataset/{dataset.Id}?module={Uri.EscapeDataString(dataset.Module)}");
    }

    private async Task ConfirmEliminar(DatasetDto dataset)
    {
        if (dataset is null) return;
        var titulo = Localizer["Confirmación"];
        var mensaje = (MarkupString)string.Format(
            Localizer["PreguntaEliminar1"],
            $"<b>{dataset.Nombre}</b>"
        );

        bool? result = await DialogService.ShowMessageBox(
            titulo,
            mensaje,
            yesText: Localizer["Eliminar"],
            cancelText: Localizer["Cancelar"],
            options: new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall }
        );

        if (result == true)
        {
            try
            {
                // Obtener el usuario actual
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var username = authState.User.Identity?.Name;
                string token = await LocalStorage.GetItemAsync<string>("authToken");

                if (string.IsNullOrEmpty(username))
                {
                    Snackbar.Add(Localizer["ErrorUsuario"], Severity.Warning);
                    return;
                }

                HttpResponseMessage response;
                
                // Eliminar según el módulo
                switch (dataset.Module)
                {
                    case "Insight Monitor":
                        response = await Http.DeleteAsync($"api/Dataset/DeleteDataset?datasetId={dataset.Id}&token={token}");
                        break;
                    case "Asset Manager":
                        response = await Http.DeleteAsync($"api/DatasetAM/{dataset.Id}/{username}");
                        break;
                    case "Urban Monitor":
                        response = await Http.DeleteAsync($"api/DatasetUM/{dataset.Id}/{username}");
                        break;
                    case "Event Manager":
                        response = await Http.DeleteAsync($"api/DatasetEM/{dataset.Id}/{username}");
                        break;
                    default:
                        Snackbar.Add("Módulo desconocido", Severity.Error);
                        return;
                }

                if (response.IsSuccessStatusCode)
                {
                    datasets.RemoveAll(d => d.Id == dataset.Id);
                    filteredDatasets.RemoveAll(d => d.Id == dataset.Id);
                    Snackbar.Add($"'{dataset.Nombre}' { Localizer["Eliminado"]}", Severity.Success, config =>
                    {
                        config.SnackbarVariant = Variant.Filled;
                    });
                    StateHasChanged();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"{Localizer["ErrorEliminar"]} {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"{Localizer["ErrorEliminar"]} {ex.Message}", Severity.Error);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDatasetsAsync();

        // Mostrar snackbar si viene mensaje por query string
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (!string.IsNullOrEmpty(uri.Query))
        {
            var query = uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
            foreach (var q in query)
            {
                var kv = q.Split('=', 2);
                if (kv.Length == 2 && kv[0] == "snackbar")
                {
                    var mensaje = Uri.UnescapeDataString(kv[1]);
                    Snackbar.Add(mensaje, Severity.Success, config =>
                    {
                        config.SnackbarVariant = Variant.Filled;
                        config.Action = "OK";
                        config.ActionColor = MudBlazor.Color.Primary;
                    });
                }
            }
        }
    }

    private async Task LoadDatasetsAsync()
    {
        try
        {
            // Obtener el usuario actual de la sesión
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;
            string token = await LocalStorage.GetItemAsync<string>("authToken");

            Console.WriteLine($"DEBUG: Username obtenido: '{username}'");

            if (string.IsNullOrEmpty(username))
            {
                Snackbar.Add(@Localizer["ErrorUsuario"] , Severity.Warning);
                filteredDatasets = new List<DatasetDto>();
                return;
            }

            var allDatasets = new List<DatasetDto>();

            // 1. Cargar datasets de Insight Monitor
            try
            {
                var urlIM = $"api/Dataset/user?token={Uri.EscapeDataString(token)}";
                if (!string.IsNullOrWhiteSpace(searchText))
                {
                    urlIM += $"&search={Uri.EscapeDataString(searchText)}";
                }

                var responseIM = await Http.GetAsync(urlIM);
                if (responseIM.IsSuccessStatusCode)
                {
                    var datasetsIM = await responseIM.Content.ReadFromJsonAsync<List<DatasetIM>>();
                    allDatasets.AddRange(datasetsIM?.Select(d => new DatasetDto
                    {
                        Id = d.Id,
                        Nombre = d.Name,
                        Descripcion = d.Description,
                        Module = "Insight Monitor"
                    }) ?? new List<DatasetDto>());
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error cargando datasets IM: {ex.Message}");
            }

            // 2. Cargar datasets de Asset Manager
            try
            {
                var urlAM = $"api/DatasetAM/GetAllDatasetAMs?token={Uri.EscapeDataString(token)}";
                var responseAM = await Http.GetAsync(urlAM);
                if (responseAM.IsSuccessStatusCode)
                {
                    var datasetsAM = await responseAM.Content.ReadFromJsonAsync<List<OmniMonitor.Shared.Dtos.DatasetAM>>();
                    var filteredAM = datasetsAM ?? new List<OmniMonitor.Shared.Dtos.DatasetAM>();
                    
                    // Aplicar filtro de búsqueda si existe
                    if (!string.IsNullOrWhiteSpace(searchText))
                    {
                        var normalizedSearch = NormalizeText(searchText);
                        filteredAM = filteredAM.Where(d => NormalizeText(d.Nombre ?? "").Contains(normalizedSearch)).ToList();
                    }
                    
                    allDatasets.AddRange(filteredAM.Select(d => new DatasetDto
                    {
                        Id = d.Id_Dataset,
                        Nombre = d.Nombre,
                        Descripcion = d.Descripcion,
                        Module = "Asset Manager"
                    }));
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error cargando datasets AM: {ex.Message}");
            }

            // 3. Cargar datasets de Urban Monitor
            try
            {
                var urlUM = $"api/DatasetUM/GetAllDatasets?token={Uri.EscapeDataString(token)}";
                var responseUM = await Http.GetAsync(urlUM);
                if (responseUM.IsSuccessStatusCode)
                {
                    var datasetsUM = await responseUM.Content.ReadFromJsonAsync<List<OmniMonitor.Shared.Dtos.DatasetUM>>();
                    var filteredUM = datasetsUM ?? new List<OmniMonitor.Shared.Dtos.DatasetUM>();
                    
                    // Aplicar filtro de búsqueda si existe
                    if (!string.IsNullOrWhiteSpace(searchText))
                    {
                        var normalizedSearch = NormalizeText(searchText);
                        filteredUM = filteredUM.Where(d => NormalizeText(d.Name ?? "").Contains(normalizedSearch)).ToList();
                    }
                    
                    allDatasets.AddRange(filteredUM.Select(d => new DatasetDto
                    {
                        Id = d.Id,
                        Nombre = d.Name,
                        Descripcion = d.Description,
                        Module = "Urban Monitor"
                    }));
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error cargando datasets UM: {ex.Message}");
            }

            // 4. Cargar datasets de Event Manager
            try
            {
                var urlEM = $"api/DatasetEM/GetAllDatasets?token={Uri.EscapeDataString(token)}";
                var responseEM = await Http.GetAsync(urlEM);
                if (responseEM.IsSuccessStatusCode)
                {
                    var datasetsEM = await responseEM.Content.ReadFromJsonAsync<List<OmniMonitor.Shared.Dtos.DatasetEM>>();
                    var filteredEM = datasetsEM ?? new List<OmniMonitor.Shared.Dtos.DatasetEM>();
                    
                    // Aplicar filtro de búsqueda si existe
                    if (!string.IsNullOrWhiteSpace(searchText))
                    {
                        var normalizedSearch = NormalizeText(searchText);
                        filteredEM = filteredEM.Where(d => NormalizeText(d.Name ?? "").Contains(normalizedSearch)).ToList();
                    }
                    
                    allDatasets.AddRange(filteredEM.Select(d => new DatasetDto
                    {
                        Id = d.Id,
                        Nombre = d.Name,
                        Descripcion = d.Description,
                        Module = "Event Manager"
                    }));
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error cargando datasets EM: {ex.Message}");
            }

            datasets = allDatasets;
            filteredDatasets = allDatasets;
            
            Console.WriteLine($"DEBUG: Total datasets cargados: {allDatasets.Count}");

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Localizer["ErrorInicializar"]} {ex.Message}", Severity.Error);
            datasets = new List<DatasetDto>();
            filteredDatasets = new List<DatasetDto>();
        }
    }

    // Método obsoleto - ahora el filtrado se hace en el backend
    // Se mantiene por compatibilidad pero ya no se usa
    private void FilterDatasets()
    {
        // Este método ya no se utiliza porque el filtrado se hace en el backend
        // Se deja vacío para no romper referencias existentes
    }

    // Método de normalización - se mantiene en caso de necesitarse en el futuro
    // pero ahora la normalización se hace en el backend
    private string NormalizeText(string text)
    {
        if (string.IsNullOrEmpty(text))
            return string.Empty;

        var formD = text.Trim().ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD);
        var withoutDiacritics = new string(formD.Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark).ToArray());

        withoutDiacritics = withoutDiacritics
            .Replace(" ", string.Empty)
            .Replace("ñ", "n")
            .Replace("₀", "0").Replace("₁", "1").Replace("₂", "2").Replace("₃", "3").Replace("₄", "4")
            .Replace("₅", "5").Replace("₆", "6").Replace("₇", "7").Replace("₈", "8").Replace("₉", "9");

        return withoutDiacritics.Normalize(System.Text.NormalizationForm.FormC);
    }


    private void CrearDataset()
    {
        NavigationManager.NavigateTo("/crearDataset");
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }

   
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (datasets.Count > 0)
        {
            await JS.InvokeVoidAsync("equalizeCardHeights");
        }
    }
}
