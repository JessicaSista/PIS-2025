@page "/datasets"
@attribute [Authorize]
@implements IDisposable
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http
@using MudBlazor
@using Blazored.LocalStorage
@using OmniMonitor.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Datasets> Localizer
@inject ILocalStorageService LocalStorage

<PageTitle>Datasets</PageTitle>

    <MudStack Row Justify="Justify.SpaceBetween" Class="mt-2 mx-4">
        <MudStack>
            <MudText Typo="Typo.h4" Style=" font-weight: 500; font-family: Inter, Roboto, sans-serif;">Datasets</MudText>
        </MudStack>
        <AddButton OnClick="CrearDataset">
            @Localizer["CrearDataset"]
        </AddButton>
    </MudStack>
    <MudStack Justify="Justify.SpaceBetween" Class="mx-4">
        <MudText Typo="Typo.body1" Class="mb-4" Style="color: #a5a8b5; font-family: Inter, Roboto, sans-serif;">@Localizer["Gestiona"]</MudText>
    </MudStack>


<MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 ml-4 mr-6">
    <MudTextField @bind-Value="searchText"
                  Immediate="true"
                  Placeholder="@Localizer["Buscar"]"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="flex-grow-1 mr-3" />

    <MudButton Variant="Variant.Outlined"
               Color="MudBlazor.Color.Secondary"
               StartIcon="@Icons.Material.Filled.FilterList"
               Class="filter-button">
        <span class="button-text-filter">@Localizer["Filtros"]</span>
    </MudButton>
</MudStack>

<style>
    @@media (max-width: 768px) {
        .button-text-filter {
            display: none !important;
            width: 0 !important;
            padding: 0 !important;
            margin: 0 !important;
        }
 
        .filter-button .mud-button-icon-start,
        .filter-button .mud-button-icon-start svg {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            margin: 0 auto !important;
        }
    }
</style>

<MudContainer Fixed="true" Class="pl-4 pr-6">
    <MudGrid Spacing="3">
        @if (_isLoading == true)
        {
            @*
            @for (int i = 0; i < 8; i++)
            {
                <MudItem xs="12" sm="6" md="4" lg="3"> 
                    <MudCard>
                        <MudCardContent>
                            <MudSkeleton Height="150px" Width="100%" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
            *@
        }
        else if (filteredDatasets.Count == 0)
        {
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1"
                         Align="MudBlazor.Align.Center"
                         Class="mt-6 mb-6"
                         Style="color:#a5a8b5;">
                    @Localizer["NoResultados"]
                </MudText>
            </MudItem>
        }
        else
        {
            @foreach (var dataset in filteredDatasets)
            {
                <MudItem xs="12" sm="6" md="4">
                    <div style="position: relative;">
                        <DatasetCardComponent Dataset="dataset"
                                              Description="@dataset.Descripcion"
                                              OnClick="@(() => EditarDataset(dataset))" />

                        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                 AnchorOrigin="Origin.TopRight"
                                 TransformOrigin="Origin.TopRight"
                                 Class="position-absolute"
                                 Style="position:absolute; top:8px; right:8px;">

                            <MudMenuItem OnClick="@(() => EditarDataset(dataset))">
                                @Localizer["Editar"]
                            </MudMenuItem>

                            <MudMenuItem OnClick="@(() => ConfirmEliminar(dataset))">
                                @Localizer["Eliminar"]
                            </MudMenuItem>
                        </MudMenu>
                    </div>
                </MudItem>
            }
        }
    </MudGrid>

    @if (totalPages > 1)
    {
        <MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-6 mb-4">
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowLeft" 
                           Disabled="@(!hasPreviousPage)" 
                           OnClick="@(() => GoToPage(1))"
                           Size="MudBlazor.Size.Small"
                           Color="MudBlazor.Color.Primary" />
            
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" 
                           Disabled="@(!hasPreviousPage)" 
                           OnClick="@(() => GoToPage(currentPage - 1))"
                           Size="MudBlazor.Size.Small"
                           Color="MudBlazor.Color.Primary" />
            
            <MudText Typo="Typo.body2" Class="mx-3">
                @Localizer["Página"] @currentPage @Localizer["de"] @totalPages
            </MudText>
            
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" 
                           Disabled="@(!hasNextPage)" 
                           OnClick="@(() => GoToPage(currentPage + 1))"
                           Size="MudBlazor.Size.Small"
                           Color="MudBlazor.Color.Primary" />
            
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight" 
                           Disabled="@(!hasNextPage)" 
                           OnClick="@(() => GoToPage(totalPages))"
                           Size="MudBlazor.Size.Small"
                           Color="MudBlazor.Color.Primary" />
        </MudStack>

        <MudStack Row Justify="Justify.Center" Class="mb-4">
            <MudText Typo="Typo.caption" Style="color: #a5a8b5;">
                @Localizer["Mostrando"] @filteredDatasets.Count @Localizer["de"] @totalCount @Localizer["datasets"]
            </MudText>
        </MudStack>
    }
</MudContainer>



@code {
    private List<DatasetDto> datasets = new();
    private List<DatasetDto> filteredDatasets = new();
    private System.Threading.Timer? _debounceTimer;
    private bool _isLoading = true;
    
    // Variables de paginación
    private int currentPage = 1;
    private int pageSize = 9;
    private int totalPages = 0;
    private int totalCount = 0;
    private bool hasPreviousPage = false;
    private bool hasNextPage = false;

    // Propiedad con setter que dispara el filtrado con debounce
    private string _searchText = string.Empty;
    private string searchText
    {
        get => _searchText;
        set
        {
            _searchText = value ?? string.Empty;
            
            // Cancelar el timer anterior si existe
            _debounceTimer?.Dispose();
            
            // Crear un nuevo timer que ejecutará la búsqueda después de 500ms
            _debounceTimer = new System.Threading.Timer(_ =>
            {
                InvokeAsync(async () => 
                {
                    currentPage = 1; // Reset a la primera página cuando se busca
                    await LoadDatasetsAsync();
                });
            }, null, 500, Timeout.Infinite);
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadDatasetsAsync();
    }

    private void EditarDataset(DatasetDto dataset)
    {
        if (dataset is null) return;
        // Pasar el módulo como parámetro de query para carga más rápida
        NavigationManager.NavigateTo($"/editarDataset/{dataset.Id}?module={Uri.EscapeDataString(dataset.Module)}");
    }

    private async Task ConfirmEliminar(DatasetDto dataset)
    {
        if (dataset is null) return;
        var titulo = Localizer["Confirmación"];
        var mensaje = (MarkupString)string.Format(
            Localizer["PreguntaEliminar1"],
            $"<b>{dataset.Nombre}</b>"
        );

        bool? result = await DialogService.ShowMessageBox(
            titulo,
            mensaje,
            yesText: Localizer["Eliminar"],
            cancelText: Localizer["Cancelar"],
            options: new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall }
        );

        if (result == true)
        {
            try
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var username = authState.User.Identity?.Name;
                string token = await LocalStorage.GetItemAsync<string>("authToken");

                if (string.IsNullOrEmpty(username))
                {
                    Snackbar.Add(Localizer["ErrorUsuario"], Severity.Warning);
                    return;
                }

                HttpResponseMessage response;
                
                switch (dataset.Module)
                {
                    case "Insight Monitor":
                        response = await Http.DeleteAsync($"api/Dataset/DeleteDataset?datasetId={dataset.Id}");
                        break;
                    case "Asset Manager":
                        response = await Http.DeleteAsync($"api/DatasetAM/{dataset.Id}");
                        break;
                    case "Urban Monitor":
                        response = await Http.DeleteAsync($"api/DatasetUM/{dataset.Id}");
                        break;
                    case "Event Manager":
                        response = await Http.DeleteAsync($"api/DatasetEM/{dataset.Id}");
                        break;
                    default:
                        Snackbar.Add("Módulo desconocido", Severity.Error);
                        return;
                }

                if (response.IsSuccessStatusCode)
                {
                    // Remover solo el dataset que coincide tanto en ID como en Módulo
                    datasets.RemoveAll(d => d.Id == dataset.Id && d.Module == dataset.Module);
                    filteredDatasets.RemoveAll(d => d.Id == dataset.Id && d.Module == dataset.Module);
                    Snackbar.Add($"'{dataset.Nombre}' { Localizer["Eliminado"]}", Severity.Success, config =>
                    {
                        config.SnackbarVariant = Variant.Filled;
                    });
                    StateHasChanged();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"{Localizer["ErrorEliminar"]} {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"{Localizer["ErrorEliminar"]} {ex.Message}", Severity.Error);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDatasetsAsync();

        // Mostrar snackbar si viene mensaje por query string
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (!string.IsNullOrEmpty(uri.Query))
        {
            var query = uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
            foreach (var q in query)
            {
                var kv = q.Split('=', 2);
                if (kv.Length == 2 && kv[0] == "snackbar")
                {
                    var mensaje = Uri.UnescapeDataString(kv[1]);
                    Snackbar.Add(mensaje, Severity.Success, config =>
                    {
                        config.SnackbarVariant = Variant.Filled;
                        config.Action = "OK";
                        config.ActionColor = MudBlazor.Color.Primary;
                    });
                }
            }
        }
    }

    private async Task LoadDatasetsAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;
            string token = await LocalStorage.GetItemAsync<string>("authToken");

            if (string.IsNullOrEmpty(token))
            {
                Snackbar.Add(Localizer["ErrorUsuario"], Severity.Warning);
                filteredDatasets = new List<DatasetDto>();
                return;
            }

            // Configurar el header de autorización
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            // Usar el endpoint paginado
            var url = $"api/DatasetUM/GetAllDatasetsDtoPaginated?page={currentPage}&pageSize={pageSize}";
            if (!string.IsNullOrWhiteSpace(searchText))
            {
                url += $"&search={Uri.EscapeDataString(searchText)}";
            }

            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var paginatedResult = await response.Content.ReadFromJsonAsync<PaginatedDatasetDto>();
                if (paginatedResult != null)
                {
                    filteredDatasets = paginatedResult.Items ?? new List<DatasetDto>();
                    totalCount = paginatedResult.TotalCount;
                    totalPages = paginatedResult.TotalPages;
                    currentPage = paginatedResult.Page;
                    hasPreviousPage = paginatedResult.HasPreviousPage;
                    hasNextPage = paginatedResult.HasNextPage;
                    
                }
                else
                {
                    Snackbar.Add(Localizer["ErrorCargarDatos"], Severity.Warning);
                    filteredDatasets = new List<DatasetDto>();
                    totalCount = 0;
                    totalPages = 0;
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"{Localizer["ErrorCargarDatos"]}: {error}", Severity.Error);
                filteredDatasets = new List<DatasetDto>();
                totalCount = 0;
                totalPages = 0;
            }
            _isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Localizer["ErrorInicializar"]} {ex.Message}", Severity.Error);
            filteredDatasets = new List<DatasetDto>();
            totalCount = 0;
            totalPages = 0;
        }
    }

    // Método obsoleto - ahora el filtrado se hace en el backend
    // Se mantiene por compatibilidad pero ya no se usa
    private void FilterDatasets()
    {
        // Este método ya no se utiliza porque el filtrado se hace en el backend
        // Se deja vacío para no romper referencias existentes
    }

    // Método de normalización - se mantiene en caso de necesitarse en el futuro
    // pero ahora la normalización se hace en el backend
    private string NormalizeText(string text)
    {
        if (string.IsNullOrEmpty(text))
            return string.Empty;

        var formD = text.Trim().ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD);
        var withoutDiacritics = new string(formD.Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark).ToArray());

        withoutDiacritics = withoutDiacritics
            .Replace(" ", string.Empty)
            .Replace("ñ", "n")
            .Replace("₀", "0").Replace("₁", "1").Replace("₂", "2").Replace("₃", "3").Replace("₄", "4")
            .Replace("₅", "5").Replace("₆", "6").Replace("₇", "7").Replace("₈", "8").Replace("₉", "9");

        return withoutDiacritics.Normalize(System.Text.NormalizationForm.FormC);
    }


    private void CrearDataset()
    {
        NavigationManager.NavigateTo("/crearDataset");
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }

   
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (datasets.Count > 0)
        {
            await JS.InvokeVoidAsync("equalizeCardHeights");
        }
    }
}
