@page "/sonda-test-um"
@using OmniMonitor.Shared
@using System.Net.Http.Json
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http

<h3>Sonda de Endpoints</h3>

<!-- Sección de UM y Zones -->
<div class="card mb-4">
    <div class="card-header">
        <h4>Endpoints de UM</h4>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <button class="btn btn-primary me-2" @onclick="CallUMApi" disabled="@isLoadingUM">
                @if (isLoadingUM)
                {
                    <span>Probando UM...</span>
                }
                else
                {

                    <span>Probar Endpoint UM</span>
                }
            </button>

            <button class="btn btn-secondary me-2" @onclick="CallZonesApi" disabled="@isLoadingZones">
                @if (isLoadingZones)
                {
                    <span>Cargando Zones...</span>
                }
                else
                {

                    <span>Probar Todas las Zones</span>
                }
            </button>
        </div>

        <div class="input-group" style="max-width: 300px;">
            <span class="input-group-text">Zone ID:</span>
            <input type="number" class="form-control" placeholder="Ej: 1" @bind="zoneId" />
            <button class="btn btn-info" @onclick="CallZoneByIdApi" disabled="@isLoadingZoneById">
                @if (isLoadingZoneById)
                {
                    <span>Buscando...</span>
                }
                else
                {

                    <span>Buscar</span>
                }
            </button>
        </div>

        <div class="mt-3">
            @if (!string.IsNullOrEmpty(umError))
            {
                <div class="alert alert-danger">@umError</div>
            }
            @if (!string.IsNullOrEmpty(umResponse))
            {
                <div class="alert alert-success"><b>Respuesta UM:</b> @umResponse</div>
            }

            @if (zones != null && zones.Any())
            {
                <p><b>Lista de Zones:</b></p>
                <ul>
                    @foreach (var z in zones)
                    {
                        <li>@z.Name (@z.Id)</li>
                    }
                </ul>
            }
            @if (zoneById != null)
            {
                <p><b>Zone por ID:</b> @zoneById.Name (@zoneById.Id)</p>
            }
        </div>
    </div>
</div>

<!-- Sección de News -->
<div class="card mb-4">
    <div class="card-header">
        <h4>Endpoints de News</h4>
    </div>
    <div class="card-body">
        <div class="input-group mb-3" style="max-width: 600px;">
            <span class="input-group-text">StartIndex:</span>
            <input type="number" class="form-control" @bind="newsStartIndex" />
            <span class="input-group-text">Count:</span>
            <input type="number" class="form-control" @bind="newsCount" />
            <span class="input-group-text">Query:</span>
            <input type="text" class="form-control" @bind="newsQuery" />
            <span class="input-group-text">Sort:</span>
            <input type="text" class="form-control" @bind="newsSort" />
            <button class="btn btn-primary" @onclick="CallNewsApi" disabled="@isLoadingNews">Cargar</button>
        </div>

        <div class="input-group mb-3" style="max-width: 300px;">
            <span class="input-group-text">News ID:</span>
            <input type="number" class="form-control" @bind="newsId" />
            <button class="btn btn-info" @onclick="CallNewsByIdApi" disabled="@isLoadingNewsById">Buscar</button>
        </div>

        <div class="mt-3">
            @if (!string.IsNullOrEmpty(newsError))
            {
                <div class="alert alert-danger">@newsError</div>
            }

            @if (newsList != null && newsList.Any())
            {
                <p><b>Lista de News:</b></p>
                <ul>
                    @foreach (var n in newsList)
                    {
                        <li>@n.Title (@n.DatePublished.ToShortDateString())</li>
                    }
                </ul>
            }

            @if (newsItem != null)
            {
                <p><b>News por ID:</b> @newsItem.Title</p>
                <p>@newsItem.Summary</p>
            }
        </div>
    </div>
</div>

<!-- Sección de Events -->
<div class="card">
    <div class="card-header">
        <h4>Endpoints de Events</h4>
    </div>
    <div class="card-body">
        <div class="input-group mb-3" style="max-width: 600px;">
            <span class="input-group-text">StartIndex:</span>
            <input type="number" class="form-control" @bind="eventStartIndex" />
            <span class="input-group-text">Count:</span>
            <input type="number" class="form-control" @bind="eventCount" />
            <span class="input-group-text">Query:</span>
            <input type="text" class="form-control" @bind="eventQuery" />
            <span class="input-group-text">Sort:</span>
            <input type="text" class="form-control" @bind="eventSort" />
            <button class="btn btn-primary" @onclick="CallEventsApi" disabled="@isLoadingEvents">Cargar</button>
        </div>

        <div class="input-group mb-3" style="max-width: 300px;">
            <span class="input-group-text">Event ID:</span>
            <input type="number" class="form-control" @bind="eventId" />
            <button class="btn btn-info" @onclick="CallEventByIdApi" disabled="@isLoadingEventById">Buscar</button>
        </div>

        <div class="mt-3">
            @if (!string.IsNullOrEmpty(eventError))
            {
                <div class="alert alert-danger">@eventError</div>
            }

            @if (eventsList != null && eventsList.Any())
            {
                <p><b>Lista de Events:</b></p>
                <ul>
                    @foreach (var e in eventsList)
                    {
                        <li>@e.Name (@e.Date?.ToShortDateString())</li>
                    }
                </ul>
            }

            @if (eventItem != null)
            {
                <p><b>Event por ID:</b> @eventItem.Name</p>
                <p>@eventItem.Description</p>
            }
        </div>
    </div>
</div>

@code {
    // UM
    private string? umResponse;
    private string? umError;
    private bool isLoadingUM = false;

    // Zones
    private List<Zone>? zones;
    private Zone? zoneById;
    private int zoneId;
    private bool isLoadingZones = false;
    private bool isLoadingZoneById = false;

    // News
    private List<News>? newsList;
    private News? newsItem;
    private int newsId;
    private bool isLoadingNews = false;
    private bool isLoadingNewsById = false;
    private string? newsError;
    private int newsStartIndex = 0;
    private int newsCount = 10;
    private string? newsQuery;
    private string? newsSort;

    // Events
    private List<Event>? eventsList;
    private Event? eventItem;
    private int eventId;
    private bool isLoadingEvents = false;
    private bool isLoadingEventById = false;
    private string? eventError;
    private int eventStartIndex = 0;
    private int eventCount = 10;
    private string? eventQuery;
    private string? eventSort;

    private void ClearState(params Action[] actions) => Array.ForEach(actions, a => a());

    // UM
    private async Task CallUMApi()
    {
        isLoadingUM = true;
        ClearState(() => umResponse = null, () => umError = null, () => zones = null, () => zoneById = null);
        try { umResponse = await Http.GetStringAsync("api/SondaMain/um"); }
        catch (Exception ex) { umError = $"Error al llamar al endpoint UM: {ex.Message}"; }
        finally { isLoadingUM = false; }
    }

    private async Task CallZonesApi()
    {
        isLoadingZones = true;
        ClearState(() => zones = null, () => umError = null);
        try { zones = await Http.GetFromJsonAsync<List<Zone>>("api/SondaMain/zones"); }
        catch (Exception ex) { umError = $"Error al obtener la lista de Zones: {ex.Message}"; }
        finally { isLoadingZones = false; }
    }

    private async Task CallZoneByIdApi()
    {
        isLoadingZoneById = true;
        ClearState(() => zoneById = null, () => umError = null);
        try { zoneById = await Http.GetFromJsonAsync<Zone>($"api/SondaMain/zones/{zoneId}"); }
        catch (Exception ex) { umError = $"Error al obtener la Zone con ID {zoneId}: {ex.Message}"; }
        finally { isLoadingZoneById = false; }
    }

    // News
    private async Task CallNewsApi()
    {
        isLoadingNews = true;
        ClearState(() => newsList = null, () => newsError = null);
        try
        {
            var queryParams = new List<string> { $"startIndex={newsStartIndex}", $"count={newsCount}" };
            if (!string.IsNullOrEmpty(newsQuery)) queryParams.Add($"queryString={Uri.EscapeDataString(newsQuery)}");
            if (!string.IsNullOrEmpty(newsSort)) queryParams.Add($"sort={Uri.EscapeDataString(newsSort)}");

            string url = $"api/SondaMain/newsUM?{string.Join("&", queryParams)}";

            newsList = await Http.GetFromJsonAsync<List<News>>(url);

            if (newsList == null) newsError = "No se recibió respuesta del servidor.";
        }
        catch (Exception ex) { newsError = $"Error al obtener la lista de News: {ex.Message}"; }
        finally { isLoadingNews = false; }
    }

    private async Task CallNewsByIdApi()
    {
        isLoadingNewsById = true;
        ClearState(() => newsItem = null, () => newsError = null);
        try { newsItem = await Http.GetFromJsonAsync<News>($"api/SondaMain/newsUM/{newsId}"); }
        catch (Exception ex) { newsError = $"Error al obtener la News con ID {newsId}: {ex.Message}"; }
        finally { isLoadingNewsById = false; }
    }

    // Events
    private async Task CallEventsApi()
    {
        isLoadingEvents = true;
        ClearState(() => eventsList = null, () => eventError = null);
        try
        {
            var queryParams = new List<string> { $"startIndex={eventStartIndex}", $"count={eventCount}" };
            if (!string.IsNullOrEmpty(eventQuery)) queryParams.Add($"queryString={Uri.EscapeDataString(eventQuery)}");
            if (!string.IsNullOrEmpty(eventSort)) queryParams.Add($"sort={Uri.EscapeDataString(eventSort)}");

            string url = $"api/SondaMain/events?{string.Join("&", queryParams)}";

            eventsList = await Http.GetFromJsonAsync<List<Event>>(url);

            if (eventsList == null) eventError = "No se recibió respuesta del servidor.";
        }
        catch (Exception ex) { eventError = $"Error al obtener la lista de Events: {ex.Message}"; }
        finally { isLoadingEvents = false; }
    }

    private async Task CallEventByIdApi()
    {
        isLoadingEventById = true;
        ClearState(() => eventItem = null, () => eventError = null);
        try { eventItem = await Http.GetFromJsonAsync<Event>($"api/SondaMain/events/{eventId}"); }
        catch (Exception ex) { eventError = $"Error al obtener el Event con ID {eventId}: {ex.Message}"; }
        finally { isLoadingEventById = false; }
    }
}
