@page "/login"
@using Microsoft.Extensions.Localization
@using OmniMonitor.Client.Auth
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using OmniMonitor.Shared.Dtos
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<Login> Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer

<div class="login-center-container flex-grow">
    <MudContainer MaxWidth="MudBlazor.MaxWidth.Small">
        <MudPaper Class="pa-6 rounded-lg d-flex flex-column justify-content-center align-center login-paper" Elevation="10">

            <MudText Typo="Typo.h5" Class="mb-2">@SharedLocalizer["LoginTitle"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-6">@Localizer["Subtitle"]</MudText>

            <EditForm Model="@loginRequest" OnValidSubmit="HandleLogin" Class="d-flex flex-column" Style="width:100%;">
                <DataAnnotationsValidator />

                @* Mostramos el mensaje de error aquí si existe *@
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
                }

                <MudText Typo="Typo.body2" Class="mb-2">@Localizer["UsernameLabel"]</MudText>
                <MudTextField T="string"
                              Variant="MudBlazor.Variant.Outlined"
                              @bind-Value="@loginRequest.Username"
                              For="@(() => loginRequest.Username)"
                              Required="true"
                              RequiredError="@Localizer["RequiredUsername"]"
                              Class="mb-4 textfield-custom-bg"
                              Style="background-color: var(--textField-color-1);" />

                <MudText Typo="Typo.body2" Class="mb-2">@Localizer["PasswordLabel"]</MudText>
                <MudTextField T="string"
                              InputType="@(showPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@TogglePasswordVisibility"
                              Variant="MudBlazor.Variant.Outlined"
                              @bind-Value="@loginRequest.Password"
                              For="@(() => loginRequest.Password)"
                              Required="true"
                              RequiredError="La contraseña es obligatoria."
                              Class="mb-4 textfield-custom-bg"
                              Style="background-color: var(--textField-color-1);" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="MudBlazor.Variant.Filled"
                           Color="MudBlazor.Color.Primary"
                           Disabled="@isLoading"
                           FullWidth="true"
                           Class="mt-2"
                           StartIcon="@Icons.Material.Filled.Login">
                    @if (isLoading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="MudBlazor.Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Iniciando...</MudText>
                    }
                    else
                    {
                        <MudText>@Localizer["LoginButton"]</MudText>
                    }
                </MudButton>
            </EditForm>
        </MudPaper>
    </MudContainer>
</div>

@code {
    private LoginRequest loginRequest = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool showPassword = false;

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty; // Limpiamos errores previos
        StateHasChanged(); // Actualiza la UI para mostrar el estado de carga

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", loginRequest);

            if (response.IsSuccessStatusCode)
            {
                var loginResponse = await response.Content.ReadFromJsonAsync<LoginResponse>();

                if (loginResponse?.Success == true && !string.IsNullOrEmpty(loginResponse.Token))
                {
                    // 1. Almacenar el token
                    await LocalStorage.SetItemAsync("authToken", loginResponse.Token);

                    // 2. Notificar al proveedor de autenticación
                    await ((ApiAuthenticationStateProvider)AuthStateProvider).NotifyUserAuthentication(loginResponse.Token);

                    // 3. Navegar a la página principal con recarga forzada para aplicar el estado de autenticación
                    NavManager.NavigateTo("/", forceLoad: true);
                }
                else
                {
                    errorMessage = loginResponse?.Message ?? "Error de autenticación: Token no recibido.";
                    Snackbar.Add(errorMessage, Severity.Error);
                }
            }
            else
            {
                var errorResponse = await response.Content.ReadFromJsonAsync<LoginResponse>();
                errorMessage = errorResponse?.Message ?? "Error de conexión o credenciales incorrectas.";
                Snackbar.Add(errorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error inesperado: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged(); // Actualiza la UI para quitar el estado de carga
        }
    }
}

<style>
    .login-paper {
        background-color: var(--card-color-1);
    }

    .login-center-container {
        display: flex;
        flex-grow: 1;
        justify-content: center;
        align-items: center;
    }

    /* Regla para aplicar el color de fondo al contenedor de entrada de texto interno */
    .textfield-custom-bg .mud-input-control-input-container {
        background-color: var(--textField-color-1) !important;
        border-radius: 4px; /* Opcional: para que coincida con el borde del Outlined */
    }
</style>