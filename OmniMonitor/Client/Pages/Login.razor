@page "/login"
@layout LoginLayout
@using Microsoft.Extensions.Localization
@using OmniMonitor.Client.Auth
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using OmniMonitor.Shared.Dtos
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<Login> Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer

<div class="login-center-container flex-grow">
    <MudContainer MaxWidth="MudBlazor.MaxWidth.Small">
        <MudPaper Class="pa-6 rounded-lg d-flex flex-column justify-content-center align-center login-paper" Elevation="10">

            <MudText Typo="Typo.h5" Class="mb-2">@SharedLocalizer["LoginTitle"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-6">@Localizer["Subtitle"]</MudText>

            <EditForm Model="@loginRequest" OnSubmit="HandleSubmit" Class="d-flex flex-column" Style="width:100%;">

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
                }

                <MudText Typo="Typo.body2" Class="mb-2">@Localizer["UsernameLabel"]</MudText>
                <MudTextField T="string"
                              Variant="MudBlazor.Variant.Outlined"
                              @bind-Value="@loginRequest.Username"
                              For="@(() => loginRequest.Username)"
                              Class="mb-1" />

                @if (showValidationErrors && string.IsNullOrEmpty(loginRequest.Username))
                {
                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Error" Class="mb-4 mt-1">@Localizer["RequiredUsername"]</MudText>
                }
                else
                {
                    <div class="mb-4"></div>
                }


                <MudText Typo="Typo.body2" Class="mb-2">@Localizer["PasswordLabel"]</MudText>
                <MudTextField T="string"
                              InputType="@(showPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@TogglePasswordVisibility"
                              Variant="MudBlazor.Variant.Outlined"
                              @bind-Value="@loginRequest.Password"
                              For="@(() => loginRequest.Password)"
                              Class="mb-1" />

                @if (showValidationErrors && string.IsNullOrEmpty(loginRequest.Password))
                {
                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Error" Class="mb-4 mt-1">@Localizer["RequiredPassword"]</MudText>
                }
                else
                {
                    <div class="mb-4"></div>
                }


                <MudButton ButtonType="ButtonType.Submit"
                           Variant="MudBlazor.Variant.Filled"
                           Color="MudBlazor.Color.Primary"
                           Disabled="@isLoading"
                           FullWidth="true"
                           Class="mt-2"
                           StartIcon="@Icons.Material.Filled.Login">
                    @if (isLoading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="MudBlazor.Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">@Localizer["LoginInButtonText"]</MudText>
                    }
                    else
                    {
                        <MudText>@Localizer["LoginButton"]</MudText>
                    }
                </MudButton>
            </EditForm>
        </MudPaper>
    </MudContainer>
</div>

@code {
    private LoginRequest loginRequest = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool showPassword = false;
    private bool showValidationErrors = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity!.IsAuthenticated)
        {
            NavManager.NavigateTo("/", forceLoad: true);
        }
    }

    private bool ValidateInputs()
    {
        return !string.IsNullOrEmpty(loginRequest.Username) && !string.IsNullOrEmpty(loginRequest.Password);
    }


    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    
    private async Task HandleSubmit(EditContext context)
    {
        errorMessage = string.Empty;

        if (ValidateInputs())
        {
            showValidationErrors = false;
            await HandleLogin();
        }
        else
        {
            showValidationErrors = true;
            isLoading = false;
        }

        StateHasChanged();
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", loginRequest);

            if (response.IsSuccessStatusCode)
            {
                var loginResponse = await response.Content.ReadFromJsonAsync<LoginResponse>();

                if (loginResponse?.Success == true && !string.IsNullOrEmpty(loginResponse.Token))
                {
                    // 1. Almacenar el token
                    await LocalStorage.SetItemAsync("authToken", loginResponse.Token);

                    // 2. Notificar al proveedor de autenticación
                    await ((ApiAuthenticationStateProvider)AuthStateProvider).NotifyUserAuthentication(loginResponse.Token);

                    // 3. Navegar a la página principal con recarga forzada para aplicar el estado de autenticación
                    NavManager.NavigateTo("/", replace: true);
                }
            }
            else
            {
                // Manejo de errores de autenticación del servidor
                errorMessage = @Localizer["AuthenticationError"];
                Snackbar.Add(errorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"{@Localizer["UnexpectedErrorPrefix"].Value}{ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged(); // Actualiza la UI para quitar el estado de carga
        }
    }
}

<style>
    .login-paper {
        background-color: var(--card-color-1);
    }

    .login-center-container {
        display: flex;
        flex-grow: 1;
        justify-content: center;
        align-items: center;
    }
</style>
