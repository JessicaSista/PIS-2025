@page "/dashboards/edit/{id:int}"
@attribute [Authorize]
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http
@using MudBlazor
@using OmniMonitor.Shared
@using Microsoft.AspNetCore.Components
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Dashboards> Localizer
@using System.Text.Json;

<PageTitle>Dashboards</PageTitle>

<!-- Encabezado -->
<MudStack Row Justify="Justify.SpaceBetween" Class="mt-2 mx-4">
    <MudStack>
        <MudText Typo="Typo.h4" Style="font-weight:500;font-family:Inter,Roboto,sans-serif;">@(dashName)</MudText>
    </MudStack>
    
</MudStack>

<MudStack Justify="Justify.SpaceBetween" Class="mx-4">
    <MudText Typo="Typo.body1" Class="mb-4" Style="color:#a5a8b5;font-family:Inter,Roboto,sans-serif;">
        @Localizer["Gestiona"]
    </MudText>
</MudStack>

<Dashboard Widgets=@ternasVisualizacion WidgetSizes=@resultList></Dashboard>

<style>
    @@media (max-width: 768px) {
        .button-text-filter {
            display: none !important;
        }

        .filter-button .mud-button-icon-start,
        .filter-button .mud-button-icon-start svg {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            margin: 0 auto !important;
        }
    }
</style>


@code {
    [Parameter] public int id { get; set; }

    private string dashName = string.Empty;
    private string dashDesc = string.Empty;

    private List<(bool, string)> ternasVisualizacion = new List<(bool, string)> { };
    private List<(int,int)> resultList = new List<(int, int)> { };

    // Datos de dos dashboards de ejemplo
    
    private List<string> dashboardNames = new List<string> {"dash1","dash2"};
    private List<string> dashboardDescriptions = new List<string> {"desc1","desc2"};
    private List<string> jsonLayoutStrings = new List<string>
    {
        // Primer string JSON (índice 0)
        @"{ ""cards"": [ 
                { ""ancho"": 4, ""alto"": 400 }, 
                { ""ancho"": 4, ""alto"": 400 } ] 
        }",

        // Segundo string JSON (índice 1)
        @"{ ""cards"": [ { ""ancho"": 5, ""alto"": 500 }] }"
    };
    private List<(bool, string)> ternasList = new List<(bool, string)>
    {
        // TERNAS CON DATOS
        (true, "DATA1,2999,false"),
        (true, "DATA2,2343.00,false"),
        (true, "DATA3,234342.99,true"),
        (true, "DATA4,484342.99,false"),

        // TERNAS CON DESCRIPCIONES (el false indica que no es un item de datos)
        (false, "Sensor de Proximidad"),
        (false, "Dispositivo de Monitoreo"),
        (false, "Tarjeta de Expansión"),
        (false, "Módulo Wi-Fi"),
        (false, "Sensor de Flujo de Agua"),
        (false, "Medidor de Voltaje"),
        (false, "Batería de Litio Recargable"),
        (false, "Cargador de Baterías")
    };
    private List<int> indices1 = new List<int>
    {
        1, 
        5, 
    };
    private List<int> indices2 = new List<int>
    {
        7,  
    };


    protected override async Task OnInitializedAsync()
    {
        // Segun el id, obtenemos el nombre, descripción y el string JSON correspondiente
        dashName = dashboardNames[id];
        dashDesc = dashboardDescriptions[id];
        var indices = id == 0 ? indices1 : indices2;

        for (int i = 0; i < indices.Count; i++)
        {
            Console.WriteLine($"Índice seleccionado: {indices[i]}");
            ternasVisualizacion.Add(ternasList[indices[i]]);
            Console.WriteLine(i);
        }
        
        // Usamos 'using' para asegurar la liberación de memoria del JsonDocument
        using (JsonDocument design = JsonDocument.Parse(jsonLayoutStrings[id]))
        {
            var root = design.RootElement;

            // 1. Obtener la propiedad "cards"
            if (root.TryGetProperty("cards", out JsonElement cardsElement) && cardsElement.ValueKind == JsonValueKind.Array)
            {
                // 2. Iterar sobre cada elemento del array y crear un objeto CardData
                foreach (var cardElement in cardsElement.EnumerateArray())
                {
                    if (cardElement.TryGetProperty("ancho", out JsonElement anchoElement) && 
                        cardElement.TryGetProperty("alto", out JsonElement altoElement))
                    {
                        // Agregar el nuevo objeto CardData a la lista de resultados
                        resultList.Add((anchoElement.GetInt32(),altoElement.GetInt32()));
                    }
                }
            }
        }

    }

