@page "/dashboards/edit/{id:int}"
@attribute [Authorize]
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http
@using MudBlazor
@using OmniMonitor.Shared
@using Microsoft.AspNetCore.Components
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Dashboards> Localizer
@using System.Text.Json;

<PageTitle>Dashboards</PageTitle>

<!-- Encabezado -->
<MudStack Row Justify="Justify.SpaceBetween" Class="mt-2 mx-4">
    <MudStack>
        <MudText Typo="Typo.h4" Style="font-weight:500;font-family:Inter,Roboto,sans-serif;">@(dashName)</MudText>
    </MudStack>
    
</MudStack>

<MudStack Justify="Justify.SpaceBetween" Class="mx-4">
    <MudText Typo="Typo.body1" Class="mb-4" Style="color:#a5a8b5;font-family:Inter,Roboto,sans-serif;">
        @Localizer["Gestiona"]
    </MudText>
</MudStack>

<Dashboard CardsData=@cardsData></Dashboard>

<style>
    @@media (max-width: 768px) {
        .button-text-filter {
            display: none !important;
        }

        .filter-button .mud-button-icon-start,
        .filter-button .mud-button-icon-start svg {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            margin: 0 auto !important;
        }
    }
</style>


@code {
    [Parameter] public int id { get; set; }

    private string dashName = string.Empty;
    private string dashDesc = string.Empty;

    // ID, ancho, alto
    private List<(int, int, int)> cardsData = new List<(int, int, int)> { };









    // Datos de dos dashboards de ejemplo hardcodeados
    
    private List<string> dashboardNames = new List<string> {"dash1","dash2"};
    private List<string> dashboardDescriptions = new List<string> {"desc1","desc2"};
    private List<string> jsonLayoutStrings = new List<string>
    {
        @"{ ""cards"": [ 
                { ""ancho"": 4, ""alto"": 400 }, 
                { ""ancho"": 4, ""alto"": 400 } ] 
        }",
        @"{ ""cards"": [ 
                { ""ancho"": 5, ""alto"": 500 }] 
        }"
    };
    private List<int> indices1 = new List<int>
    {
        1, 
        2, 
    };
    private List<int> indices2 = new List<int>
    {
        1,  
    };






    protected override async Task OnInitializedAsync()
    {
        // Segun el id, obtenemos el nombre, descripción y el string JSON correspondiente
        dashName = dashboardNames[id];
        dashDesc = dashboardDescriptions[id];
        
        //tentativo de ids de visualizaciones
        var visualizationIDs = id == 0 ? indices1 : indices2;
        
        
        // Ontengo el json y lo parseo para obtener las dimensiones de las tarjetas y armar el cardsData
        using (JsonDocument design = JsonDocument.Parse(jsonLayoutStrings[id]))
        {
            var root = design.RootElement;
            if (root.TryGetProperty("cards", out JsonElement cardsElement) && cardsElement.ValueKind == JsonValueKind.Array)
            {
                var cardsElementArray = cardsElement.EnumerateArray().ToList();
                for (int i = 0; i<visualizationIDs.Count; i++)
                {
                    if (i >= cardsElementArray.Count)
                    {
                        break; // Evita errores si hay más IDs de cards que tamaños definidos
                    }
                    if (cardsElementArray[i].TryGetProperty("ancho", out JsonElement anchoElement) && 
                        cardsElementArray[i].TryGetProperty("alto", out JsonElement altoElement))
                    {
                        // Agregar el nuevo objeto CardData a la lista de resultados
                        cardsData.Add((visualizationIDs[i],anchoElement.GetInt32(), altoElement.GetInt32()));
                    }
                }
            }
        }

    }

    
}
