@page "/dashboards/edit/{DashboardId:int}"
@attribute [Authorize]
@using OmniMonitor.Shared.Dtos
@using MudBlazor
@using OmniMonitor.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Localization
@using System.Text.Json;
@using Blazored.LocalStorage
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject IStringLocalizer<Dashboards> Localizer
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboards</PageTitle>

<!-- Encabezado -->
<MudStack Row Justify="Justify.SpaceBetween" Class="mt-2 mx-4">
    <MudStack>
        <MudText Typo="Typo.h4" Style="font-weight:500;font-family:Inter,Roboto,sans-serif;">@(dashName)</MudText>
    </MudStack>

    <MudButton Variant="Variant.Filled"
               Color="MudBlazor.Color.Primary"
               StartIcon="@Icons.Material.Filled.Save"
               OnClick="GuardarCambiosAsync">
        Guardar Cambios
    </MudButton>
    
</MudStack>

<MudStack Justify="Justify.SpaceBetween" Class="mx-4">
    <MudText Typo="Typo.body1" Class="mb-4" Style="color:#a5a8b5;font-family:Inter,Roboto,sans-serif;">
        @(dashDesc)
    </MudText>
</MudStack>

<Dashboard CardsData=@(cardsData) dashboardId="@DashboardId" OnVisualizationCreated="HandleNewVisualization"></Dashboard>

<style>
    @@media (max-width: 768px) {
        .button-text-filter {
            display: none !important;
        }

        .filter-button .mud-button-icon-start,
        .filter-button .mud-button-icon-start svg {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            margin: 0 auto !important;
        }
    }
</style>


@code {
    [Parameter] public int DashboardId { get; set; }

    private string dashName = string.Empty;
    private string dashDesc = string.Empty;

    private List<int> _visualizationsIDs = new List<int> { };

    private List<int> _visulaizationsToSave = new List<int> { };

    // ID, ancho, alto
    private List<(int Id, int Ancho, int Alto)> cardsData = new List<(int, int, int)> { };



    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Segun el id, obtenemos el nombre, descripción y el string JSON correspondiente
            string token = await LocalStorage.GetItemAsync<string>("authToken");
            HttpResponseMessage? response = await Http.GetAsync($"api/Dashboard/GetDashboard?id={DashboardId}&token={token}");

            if (response.IsSuccessStatusCode)
            {
                DashboardResponse? dashboardData = await response.Content.ReadFromJsonAsync<DashboardResponse>();

                if (dashboardData != null)
                {
                    dashName = dashboardData.Nombre;
                    dashDesc = dashboardData.Descripcion;


                    for (int i = 0; i < dashboardData.Tarjetas.Count; i++)
                    {
                        _visualizationsIDs.Add(dashboardData.Tarjetas[i].Visualizacion.IdVisualizacion);
                    }

                    // Ontengo el json y lo parseo para obtener las dimensiones de las tarjetas y armar el cardsData
                    string jsonDesign = dashboardData.JsonDiseno;
                    if (string.IsNullOrEmpty(jsonDesign))
                    {
                        jsonDesign = @"{ ""cards"": []}";
                    }
                    using (JsonDocument design = JsonDocument.Parse(jsonDesign))
                    {
                        var root = design.RootElement;
                        if (root.TryGetProperty("cards", out JsonElement cardsElement) && cardsElement.ValueKind == JsonValueKind.Array)
                        {
                            var cardsElementArray = cardsElement.EnumerateArray().ToList();
                            for (int i = 0; i<_visualizationsIDs.Count; i++)
                            {
                                if (i >= cardsElementArray.Count)
                                {
                                    break; // Evita errores si hay más IDs de cards que tamaños definidos
                                }
                                if (cardsElementArray[i].TryGetProperty("ancho", out JsonElement anchoElement) && 
                                    cardsElementArray[i].TryGetProperty("alto", out JsonElement altoElement))
                                {
                                    // Agregar el nuevo objeto CardData a la lista de resultados
                                    cardsData.Add((_visualizationsIDs[i],anchoElement.GetInt32(), altoElement.GetInt32()));
                                }
                            }
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error recargando dashboard: {ex.Message}");
        }
    }


    private void HandleNewVisualization(int newVisualizationId)
    {
        const int DefaultAncho = 4;
        const int DefaultAlto = 400;

        bool alreadyExists = _visualizationsIDs.Contains(newVisualizationId);

        if (alreadyExists)
        {
            // 2. Si ya existe, loguea la advertencia y sale del método.
            Console.WriteLine($"ADVERTENCIA: La visualización con ID {newVisualizationId} ya existe y no se agregará.");
            return;
        }
        _visualizationsIDs.Add(newVisualizationId);

        _visulaizationsToSave.Add(newVisualizationId);

        cardsData.Add((newVisualizationId, DefaultAncho, DefaultAlto));

        StateHasChanged();

        Console.WriteLine($"Dashboard: Nueva visualización agregada. ID: {newVisualizationId}, Tamaño: {DefaultAncho}x{DefaultAlto}. Total Cards: {cardsData.Count}");
    }


    private async Task GuardarCambiosAsync()
    {
        AuthenticationState? authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        System.String? username = authState.User.Identity?.Name;
        bool allNewCardsSaved = true;

        
        foreach (var visualizationId in _visulaizationsToSave)
        {
            try
            {
                using (JsonDocument doc = JsonDocument.Parse("{}"))
                {
                    OmniMonitor.Shared.Dtos.DashboardCard request = new OmniMonitor.Shared.Dtos.DashboardCard
                    {
                        CardId = visualizationId,
                        TipoCard = 1,
                        Props = doc.RootElement.Clone()
                    };

                    HttpResponseMessage? response = await Http.PostAsJsonAsync($"api/Dashboard/{DashboardId}/card?username={username}", request);

                    if (!response.IsSuccessStatusCode)
                    {
                        allNewCardsSaved = false;
                        string error = await response.Content.ReadAsStringAsync();
                        Snackbar.Add($"Error al agregar la visualización {visualizationId}: {error}", Severity.Error);
                    }
                }
            }
            catch (Exception ex)
            {
                allNewCardsSaved = false;
                Console.WriteLine($"Error al guardar visualización {visualizationId} en el dashboard: {ex.Message}");
                Snackbar.Add($"Error interno al guardar visualización {visualizationId}.", Severity.Error);
            }
        }

        if (!allNewCardsSaved && _visulaizationsToSave.Any())
        {
            Snackbar.Add("Se produjo un error al guardar una o más tarjetas nuevas. Diseño no actualizado.", Severity.Warning);
            return;
        }
        try
        {
            var cardsDesignList = cardsData.Select(card => new
            {
                ancho = card.Ancho,
                alto = card.Alto
            }).ToList();

            // Creamos el objeto anónimo raíz que contiene la propiedad "cards"
            var designRootObject = new { cards = cardsDesignList };


            // 2. Serializar el objeto C# A UN STRING JSON temporal
            string tempJsonString = JsonSerializer.Serialize(designRootObject);

            // 3. Parsear el STRING JSON de vuelta a un JsonDocument
            using (JsonDocument doc = JsonDocument.Parse(tempJsonString))
            {
                // 4. Obtener la JsonElement raíz (que es el objeto JSON completo)
                JsonElement nuevoJsonDisenoElement = doc.RootElement.Clone();

                // 5. Convertir la JsonElement a STRING usando GetRawText()
                string newJsonDesign = nuevoJsonDisenoElement.GetRawText();

                Console.WriteLine("Nuevo JSON de Diseño (obtenido vía GetRawText):");
                Console.WriteLine(newJsonDesign);

                // 6. ENVIAR LA SOLICITUD HTTP PUT A /api/Dashboard/{id}/config

                string requestUri = $"api/Dashboard/{DashboardId}/config?username={username}";

                // Usamos el string final y ESPECIFICAMOS application/json
                var contentToSend = new StringContent(newJsonDesign, System.Text.Encoding.UTF8, "application/json");

                string token = await LocalStorage.GetItemAsync<string>("authToken");
                Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

                var response = await Http.PutAsync(requestUri, contentToSend);

                // ... (Resto del manejo de la respuesta) ...
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Diseño del Dashboard guardado exitosamente.", Severity.Success);
                }
                else
                {
                    string errorContent = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Error al actualizar el diseño: {response.ReasonPhrase}. {errorContent}", Severity.Error);
                }
            }
            
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar cambios en el dashboard: {ex.Message}");
            Snackbar.Add($"Error al guardar el diseño del dashboard: {ex.Message}", Severity.Error);
        }

    }


}
