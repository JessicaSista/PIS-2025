@page "/dashboards/edit/{DashboardId:int}"
@attribute [Authorize]
@using OmniMonitor.Shared.Dtos
@using MudBlazor
@using OmniMonitor.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Localization
@using System.Text.Json;
@using Blazored.LocalStorage
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject IStringLocalizer<Dashboards> Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboards</PageTitle>

<!-- Encabezado -->
<MudStack Row Justify="Justify.SpaceBetween" Class="mt-2 mx-4">
    <MudStack>
        <MudText Typo="Typo.h4" Style="font-weight:500;font-family:Inter,Roboto,sans-serif;">@(dashName)</MudText>
    </MudStack>

    <MudButton Variant="Variant.Filled"
               Color="MudBlazor.Color.Primary"
               StartIcon="@Icons.Material.Filled.Save"
               OnClick="GuardarCambiosAsync">
        Guardar Cambios
    </MudButton>
    
</MudStack>

<MudStack Justify="Justify.SpaceBetween" Class="mx-4">
    <MudText Typo="Typo.body1" Class="mb-4" Style="color:#a5a8b5;font-family:Inter,Roboto,sans-serif;">
        @(dashDesc)
    </MudText>
</MudStack>

<Dashboard CardsData=@(cardsData) 
           dashboardId="@DashboardId" 
           OnVisualizationCreated="HandleNewVisualization"
           UpdateCardSize="UpdateCardSize" 
           RemoveCard="HandleDeleteVisualization">
</Dashboard>

<style>
    @@media (max-width: 768px) {
        .button-text-filter {
            display: none !important;
        }

        .filter-button .mud-button-icon-start,
        .filter-button .mud-button-icon-start svg {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            margin: 0 auto !important;
        }
    }
</style>


@code {
    [Parameter] public int DashboardId { get; set; }

    private string dashName = string.Empty;
    private string dashDesc = string.Empty;

    private List<(int,int)> _visualizationsIDs = new List<(int,int)> { };

    private List<(int,int)> _visulaizationsToSave = new List<(int,int)> { };
    private List<(int, int)> _visulaizationsToDelete = new List<(int, int)> { };

    // ID, AnchoSm, AnchoMd, AnchoLg, Alto
    private List<(int Id, int CardType, int AnchoSm, int AnchoMd, int AnchoLg, int Alto)> cardsData = new List<(int, int, int, int, int, int)> { };


    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Segun el id, obtenemos el nombre, descripción y el string JSON correspondiente
            string token = await LocalStorage.GetItemAsync<string>("authToken");
            HttpResponseMessage? response = await Http.GetAsync($"api/Dashboard/GetDashboard?id={DashboardId}&token={token}");

            if (response.IsSuccessStatusCode)
            {
                DashboardResponse? dashboardData = await response.Content.ReadFromJsonAsync<DashboardResponse>();

                if (dashboardData != null)
                {
                    dashName = dashboardData.Nombre;
                    dashDesc = dashboardData.Descripcion;


                    for (int i = 0; i < dashboardData.Tarjetas.Count; i++)
                    {
                        _visualizationsIDs.Add((dashboardData.Tarjetas[i].CardId,dashboardData.Tarjetas[i].TipoCard));
                        Console.WriteLine($"Dashboard: Agregada visualización con ID,Tipo: {_visualizationsIDs[i]} desde el dashboard.");
                    }
                    Console.WriteLine($"Dashboard: Total de visualizaciones cargadas: {dashboardData.Tarjetas.Count}");

                    // Ontengo el json y lo parseo para obtener las dimensiones de las tarjetas y armar el cardsData
                    string jsonDesign = dashboardData.JsonDiseno;
                    if (string.IsNullOrEmpty(jsonDesign))
                    {
                        jsonDesign = @"{ ""cards"": []}";
                    }
                    using (JsonDocument design = JsonDocument.Parse(jsonDesign))
                    {
                        var root = design.RootElement;
                        if (root.TryGetProperty("cards", out JsonElement cardsElement) && cardsElement.ValueKind == JsonValueKind.Array)
                        {
                            var cardsElementArray = cardsElement.EnumerateArray().ToList();
                            for (int i = 0; i<_visualizationsIDs.Count; i++)
                            {
                                if (i >= cardsElementArray.Count)
                                {
                                    break; // Evita errores si hay más IDs de cards que tamaños definidos
                                }
                                if (cardsElementArray[i].TryGetProperty("anchoSm", out JsonElement anchoSmElement) && 
                                    cardsElementArray[i].TryGetProperty("anchoMd", out JsonElement anchoMdElement) &&
                                    cardsElementArray[i].TryGetProperty("anchoLg", out JsonElement anchoLgElement) &&
                                    cardsElementArray[i].TryGetProperty("alto", out JsonElement altoElement))
                                {
                                    // Agregar el nuevo objeto CardData a la lista de resultados
                                    var (id, type) = _visualizationsIDs[i];
                                    cardsData.Add((id,type, anchoSmElement.GetInt32(), anchoMdElement.GetInt32(), anchoLgElement.GetInt32(), altoElement.GetInt32()));
                                }
                            }
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error recargando dashboard: {ex.Message}");
        }
    }


    private void HandleNewVisualization((int Id, int Type) newVisualization)
    {
        const int DefaultAnchoSm = 6;
        const int DefaultAnchoMd = 4;
        const int DefaultAnchoLg = 3;
        const int DefaultAlto = 400;

        bool alreadyExists = _visualizationsIDs.Contains((newVisualization.Id, newVisualization.Type));

        if (alreadyExists)
        {
            // 2. Si ya existe, loguea la advertencia y sale del método.
            // Console.WriteLine($"ADVERTENCIA: La visualización con ID {newVisualizationId}, Tipo {newVisualizationType} ya existe y no se agregará.");
            return;
        }
        _visualizationsIDs.Add((newVisualization.Id, newVisualization.Type));

        _visulaizationsToSave.Add((newVisualization.Id, newVisualization.Type));

        cardsData.Add((newVisualization.Id, newVisualization.Type, DefaultAnchoSm, DefaultAnchoMd, DefaultAnchoLg, DefaultAlto));

        StateHasChanged();

        // Console.WriteLine($"Dashboard: Nueva visualización agregada. ID: {newVisualizationId}, Tipo: {newVisualizationType} Tamaño: {DefaultAnchoSm}x{DefaultAlto}. Total Cards: {cardsData.Count}");
    }

    private void HandleDeleteVisualization((int Id, int Type) deletedVisualization)
