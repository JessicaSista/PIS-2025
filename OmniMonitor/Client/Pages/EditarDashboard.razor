    private void UpdateCardSize((int Id, int Type, int AnchoSm, int AnchoMd, int AnchoLg, int Alto) cardInfo)
    {
        for (int i = 0; i < cardsData.Count; i++)
        {
            if ((cardsData[i].Id == cardInfo.Id)&&(cardsData[i].CardType == cardInfo.Type))
            {
                cardsData[i] = cardInfo;
                Console.WriteLine($"Tamaño de la tarjeta actualizado. ID: {cardInfo.Id}, Type: {cardInfo.Type} Nuevos Anchos: {cardInfo.AnchoSm}, {cardInfo.AnchoMd}, {cardInfo.AnchoLg}. Alto: {cardInfo.Alto}");
                break;
            }
        }
    }


    private async Task GuardarCambiosAsync()
    {
        AuthenticationState? authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        System.String? username = authState.User.Identity?.Name;
        bool allNewCardsSaved = true;

        
        foreach (var (id, type) in _visulaizationsToSave)
        {
            try
            {
                using (JsonDocument doc = JsonDocument.Parse("{}"))
                {
                    OmniMonitor.Shared.Dtos.DashboardCard request = new OmniMonitor.Shared.Dtos.DashboardCard
                    {
                        CardId = id,
                        TipoCard = type,
                        Props = doc.RootElement.Clone()
                    };

                    HttpResponseMessage? response = await Http.PostAsJsonAsync($"api/Dashboard/{DashboardId}/card?username={username}", request);

                    if (!response.IsSuccessStatusCode)
                    {
                        allNewCardsSaved = false;
                        string error = await response.Content.ReadAsStringAsync();
                        Snackbar.Add($"Error al agregar la visualización {id}: {error}", Severity.Error);
                    }
                }
            }
            catch (Exception ex)
            {
                allNewCardsSaved = false;
                Console.WriteLine($"Error al guardar visualización ID: {id}, Type: {type} en el dashboard: {ex.Message}");
                Snackbar.Add($"Error interno al guardar visualización ID: {id}, Type: {type}.", Severity.Error);
            }
        }

        if (!allNewCardsSaved && _visulaizationsToSave.Any())
        {
            Snackbar.Add("Se produjo un error al guardar una o más tarjetas nuevas. Diseño no actualizado.", Severity.Warning);
            return;
        }

        foreach (var (id, type) in _visulaizationsToDelete)
        {
            try
            {
                string deleteUri = $"api/Dashboard/{DashboardId}/card/{id}/{type}?username={username}";

                HttpResponseMessage? response = await Http.DeleteAsync(deleteUri);

                if (!response.IsSuccessStatusCode)
                {
                    string error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Error al eliminar la visualización ID: {id}, Type: {type}: {response.ReasonPhrase}. {error}", Severity.Error);
                }
                else
                {
                    Console.WriteLine($"Tarjeta eliminada del servidor: ID: {id}, Type: {type}.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al eliminar visualización  ID: {id}, Type: {type} del dashboard: {ex.Message}");
                Snackbar.Add($"Error interno al eliminar visualización  ID: {id}, Type: {type}.", Severity.Error);
            }
        }

        try
        {
            var cardsDesignList = cardsData.Select(card => new
            {
                anchoSm = card.AnchoSm,
                anchoMd = card.AnchoMd,
                anchoLg = card.AnchoLg,
                alto = card.Alto
            }).ToList();

            // Creamos el objeto anónimo raíz que contiene la propiedad "cards"
            var designRootObject = new { cards = cardsDesignList };


            // 2. Serializar el objeto C# A UN STRING JSON temporal
            string tempJsonString = JsonSerializer.Serialize(designRootObject);

            // 3. Parsear el STRING JSON de vuelta a un JsonDocument
            using (JsonDocument doc = JsonDocument.Parse(tempJsonString))
            {
                // 4. Obtener la JsonElement raíz (que es el objeto JSON completo)
                JsonElement nuevoJsonDisenoElement = doc.RootElement.Clone();

                // 5. Convertir la JsonElement a STRING usando GetRawText()
                string newJsonDesign = nuevoJsonDisenoElement.GetRawText();

                Console.WriteLine("Nuevo JSON de Diseño (obtenido vía GetRawText):");
                Console.WriteLine(newJsonDesign);

                // 6. ENVIAR LA SOLICITUD HTTP PUT A /api/Dashboard/{id}/config

                string requestUri = $"api/Dashboard/{DashboardId}/config?username={username}";

                // Usamos el string final y ESPECIFICAMOS application/json

                string token = await LocalStorage.GetItemAsync<string>("authToken");
                Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

                var response = await Http.PutAsJsonAsync(requestUri, newJsonDesign);

                // ... (Resto del manejo de la respuesta) ...
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Diseño del Dashboard guardado exitosamente.", Severity.Success);
                    _visulaizationsToSave.Clear();
                    _visulaizationsToDelete.Clear();
                }
                else
                {
                    string errorContent = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Error al actualizar el diseño: {response.ReasonPhrase}. {errorContent}", Severity.Error);
                }
            }

            
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar cambios en el dashboard: {ex.Message}");
            Snackbar.Add($"Error al guardar el diseño del dashboard: {ex.Message}", Severity.Error);
        }

    }


}
