@page "/dashboards"
@attribute [Authorize]
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http
@using MudBlazor
@using OmniMonitor.Shared
@using Microsoft.AspNetCore.Components
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Dashboards> Localizer

<PageTitle>Dashboards</PageTitle>

<!-- Encabezado -->
<MudStack Row Justify="Justify.SpaceBetween" Class="mt-2 mx-4">
    <MudStack>
        <MudText Typo="Typo.h4" Style="font-weight:500;font-family:Inter,Roboto,sans-serif;">Dashboards</MudText>
    </MudStack>
    <AddButton OnClick="AbrirDialogoCrearDashboard">
        @Localizer["CrearDashboard"]
    </AddButton>
</MudStack>

<MudStack Justify="Justify.SpaceBetween" Class="mx-4">
    <MudText Typo="Typo.body1" Class="mb-4" Style="color:#a5a8b5;font-family:Inter,Roboto,sans-serif;">
        @Localizer["Gestiona"]
    </MudText>
</MudStack>

<!-- Buscador -->
<MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 ml-4 mr-6">
    <MudTextField @bind-Value="searchText"
                  Immediate="true"
                  Placeholder="@Localizer["Buscar"]"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="flex-grow-1 mr-3" />

    <MudButton Variant="Variant.Outlined"
               Color="MudBlazor.Color.Secondary"
               StartIcon="@Icons.Material.Filled.FilterList"
               Class="filter-button">
        <span class="button-text-filter">@Localizer["Filtros"]</span>
    </MudButton>
</MudStack>

<style>
    @@media (max-width: 768px) {
        .button-text-filter {
            display: none !important;
        }

        .filter-button .mud-button-icon-start,
        .filter-button .mud-button-icon-start svg {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            margin: 0 auto !important;
        }
    }
</style>

<!-- Grid de dashboards -->
<MudContainer Fixed="true" Class="pl-4 pr-6">
    <MudGrid GutterSize="3">
        @foreach (var dashboard in filteredDashboards)
        {
            <MudItem xs="12" sm="6" md="4">
                <div style="position:relative;">
                    <DashboardCardComponent Dashboard="dashboard"
                                            Description="@dashboard.Description"
                                            OnClick="@(() => AbrirDashboard(dashboard.Id))" />

                    <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                             AnchorOrigin="Origin.TopRight"
                             TransformOrigin="Origin.TopRight"
                             Class="position-absolute"
                             Style="position:absolute; top:8px; right:8px;">

                        <MudMenuItem OnClick="@(() => EditarDashboard(dashboard))">
                            @Localizer["Editar"]
                        </MudMenuItem>

                        <MudMenuItem OnClick="@(() => ConfirmEliminar(dashboard))">
                            @Localizer["Eliminar"]
                        </MudMenuItem>
                    </MudMenu>
                </div>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

@code {
    private List<DashboardDto> dashboards = new();
    private List<DashboardDto> filteredDashboards = new();

    private string _searchText = string.Empty;
    private string searchText
    {
        get => _searchText;
        set
        {
            _searchText = value ?? string.Empty;
            FilterDashboards();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Por ahora: mock desde localStorage
        var storedDashboards = await JS.InvokeAsync<string>("localStorage.getItem", "dashboards");
        if (!string.IsNullOrEmpty(storedDashboards))
        {
            dashboards = System.Text.Json.JsonSerializer.Deserialize<List<DashboardDto>>(storedDashboards) ?? new();
        }
        else
        {
            dashboards = new List<DashboardDto>
            {
                new DashboardDto { Id = 1, Name = "Producción", Description = "Indicadores de planta", CreatedAt = DateTime.Now.AddDays(-3) },
                new DashboardDto { Id = 2, Name = "Ventas", Description = "KPIs comerciales", CreatedAt = DateTime.Now.AddDays(-1) },
                new DashboardDto { Id = 3, Name = "Mantenimiento", Description = "Estado de sensores y alertas", CreatedAt = DateTime.Now }
            };
        }

        filteredDashboards = dashboards.ToList();
    }

    private async Task GuardarLocalAsync()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(dashboards);
        await JS.InvokeVoidAsync("localStorage.setItem", "dashboards", json);
    }

    private async Task AbrirDialogoCrearDashboard()
    {
        var parameters = new DialogParameters
        {
            ["OnConfirm"] = EventCallback.Factory.Create<DashboardDto>(this, CrearDashboard)
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = false,
            Position = DialogPosition.Center,
            NoHeader = false,
            BackgroundClass = "mud-overlay-dark"
        };

        await DialogService.ShowAsync<CreateDashboardDialog>("Crear Dashboard", parameters, options);
    }

    private async void CrearDashboard(DashboardDto nuevo)
    {
        if (nuevo == null) return;
        nuevo.Id = dashboards.Any() ? dashboards.Max(d => d.Id) + 1 : 1;
        nuevo.CreatedAt = DateTime.Now;
        dashboards.Add(nuevo);
        filteredDashboards = dashboards.ToList();
        await GuardarLocalAsync();

        Snackbar.Add($"'{nuevo.Name}' creado correctamente", Severity.Success, config =>
        {
            config.SnackbarVariant = Variant.Filled;
        });
    }

    private void AbrirDashboard(int id)
    {
        // En el futuro -> NavigationManager.NavigateTo($"/dashboard/{id}");
        Console.WriteLine($"Click en dashboard con id {id}");
    }

    private async Task EditarDashboard(DashboardDto dashboard)
    {
        if (dashboard is null) return;

        var titulo = Localizer["Editar Dashboard"];
        var mensaje = Localizer["Ingrese un nuevo nombre y descripción"];

        var parameters = new DialogParameters
        {
            ["OnConfirm"] = EventCallback.Factory.Create<DashboardDto>(this, async (DashboardDto actualizado) =>
            {
                dashboard.Name = actualizado.Name;
                dashboard.Description = actualizado.Description;
                await GuardarLocalAsync();

                Snackbar.Add($"'{dashboard.Name}' actualizado", Severity.Success, config =>
                {
                    config.SnackbarVariant = Variant.Filled;
                });
            })
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = false,
            Position = DialogPosition.Center,
            NoHeader = false,
            BackgroundClass = "mud-overlay-dark"
        };

        await DialogService.ShowAsync<CreateDashboardDialog>(titulo, parameters, options);
    }

    private async Task ConfirmEliminar(DashboardDto dashboard)
    {
        if (dashboard is null) return;

        bool? result = await DialogService.ShowMessageBox(
            Localizer["Confirmación"],
            (MarkupString)$"<b>{dashboard.Name}</b> {Localizer["PreguntaEliminar1"]}",
            yesText: Localizer["Eliminar"],
            cancelText: Localizer["Cancelar"],
            options: new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall }
        );

        if (result == true)
        {
            dashboards.RemoveAll(d => d.Id == dashboard.Id);
            filteredDashboards.RemoveAll(d => d.Id == dashboard.Id);
            await GuardarLocalAsync();

            Snackbar.Add($"'{dashboard.Name}' eliminado correctamente", Severity.Success, config =>
            {
                config.SnackbarVariant = Variant.Filled;
            });
            StateHasChanged();
        }
    }

    private void FilterDashboards()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredDashboards = dashboards.ToList();
            return;
        }

        var normalizedSearch = NormalizeText(searchText);
        filteredDashboards = dashboards
            .Where(d => NormalizeText(d.Name).Contains(normalizedSearch))
            .ToList();
    }

    private string NormalizeText(string text)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        var formD = text.Trim().ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD);
        var withoutDiacritics = new string(formD.Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark).ToArray());
        return withoutDiacritics.Normalize(System.Text.NormalizationForm.FormC);
    }
}
