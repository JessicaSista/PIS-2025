@page "/dashboards"
@attribute [Authorize]
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http
@using MudBlazor
@using OmniMonitor.Shared
@using Microsoft.AspNetCore.Components
@using Blazored.LocalStorage
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Dashboards> Localizer
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILocalStorageService LocalStorage
<PageTitle>Dashboards</PageTitle>

<!-- Header -->
<MudStack Row Justify="Justify.SpaceBetween" Class="mt-2 mx-4">
    <MudStack>
        <MudText Typo="Typo.h4" Style="font-weight:500;font-family:Inter,Roboto,sans-serif;">Dashboards</MudText>
    </MudStack>
    <AddButton OnClick="OpenCreateDashboardDialog">
        @Localizer["CrearDashboard"]
    </AddButton>
</MudStack>

<MudStack Justify="Justify.SpaceBetween" Class="mx-4">
    <MudText Typo="Typo.body1" Class="mb-4" Style="color:#a5a8b5;font-family:Inter,Roboto,sans-serif;">
        @Localizer["Gestiona"]
    </MudText>
</MudStack>

<!-- Search bar -->
<MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 ml-4 mr-6">
    <MudTextField @bind-Value="searchText"
                  Immediate="true"
                  Placeholder="@Localizer["Buscar"]"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="flex-grow-1 mr-3" />

    <MudButton Variant="Variant.Outlined"
               Color="MudBlazor.Color.Secondary"
               StartIcon="@Icons.Material.Filled.FilterList"
               Class="filter-button">
        <span class="button-text-filter">@Localizer["Filtros"]</span>
    </MudButton>
</MudStack>

<style>
    @@media (max-width: 768px) {
        .button-text-filter {
            display: none !important;
        }

        .filter-button .mud-button-icon-start,
        .filter-button .mud-button-icon-start svg {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            margin: 0 auto !important;
        }
    }
    .mud-container {
        width: 100%;
        display: block;
        box-sizing: border-box;
        margin-left: 0 !important; 
        margin-right: auto; 
        padding-left: 16px !important;
        padding-right: 16px !important;
    }

    .mud-container--gutters {
        padding-left: 16px !important;
        padding-right: 16px !important;
    }

    .mud-container-maxwidth-lg {
        max-width: 100% !important;
    }

</style>

<!-- Dashboard grid -->
<MudContainer Fixed="false">
    <MudGrid Spacing="3" Justify="Justify.FlexStart">
        @if (_isLoading == true)
        {
            @*
            @for (int i = 0; i < 8; i++)
            {
                <MudItem xs="12" sm="6" md="4" lg="3"> 
                    <MudCard>
                        <MudCardContent>
                            <MudSkeleton Height="150px" Width="100%" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
            *@
        }
        else if (filteredDashboards.Count == 0)
        {
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1"
                         Align="MudBlazor.Align.Center"
                         Class="mt-6 mb-6"
                         Style="color:#a5a8b5;">
                    @Localizer["NoResultados"]
                </MudText>
            </MudItem>
        }
        else
        {
            @foreach (var dashboard in filteredDashboards)
            {
                <MudItem xs="12" sm="6" md="4" lg="3"> 
                    <div style="position:relative;">
                        <DashboardCardComponent Dashboard="dashboard"
                                                OnClick="@(() => OpenDashboard(dashboard.IdDashboard))" />

                        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                 AnchorOrigin="Origin.TopRight"
                                 TransformOrigin="Origin.TopRight"
                                 Class="position-absolute"
                                 Style="position:absolute; top:8px; right:8px;">
                            <MudMenuItem OnClick="@(() => EditDashboard(dashboard))">
                                @Localizer["Editar"]
                            </MudMenuItem>

                            <MudMenuItem OnClick="@(() => ConfirmDelete(dashboard))">
                                @Localizer["Eliminar"]
                            </MudMenuItem>
                        </MudMenu>
                    </div>
                </MudItem>
            }
        }
    </MudGrid>

    @if (totalPages > 1)
    {
        <MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-6 mb-4">
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowLeft" 
                           Disabled="@(!hasPreviousPage)" 
                           OnClick="@(() => GoToPage(1))"
                           Size="MudBlazor.Size.Small"
                           Color="MudBlazor.Color.Primary" />
            
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" 
                           Disabled="@(!hasPreviousPage)" 
                           OnClick="@(() => GoToPage(currentPage - 1))"
                           Size="MudBlazor.Size.Small"
                           Color="MudBlazor.Color.Primary" />
            
            <MudText Typo="Typo.body2" Class="mx-3">
                @Localizer["Página"] @currentPage @Localizer["de"] @totalPages
            </MudText>
            
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" 
                           Disabled="@(!hasNextPage)" 
                           OnClick="@(() => GoToPage(currentPage + 1))"
                           Size="MudBlazor.Size.Small"
                           Color="MudBlazor.Color.Primary" />
            
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight" 
                           Disabled="@(!hasNextPage)" 
                           OnClick="@(() => GoToPage(totalPages))"
                           Size="MudBlazor.Size.Small"
                           Color="MudBlazor.Color.Primary" />
        </MudStack>

        <MudStack Row Justify="Justify.Center" Class="mb-4">
            <MudText Typo="Typo.caption" Style="color: #a5a8b5;">
                @Localizer["Mostrando"] @filteredDashboards.Count @Localizer["de"] @totalCount dashboards
            </MudText>
        </MudStack>
    }
</MudContainer>


@code {
    // Eliminada variable 'dashboards', solo se usa 'filteredDashboards'
    private List<DashboardSummaryResponse> filteredDashboards = new();
    private string _searchText = string.Empty;
    private bool _isLoading = true;

    // Variables de paginación
    private int currentPage = 1;
    private int pageSize = 12;
    private int totalPages = 0;
    private int totalCount = 0;
    private bool hasPreviousPage = false;
    private bool hasNextPage = false;

    private string searchText
    {
        get => _searchText;
        set
        {
            _searchText = value ?? string.Empty;
            currentPage = 1; // Reset a la primera página cuando se busca
            _ = LoadDashboardsAsync(); // Cargar con el nuevo filtro
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadDashboardsAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;

            if (string.IsNullOrEmpty(username))
            {
                Snackbar.Add(Localizer["ErrorUsuario"], Severity.Warning);
                filteredDashboards = new List<DashboardSummaryResponse>();
                return;
            }

            await LoadDashboardsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading dashboards: {ex.Message}", Severity.Error);
            filteredDashboards = new List<DashboardSummaryResponse>();
            totalCount = 0;
            totalPages = 0;
        }
    }

    private async Task LoadDashboardsAsync()
    {
        try
        {
            // Construir URL con paginación
            var url = $"api/Dashboard/GetAllDashboardsPaginated?page={currentPage}&pageSize={pageSize}";
            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                url += $"&query={Uri.EscapeDataString(_searchText)}";
            }

            var result = await Http.GetFromJsonAsync<PaginatedDashboardDto>(url);

            if (result != null)
            {
                filteredDashboards = result.Items ?? new List<DashboardSummaryResponse>();
                totalCount = result.TotalCount;
                totalPages = result.TotalPages;
                currentPage = result.Page;
                hasPreviousPage = result.HasPreviousPage;
                hasNextPage = result.HasNextPage;                
            }
            else
            {
                filteredDashboards = new List<DashboardSummaryResponse>();
                totalCount = 0;
                totalPages = 0;
            }
            _isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading dashboards: {ex.Message}", Severity.Error);
            filteredDashboards = new List<DashboardSummaryResponse>();
            totalCount = 0;
            totalPages = 0;
            StateHasChanged();
        }
    }

    private async Task OpenCreateDashboardDialog()
    {
        var parameters = new DialogParameters
        {
            ["OnConfirm"] = EventCallback.Factory.Create<DashboardDto>(this, CreateDashboard)
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = false,
            Position = DialogPosition.Center,
            NoHeader = false,
            BackgroundClass = "mud-overlay-dark"
        };

        var title = Localizer["CrearDashboard"];
        await DialogService.ShowAsync<CreateDashboardDialog>(title, parameters, options);
    }

    private async void CreateDashboard(DashboardDto newDashboard)
    {
        if (newDashboard == null) return;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;

            if (string.IsNullOrEmpty(username))
            {
                Snackbar.Add(Localizer["ErrorUsuario"], Severity.Warning);
                filteredDashboards = new List<DashboardSummaryResponse>();
                return;
            }

            var request = new CreateDashboardRequest
            {
                Nombre = newDashboard.Nombre,
                Descripcion = newDashboard.Descripcion
            };
            var response = await Http.PostAsJsonAsync("api/Dashboard", request);

            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<DashboardResponse>();
                if (created != null)
                {
                    // Recargar la lista paginada desde el servidor
                    await LoadDashboardsAsync();
                    await JS.InvokeVoidAsync("equalizeCardHeights");
                    Snackbar.Add($"'{created.Nombre}' created successfully", Severity.Success);
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error creating dashboard: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error: {ex.Message}", Severity.Error);
        }
    }

    private void OpenDashboard(int id)
    {
        NavigationManager.NavigateTo($"/dashboards/edit/{id}");
    }

    private async Task EditDashboard(DashboardSummaryResponse dashboard)
    {
        if (dashboard is null) return;

        var title = Localizer["Editar Dashboard"];

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var username = authState.User.Identity?.Name;

        if (string.IsNullOrEmpty(username))
        {
            Snackbar.Add(Localizer["ErrorUsuario"], Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["OnConfirm"] = EventCallback.Factory.Create<DashboardDto>(this, async (DashboardDto updated) =>
            {
                try
                {
                    var url = $"api/Dashboard/{dashboard.IdDashboard}/info?username={username}";
                    if (!string.IsNullOrWhiteSpace(updated.Nombre))
                        url += $"&nombre={Uri.EscapeDataString(updated.Nombre)}";
                    if (!string.IsNullOrWhiteSpace(updated.Descripcion))
                        url += $"&descripcion={Uri.EscapeDataString(updated.Descripcion)}";

                    var response = await Http.PutAsync(url, null);

                    if (response.IsSuccessStatusCode)
                    {
                        dashboard.Nombre = updated.Nombre;
                        dashboard.Descripcion = updated.Descripcion;
                        dashboard.FechaModificacion = DateTime.UtcNow;

                        Snackbar.Add($"'{dashboard.Nombre}' updated successfully", Severity.Success, config =>
                        {
                            config.SnackbarVariant = Variant.Filled;
                        });

                        StateHasChanged();
                        await JS.InvokeVoidAsync("equalizeCardHeights");
                        NavigationManager.NavigateTo($"/dashboards/edit/{dashboard.IdDashboard}");
                    }
                    else
                    {
                        var errorContent = await response.Content.ReadAsStringAsync();
                        Snackbar.Add($"Error updating dashboard: {errorContent}", Severity.Error);
                    }
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Unexpected error: {ex.Message}", Severity.Error);
                }
            })
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = false,
            Position = DialogPosition.Center,
            NoHeader = false,
            BackgroundClass = "mud-overlay-dark"
        };

        parameters.Add("InitialName", dashboard.Nombre);
        parameters.Add("InitialDescription", dashboard.Descripcion);

        await DialogService.ShowAsync<CreateDashboardDialog>(title, parameters, options);
    }

    private async Task ConfirmDelete(DashboardSummaryResponse dashboard)
    {
        if (dashboard is null) return;

        bool? result = await DialogService.ShowMessageBox(
            Localizer["Confirmación"],
            (MarkupString)string.Format(
                Localizer["PreguntaEliminar1"],
                $"<b>{dashboard.Nombre}</b>"
            ),
            yesText: Localizer["Eliminar"],
            cancelText: Localizer["Cancelar"],
            options: new DialogOptions
            {
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.ExtraSmall
            }
        );

        if (result == true)
        {
            try
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var username = authState.User.Identity?.Name;

                if (string.IsNullOrEmpty(username))
                {
                    Snackbar.Add(Localizer["ErrorUsuario"], Severity.Warning);
                    filteredDashboards = new List<DashboardSummaryResponse>();
                    return;
                }

                var response = await Http.DeleteAsync($"api/Dashboard/{dashboard.IdDashboard}?username={username}");

                if (response.IsSuccessStatusCode)
                {
                    // dashboards eliminado, solo se usa filteredDashboards
                    if(filteredDashboards.Count == 1 && totalCount > 1)
                    {
                        currentPage--;
                    }
                    await LoadDashboardsAsync();
                    Snackbar.Add($"'{dashboard.Nombre}' deleted successfully", Severity.Success);
                }
                else
                {
                    Snackbar.Add($"Error deleting dashboard", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }

            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (filteredDashboards != null && filteredDashboards.Count > 0)
        {
            await JS.InvokeVoidAsync("equalizeCardHeights");
        }
    }
}

