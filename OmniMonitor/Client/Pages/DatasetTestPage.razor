@page "/dataset-test"
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar
@using System.Net.Http.Json
@using System.Text.Json

<PageTitle>Página de Prueba de Datasets</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Panel de Prueba de Datasets</MudText>

<MudGrid>
    <!-- Columna para Crear Dataset -->
    <MudItem xs="12" md="5">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Crear Nuevo Dataset</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (isLoadingOptions)
                {
                    <div class="d-flex justify-center">
                        <MudProgressCircular Indeterminate="true" />
                        <MudText Class="ms-2">Cargando opciones...</MudText>
                    </div>
                }
                else
                {
                    <MudTextField @bind-Value="createRequest.Name" Label="Nombre del Dataset" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField @bind-Value="createRequest.Username" Label="Nombre de Usuario" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField @bind-Value="createRequest.Description" Label="Descripción" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" />

                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.subtitle1">Filtros (para carga dinámica)</MudText>

                    @if (allSources.Any())
                    {
                        <MudSelect T="int?" @bind-Value="createRequest.SourceId" Label="Source" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var source in allSources)
                            {
                                <MudSelectItem Value="@((int?)source.Id)">@source.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }

                    @if (allGroups.Any())
                    {
                        <MudSelect T="int?" @bind-Value="createRequest.GroupId" Label="Group" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var group in allGroups)
                            {
                                <MudSelectItem Value="@((int?)group.Id)">@group.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }

                    @if (allSensorNames.Any())
                    {
                        <MudSelect T="string" @bind-Value="createRequest.SensorName" Label="Sensor" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var sensorName in allSensorNames)
                            {
                                <MudSelectItem Value="@sensorName">@sensorName</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.subtitle1">Dispositivos (selección explícita)</MudText>
                    
                    <!-- Indicador de diagnóstico para la carga de dispositivos -->
                    <MudText Class="mb-2"><b>Dispositivos cargados: @allDevices.Count</b></MudText>

                    @if (allDevices.Any())
                    {
                        <MudSelect T="int" @bind-SelectedValues="selectedDeviceIds" Label="Devices" MultiSelection="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                             @foreach (var device in allDevices)
                            {
                                <MudSelectItem Value="@device.Id">@device.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">No se encontraron dispositivos para seleccionar.</MudAlert>
                    }

                    <MudSwitch T="bool" @bind-Checked="@isFormalDataset" Color="MudBlazor.Color.Primary" Class="mt-4">
                        ¿Es un Dataset Formal? (Si está apagado, es interno 'N')
                    </MudSwitch>
                }
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="CreateNewDataset">Crear Dataset</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <!-- Columna para Listar y Ver Datasets -->
    <MudItem xs="12" md="7">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Ver Datasets</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudTextField @bind-Value="usernameToFetch" Label="Nombre de Usuario para Buscar" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Secondary" OnClick="LoadUserDatasets" Disabled="@isLoadingDatasets" Class="mt-2 mb-4">
                    @if (isLoadingDatasets)
                    {
                        <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" />
                        <span class="ms-2">Cargando...</span>
                    }
                    else
                    {
                        <span>Cargar Datasets</span>
                    }
                </MudButton>

                @if (userDatasets == null)
                {
                    <MudText>Introduce un nombre de usuario y haz clic en cargar.</MudText>
                }
                else
                {
                    <MudTable Items="userDatasets" Hover="true" Striped="true">
                        <HeaderContent>
                            <MudTh>ID</MudTh>
                            <MudTh>Nombre</MudTh>
                            <MudTh>Tipo</MudTh>
                            <MudTh>Acciones</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="ID">@context.Id</MudTd>
                            <MudTd DataLabel="Nombre">@context.Name</MudTd>
                            <MudTd DataLabel="Tipo">@(context.Is_Dataset == "S" ? "Formal" : "Interno")</MudTd>
                            <MudTd DataLabel="Acciones">
                                <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Outlined" Color="MudBlazor.Color.Primary" OnClick="@(() => ShowDatasetDetails(context.Id))">Ver Detalles</MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudCardContent>
        </MudCard>
        
        @if (selectedDataset != null)
        {
            <MudCard Class="mt-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Detalles de: @selectedDataset.Name</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText><b>ID:</b> @selectedDataset.Id</MudText>
                    <MudText><b>Usuario:</b> @selectedDataset.Username</MudText>
                    <MudText><b>Descripción:</b> @selectedDataset.Description</MudText>
                    <MudText><b>Filtros:</b> SourceID: @selectedDataset.Id_Source, GroupID: @selectedDataset.Id_Group, Sensor: @selectedDataset.SensorName</MudText>
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle1"><b>Dispositivos Encontrados:</b></MudText>
                    @if(selectedDataset.DatasetDevices != null && selectedDataset.DatasetDevices.Any())
                    {
                        <ul>
                            @foreach(var device in selectedDataset.DatasetDevices)
                            {
                                <li>ID de Dispositivo: @device.Id_device</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <MudText Color="MudBlazor.Color.Warning">No se encontraron dispositivos para este dataset (o no se seleccionó ninguno).</MudText>
                    }
                </MudCardContent>
            </MudCard>
        }
    </MudItem>
</MudGrid>

@code {
    private CreateDatasetRequest createRequest = new();
    private bool isFormalDataset = true;
    private string usernameToFetch = "admin"; // Valor por defecto

    private List<Dataset>? userDatasets;
    private Dataset? selectedDataset;
    
    // Banderas de estado de carga
    private bool isLoadingOptions = true;
    private bool isLoadingDatasets = false;

    // Listas para poblar los selectores
    private List<Source> allSources = new();
    private List<DeviceGroup> allGroups = new();
    private List<Device> allDevices = new();
    private List<string> allSensorNames = new();
    private IEnumerable<int> selectedDeviceIds = new List<int>();

    protected override async Task OnInitializedAsync()
    {
        await LoadOptionsAsync();
    }

    private async Task LoadOptionsAsync()
    {
        isLoadingOptions = true;
        try
        {
            allSources = await GetAndHandleResponse<List<Source>>("api/SondaMain/sources") ?? new();
            allGroups = await GetAndHandleResponse<List<DeviceGroup>>("api/SondaMain/groups") ?? new();
            allDevices = await GetAndHandleResponse<List<Device>>("api/SondaMain/devices?user=admin&pass=admin") ?? new();

            if (allDevices.Any())
            {
                allSensorNames = allDevices
                    .Where(d => d.Sensors != null)
                    .SelectMany(d => d.Sensors)
                    .Select(s => s.Name)
                    .Where(name => !string.IsNullOrEmpty(name))
                    .Distinct()
                    .OrderBy(name => name)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error fatal cargando opciones: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoadingOptions = false;
        }
    }

    private async Task<T?> GetAndHandleResponse<T>(string url)
    {
        try
        {
            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                // --- PASO DE DIAGNÓSTICO ---
                // Imprimirá el JSON en la consola del navegador (F12)
                Console.WriteLine($"Respuesta JSON de {url}:\n{jsonString}");
                
                return JsonSerializer.Deserialize<T>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error cargando desde {url}. Status: {response.StatusCode}. Respuesta: {errorContent}", Severity.Error, config => { config.Action = "Cerrar"; config.ActionColor = MudBlazor.Color.Secondary; });
                return default;
            }
        }
        catch(JsonException jsonEx)
        {
            Snackbar.Add($"Error de deserialización de JSON: {jsonEx.Message}", Severity.Error);
            return default;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error en la solicitud HTTP: {ex.Message}", Severity.Error);
            return default;
        }
    }

    private async Task CreateNewDataset()
    {
        createRequest.IsDataset = isFormalDataset ? "S" : "N";
        createRequest.DeviceIds = selectedDeviceIds.ToList();
        
        var response = await Http.PostAsJsonAsync("api/Dataset", createRequest);

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Dataset creado con éxito!", Severity.Success);
            createRequest = new(); // Limpiar formulario
            selectedDeviceIds = new List<int>();
            await LoadUserDatasets(); // Recargar la lista
        }
        else
        {
            Snackbar.Add("Error al crear el dataset.", Severity.Error);
        }
    }

    private async Task LoadUserDatasets()
    {
        isLoadingDatasets = true;
        selectedDataset = null;
        try
        {
            userDatasets = await GetAndHandleResponse<List<Dataset>>($"api/Dataset/user/{usernameToFetch}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al procesar la respuesta de datasets: {ex.Message}", Severity.Error);
            userDatasets = new List<Dataset>(); // Asignar lista vacía en caso de error para evitar que la tabla desaparezca
        }
        finally
        {
            isLoadingDatasets = false;
        }
    }

    private async Task ShowDatasetDetails(int datasetId)
    {
        try
        {
            selectedDataset = await GetAndHandleResponse<Dataset>($"api/Dataset/{datasetId}/{usernameToFetch}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al obtener los detalles: {ex.Message}", Severity.Error);
        }
    }
}

