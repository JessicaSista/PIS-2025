@page "/test-permissions"
@using OmniMonitor.Shared.Dtos
@using System.Security.Claims
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<PageTitle>Prueba de Permisos</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2>Prueba del Sistema de Roles y Permisos</h2>

            <AuthorizeView>
                <Authorized>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h5>Información del Usuario Autenticado</h5>
                                </div>
                                <div class="card-body">
                                    <p><strong>Usuario:</strong> @context.User.Identity?.Name</p>
                                    <p><strong>ID:</strong> @(context.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier)?.Value)</p>
                                    <p><strong>Roles:</strong> @(string.Join(", ", context.User.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value)))</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h5>Permisos del Usuario (desde API)</h5>
                                </div>
                                <div class="card-body">
                                    @if (isLoadingPermissions)
                                    {
                                        <p class="text-muted">Cargando permisos...</p>
                                    }
                                    else if (userPermissions != null && userPermissions.Any())
                                    {
                                        @foreach (var permission in userPermissions)
                                        {
                                            <span class="badge bg-success me-1 mb-1">@permission.Name</span>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-danger">No se pudieron cargar los permisos o no tiene ninguno.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <h4>Pruebas de Permisos</h4>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="card mb-3">
                                        <div class="card-header">
                                            <h6>Verificar Permisos Específicos</h6>
                                        </div>
                                        <div class="card-body">
                                            @foreach (var permissionName in permissionsToTest)
                                            {
                                                <div class="mb-2">
                                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="@(() => CheckPermission(permissionName))">
                                                        Verificar "@permissionName"
                                                    </button>
                                                    <span class="badge @(permissionResults.ContainsKey(permissionName) ? (permissionResults[permissionName] ? "bg-success" : "bg-danger") : "bg-secondary")">
                                                        @(permissionResults.ContainsKey(permissionName) ? (permissionResults[permissionName] ? "SÍ" : "NO") : "?")
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card mb-3">
                                        <div class="card-header">
                                            <h6>Verificar Roles</h6>
                                        </div>
                                        <div class="card-body">
                                            @foreach (var roleName in rolesToTest)
                                            {
                                                <div class="mb-2">
                                                    <button class="btn btn-sm btn-outline-info me-2" @onclick="@(() => CheckRole(roleName))">
                                                        Verificar "@roleName"
                                                    </button>
                                                    <span class="badge @(roleResults.ContainsKey(roleName) ? (roleResults[roleName] ? "bg-success" : "bg-danger") : "bg-secondary")">
                                                        @(roleResults.ContainsKey(roleName) ? (roleResults[roleName] ? "SÍ" : "NO") : "?")
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-12">
                            <button class="btn btn-secondary" @onclick="Logout">
                                Cerrar Sesión
                            </button>
                        </div>
                    </div>

                </Authorized>
                <NotAuthorized>
                    <div class="alert alert-warning">
                        <h4>No hay usuario autenticado</h4>
                        <p>Por favor, inicia sesión para probar el sistema de permisos.</p>
                        <a href="/login" class="btn btn-primary">Iniciar Sesión</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@code {
    private List<Permission>? userPermissions;
    private bool isLoadingPermissions = true;
    private int currentUserId;

    private Dictionary<string, bool> permissionResults = new();
    private Dictionary<string, bool> roleResults = new();

    private readonly List<string> permissionsToTest = new() { "Ver Usuarios", "Crear Usuarios", "Ver Empleados", "Gestionar Empleados" };
    private readonly List<string> rolesToTest = new() { "Administrador", "Visitante" };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var userIdClaim = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(userIdClaim, out currentUserId))
            {
                await LoadUserPermissions();
            }
        }
    }

    private async Task LoadUserPermissions()
    {
        isLoadingPermissions = true;
        try
        {
            var response = await Http.GetAsync($"api/authorization/users/{currentUserId}/permissions");
            if (response.IsSuccessStatusCode)
            {
                userPermissions = await response.Content.ReadFromJsonAsync<List<Permission>>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando permisos del usuario: {ex.Message}");
        }
        finally
        {
            isLoadingPermissions = false;
        }
    }

    private async Task CheckPermission(string permissionName)
    {
        try
        {
            var response = await Http.GetAsync($"api/authorization/users/{currentUserId}/has-permission?permissionName={Uri.EscapeDataString(permissionName)}");
            permissionResults[permissionName] = response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<bool>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error verificando permiso {permissionName}: {ex.Message}");
            permissionResults[permissionName] = false;
        }
    }

    private async Task CheckRole(string roleName)
    {
        try
        {
            var response = await Http.GetAsync($"api/authorization/users/{currentUserId}/has-role?roleName={Uri.EscapeDataString(roleName)}");
            roleResults[roleName] = response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<bool>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error verificando rol {roleName}: {ex.Message}");
            roleResults[roleName] = false;
        }
    }

    private async Task Logout()
    {
        // Use the custom provider to notify the app of logout
        await ((OmniMonitor.Client.Auth.ApiAuthenticationStateProvider)AuthStateProvider).NotifyUserLogout();
        Navigation.NavigateTo("/login");
    }
}
