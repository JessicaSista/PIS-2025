@page "/editarReporte/{ReportId:int}"
@attribute [Authorize]
@using System.Text.Json
@using System.Text.Json.Serialization
@using OmniMonitor.Shared.Dtos
@using OmniMonitor.Client.Extensions
@inject HttpClient Http
@using MudBlazor
@using OmniMonitor.Shared
@using OmniMonitor.Shared.Dtos.AM
@using OmniMonitor.Shared.Dtos.EM
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Datasets> Localizer
@inject ILogger<EditReport> Logger



<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">

    <MudStack Class="mb-6">
        <MudText Typo="Typo.h4">@(!string.IsNullOrWhiteSpace(reportName) ? reportName : "Reporte")</MudText>
        <MudGrid Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudItem>
                <MudText Typo="Typo.body1">@(!string.IsNullOrWhiteSpace(reportDescription) ? reportDescription : "Sin descripción")</MudText>
            </MudItem>
            <MudItem>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Share" Size="MudBlazor.Size.Small" Style="border-color: var(--mud-palette-lines-default);">Compartir</MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PictureAsPdf" Size="MudBlazor.Size.Small" Style="border-color: var(--mud-palette-lines-default);">PDF</MudButton>
                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small" Disabled="@isSaving" OnClick="GenerarJsonConfig">
                        @(isSaving ? "Guardando..." : "Guardar Reporte")
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudStack>


    <MudGrid Spacing="4">

        <MudItem Xs="12" Sm="5" Md="4">
            <ReportConfiguration
                ActiveTab="@activeTab"
                OnActiveTabChanged="SetActiveTab"
                SelectedDatasets="@selectedDatasets"
                FilteredDatasets="@filteredDatasets"
                OnDatasetToggle="ToggleDatasetSelection"
                IsDatasetSelected="@IsSelected"
                ResolveSelectedEntity="@GetSelectedEntity"
                ResolveEntityOptions="@GetEntityOptions"
                OnDatasetEntityChanged="@HandleDatasetEntityChanged"
                DatasetSearchText="@searchText"
                OnDatasetSearchTextChanged="@HandleDatasetSearchTextChanged"
                AvailableColumns="@availableColumns"
                Joins="@joins"
                HasJoinColumns="@HasJoinColumns"
                OnSelectAllColumns="SelectAllColumns"
                OnDeselectAllColumns="DeselectAllColumns"
                OnColumnToggled="ToggleColumnVisibility"
                ResolveDatasetLabel="@GetDatasetDisplayLabel"
                ResolveJoinLabel="@GetJoinDisplayName"
                OnJoinAdd="@HandleJoinAdd"
                OnJoinRemove="EliminarJoin"
                OnApplyJoins="AplicarJoins"
                ResolvePropertyNamesForDataset="@GetEntityPropertyNamesForDatasetName"
                OnJoinDatasetsChanged="@HandleJoinDatasetsChanged"
                Filters="@filters"
                OnFilterAdd="@HandleFilterAdd"
                OnFilterRemove="@HandleFilterRemove" />
        </MudItem>

        <MudItem Xs="12" Sm="7" Md="8">
            <MudPaper Class="pa-4" Elevation="2" Style="height: 75vh; overflow:auto;">
                @if (isExecuting)
                {
                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height:100%">
                        <MudProgressCircular Color="MudBlazor.Color.Primary" />
                        <MudText Class="mt-2">Ejecutando reporte...</MudText>
                    </MudStack>
                }
                else if (executeRows.Any())
                {
                    <MudTable Items="@executeRows" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>#</MudTh>
                            @foreach (var col in executeColumns)
                            {
                                <MudTh>@col</MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="#">@(executeRows.IndexOf(context) + 1)</MudTd>
                            @foreach (var col in executeColumns)
                            {
                                <MudTd DataLabel="@col">@((context.TryGetValue(col, out var val) ? val : null))</MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    if (previewExecuted)
                    {
                        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height:100%">
                            <MudText Typo="Typo.h6" Color="MudBlazor.Color.Secondary">No hay datos que cumplan la configuracion elegida.</MudText>
                        </MudStack>
                    }
                    else
                    {
                        <MudText Typo="Typo.h6" Color="MudBlazor.Color.Secondary">
                            Seleccione al menos una columna
                        </MudText>
                    }
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    public class ColumnDefinition
    {
        public string Name { get; set; } = string.Empty; // Initialize to avoid null
        public string DisplayName { get; set; } = string.Empty; // Initialize to avoid null
        public string DatasetName { get; set; } = string.Empty; // Initialize to avoid null
        public string GroupLabel { get; set; } = string.Empty; // Used to display dataset/module grouping
        public bool IsVisible { get; set; } = false;
        public int DatasetId { get; set; }
        public EntityName Entity { get; set; } = EntityName.Device;
        public string PropertyName { get; set; } = string.Empty;
        public bool IsJoin { get; set; }
        public int? JoinId { get; set; }
        public string? JoinDisplayName { get; set; }
    }

    private List<ColumnDefinition> availableColumns = new();

    private static readonly EntityName[] InsightMonitorEntityOptions = new[] { EntityName.Device, EntityName.Source, EntityName.Group, EntityName.Sensor };
    private static readonly EntityName[] AssetManagerEntityOptions = new[] { EntityName.EventAM, EntityName.Stock, EntityName.Asset };
    private static readonly EntityName[] EventManagerEntityOptions = new[] { EntityName.Alert, EntityName.EventEM, EntityName.Extension, EntityName.Categoria };
    private static readonly EntityName[] UrbanMonitorEntityOptions = new[] { EntityName.Zone, EntityName.EventUM, EntityName.New };
    private const string ModuleInsightMonitor = "Insight Monitor";
    private const string ModuleAssetManager = "Asset Manager";
    private const string ModuleUrbanMonitor = "Urban Monitor";
    private const string ModuleEventManager = "Event Manager";

    [Parameter]
    public int ReportId { get; set; }
    private static int _nextFilterId = 1;
    private int currentPage = 1;
    private const int pageSize = 10; 
    private Dictionary<int, DatasetIM> selectedDatasetsIM = new();
    private Dictionary<string, EntityName> selectedEntities = new();
    private List<DatasetDto> selectedDatasets = new();
    private List<DatasetDto> datasets = new();
    private List<DatasetDto> filteredDatasets = new();
    private string reportName = string.Empty;
    private string reportDescription = string.Empty;
    private bool isSaving = false;
    private bool isExecuting = false;
    private bool previewExecuted = false;
    private List<Dictionary<string, string?>> executeRows = new();
    private List<string> executeColumns = new();
    private List<CrossModuleJoinDto> userJoins = new();
    private bool HasJoinColumns => availableColumns.Any(c => c.IsJoin);

    private static string BuildDatasetKey(DatasetDto dataset) => BuildDatasetKey(dataset.Id, dataset.Module);
    private static string BuildDatasetKey(int datasetId, string? module)
    {
        var normalizedModule = string.IsNullOrWhiteSpace(module) ? ModuleInsightMonitor : module;
        return $"{normalizedModule}|{datasetId}";
    }

    private static EntityName[] GetEntityOptions(string? module)
    {
        if (string.Equals(module, ModuleAssetManager, StringComparison.OrdinalIgnoreCase))
        {
            return AssetManagerEntityOptions;
        }

        if (string.Equals(module, ModuleEventManager, StringComparison.OrdinalIgnoreCase))
        {
            return EventManagerEntityOptions;
        }

        if (string.Equals(module, ModuleUrbanMonitor, StringComparison.OrdinalIgnoreCase))
        {
            return UrbanMonitorEntityOptions;
        }

        return InsightMonitorEntityOptions;
    }

    private static EntityName GetDefaultEntityForModule(string? module)
    {
        var options = GetEntityOptions(module);
        return options.Length > 0 ? options[0] : EntityName.Device;
    }

    private static string GetSourceModuleForDataset(string? module)
    {
        if (string.Equals(module, ModuleAssetManager, StringComparison.OrdinalIgnoreCase))
        {
            return ModuleType.AssetManager.ToString();
        }

        if (string.Equals(module, ModuleUrbanMonitor, StringComparison.OrdinalIgnoreCase))
        {
            return ModuleType.UrbanMonitor.ToString();
        }

        if (string.Equals(module, ModuleEventManager, StringComparison.OrdinalIgnoreCase))
        {
            return ModuleType.EventManager.ToString();
        }

        return ModuleType.InsightMonitor.ToString();
    }

    private static string GetDatasetDisplayLabel(DatasetDto dataset)
    {
        if (dataset == null)
        {
            return string.Empty;
        }

        var moduleLabel = string.IsNullOrWhiteSpace(dataset.Module) ? ModuleInsightMonitor : dataset.Module;
        return string.IsNullOrWhiteSpace(moduleLabel) ? dataset.Nombre : $"{dataset.Nombre} ({moduleLabel})";
    }

    private static ModuleType GetModuleTypeForDataset(string? module)
    {
        if (string.Equals(module, ModuleAssetManager, StringComparison.OrdinalIgnoreCase))
        {
            return ModuleType.AssetManager;
        }

        if (string.Equals(module, ModuleUrbanMonitor, StringComparison.OrdinalIgnoreCase))
        {
            return ModuleType.UrbanMonitor;
        }

        if (string.Equals(module, ModuleEventManager, StringComparison.OrdinalIgnoreCase))
        {
            return ModuleType.EventManager;
        }

        return ModuleType.InsightMonitor;
    }

    private static string GetModuleNameFromType(ModuleType moduleType)
    {
        return moduleType switch
        {
            ModuleType.AssetManager => ModuleAssetManager,
            ModuleType.UrbanMonitor => ModuleUrbanMonitor,
            ModuleType.EventManager => ModuleEventManager,
            _ => ModuleInsightMonitor
        };
    }

    private async Task ToggleDatasetSelection(DatasetDto dataset)
    {
        try
        {
            if (selectedDatasets.Any(d => d.Id == dataset.Id && d.Module == dataset.Module))
            {
                // If removing a dataset, clear any joins that reference it
                var joinsToRemove = joins
                    .Where(j => j.LeftDataset == dataset.Nombre || j.RightDataset == dataset.Nombre)
                    .ToList();

                foreach (var join in joinsToRemove)
                {
                    joins.Remove(join);
                }

                selectedDatasets.RemoveAll(d => d.Id == dataset.Id && d.Module == dataset.Module);
                if (string.Equals(dataset.Module, ModuleInsightMonitor, StringComparison.OrdinalIgnoreCase))
                {
                    selectedDatasetsIM.Remove(dataset.Id);
                }
                selectedEntities.Remove(BuildDatasetKey(dataset));

                if (!selectedDatasets.Any())
                {
                    availableColumns.Clear();
                    filters.Clear();
                }
                else if (activeTab == "columnas")
                {
                    UpdateAvailableColumns();
                }
            }
            else
            {
                selectedDatasets.Add(dataset);
                var datasetKey = BuildDatasetKey(dataset);
                if (!selectedEntities.ContainsKey(datasetKey))
                {
                    selectedEntities[datasetKey] = GetDefaultEntityForModule(dataset.Module);
                }

                if (string.Equals(dataset.Module, ModuleInsightMonitor, StringComparison.OrdinalIgnoreCase))
                {
                    var token = await LocalStorage.GetItemAsync<string>("authToken");
                    var responseDataset = !string.IsNullOrEmpty(token)
                        ? await Http.GetAsync($"api/Dataset/GetDataset?datasetId={dataset.Id}")
                        : null;

                    if (responseDataset != null && responseDataset.IsSuccessStatusCode)
                    {
                        var datasetIM = await responseDataset.Content.ReadFromJsonWithEnumSupportAsync<DatasetIM>();
                        if (datasetIM != null)
                        {
                            selectedDatasetsIM[dataset.Id] = datasetIM;
                        }
                    }
                }
            }
            FilterDatasets();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar el dataset: {ex.Message}", Severity.Error);
            Logger?.LogError(ex, "ToggleDatasetSelection error");
        }
        finally
        {
            StateHasChanged();
        }

    }


    private bool IsSelected(DatasetDto dataset)
    {
        return selectedDatasets.Any(d => d.Id == dataset.Id && d.Module == dataset.Module);
    }

    private string _searchText = string.Empty;

    private string searchText
    {
        get => _searchText;
        set
        {
            _searchText = value ?? string.Empty;
            FilterDatasets();
        }
    }

    private void FilterDatasets()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredDatasets = datasets.ToList();
            return;
        }

        var normalizedSearch = NormalizeText(searchText);

        filteredDatasets = datasets
            .Where(d =>
                NormalizeText(d.Nombre).Contains(normalizedSearch) ||
                NormalizeText(d.Module ?? string.Empty).Contains(normalizedSearch) ||
                NormalizeText(d.Descripcion ?? string.Empty).Contains(normalizedSearch))
            .OrderByDescending(d => NormalizeText(d.Nombre) == normalizedSearch) 
            .ThenByDescending(d => NormalizeText(d.Nombre).StartsWith(normalizedSearch)) 
            .ThenBy(d => NormalizeText(d.Nombre).IndexOf(normalizedSearch)) 
            .ThenBy(d => d.Nombre) 
            .ToList();
    }

    private string NormalizeText(string text)
    {
        if (string.IsNullOrEmpty(text))
            return string.Empty;

        var formD = text.Trim().ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD);
        var withoutDiacritics = new string(formD.Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark).ToArray());

        withoutDiacritics = withoutDiacritics
            .Replace(" ", string.Empty)
            .Replace("ñ", "n")
            .Replace("₀", "0").Replace("₁", "1").Replace("₂", "2").Replace("₃", "3").Replace("₄", "4")
            .Replace("₅", "5").Replace("₆", "6").Replace("₇", "7").Replace("₈", "8").Replace("₉", "9");

        return withoutDiacritics.Normalize(System.Text.NormalizationForm.FormC);
    }

    public class JoinDto
    {
        private static int nextId = 1;
        public int Id { get; set; }
        // ID del join creado en el backend (CrossModuleJoin.Id). Null si aún no fue persistido
        public int? ServerJoinId { get; set; }
        public string LeftDataset { get; set; } = string.Empty;
        public string LeftField { get; set; } = string.Empty;
        public string Comparison { get; set; } = "Equal";
        public string JoinType { get; set; } = string.Empty;
        public string RightDataset { get; set; } = string.Empty;
        public string RightField { get; set; } = string.Empty;

        public JoinDto(int id)
        {
            Id = id;
        }

        public static void ResetIdCounter()
        {
            nextId = 1;
        }

        public static int GetNextId()
        {
            return nextId++;
        }
    }

    public class FilterDto
    {
        public int Id { get; set; }
        public string Column { get; set; } = "ID"; 
        public string Operator { get; set; } = "=";
        public string Value { get; set; } = "";

        public FilterDto(int id)
        {
            Id = id;
        }
    }

    private class ColumnSelectionSpec
    {
        public bool IsJoin { get; init; }
        public int? JoinId { get; init; }
        public int DatasetId { get; init; }
        public string ModuleName { get; init; } = string.Empty;
        public EntityName Entity { get; init; }
        public string PropertyName { get; init; } = string.Empty;
        public string? Alias { get; init; }
    }

    private class JoinConfigDetails
    {
        public int JoinId { get; init; }
        public int LeftDatasetId { get; init; }
        public ModuleType LeftModuleType { get; init; }
        public EntityName LeftEntity { get; init; }
        public string LeftField { get; init; } = string.Empty;
        public int RightDatasetId { get; init; }
        public ModuleType RightModuleType { get; init; }
        public EntityName RightEntity { get; init; }
        public string RightField { get; init; } = string.Empty;
        public JoinType JoinType { get; init; }
    }

    private string activeTab = "datasets";

    private List<JoinDto> joins = new();
    private List<FilterDto> filters = new();
    protected override async Task OnInitializedAsync()
    {
        JoinDto.ResetIdCounter();

        string? token = null;
        Report? currentReport = null;

        try
        {
            if (ReportId <= 0)
            {
                NavigationManager.NavigateTo("/reportes");
                return;
            }

            token = await LocalStorage.GetItemAsync<string>("authToken");
            if (string.IsNullOrEmpty(token))
            {
                Snackbar.Add("No se encontró el token de autenticación", Severity.Error);
                return;
            }

            await LoadAvailableJoinsAsync(token);
            var reportResp = await Http.GetAsync($"api/reports/{ReportId}");
            if (reportResp.IsSuccessStatusCode)
            {
                currentReport = await reportResp.Content.ReadFromJsonWithEnumSupportAsync<Report>();
                if (currentReport != null)
                {
                    reportName = currentReport.Name ?? string.Empty;
                    reportDescription = currentReport.Description ?? string.Empty;
                }
            }

            var aggregatedDatasets = new List<DatasetDto>();
            try
            {
                var responseIM = await Http.GetAsync($"api/Dataset/user");
                if (responseIM.IsSuccessStatusCode)
                {
                    var datasetsIM = await responseIM.Content.ReadFromJsonWithEnumSupportAsync<List<DatasetIM>>();
                    aggregatedDatasets.AddRange(datasetsIM?.Select(d => new DatasetDto
                    {
                        Id = d.Id,
                        Nombre = d.Name ?? string.Empty,
                        Descripcion = d.Description ?? "Sin descripción",
                        Module = ModuleInsightMonitor,
                        ContentType = d.ContentType
                    }) ?? new List<DatasetDto>());
                }
                else
                {
                    Logger?.LogWarning("[EditarReporte] No fue posible cargar datasets IM. Status={StatusCode}", responseIM.StatusCode);
                }
            }
            catch (Exception ex)
            {
                Logger?.LogError(ex, "[EditarReporte] Error cargando datasets IM");
                Snackbar.Add("Error al cargar datasets de Insight Monitor", Severity.Warning);
            }
            try
            {
                var responseAM = await Http.GetAsync($"api/DatasetAM/GetAllDatasetAMs");
                if (responseAM.IsSuccessStatusCode)
                {
                    var datasetsAM = await responseAM.Content.ReadFromJsonWithEnumSupportAsync<List<DatasetAM>>();
                    aggregatedDatasets.AddRange(datasetsAM?.Select(d => new DatasetDto
                    {
                        Id = d.Id_Dataset,
                        Nombre = d.Nombre ?? string.Empty,
                        Descripcion = d.Descripcion ?? "Sin descripción",
                        Module = ModuleAssetManager,
                        ContentType = d.ContentType
                    }) ?? new List<DatasetDto>());
                }
                else
                {
                    Logger?.LogWarning("[EditarReporte] No fue posible cargar datasets AM. Status={StatusCode}", responseAM.StatusCode);
                }
            }
            catch (Exception ex)
            {
                Logger?.LogError(ex, "[EditarReporte] Error cargando datasets AM");
                Snackbar.Add("Error al cargar datasets de Asset Manager", Severity.Warning);
            }
            try
            {
                var responseUM = await Http.GetAsync($"api/DatasetUM/GetAllDatasets");
                if (responseUM.IsSuccessStatusCode)
                {
                    var datasetsUM = await responseUM.Content.ReadFromJsonWithEnumSupportAsync<List<DatasetUM>>();
                    aggregatedDatasets.AddRange(datasetsUM?.Select(d => new DatasetDto
                    {
                        Id = d.Id,
                        Nombre = d.Name ?? string.Empty,
                        Descripcion = d.Description ?? "Sin descripción",
                        Module = ModuleUrbanMonitor,
                        ContentType = d.ContentType
                    }) ?? new List<DatasetDto>());
                }
                else
                {
                    Logger?.LogWarning("[EditarReporte] No fue posible cargar datasets UM. Status={StatusCode}", responseUM.StatusCode);
                }
            }
            catch (Exception ex)
            {
                Logger?.LogError(ex, "[EditarReporte] Error cargando datasets UM");
                Snackbar.Add("Error al cargar datasets de Urban Monitor", Severity.Warning);
            }
            try
            {
                var responseEM = await Http.GetAsync($"api/DatasetEM/GetAllDatasets");
                if (responseEM.IsSuccessStatusCode)
                {
                    var datasetsEM = await responseEM.Content.ReadFromJsonWithEnumSupportAsync<List<DatasetEM>>();
                    aggregatedDatasets.AddRange(datasetsEM?.Select(d => new DatasetDto
                    {
                        Id = d.Id,
                        Nombre = d.Name ?? string.Empty,
                        Descripcion = d.Description ?? "Sin descripción",
                        Module = ModuleEventManager,
                        ContentType = d.ContentType
                    }) ?? new List<DatasetDto>());
                }
                else
                {
                    Logger?.LogWarning("[EditarReporte] No fue posible cargar datasets EM. Status={StatusCode}", responseEM.StatusCode);
                }
            }
            catch (Exception ex)
            {
                Logger?.LogError(ex, "[EditarReporte] Error cargando datasets EM");
                Snackbar.Add("Error al cargar datasets de Event Manager", Severity.Warning);
            }

            datasets = aggregatedDatasets
                .OrderBy(d => d.Module)
                .ThenBy(d => d.Nombre)
                .ToList();

            filteredDatasets = datasets.ToList();
            FilterDatasets();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar los datos: {ex.Message}", Severity.Error);
        }

        _nextFilterId = 1;

        if (currentReport != null && !string.IsNullOrEmpty(token))
        {
            await RestoreReportConfigurationAsync(currentReport, token);

            if (!string.IsNullOrWhiteSpace(currentReport.JSON_config))
            {
                await ExecuteReportPreviewAsync(token);
            }
        }
    }

    // --- Métodos de Columnas ---
    private void SelectAllColumns()
    {
        // Marcar todas las columnas como visibles
        foreach (var column in availableColumns)
        {
            column.IsVisible = true;
        }
        StateHasChanged();
    }

    private void DeselectAllColumns()
    {
        // Marcar todas las columnas como no visibles
        foreach (var column in availableColumns)
        {
            column.IsVisible = false;
        }
        StateHasChanged(); // Forzar actualización de la UI
    }

    private void ToggleColumnVisibility(ColumnDefinition column)
    {
        var colToUpdate = availableColumns.FirstOrDefault(c => c.Name == column.Name);
        if (colToUpdate != null)
        {
            colToUpdate.IsVisible = column.IsVisible;
        }
        StateHasChanged();
    }




    // --- Métodos de Joins ---
    private void AgregarJoin()
    {
        joins.Add(new JoinDto(JoinDto.GetNextId()));
    }

    private async Task EliminarJoin(JoinDto join)
    {
        try
        {
            if (join.ServerJoinId.HasValue)
            {
                var token = await LocalStorage.GetItemAsync<string>("authToken");
                if (string.IsNullOrEmpty(token))
                {
                    Snackbar.Add("No se encontró el token de autenticación", Severity.Error);
                }
                else
                {
                    var response = await Http.DeleteAsync($"api/reports/RemoveJoinFromReport?reportId={ReportId}&joinId={join.ServerJoinId.Value}");
                    if (!response.IsSuccessStatusCode)
                    {
                        var error = await response.Content.ReadAsStringAsync();
                        Snackbar.Add($"Error al quitar el join del reporte: {error}", Severity.Error);
                        // Aún así, lo removemos de la UI para que el usuario pueda continuar
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Error al eliminar join del reporte");
            Snackbar.Add($"Error al eliminar el join: {ex.Message}", Severity.Error);
        }
        finally
        {
            // Quitar de la UI
            joins.Remove(join);
            StateHasChanged();
        }
    }
    private async Task AplicarJoins()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token))
        {
            Snackbar.Add("Token de autenticación no encontrado.", Severity.Error);
            return;
        }

        var appliedJoins = 0;
        var encounteredErrors = false;

        foreach (var join in joins)
        {
            try
            {
                if (join.ServerJoinId.HasValue)
                {
                    // Ya asociado en backend, continuar
                    continue;
                }

                if (string.IsNullOrWhiteSpace(join.LeftDataset) || string.IsNullOrWhiteSpace(join.RightDataset))
                {
                    Snackbar.Add($"Seleccione los datasets izquierdo y derecho para el join #{join.Id}", Severity.Warning);
                    encounteredErrors = true;
                    continue;
                }

                if (string.IsNullOrWhiteSpace(join.LeftField) || string.IsNullOrWhiteSpace(join.RightField))
                {
                    Snackbar.Add($"Seleccione los campos del join #{join.Id}", Severity.Warning);
                    encounteredErrors = true;
                    continue;
                }

                if (string.IsNullOrWhiteSpace(join.JoinType))
                {
                    Snackbar.Add($"Seleccione el tipo de join para #{join.Id}", Severity.Warning);
                    encounteredErrors = true;
                    continue;
                }

                var leftDataset = selectedDatasets.FirstOrDefault(d => d.Nombre == join.LeftDataset);
                var rightDataset = selectedDatasets.FirstOrDefault(d => d.Nombre == join.RightDataset);

                if (leftDataset == null || rightDataset == null)
                {
                    Snackbar.Add($"Datasets no encontrados para el join: {join.LeftDataset} - {join.RightDataset}", Severity.Error);
                    encounteredErrors = true;
                    continue;
                }

                var leftEntity = GetSelectedEntity(leftDataset);
                var rightEntity = GetSelectedEntity(rightDataset);

                if (!Enum.TryParse<JoinType>(join.JoinType, true, out var joinType))
                {
                    Snackbar.Add($"Tipo de join desconocido para #{join.Id}: {join.JoinType}", Severity.Error);
                    encounteredErrors = true;
                    continue;
                }

                var leftModuleType = GetModuleTypeForDataset(leftDataset.Module);
                var rightModuleType = GetModuleTypeForDataset(rightDataset.Module);

                var createJoinRequest = new CreateJoinRequestDto
                    {
                        Name = $"Join: {join.LeftDataset} y {join.RightDataset}",
                        Description = string.Empty,
                        JoinType = joinType,
                        LeftOperand = new JoinOperandDto
                        {
                            ModuleType = leftModuleType,
                            DatasetId = leftDataset.Id,
                            EntityName = leftEntity,
                            JoinPropertyName = join.LeftField
                        },
                        RightOperand = new JoinOperandDto
                        {
                            ModuleType = rightModuleType,
                            DatasetId = rightDataset.Id,
                            EntityName = rightEntity,
                            JoinPropertyName = join.RightField
                        }
                    };

                var endpoint = $"api/reports/{ReportId}/joins/create-and-add";
                var createJoinResponse = await Http.PostAsJsonAsync(endpoint, createJoinRequest);

                if (!createJoinResponse.IsSuccessStatusCode)
                {
                    var error = await createJoinResponse.Content.ReadAsStringAsync();
                    Snackbar.Add($"Error al crear la configuración del join #{join.Id}: {error}", Severity.Error);
                    encounteredErrors = true;
                    continue;
                }

                try
                {
                    var rawResponse = await createJoinResponse.Content.ReadAsStringAsync();
                    Logger?.LogInformation("[EditarReporte] create-and-add join {JoinId} response: {Response}", join.Id, rawResponse);

                    if (!string.IsNullOrWhiteSpace(rawResponse))
                    {
                        var createdLink = JsonSerializer.Deserialize<ReportJoin>(rawResponse, new JsonSerializerOptions
                            {
                                PropertyNameCaseInsensitive = true,
                                Converters = { new JsonStringEnumConverter() }
                            });
                        if (createdLink?.CrossModuleJoinId > 0)
                        {
                            join.ServerJoinId = createdLink.CrossModuleJoinId;
                            appliedJoins++;
                            await LogJoinExecutionAsync(createdLink.CrossModuleJoinId);
                        }
                        else
                        {
                            encounteredErrors = true;
                        }
                    }
                    else
                    {
                        Logger?.LogWarning("[EditarReporte] create-and-add join #{JoinId} devolvió un cuerpo vacío", join.Id);
                        encounteredErrors = true;
                    }
                }
                catch (Exception ex)
                {
                    Logger?.LogWarning(ex, "[EditarReporte] No fue posible procesar la respuesta de create-and-add del join #{JoinId}", join.Id);
                    encounteredErrors = true;
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al aplicar join: {ex.Message}", Severity.Error);
                encounteredErrors = true;
            }
        }

        await LoadAvailableJoinsAsync(token);

        if (!encounteredErrors)
        {
            var message = appliedJoins > 0 ? "Joins guardados correctamente." : "Joins actualizados correctamente.";
            Snackbar.Add(message, Severity.Success);
        }

        activeTab = "columnas";
        UpdateAvailableColumns();
        StateHasChanged();
    }

    // --- Métodos de Filtros ---
    private void AgregarFiltro()
    {
        var newFilter = new FilterDto(_nextFilterId++);

        var defaultColumn = availableColumns.FirstOrDefault(c => c.IsVisible)?.Name;
        if (defaultColumn != null)
        {
            newFilter.Column = defaultColumn;
        }

        filters.Add(newFilter);
    }

    private void EliminarFiltro(FilterDto filter)
    {
        filters.Remove(filter);
    }


    // --- Métodos de UI / Tabs ---
    private void SetActiveTab(string tab)
    {
        // Only allow moving to joins if we have at least two datasets
        if (tab == "joins" && selectedDatasets.Count < 2)
        {
            Snackbar.Add("Seleccione al menos dos datasets para configurar joins", Severity.Warning);
            return;
        }

        // Only allow moving to columns if we have at least one dataset
        if (tab == "columnas" && !selectedDatasets.Any())
        {
            Snackbar.Add("Seleccione al menos un dataset para configurar columnas", Severity.Warning);
            return;
        }

        // Log availableColumns when switching to filtros
        if (tab == "filtros")
        {
            try
            {
                var details = string.Join(" | ", availableColumns.Select(c => $"Name={c.Name}, Display={c.DisplayName}, Dataset={c.DatasetName}, Visible={c.IsVisible}"));
                Logger?.LogInformation("[EditarReporte] Tab=filtros, availableColumns Count={Count}. Details: {Details}", availableColumns.Count, details);
            }
            catch (Exception ex)
            {
                Logger?.LogError(ex, "[EditarReporte] Error construyendo log de availableColumns");
            }
        }

        if (tab == "filtros" 
            && !availableColumns.Any(c => c.IsVisible))
        {
            Snackbar.Add("Configure las columnas antes de agregar filtros", Severity.Warning);
            return;
        }

        activeTab = tab;

        // If switching to columns tab, update available columns based on selected datasets
        if (tab == "columnas")
        {
            UpdateAvailableColumns();
        }

        StateHasChanged(); // Forzar actualización de la UI
    }

