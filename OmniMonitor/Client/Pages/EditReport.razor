    private Task HandleFilterColumnChanged((int FilterId, string ColumnKey) args)
    {
        var (filterId, columnKey) = args;

        var filter = filters.FirstOrDefault(f => f.Id == filterId);
        if (filter == null)
        {
            return Task.CompletedTask;
        }

        var column = availableColumns.FirstOrDefault(c => string.Equals(c.FilterKey, columnKey, StringComparison.Ordinal));
        if (column == null)
        {
            Snackbar.Add(Localizer["FilterColumnNotFound"], Severity.Warning);
            return Task.CompletedTask;
        }

        ApplyColumnToFilter(filter, column);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void UpdateAvailableColumns()
    {
        if (!selectedDatasets.Any())
        {
            availableColumns.Clear();
            return;
        }

        // Conservar el estado de visibilidad previo por columna (clave = Nombre completo "Dataset.Prop")
        var previousVisibility = availableColumns
            .GroupBy(c => c.Name)
            .ToDictionary(g => g.Key, g => g.First().IsVisible, StringComparer.OrdinalIgnoreCase);

        var newColumns = new List<ColumnDefinition>();

        var resolvedJoins = joins.Where(TryResolveServerJoinId)
            .Where(j => j.ServerJoinId.HasValue)
            .ToList();

        if (resolvedJoins.Any())
        {
            foreach (var join in resolvedJoins)
            {
                var joinId = join.ServerJoinId!.Value;
                var joinDisplayName = GetJoinDisplayName(joinId);
                AddColumnsForJoin(joinDisplayName, joinId, join, previousVisibility, newColumns);
            }
        }
        else
        {
            foreach (var dataset in selectedDatasets)
            {
                AddColumnsForDataset(dataset, previousVisibility, newColumns);
            }
        }

        // Reemplazar preservando la instancia de la lista para que el binding no se rompa
        availableColumns.Clear();
        availableColumns.AddRange(newColumns);

        StateHasChanged();
    }

    private void AddColumnsForJoin(string joinDisplayName, int joinId, JoinDto join, Dictionary<string, bool> previousVisibility, List<ColumnDefinition> target)
    {
        var leftDataset = selectedDatasets.FirstOrDefault(d => d.Nombre == join.LeftDataset);
        var rightDataset = selectedDatasets.FirstOrDefault(d => d.Nombre == join.RightDataset);

        EntityName? leftEntity = leftDataset != null ? GetSelectedEntity(leftDataset) : (EntityName?)null;
        EntityName? rightEntity = rightDataset != null ? GetSelectedEntity(rightDataset) : (EntityName?)null;

        var useSharedColumns = leftDataset != null
            && rightDataset != null
            && string.Equals(leftDataset.Module, rightDataset.Module, StringComparison.OrdinalIgnoreCase)
            && leftEntity.HasValue
            && rightEntity.HasValue
            && leftEntity.Value == rightEntity.Value;

        var sides = new List<(DatasetDto Dataset, EntityName Entity, string SideKey)>();

        if (leftDataset != null && leftEntity.HasValue)
        {
            sides.Add((leftDataset, leftEntity.Value, "left"));
        }

        if (rightDataset != null && rightEntity.HasValue)
        {
            sides.Add((rightDataset, rightEntity.Value, "right"));
        }

        foreach (var (dataset, entity, sideKey) in sides)
        {
            var datasetLabel = GetDatasetDisplayLabel(dataset);
            var propertyDescriptors = GetEntityPropertyDescriptors(entity);
            foreach (var descriptor in propertyDescriptors)
            {
                var columnName = $"{joinDisplayName}.{entity}.{descriptor.Name}";

                if (useSharedColumns)
                {
                    var existingColumn = target.FirstOrDefault(c => string.Equals(c.Name, columnName, StringComparison.OrdinalIgnoreCase));
                    if (existingColumn != null)
                    {
                        var extraVisibility = GetVisibilityForJoinColumn(previousVisibility, joinDisplayName, dataset, descriptor.Name, columnName, sideKey);
                        if (extraVisibility && !existingColumn.IsVisible)
                        {
                            existingColumn.IsVisible = true;
                        }
                        continue;
                    }
                }

                var isVisible = GetVisibilityForJoinColumn(previousVisibility, joinDisplayName, dataset, descriptor.Name, columnName, sideKey);
                var moduleName = string.IsNullOrWhiteSpace(dataset.Module) ? ModuleInsightMonitor : dataset.Module!;
                var moduleType = GetModuleTypeForDataset(dataset.Module);

                target.Add(new ColumnDefinition
                {
                    Name = columnName,
                    DisplayName = descriptor.Name,
                    DatasetName = dataset.Nombre,
                    GroupLabel = datasetLabel,
                    IsVisible = isVisible,
                    DatasetId = dataset.Id,
                    Entity = entity,
                    PropertyName = descriptor.Name,
                    IsJoin = true,
                    JoinId = joinId,
                    JoinDisplayName = joinDisplayName,
                    ModuleName = moduleName,
                    ModuleType = moduleType,
                    PropertyType = descriptor.ClrType,
                    FilterValueType = descriptor.ValueType,
                    EnumOptions = descriptor.EnumOptions
                });
            }
        }
    }

    private static bool GetVisibilityForJoinColumn(Dictionary<string, bool> previousVisibility, string joinDisplayName, DatasetDto dataset, string propertyName, string columnName, string sideKey)
    {
        if (previousVisibility.TryGetValue(columnName, out var value))
        {
            return value;
        }

        if (previousVisibility.TryGetValue($"{joinDisplayName}.{sideKey}.{dataset.Id}.{propertyName}", out value))
        {
            return value;
        }

        if (previousVisibility.TryGetValue($"{joinDisplayName}.{dataset.Id}.{propertyName}", out value))
        {
            return value;
        }

        if (previousVisibility.TryGetValue($"{dataset.Nombre}.{propertyName}", out value))
        {
            return value;
        }

        return false;
    }

    private void AddColumnsForDataset(DatasetDto dataset, Dictionary<string, bool> previousVisibility, List<ColumnDefinition> target)
    {
        var entity = GetSelectedEntity(dataset);
        var props = GetEntityPropertyDescriptors(entity);
        var datasetLabel = GetDatasetDisplayLabel(dataset);
        var moduleName = string.IsNullOrWhiteSpace(dataset.Module) ? ModuleInsightMonitor : dataset.Module!;
        var moduleType = GetModuleTypeForDataset(dataset.Module);
        foreach (var prop in props)
        {
            var columnKey = $"{dataset.Nombre}.{prop.Name}";
            var isVisible = previousVisibility.TryGetValue(columnKey, out var prev) ? prev : false;
            target.Add(new ColumnDefinition
            {
                Name = columnKey,
                DisplayName = prop.Name,
                DatasetName = dataset.Nombre,
                GroupLabel = datasetLabel,
                IsVisible = isVisible,
                DatasetId = dataset.Id,
                Entity = entity,
                PropertyName = prop.Name,
                IsJoin = false,
                JoinId = null,
                JoinDisplayName = null,
                ModuleName = moduleName,
                ModuleType = moduleType,
                PropertyType = prop.ClrType,
                FilterValueType = prop.ValueType,
                EnumOptions = prop.EnumOptions
            });
        }
    }

    private bool TryResolveServerJoinId(JoinDto join)
    {
        if (join.ServerJoinId.HasValue)
            return true;

        if (userJoins == null || userJoins.Count == 0)
            return false;

        var leftDataset = selectedDatasets.FirstOrDefault(d => d.Nombre == join.LeftDataset);
        var rightDataset = selectedDatasets.FirstOrDefault(d => d.Nombre == join.RightDataset);
        if (leftDataset == null || rightDataset == null)
            return false;

        var leftEntity = GetSelectedEntity(leftDataset);
        var rightEntity = GetSelectedEntity(rightDataset);

        if (!Enum.TryParse<JoinType>(join.JoinType, true, out var joinType))
            return false;

        foreach (var candidate in userJoins)
        {
            if (candidate.JoinType != joinType)
                continue;

            if (JoinMatches(candidate.LeftOperand, candidate.RightOperand,
                    leftDataset.Id, leftEntity, join.LeftField,
                    rightDataset.Id, rightEntity, join.RightField))
            {
                join.ServerJoinId = candidate.Id;
                return true;
            }

            if (JoinMatches(candidate.LeftOperand, candidate.RightOperand,
                    rightDataset.Id, rightEntity, join.RightField,
                    leftDataset.Id, leftEntity, join.LeftField))
            {
                join.ServerJoinId = candidate.Id;
                return true;
            }
        }

        return false;
    }

    private static bool JoinMatches(JoinOperandDto leftOperand, JoinOperandDto rightOperand,
        int expectedLeftDatasetId, EntityName expectedLeftEntity, string expectedLeftField,
        int expectedRightDatasetId, EntityName expectedRightEntity, string expectedRightField)
    {
        if (leftOperand == null || rightOperand == null)
            return false;

        var leftMatch = leftOperand.DatasetId == expectedLeftDatasetId
            && leftOperand.EntityName == expectedLeftEntity
            && string.Equals(leftOperand.JoinPropertyName, expectedLeftField, StringComparison.OrdinalIgnoreCase);

        var rightMatch = rightOperand.DatasetId == expectedRightDatasetId
            && rightOperand.EntityName == expectedRightEntity
            && string.Equals(rightOperand.JoinPropertyName, expectedRightField, StringComparison.OrdinalIgnoreCase);

        return leftMatch && rightMatch;
    }

    private string GetJoinDisplayName(int joinId) => Localizer["JoinDisplayName", joinId];

    private async Task LoadAvailableJoinsAsync(string token)
    {
        try
        {
            var response = await Http.GetAsync($"api/reports/joins/by-user");
            if (response.IsSuccessStatusCode)
            {
                var joinsFromApi = await response.Content.ReadFromJsonWithEnumSupportAsync<List<CrossModuleJoinDto>>();
                userJoins = joinsFromApi ?? new List<CrossModuleJoinDto>();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Logger?.LogWarning("[EditarReporte] No se pudieron obtener los joins del usuario. Status={StatusCode}. Body={Body}", response.StatusCode, error);
            }
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "[EditarReporte] Error al cargar los joins del usuario");
        }
    }

    private async Task RestoreReportConfigurationAsync(Report report, string token)
    {
        if (report == null || string.IsNullOrWhiteSpace(report.JSON_config))
        {
            return;
        }

        ReportJsonConfig? config;
        try
        {
            config = JsonSerializer.Deserialize<ReportJsonConfig>(report.JSON_config, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                Converters = { new JsonStringEnumConverter() }
            });
        }
        catch (Exception ex)
        {
            Logger?.LogWarning(ex, "[EditarReporte] No se pudo deserializar JSON_config para el reporte {ReportId}", ReportId);
            return;
        }

        if (config?.Sources == null || !config.Sources.Any())
        {
            return;
        }

        joins.Clear();
        selectedDatasets.Clear();
        selectedDatasetsIM.Clear();
        selectedEntities.Clear();
        availableColumns.Clear();
        filters.Clear();
        JoinDto.ResetIdCounter();

        var datasetSelections = new List<(int DatasetId, string ModuleName)>();
        var entityOverrides = new Dictionary<string, EntityName>(StringComparer.OrdinalIgnoreCase);
        var joinDetails = new List<JoinConfigDetails>();
        var columnSelections = new List<ColumnSelectionSpec>();

        foreach (var source in config.Sources)
        {
            if (source == null)
            {
                continue;
            }

            if (string.Equals(source.SourceType, "dataset", StringComparison.OrdinalIgnoreCase) && source.SourceId.HasValue)
            {
                var moduleType = source.SourceModule ?? ModuleType.InsightMonitor;
                var moduleName = GetModuleNameFromType(moduleType);
                if (!datasetSelections.Any(d => d.DatasetId == source.SourceId.Value && string.Equals(d.ModuleName, moduleName, StringComparison.OrdinalIgnoreCase)))
                {
                    datasetSelections.Add((source.SourceId.Value, moduleName));
                }

                if (source.EntityName.HasValue)
                {
                    var overrideKey = BuildDatasetKey(source.SourceId.Value, moduleName);
                    entityOverrides[overrideKey] = source.EntityName.Value;
                }

                foreach (var column in source.Columns ?? Enumerable.Empty<ReportColumnConfig>())
                {
                    if (!TryParseAttribute(column?.Attribute, out var entity, out var property))
                    {
                        continue;
                    }

                    columnSelections.Add(new ColumnSelectionSpec
                    {
                        IsJoin = false,
                        DatasetId = source.SourceId.Value,
                        ModuleName = moduleName,
                        Entity = entity,
                        PropertyName = property,
                        Alias = column?.As
                    });
                }

                continue;
            }

            if (string.Equals(source.SourceType, "join", StringComparison.OrdinalIgnoreCase) && source.SourceId.HasValue)
            {
                var joinId = source.SourceId.Value;
                var detail = BuildJoinConfigDetails(report, joinId) ?? BuildJoinConfigDetailsFromUserJoins(joinId);
                if (detail == null)
                {
                    Logger?.LogWarning("[EditarReporte] No se encontró información del join {JoinId} para restaurar la configuración", joinId);
                    continue;
                }

                var leftModuleName = GetModuleNameFromType(detail.LeftModuleType);
                if (!datasetSelections.Any(d => d.DatasetId == detail.LeftDatasetId && string.Equals(d.ModuleName, leftModuleName, StringComparison.OrdinalIgnoreCase)))
                {
                    datasetSelections.Add((detail.LeftDatasetId, leftModuleName));
                }

                var rightModuleName = GetModuleNameFromType(detail.RightModuleType);
                if (!datasetSelections.Any(d => d.DatasetId == detail.RightDatasetId && string.Equals(d.ModuleName, rightModuleName, StringComparison.OrdinalIgnoreCase)))
                {
                    datasetSelections.Add((detail.RightDatasetId, rightModuleName));
                }

                entityOverrides[BuildDatasetKey(detail.LeftDatasetId, leftModuleName)] = detail.LeftEntity;
                entityOverrides[BuildDatasetKey(detail.RightDatasetId, rightModuleName)] = detail.RightEntity;
                joinDetails.Add(detail);

                foreach (var column in source.Columns ?? Enumerable.Empty<ReportColumnConfig>())
                {
                    if (!TryParseAttribute(column?.Attribute, out var entity, out var property))
                    {
                        continue;
                    }

                    columnSelections.Add(new ColumnSelectionSpec
                    {
                        IsJoin = true,
                        JoinId = joinId,
                        ModuleName = string.Empty,
                        Entity = entity,
                        PropertyName = property,
                        Alias = column?.As
                    });
                }
            }
        }

        if (report?.ReportJoins != null)
        {
            foreach (var link in report.ReportJoins)
            {
                if (link == null || link.CrossModuleJoinId <= 0)
                {
                    continue;
                }

                if (joinDetails.Any(j => j.JoinId == link.CrossModuleJoinId))
                {
                    continue;
                }

                var detail = BuildJoinConfigDetails(report, link.CrossModuleJoinId) ?? BuildJoinConfigDetailsFromUserJoins(link.CrossModuleJoinId);
                if (detail == null)
                {
                    continue;
                }

                var leftModuleName = GetModuleNameFromType(detail.LeftModuleType);
                if (!datasetSelections.Any(d => d.DatasetId == detail.LeftDatasetId && string.Equals(d.ModuleName, leftModuleName, StringComparison.OrdinalIgnoreCase)))
                {
                    datasetSelections.Add((detail.LeftDatasetId, leftModuleName));
                }

                var rightModuleName = GetModuleNameFromType(detail.RightModuleType);
                if (!datasetSelections.Any(d => d.DatasetId == detail.RightDatasetId && string.Equals(d.ModuleName, rightModuleName, StringComparison.OrdinalIgnoreCase)))
                {
                    datasetSelections.Add((detail.RightDatasetId, rightModuleName));
                }

                var leftKey = BuildDatasetKey(detail.LeftDatasetId, leftModuleName);
                if (!entityOverrides.ContainsKey(leftKey))
                {
                    entityOverrides[leftKey] = detail.LeftEntity;
                }

                var rightKey = BuildDatasetKey(detail.RightDatasetId, rightModuleName);
                if (!entityOverrides.ContainsKey(rightKey))
                {
                    entityOverrides[rightKey] = detail.RightEntity;
                }

                joinDetails.Add(detail);
            }
        }

        foreach (var selectionEntry in datasetSelections)
        {
            await EnsureDatasetSelectedAsync(selectionEntry.DatasetId, selectionEntry.ModuleName, token);
        }

        foreach (var kvp in entityOverrides)
        {
            var dataset = selectedDatasets.FirstOrDefault(d => string.Equals(BuildDatasetKey(d), kvp.Key, StringComparison.OrdinalIgnoreCase));
            if (dataset == null)
            {
                continue;
            }
            var options = GetEntityOptions(dataset.Module);
            var entityToApply = options.Contains(kvp.Value) ? kvp.Value : GetDefaultEntityForModule(dataset.Module);
            selectedEntities[BuildDatasetKey(dataset)] = entityToApply;
        }

        foreach (var detail in joinDetails)
        {
            var leftModuleName = GetModuleNameFromType(detail.LeftModuleType);
            var rightModuleName = GetModuleNameFromType(detail.RightModuleType);
            var leftDataset = selectedDatasets.FirstOrDefault(d => d.Id == detail.LeftDatasetId && string.Equals(d.Module, leftModuleName, StringComparison.OrdinalIgnoreCase));
            var rightDataset = selectedDatasets.FirstOrDefault(d => d.Id == detail.RightDatasetId && string.Equals(d.Module, rightModuleName, StringComparison.OrdinalIgnoreCase));

            if (leftDataset == null || rightDataset == null)
            {
                Logger?.LogWarning("[EditarReporte] No se pudieron resolver datasets para el join {JoinId}", detail.JoinId);
                continue;
            }

            var joinDto = new JoinDto(JoinDto.GetNextId())
            {
                ServerJoinId = detail.JoinId,
                LeftDataset = leftDataset.Nombre,
                LeftField = detail.LeftField,
                RightDataset = rightDataset.Nombre,
                RightField = detail.RightField,
                JoinType = detail.JoinType.ToString(),
                Comparison = "Equal"
            };

            joins.Add(joinDto);
        }

        UpdateAvailableColumns();
        ApplyColumnSelections(columnSelections);
        RestoreFiltersFromConfig(report.JSON_filters);
        FilterDatasets();
        StateHasChanged();
    }

    private JoinConfigDetails? BuildJoinConfigDetails(Report report, int joinId)
    {
        var link = report.ReportJoins?.FirstOrDefault(rj => rj.CrossModuleJoinId == joinId);
        if (link?.CrossModuleJoin == null)
        {
            return null;
        }

        var cross = link.CrossModuleJoin;
        if (cross.LeftOperand == null || cross.RightOperand == null)
        {
            return null;
        }

        return new JoinConfigDetails
        {
            JoinId = joinId,
            LeftDatasetId = cross.LeftOperand.DatasetId,
            LeftModuleType = cross.LeftOperand.ModuleType,
            LeftEntity = cross.LeftOperand.EntityName,
            LeftField = cross.LeftOperand.JoinPropertyName,
            RightDatasetId = cross.RightOperand.DatasetId,
            RightModuleType = cross.RightOperand.ModuleType,
            RightEntity = cross.RightOperand.EntityName,
            RightField = cross.RightOperand.JoinPropertyName,
            JoinType = cross.JoinType
        };
    }

    private JoinConfigDetails? BuildJoinConfigDetailsFromUserJoins(int joinId)
    {
        var join = userJoins?.FirstOrDefault(j => j.Id == joinId);
        if (join == null || join.LeftOperand == null || join.RightOperand == null)
        {
            return null;
        }

        return new JoinConfigDetails
        {
            JoinId = joinId,
            LeftDatasetId = join.LeftOperand.DatasetId,
            LeftModuleType = join.LeftOperand.ModuleType,
            LeftEntity = join.LeftOperand.EntityName,
            LeftField = join.LeftOperand.JoinPropertyName,
            RightDatasetId = join.RightOperand.DatasetId,
            RightModuleType = join.RightOperand.ModuleType,
            RightEntity = join.RightOperand.EntityName,
            RightField = join.RightOperand.JoinPropertyName,
            JoinType = join.JoinType
        };
    }

    private async Task EnsureDatasetSelectedAsync(int datasetId, string moduleName, string token)
    {
        var moduleComparer = StringComparer.OrdinalIgnoreCase;

        if (selectedDatasets.Any(d => d.Id == datasetId && moduleComparer.Equals(d.Module, moduleName)))
        {
            var existingDataset = selectedDatasets.First(d => d.Id == datasetId && moduleComparer.Equals(d.Module, moduleName));
            var existingKey = BuildDatasetKey(existingDataset);
            if (!selectedEntities.ContainsKey(existingKey))
            {
                selectedEntities[existingKey] = GetDefaultEntityForModule(existingDataset.Module);
            }
            if (string.Equals(existingDataset.Module, ModuleInsightMonitor, StringComparison.OrdinalIgnoreCase)
                && !selectedDatasetsIM.ContainsKey(datasetId)
                && !string.IsNullOrEmpty(token))
            {
                await PrefetchDatasetDetailsAsync(existingDataset, token);
            }
            return;
        }

        var dataset = datasets.FirstOrDefault(d => d.Id == datasetId && moduleComparer.Equals(d.Module, moduleName));
        if (dataset == null)
        {
            Logger?.LogWarning("[EditarReporte] Dataset {DatasetId} ({Module}) no está disponible para restaurar la configuración", datasetId, moduleName);
            return;
        }

        selectedDatasets.Add(dataset);
        var datasetKey = BuildDatasetKey(dataset);
        if (!selectedEntities.ContainsKey(datasetKey))
        {
            selectedEntities[datasetKey] = EntityName.Device;
        }

        if (!string.IsNullOrEmpty(token))
        {
            await PrefetchDatasetDetailsAsync(dataset, token);
        }
    }

    private async Task PrefetchDatasetDetailsAsync(DatasetDto dataset, string token)
    {
        if (!string.Equals(dataset.Module, ModuleInsightMonitor, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }
        try
        {
            var responseDataset = await Http.GetAsync($"api/Dataset/GetDataset?datasetId={dataset.Id}");
            if (!responseDataset.IsSuccessStatusCode)
            {
                var error = await responseDataset.Content.ReadAsStringAsync();
                Logger?.LogWarning("[EditarReporte] No se pudieron obtener los detalles del dataset {DatasetId}. Status={StatusCode}. Body={Body}", dataset.Id, responseDataset.StatusCode, error);
                return;
            }

            var datasetIM = await responseDataset.Content.ReadFromJsonWithEnumSupportAsync<DatasetIM>();
            if (datasetIM == null)
            {
                return;
            }

            selectedDatasetsIM[dataset.Id] = datasetIM;
        }
        catch (Exception ex)
        {
            Logger?.LogWarning(ex, "[EditarReporte] No se pudo recuperar detalles del dataset {DatasetId}", dataset.Id);
        }
    }

    private void ApplyColumnSelections(IEnumerable<ColumnSelectionSpec> selections)
    {
        foreach (var selection in selections)
        {
            ColumnDefinition? column;
            if (selection.IsJoin)
            {
                column = availableColumns.FirstOrDefault(c =>
                    c.IsJoin &&
                    c.JoinId == selection.JoinId &&
                    c.Entity == selection.Entity &&
                    string.Equals(c.PropertyName, selection.PropertyName, StringComparison.OrdinalIgnoreCase));
            }
            else
            {
                DatasetDto? datasetForSelection = null;
                if (!string.IsNullOrWhiteSpace(selection.ModuleName))
                {
                    datasetForSelection = selectedDatasets.FirstOrDefault(d => d.Id == selection.DatasetId && string.Equals(d.Module, selection.ModuleName, StringComparison.OrdinalIgnoreCase))
                        ?? datasets.FirstOrDefault(d => d.Id == selection.DatasetId && string.Equals(d.Module, selection.ModuleName, StringComparison.OrdinalIgnoreCase));
                }
                else
                {
                    datasetForSelection = selectedDatasets.FirstOrDefault(d => d.Id == selection.DatasetId)
                        ?? datasets.FirstOrDefault(d => d.Id == selection.DatasetId);
                }

                column = availableColumns.FirstOrDefault(c =>
                    !c.IsJoin &&
                    c.DatasetId == selection.DatasetId &&
                    (datasetForSelection == null || string.Equals(c.DatasetName, datasetForSelection.Nombre, StringComparison.OrdinalIgnoreCase)) &&
                    c.Entity == selection.Entity &&
                    string.Equals(c.PropertyName, selection.PropertyName, StringComparison.OrdinalIgnoreCase));

                if (column == null)
                {
                    column = availableColumns.FirstOrDefault(c =>
                        c.IsJoin &&
                        c.DatasetId == selection.DatasetId &&
                        (datasetForSelection == null || string.Equals(c.DatasetName, datasetForSelection.Nombre, StringComparison.OrdinalIgnoreCase)) &&
                        c.Entity == selection.Entity &&
                        string.Equals(c.PropertyName, selection.PropertyName, StringComparison.OrdinalIgnoreCase));
                }
            }

            if (column == null)
            {
                Logger?.LogWarning("[EditarReporte] No se encontró la columna {Property} ({Entity}) para restaurar la configuración", selection.PropertyName, selection.Entity);
                continue;
            }

            column.IsVisible = true;

            if (!string.IsNullOrWhiteSpace(selection.Alias))
            {
                column.DisplayName = selection.Alias;
            }
        }
    }

    private static bool TryParseAttribute(string? attribute, out EntityName entity, out string propertyName)
    {
        entity = default;
        propertyName = string.Empty;

        if (string.IsNullOrWhiteSpace(attribute))
        {
            return false;
        }

        var separatorIndex = attribute.IndexOf('_');
        if (separatorIndex <= 0 || separatorIndex >= attribute.Length - 1)
        {
            return false;
        }

        var entityPart = attribute.Substring(0, separatorIndex);
        var propertyPart = attribute.Substring(separatorIndex + 1);

        if (!Enum.TryParse<EntityName>(entityPart, true, out entity))
        {
            return false;
        }

        propertyName = propertyPart;
        return true;
    }

    private async Task LogJoinExecutionAsync(int joinId)
    {
