    }

    private async Task GenerarJsonConfig()
    {
        try
        {
            // Tomar columnas visibles
            var visibleColumns = availableColumns.Where(c => c.IsVisible).ToList();

            if (!selectedDatasets.Any())
            {
                Snackbar.Add("Seleccione al menos un dataset antes de guardar.", Severity.Warning);
                return;
            }

            if (!visibleColumns.Any())
            {
                Snackbar.Add("Seleccione al menos una columna visible antes de guardar.", Severity.Warning);
                return;
            }

            var sources = new List<object>();
            var datasetColumns = visibleColumns.Where(c => !c.IsJoin).ToList();
            var joinColumns = visibleColumns.Where(c => c.IsJoin).ToList();

            if (datasetColumns.Any())
            {
                string ResolveDatasetModule(ColumnDefinition column)
                {
                    var dataset = selectedDatasets.FirstOrDefault(d => d.Id == column.DatasetId && string.Equals(d.Nombre, column.DatasetName, StringComparison.OrdinalIgnoreCase))
                        ?? datasets.FirstOrDefault(d => d.Id == column.DatasetId && string.Equals(d.Nombre, column.DatasetName, StringComparison.OrdinalIgnoreCase))
                        ?? selectedDatasets.FirstOrDefault(d => d.Id == column.DatasetId)
                        ?? datasets.FirstOrDefault(d => d.Id == column.DatasetId);

                    return dataset?.Module ?? string.Empty;
                }

                var datasetGroups = datasetColumns
                    .GroupBy(c => new
                    {
                        DatasetId = c.DatasetId,
                        Module = ResolveDatasetModule(c)
                    });

                foreach (var group in datasetGroups)
                {
                    if (group.Key.DatasetId <= 0)
                    {
                        continue;
                    }

                    var columns = group.Select(c =>
                    {
                        var alias = string.IsNullOrWhiteSpace(c.DisplayName) ? c.PropertyName : c.DisplayName;
                        var attribute = $"{c.Entity}_{c.PropertyName}";
                        return new Dictionary<string, string>
                        {
                            ["attribute"] = attribute,
                            ["as"] = alias
                        };
                    }).ToList();

                    if (!columns.Any())
                    {
                        continue;
                    }

                    var representative = group.First();
                    var entity = representative.Entity;
                    var selectedDataset = selectedDatasets.FirstOrDefault(d => d.Id == group.Key.DatasetId && string.Equals(d.Module, group.Key.Module, StringComparison.OrdinalIgnoreCase))
                        ?? datasets.FirstOrDefault(d => d.Id == group.Key.DatasetId && string.Equals(d.Module, group.Key.Module, StringComparison.OrdinalIgnoreCase))
                        ?? selectedDatasets.FirstOrDefault(d => d.Id == group.Key.DatasetId)
                        ?? datasets.FirstOrDefault(d => d.Id == group.Key.DatasetId);
                    var sourceModule = GetSourceModuleForDataset(selectedDataset?.Module);

                    sources.Add(new
                    {
                        sourceType = "dataset",
                        sourceModule,
                        sourceId = group.Key.DatasetId,
                        entityName = entity.ToString(),
                        columns
                    });
                }
            }

            if (joinColumns.Any())
            {
                var unresolvedJoinColumns = joinColumns.Where(c => !c.JoinId.HasValue).ToList();
                if (unresolvedJoinColumns.Any())
                {
                    Snackbar.Add("Hay columnas de joins sin un join aplicado. Guarde los joins antes de generar el reporte.", Severity.Warning);
                    Logger?.LogWarning("[EditarReporte] Columnas de join sin JoinId: {Columns}", string.Join(", ", unresolvedJoinColumns.Select(c => c.Name)));
                }

                var joinGroups = joinColumns
                    .Where(c => c.JoinId.HasValue)
                    .GroupBy(c => c.JoinId!.Value);

                foreach (var group in joinGroups)
                {
                    var columns = group.Select(c =>
                    {
                        var alias = string.IsNullOrWhiteSpace(c.DisplayName) ? c.PropertyName : c.DisplayName;
                        var attribute = $"{c.Entity}_{c.PropertyName}";
                        return new Dictionary<string, string>
                        {
                            ["attribute"] = attribute,
                            ["as"] = alias
                        };
                    }).ToList();

                    if (!columns.Any())
                    {
                        continue;
                    }

                    sources.Add(new
                    {
                        sourceType = "join",
                        sourceId = group.Key,
                        columns
                    });
                }
            }

            if (!sources.Any())
            {
                Snackbar.Add("No se encontraron columnas visibles para generar el reporte.", Severity.Warning);
                return;
            }

            var payload = new
            {
                sources = sources
            };

            var json = JsonSerializer.Serialize(payload, new JsonSerializerOptions
            {
                WriteIndented = true
            });

            try
            {
                await JS.InvokeVoidAsync("console.log", "UpdateReport JSON_config payload", json);
            }
            catch (Exception ex)
            {
                Logger?.LogWarning(ex, "[EditarReporte] No fue posible registrar JSON_config en la consola del navegador");
            }

            // Guardar en backend (UpdateReport) y luego ejecutar
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (string.IsNullOrEmpty(token))
            {
                Snackbar.Add("No se encontró el token de autenticación", Severity.Error);
                return;
            }

            isSaving = true;
            StateHasChanged();


            UpdateReportRequestDto updateRequest = new UpdateReportRequestDto
                {
                    Name = reportName,
                    Description = reportDescription,
                    JSON_config = json
                };

            var url = $"api/reports/UpdateReport?id={ReportId}";
            var putResp = await Http.PutAsJsonAsync(url, updateRequest);
            isSaving = false;

            if (!putResp.IsSuccessStatusCode)
            {
                var err = await putResp.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al guardar el reporte: {putResp.StatusCode}", Severity.Error);
                Logger?.LogWarning("[EditarReporte] UpdateReport falló con estado {StatusCode}. Body: {Body}", putResp.StatusCode, err);
                return;
            }

            Snackbar.Add("Reporte guardado correctamente", Severity.Success);
            Logger?.LogInformation("[EditarReporte] UpdateReport completado correctamente");

            await ExecuteReportPreviewAsync(token);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error generando el JSON: {ex.Message}", Severity.Error);
        }
    }

    private async Task ExecuteReportPreviewAsync(string token)
    {
        try
        {
            isExecuting = true;
            executeRows.Clear();
            executeColumns.Clear();
            previewExecuted = false;
            StateHasChanged();

            var execUrl = $"api/reports/{ReportId}/execute?id={ReportId}";
            var execResp = await Http.GetAsync(execUrl);
            isExecuting = false;

            if (!execResp.IsSuccessStatusCode)
            {
                var err = await execResp.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al ejecutar el reporte: {execResp.StatusCode}", Severity.Error);
                Logger?.LogWarning("[EditarReporte] ExecuteReport falló con estado {StatusCode}. Body: {Body}", execResp.StatusCode, err);
                return;
            }

            var execText = await execResp.Content.ReadAsStringAsync();

            try
            {
                using var doc = JsonDocument.Parse(execText);
                if (doc.RootElement.ValueKind == JsonValueKind.Array)
                {
                    var columns = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    foreach (var el in doc.RootElement.EnumerateArray())
                    {
                        if (el.ValueKind != JsonValueKind.Object)
                        {
                            continue;
                        }

                        var row = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
                        foreach (var prop in el.EnumerateObject())
                        {
                            columns.Add(prop.Name);
                            row[prop.Name] = prop.Value.ValueKind switch
                            {
                                JsonValueKind.String => prop.Value.GetString(),
                                JsonValueKind.Number => prop.Value.ToString(),
                                JsonValueKind.True => "true",
                                JsonValueKind.False => "false",
                                JsonValueKind.Null => null,
                                _ => prop.Value.ToString()
                            };
                        }
                        executeRows.Add(row);
                    }

                    executeColumns = columns.OrderBy(c => c).ToList();
                    previewExecuted = true;
                }
                else
                {
                    Snackbar.Add("La respuesta de ejecución no es una lista", Severity.Warning);
                }
            }
            catch (Exception ex)
            {
                Logger?.LogError(ex, "[EditarReporte] Error al procesar respuesta de ExecuteReport");
                Snackbar.Add("Error al procesar la respuesta de ejecución", Severity.Error);
            }
            finally
            {
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            isExecuting = false;
            Logger?.LogError(ex, "[EditarReporte] Error ejecutando vista previa del reporte");
            Snackbar.Add($"Error al ejecutar el reporte: {ex.Message}", Severity.Error);
            StateHasChanged();
        }
    }

    private EntityName GetSelectedEntity(DatasetDto dataset)
    {
        var key = BuildDatasetKey(dataset);
        if (selectedEntities.TryGetValue(key, out var e))
        {
            var allowed = GetEntityOptions(dataset.Module);
            if (allowed.Contains(e))
            {
                return e;
            }
        }

        var defaultEntity = GetDefaultEntityForModule(dataset.Module);
        selectedEntities[key] = defaultEntity;
        return defaultEntity;
    }

    private void OnEntityChanged(DatasetDto dataset, EntityName entity)
    {
        var options = GetEntityOptions(dataset.Module);
        if (!options.Contains(entity))
        {
            entity = GetDefaultEntityForModule(dataset.Module);
        }

        selectedEntities[BuildDatasetKey(dataset)] = entity;
        UpdateAvailableColumns();
        StateHasChanged();
    }

    private IEnumerable<string> GetEntityPropertyNamesForDatasetName(string datasetName)
    {
        var ds = selectedDatasets.FirstOrDefault(d => d.Nombre == datasetName);
        if (ds == null) return Enumerable.Empty<string>();
        var entity = GetSelectedEntity(ds);
        return GetEntityPropertyNames(entity);
    }

    private static IEnumerable<string> GetEntityPropertyNames(EntityName entity)
    {
        Type? t = entity switch
        {
            EntityName.Device => typeof(Device),
            EntityName.Source => typeof(Source),
            EntityName.Group => typeof(DeviceGroup),
            EntityName.Sensor => typeof(Sensor),
            EntityName.EventAM => typeof(EventTaskDto),
            EntityName.Stock => typeof(StockDto),
            EntityName.Asset => typeof(AssetDto),
            EntityName.Alert => typeof(AlertDto),
            EntityName.EventEM => typeof(EventDto),
            EntityName.Extension => typeof(ExtensionDto),
            EntityName.Categoria => typeof(CategoryDto),
            EntityName.Zone => typeof(Zone),
            EntityName.EventUM => typeof(Event),
            EntityName.New => typeof(News),
            _ => null
        };

        if (t == null) return Array.Empty<string>();

        // Tomar propiedades públicas simples (excluir colecciones complejas)
        return t.GetProperties(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance)
            .Where(p => IsSimplePropertyType(p.PropertyType))
            .Select(p => p.Name)
            .ToList();
    }

    private static bool IsSimplePropertyType(Type type)
    {
        if (type.IsGenericType && typeof(System.Collections.IEnumerable).IsAssignableFrom(type))
            return false; // excluir listas y colecciones
        if (type == typeof(string)) return true;
        if (type.IsPrimitive) return true;
        if (type == typeof(decimal) || type == typeof(DateTime) || type == typeof(DateTimeOffset)) return true;
        if (Nullable.GetUnderlyingType(type) is Type inner)
            return IsSimplePropertyType(inner);
        return false;
    }

    private void UpdateJoinFields(JoinDto join)
    {
        if (string.IsNullOrEmpty(join.LeftDataset) || string.IsNullOrEmpty(join.RightDataset))
        {
            join.LeftField = string.Empty; // Use empty string instead of null
            join.RightField = string.Empty; // Use empty string instead of null
        }
        StateHasChanged();
    }
