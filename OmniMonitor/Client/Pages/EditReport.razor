        }
    }

    private bool TryBuildFiltersConfig(out ReportFiltersConfig? filtersConfig)
    {
        filtersConfig = null;

        if (!filters.Any())
        {
            return true;
        }

        var config = new ReportFiltersConfig();

        foreach (var group in filters.GroupBy(f => new { f.DatasetId, f.ModuleType }))
        {
            if (group.Key.DatasetId <= 0)
            {
                Snackbar.Add(Localizer["FilterDatasetMissing"], Severity.Warning);
                return false;
            }

            var datasetFilter = new DatasetFilterConfig
            {
                DatasetId = group.Key.DatasetId,
                ModuleType = group.Key.ModuleType
            };

            foreach (var filter in group)
            {
                if (!TryBuildFilterCondition(filter, out var condition, out var errorMessage))
                {
                    if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        Snackbar.Add(errorMessage, Severity.Warning);
                    }
                    else
                    {
                        Snackbar.Add(Localizer["FilterValidationFailed"], Severity.Warning);
                    }
                    return false;
                }

                datasetFilter.Filters.Add(condition);
            }

            if (datasetFilter.Filters.Any())
            {
                config.DatasetFilters.Add(datasetFilter);
            }
        }

        if (!config.DatasetFilters.Any())
        {
            filtersConfig = null;
            return true;
        }

        filtersConfig = config;
        return true;
    }

    private bool TryBuildFilterCondition(FilterViewModel filter, out FilterCondition condition, out string? errorMessage)
    {
        condition = null!;
        errorMessage = null;

        var attributeName = string.IsNullOrWhiteSpace(filter.AttributeName)
            ? filter.PropertyName
            : filter.AttributeName;

        if (string.IsNullOrWhiteSpace(attributeName))
        {
            errorMessage = Localizer["FilterAttributeMissing"];
            return false;
        }

        object? value = null;

        switch (filter.ValueType)
        {
            case FilterValueType.String:
                var stringValue = filter.StringValue?.Trim();
                if (string.IsNullOrEmpty(stringValue))
                {
                    errorMessage = Localizer["FilterValueRequired", filter.DisplayLabel ?? filter.PropertyName];
                    return false;
                }
                value = stringValue;
                break;

            case FilterValueType.Number:
                if (!filter.NumericValue.HasValue)
                {
                    errorMessage = Localizer["FilterValueRequired", filter.DisplayLabel ?? filter.PropertyName];
                    return false;
                }
                value = filter.NumericValue.Value;
                break;

            case FilterValueType.Date:
                if (filter.FilterType == FilterType.Between)
                {
                    if (!filter.DateValue.HasValue || !filter.DateValueTo.HasValue)
                    {
                        errorMessage = Localizer["FilterRangeRequired", filter.DisplayLabel ?? filter.PropertyName];
                        return false;
                    }

                    value = new object[]
                    {
                        filter.DateValue.Value.ToString("O"),
                        filter.DateValueTo.Value.ToString("O")
                    };
                }
                else
                {
                    if (!filter.DateValue.HasValue)
                    {
                        errorMessage = Localizer["FilterValueRequired", filter.DisplayLabel ?? filter.PropertyName];
                        return false;
                    }

                    value = filter.DateValue.Value.ToString("O");
                }
                break;

            case FilterValueType.Boolean:
                if (!filter.BooleanValue.HasValue)
                {
                    errorMessage = Localizer["FilterValueRequired", filter.DisplayLabel ?? filter.PropertyName];
                    return false;
                }
                value = filter.BooleanValue.Value;
                break;

            case FilterValueType.Enum:
                if (filter.FilterType == FilterType.In)
                {
                    var enumValues = filter.EnumValues?.Where(v => !string.IsNullOrWhiteSpace(v)).Select(v => (object)v).ToList() ?? new List<object>();
                    if (!enumValues.Any())
                    {
                        errorMessage = Localizer["FilterValueRequired", filter.DisplayLabel ?? filter.PropertyName];
                        return false;
                    }
                    value = enumValues;
                }
                else
                {
                    var enumValue = string.IsNullOrWhiteSpace(filter.EnumValue) ? filter.StringValue : filter.EnumValue;
                    if (string.IsNullOrWhiteSpace(enumValue))
                    {
                        errorMessage = Localizer["FilterValueRequired", filter.DisplayLabel ?? filter.PropertyName];
                        return false;
                    }
                    value = enumValue;
                }
                break;

            default:
                errorMessage = Localizer["FilterValueRequired", filter.DisplayLabel ?? filter.PropertyName];
                return false;
        }

        condition = new FilterCondition
        {
            AttributeName = attributeName,
            Type = filter.FilterType,
            ValueType = filter.ValueType,
            Condition = value!
        };

        return true;
    }

    private void RestoreFiltersFromConfig(string? jsonFilters)
    {
        if (string.IsNullOrWhiteSpace(jsonFilters))
        {
            return;
        }

        try
        {
            var serializerOptions = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                Converters = { new JsonStringEnumConverter() }
            };

            var filtersConfig = JsonSerializer.Deserialize<ReportFiltersConfig>(jsonFilters, serializerOptions);
            if (filtersConfig?.DatasetFilters == null)
            {
                return;
            }

            foreach (var datasetFilter in filtersConfig.DatasetFilters)
            {
                if (datasetFilter.Filters == null)
                {
                    continue;
                }

                foreach (var condition in datasetFilter.Filters)
                {
                    var column = availableColumns.FirstOrDefault(c =>
                        c.DatasetId == datasetFilter.DatasetId &&
                        c.ModuleType == datasetFilter.ModuleType &&
                        (string.Equals(c.PropertyName, condition.AttributeName, StringComparison.OrdinalIgnoreCase) ||
                         string.Equals(c.AttributeName, condition.AttributeName, StringComparison.OrdinalIgnoreCase)));

                    if (column == null)
                    {
                        Logger?.LogWarning("[EditarReporte] No se encontró la columna para restaurar el filtro DatasetId={DatasetId}, ModuleType={ModuleType}, Attribute={Attribute}", datasetFilter.DatasetId, datasetFilter.ModuleType, condition.AttributeName);
                        continue;
                    }

                    column.IsVisible = true;

                    var filter = CreateFilterFromColumn(column, _nextFilterId++);
                    filter.FilterType = condition.Type;
                    ApplyConditionToFilter(filter, condition);
                    filters.Add(filter);
                }
            }
        }
        catch (Exception ex)
        {
            Logger?.LogWarning(ex, "[EditarReporte] Error restaurando filtros desde JSON_filters");
        }
    }

    private void ApplyConditionToFilter(FilterViewModel filter, FilterCondition condition)
    {
        filter.FilterType = condition.Type;

        if (condition.ValueType != filter.ValueType)
        {
            filter.ValueType = condition.ValueType;
        }

        ResetFilterValues(filter);

        switch (filter.ValueType)
        {
            case FilterValueType.String:
                filter.StringValue = ExtractStringValue(condition.Condition);
                break;

            case FilterValueType.Number:
                filter.NumericValue = ExtractDoubleValue(condition.Condition);
                break;

            case FilterValueType.Date:
                if (filter.FilterType == FilterType.Between)
                {
                    var (start, end) = ExtractDateRange(condition.Condition);
                    filter.DateValue = start;
                    filter.DateValueTo = end;
                }
                else
                {
                    filter.DateValue = ExtractDateValue(condition.Condition);
                }
                break;

            case FilterValueType.Boolean:
                filter.BooleanValue = ExtractBooleanValue(condition.Condition);
                break;

            case FilterValueType.Enum:
                if (filter.FilterType == FilterType.In)
                {
                    var enumValues = ExtractStringList(condition.Condition);
                    filter.EnumValues = new HashSet<string>(enumValues, StringComparer.OrdinalIgnoreCase);
                }
                else
                {
                    filter.EnumValue = ExtractStringValue(condition.Condition);
                }
                break;
        }
    }

    private static string? ExtractStringValue(object? rawValue)
    {
        return rawValue switch
        {
            null => null,
            string s => s,
            JsonElement element when element.ValueKind == JsonValueKind.String => element.GetString(),
            JsonElement element when element.ValueKind == JsonValueKind.Number || element.ValueKind == JsonValueKind.True || element.ValueKind == JsonValueKind.False => element.ToString(),
            _ => rawValue?.ToString()
        };
    }

    private static double? ExtractDoubleValue(object? rawValue)
    {
        return rawValue switch
        {
            null => null,
            double d => d,
            float f => f,
            decimal dec => (double)dec,
            int i => i,
            long l => l,
            JsonElement element when element.ValueKind == JsonValueKind.Number => element.GetDouble(),
            JsonElement element when element.ValueKind == JsonValueKind.String && double.TryParse(element.GetString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsed) => parsed,
            string s when double.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsedString) => parsedString,
            _ => null
        };
    }

    private static DateTime? ExtractDateValue(object? rawValue)
    {
        return rawValue switch
        {
            null => null,
            DateTime dt => dt,
            JsonElement element when element.ValueKind == JsonValueKind.String && DateTime.TryParse(element.GetString(), out var parsed) => parsed,
            JsonElement element when element.ValueKind == JsonValueKind.Number && long.TryParse(element.GetRawText(), out var ticks) => new DateTime(ticks),
            string s when DateTime.TryParse(s, out var parsedString) => parsedString,
            _ => null
        };
    }

    private static (DateTime? Start, DateTime? End) ExtractDateRange(object? rawValue)
    {
        if (rawValue == null)
        {
            return (null, null);
        }

        if (rawValue is JsonElement element && element.ValueKind == JsonValueKind.Array)
        {
            var items = element.EnumerateArray().ToArray();
            var start = items.Length > 0 ? ExtractDateValue(items[0]) : null;
            var end = items.Length > 1 ? ExtractDateValue(items[1]) : null;
            return (start, end);
        }

        if (rawValue is IEnumerable<object> enumerable)
        {
            var list = enumerable.Select(ExtractDateValue).ToList();
            var start = list.Count > 0 ? list[0] : null;
            var end = list.Count > 1 ? list[1] : null;
            return (start, end);
        }

        if (rawValue is object[] array)
        {
            var start = array.Length > 0 ? ExtractDateValue(array[0]) : null;
            var end = array.Length > 1 ? ExtractDateValue(array[1]) : null;
            return (start, end);
        }

        return (ExtractDateValue(rawValue), null);
    }

    private static bool? ExtractBooleanValue(object? rawValue)
    {
        return rawValue switch
        {
            null => null,
            bool b => b,
            JsonElement element when element.ValueKind == JsonValueKind.True => true,
            JsonElement element when element.ValueKind == JsonValueKind.False => false,
            string s when bool.TryParse(s, out var parsed) => parsed,
            _ => null
        };
    }

    private static IEnumerable<string> ExtractStringList(object? rawValue)
    {
        if (rawValue == null)
        {
            return Array.Empty<string>();
        }

        if (rawValue is JsonElement element)
        {
            if (element.ValueKind == JsonValueKind.Array)
            {
                var list = new List<string>();
                foreach (var item in element.EnumerateArray())
                {
                    if (item.ValueKind == JsonValueKind.String)
                    {
                        var value = item.GetString();
                        if (!string.IsNullOrWhiteSpace(value))
                        {
                            list.Add(value);
                        }
                    }
                    else if (item.ValueKind == JsonValueKind.Number || item.ValueKind == JsonValueKind.True || item.ValueKind == JsonValueKind.False)
                    {
                        list.Add(item.ToString());
                    }
                }
                return list;
            }

            if (element.ValueKind == JsonValueKind.String)
            {
                var single = element.GetString();
                return string.IsNullOrWhiteSpace(single) ? Array.Empty<string>() : new[] { single };
            }
        }

        if (rawValue is IEnumerable<string> stringEnumerable)
        {
            return stringEnumerable.Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
        }

        if (rawValue is IEnumerable<object> objectEnumerable)
        {
            return objectEnumerable.Select(o => o?.ToString() ?? string.Empty).Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
        }

        if (rawValue is string singleValue)
        {
            return string.IsNullOrWhiteSpace(singleValue) ? Array.Empty<string>() : new[] { singleValue };
        }

        var converted = rawValue.ToString();
        return string.IsNullOrWhiteSpace(converted) ? Array.Empty<string>() : new[] { converted };
    }

    // --- Generar JSON de configuración ---
    private async Task GenerarJsonConfig()
    {
        try
        {
            // Tomar columnas visibles
            var visibleColumns = availableColumns.Where(c => c.IsVisible).ToList();

            if (!selectedDatasets.Any())
            {
                Snackbar.Add(Localizer["SelectDatasetBeforeSave"], Severity.Warning);
                return;
            }

            if (!visibleColumns.Any())
            {
                Snackbar.Add(Localizer["SelectVisibleColumnBeforeSave"], Severity.Warning);
                return;
            }

            var sources = new List<object>();
            var datasetColumns = visibleColumns.Where(c => !c.IsJoin).ToList();
            var joinColumns = visibleColumns.Where(c => c.IsJoin).ToList();

            if (datasetColumns.Any())
            {
                string ResolveDatasetModule(ColumnDefinition column)
                {
                    var dataset = selectedDatasets.FirstOrDefault(d => d.Id == column.DatasetId && string.Equals(d.Nombre, column.DatasetName, StringComparison.OrdinalIgnoreCase))
                        ?? datasets.FirstOrDefault(d => d.Id == column.DatasetId && string.Equals(d.Nombre, column.DatasetName, StringComparison.OrdinalIgnoreCase))
                        ?? selectedDatasets.FirstOrDefault(d => d.Id == column.DatasetId)
                        ?? datasets.FirstOrDefault(d => d.Id == column.DatasetId);

                    return dataset?.Module ?? string.Empty;
                }

                var datasetGroups = datasetColumns
                    .GroupBy(c => new
                    {
                        DatasetId = c.DatasetId,
                        Module = ResolveDatasetModule(c)
                    });

                foreach (var group in datasetGroups)
                {
                    if (group.Key.DatasetId <= 0)
                    {
                        continue;
                    }

                    var columns = group.Select(c =>
                    {
                        var alias = string.IsNullOrWhiteSpace(c.DisplayName) ? c.PropertyName : c.DisplayName;
                        var attribute = $"{c.Entity}_{c.PropertyName}";
                        return new Dictionary<string, string>
                        {
                            ["attribute"] = attribute,
                            ["as"] = alias
                        };
                    }).ToList();

                    if (!columns.Any())
                    {
                        continue;
                    }

                    var representative = group.First();
                    var entity = representative.Entity;
                    var selectedDataset = selectedDatasets.FirstOrDefault(d => d.Id == group.Key.DatasetId && string.Equals(d.Module, group.Key.Module, StringComparison.OrdinalIgnoreCase))
                        ?? datasets.FirstOrDefault(d => d.Id == group.Key.DatasetId && string.Equals(d.Module, group.Key.Module, StringComparison.OrdinalIgnoreCase))
                        ?? selectedDatasets.FirstOrDefault(d => d.Id == group.Key.DatasetId)
                        ?? datasets.FirstOrDefault(d => d.Id == group.Key.DatasetId);
                    var sourceModule = GetSourceModuleForDataset(selectedDataset?.Module);

                    sources.Add(new
                    {
                        sourceType = "dataset",
                        sourceModule,
                        sourceId = group.Key.DatasetId,
                        entityName = entity.ToString(),
                        columns
                    });
                }
            }

            if (joinColumns.Any())
            {
                var unresolvedJoinColumns = joinColumns.Where(c => !c.JoinId.HasValue).ToList();
                if (unresolvedJoinColumns.Any())
                {
                    Snackbar.Add(Localizer["JoinColumnsWithoutJoin"], Severity.Warning);
                    Logger?.LogWarning("[EditarReporte] Columnas de join sin JoinId: {Columns}", string.Join(", ", unresolvedJoinColumns.Select(c => c.Name)));
                }

                var joinGroups = joinColumns
                    .Where(c => c.JoinId.HasValue)
                    .GroupBy(c => c.JoinId!.Value);

                foreach (var group in joinGroups)
                {
                    var columns = group.Select(c =>
                    {
                        var alias = string.IsNullOrWhiteSpace(c.DisplayName) ? c.PropertyName : c.DisplayName;
                        var attribute = $"{c.Entity}_{c.PropertyName}";
                        return new Dictionary<string, string>
                        {
                            ["attribute"] = attribute,
                            ["as"] = alias
                        };
                    }).ToList();

                    if (!columns.Any())
                    {
                        continue;
                    }

                    sources.Add(new
                    {
                        sourceType = "join",
                        sourceId = group.Key,
                        columns
                    });
                }
            }

            if (!sources.Any())
            {
                Snackbar.Add(Localizer["NoVisibleColumns"], Severity.Warning);
                return;
            }

            var payload = new
            {
                sources = sources
            };

            var json = JsonSerializer.Serialize(payload, new JsonSerializerOptions
            {
                WriteIndented = true
            });

            if (!TryBuildFiltersConfig(out var filtersPayload))
            {
                return;
            }

            try
            {
                await JS.InvokeVoidAsync("console.log", "UpdateReport JSON_config payload", json);
            }
            catch (Exception ex)
            {
                Logger?.LogWarning(ex, "[EditarReporte] No fue posible registrar JSON_config en la consola del navegador");
            }

            // Guardar en backend (UpdateReport) y luego ejecutar
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (string.IsNullOrEmpty(token))
            {
                Snackbar.Add(Localizer["AuthTokenNotFound"], Severity.Error);
                return;
            }

            isSaving = true;
            StateHasChanged();

            Console.WriteLine($"UpdateReport JSON_config payload: {json}");

            UpdateReportRequestDto updateRequest = new UpdateReportRequestDto
                {
                    Name = reportName,
                    Description = reportDescription,
                    JSON_config = json,
                    Filters = filtersPayload
                };

            var url = $"api/reports/UpdateReport?id={ReportId}";
            var putResp = await Http.PutAsJsonAsync(url, updateRequest);
            isSaving = false;

            if (!putResp.IsSuccessStatusCode)
            {
                var err = await putResp.Content.ReadAsStringAsync();
                Snackbar.Add(Localizer["SaveReportError", putResp.StatusCode], Severity.Error);
                Logger?.LogWarning("[EditarReporte] UpdateReport falló con estado {StatusCode}. Body: {Body}", putResp.StatusCode, err);
                return;
            }

            Snackbar.Add(Localizer["ReportSaved"], Severity.Success);
            Logger?.LogInformation("[EditarReporte] UpdateReport completado correctamente");

            await ExecuteReportPreviewAsync(token);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Localizer["JsonGenerationError", ex.Message], Severity.Error);
        }
    }

    private async Task ExecuteReportPreviewAsync(string token)
    {
        try
        {
            isExecuting = true;
            executeRows.Clear();
            executeColumns.Clear();
            previewExecuted = false;
            StateHasChanged();

            var execUrl = $"api/reports/{ReportId}/execute?id={ReportId}";
            var execResp = await Http.GetAsync(execUrl);
            isExecuting = false;

            if (!execResp.IsSuccessStatusCode)
            {
                var err = await execResp.Content.ReadAsStringAsync();
                Snackbar.Add(Localizer["ExecuteReportStatusError", execResp.StatusCode], Severity.Error);
                Logger?.LogWarning("[EditarReporte] ExecuteReport falló con estado {StatusCode}. Body: {Body}", execResp.StatusCode, err);
                return;
            }

            var execText = await execResp.Content.ReadAsStringAsync();

            try
            {
                using var doc = JsonDocument.Parse(execText);
                if (doc.RootElement.ValueKind == JsonValueKind.Array)
                {
                    var columns = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    foreach (var el in doc.RootElement.EnumerateArray())
                    {
                        if (el.ValueKind != JsonValueKind.Object)
                        {
                            continue;
                        }

                        var row = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
                        foreach (var prop in el.EnumerateObject())
                        {
                            columns.Add(prop.Name);
                            row[prop.Name] = prop.Value.ValueKind switch
                            {
                                JsonValueKind.String => prop.Value.GetString(),
                                JsonValueKind.Number => prop.Value.ToString(),
                                JsonValueKind.True => "true",
                                JsonValueKind.False => "false",
                                JsonValueKind.Null => null,
                                _ => prop.Value.ToString()
                            };
                        }
                        executeRows.Add(row);
                    }

                    executeColumns = columns.OrderBy(c => c).ToList();
                    previewExecuted = true;
                }
                else
                {
                    Snackbar.Add(Localizer["ExecutionResponseNotList"], Severity.Warning);
                }
            }
            catch (Exception ex)
            {
                Logger?.LogError(ex, "[EditarReporte] Error al procesar respuesta de ExecuteReport");
                Snackbar.Add(Localizer["ExecutionResponseProcessError"], Severity.Error);
            }
            finally
            {
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            isExecuting = false;
            Logger?.LogError(ex, "[EditarReporte] Error ejecutando vista previa del reporte");
            Snackbar.Add(Localizer["ExecuteReportError", ex.Message], Severity.Error);
            StateHasChanged();
        }
    }

    private EntityName GetSelectedEntity(DatasetDto dataset)
    {
        var key = BuildDatasetKey(dataset);
        if (selectedEntities.TryGetValue(key, out var e))
        {
            var allowed = GetEntityOptions(dataset.Module);
            if (allowed.Contains(e))
            {
                return e;
            }
        }

        var defaultEntity = GetDefaultEntityForModule(dataset.Module);
        selectedEntities[key] = defaultEntity;
        return defaultEntity;
    }

    private void OnEntityChanged(DatasetDto dataset, EntityName entity)
    {
        var options = GetEntityOptions(dataset.Module);
        if (!options.Contains(entity))
        {
            entity = GetDefaultEntityForModule(dataset.Module);
        }

        selectedEntities[BuildDatasetKey(dataset)] = entity;
        UpdateAvailableColumns();
        StateHasChanged();
    }

    private IEnumerable<string> GetEntityPropertyNamesForDatasetName(string datasetName)
    {
        var ds = selectedDatasets.FirstOrDefault(d => d.Nombre == datasetName);
        if (ds == null) return Enumerable.Empty<string>();
        var entity = GetSelectedEntity(ds);
        return GetEntityPropertyDescriptors(entity).Select(p => p.Name);
    }

    private static IEnumerable<PropertyDescriptor> GetEntityPropertyDescriptors(EntityName entity)
    {
        Type? t = entity switch
        {
            EntityName.Device => typeof(Device),
            EntityName.Source => typeof(Source),
            EntityName.Group => typeof(DeviceGroup),
            EntityName.Sensor => typeof(Sensor),
            EntityName.EventAM => typeof(EventTaskDto),
            EntityName.Stock => typeof(StockDto),
            EntityName.Asset => typeof(AssetDto),
            EntityName.Alert => typeof(AlertDto),
            EntityName.EventEM => typeof(EventDto),
            EntityName.Extension => typeof(ExtensionDto),
            EntityName.Categoria => typeof(CategoryDto),
            EntityName.Zone => typeof(Zone),
            EntityName.EventUM => typeof(Event),
            EntityName.New => typeof(News),
            _ => null
        };

        if (t == null) return Array.Empty<PropertyDescriptor>();

        return t.GetProperties(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance)
            .Where(p => IsFilterableProperty(p.PropertyType))
            .Select(p => new PropertyDescriptor(p.Name, p.PropertyType, MapToFilterValueType(p.PropertyType), GetEnumOptions(p.PropertyType)))
            .ToList();
    }

    private static bool IsFilterableProperty(Type type)
    {
        var underlying = Nullable.GetUnderlyingType(type) ?? type;
        if (underlying.IsEnum) return true;
        if (underlying == typeof(string)) return true;
        if (underlying == typeof(bool)) return true;
        if (underlying == typeof(DateTime) || underlying == typeof(DateTimeOffset)) return true;
        if (IsNumericType(underlying)) return true;
        return false;
    }

    private static bool IsNumericType(Type type)
    {
        return type == typeof(byte) || type == typeof(sbyte) ||
               type == typeof(short) || type == typeof(ushort) ||
               type == typeof(int) || type == typeof(uint) ||
               type == typeof(long) || type == typeof(ulong) ||
               type == typeof(float) || type == typeof(double) ||
               type == typeof(decimal);
    }

    private static FilterValueType MapToFilterValueType(Type type)
    {
        var underlying = Nullable.GetUnderlyingType(type) ?? type;
        if (underlying.IsEnum) return FilterValueType.Enum;
        if (underlying == typeof(string)) return FilterValueType.String;
        if (underlying == typeof(bool)) return FilterValueType.Boolean;
        if (underlying == typeof(DateTime) || underlying == typeof(DateTimeOffset)) return FilterValueType.Date;
        if (IsNumericType(underlying)) return FilterValueType.Number;
        return FilterValueType.String;
    }

    private static IReadOnlyList<string> GetEnumOptions(Type type)
    {
        var underlying = Nullable.GetUnderlyingType(type) ?? type;
        if (underlying.IsEnum)
        {
            return Enum.GetNames(underlying);
        }
        return Array.Empty<string>();
    }

    private void UpdateJoinFields(JoinDto join)
    {
        // Limpiar los campos de unión al cambiar el dataset
        if (string.IsNullOrEmpty(join.LeftDataset) || string.IsNullOrEmpty(join.RightDataset))
        {
            join.LeftField = string.Empty; // Use empty string instead of null
            join.RightField = string.Empty; // Use empty string instead of null
        }
        StateHasChanged();
    }
