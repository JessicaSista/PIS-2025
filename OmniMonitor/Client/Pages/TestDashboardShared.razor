@page "/dashboard-share-tester"
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@using System.Text.Json
@using System.ComponentModel.DataAnnotations

<div class="container mx-auto p-4 md:p-8 font-sans">
    <header class="text-center mb-8">
        <h1 class="text-4xl font-bold text-gray-800">Prueba de Enlaces Compartidos</h1>
        <p class="text-gray-600 mt-2">Página para probar la creación y validación de enlaces para dashboards.</p>
    </header>

    <!-- Session Token Card -->
    <div class="card mb-8 max-w-2xl mx-auto">
        <h2 class="text-2xl font-semibold mb-4 text-gray-700">Autenticación</h2>
        <div class="flex items-end space-x-2">
            <div class="flex-grow">
                <label for="session-token" class="form-label">Token de Sesión (de Local Storage)</label>
                <input @bind="sessionToken" id="session-token" class="form-input font-mono" placeholder="Pega tu token aquí si no se carga automáticamente..." />
            </div>
            <button class="btn btn-secondary" @onclick="LoadTokenFromLocalStorage">Cargar Token</button>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- Columna de Acciones -->
        <div class="space-y-6">
            <div class="card">
                <h2 class="text-2xl font-semibold mb-4 text-gray-700">1. Crear Enlace Compartido</h2>
                <EditForm Model="@shareRequest" OnValidSubmit="HandleCreateShareLink" class="space-y-4">
                    <DataAnnotationsValidator />

                    <div>
                        <label class="form-label">ID del Dashboard a Compartir</label>
                        <InputNumber @bind-Value="dashboardId" class="form-input" />
                    </div>

                    <div>
                        <label class="form-label">Visibilidad</label>
                        <InputSelect @bind-Value="shareRequest.Visibility" class="form-input">
                            <option value="public">Público</option>
                            <option value="private">Privado</option>
                        </InputSelect>
                    </div>

                    @if (shareRequest.Visibility == "private")
                    {
                        <div>
                            <label class="form-label">Contraseña (requerida para privado)</label>
                            <InputText @bind-Value="shareRequest.Password" type="password" class="form-input" />
                        </div>
                    }

                    <div>
                        <label class="form-label">Fecha de Expiración (Opcional)</label>
                        <InputDate @bind-Value="expiresAtDate" class="form-input" />
                    </div>

                    <button type="submit" class="btn btn-primary w-full h-12">Generar Enlace</button>
                </EditForm>
            </div>

            <!-- --- NUEVA TARJETA PARA VALIDACIÓN --- -->
            <div class="card">
                <h2 class="text-2xl font-semibold mb-4 text-gray-700">2. Validar Enlace Privado</h2>
                <EditForm Model="@validationRequest" OnValidSubmit="HandleValidatePassword" class="space-y-4">
                    <DataAnnotationsValidator />
                    <div>
                        <label class="form-label">Slug del Enlace</label>
                        <InputText @bind-Value="slugToValidate" class="form-input" placeholder="Pega el slug aquí (ej: a8f3bZp1oK)" />
                    </div>
                    <div>
                        <label class="form-label">Contraseña</label>
                        <InputText @bind-Value="validationRequest.Password" type="password" class="form-input" />
                    </div>
                    <button type="submit" class="btn btn-success w-full h-12">Validar Contraseña</button>
                </EditForm>
            </div>
        </div>

        <!-- Columna de Resultados -->
        <div class="lg:col-span-1">
            <div class="card sticky top-8">
                <h2 class="text-2xl font-semibold mb-4 text-gray-700">Resultados de la API</h2>
                <div class="bg-gray-800 text-white rounded-md p-4 min-h-[30rem] max-h-[80vh] overflow-y-auto font-mono text-sm">
                    <pre><code>@resultJson</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        background-color: white;
        border-radius: 0.5rem;
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        padding: 1.5rem;
    }

    .btn {
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        font-weight: 600;
        color: white;
        transition: background-color 200ms;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-primary {
        background-color: #2563eb;
    }

        .btn-primary:hover {
            background-color: #1d4ed8;
        }

    .btn-secondary {
        background-color: #6b7280;
    }

        .btn-secondary:hover {
            background-color: #4b5563;
        }

    .btn-success {
        background-color: #16a34a;
    }

        .btn-success:hover {
            background-color: #15803d;
        }

    .form-input {
        margin-top: 0.25rem;
        display: block;
        width: 100%;
        border-radius: 0.375rem;
        border: 1px solid #d1d5db;
        padding: 0.5rem;
    }

    .form-label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        color: #374151;
    }
</style>


@code {
    private const string ApiBaseUrl = "api/dashboard";

    // --- State Variables ---
    private string sessionToken = "";
    private string resultJson = "Completa un formulario y haz clic en un botón...";

    // Para crear
    private int dashboardId;
    private ShareRequestDto shareRequest = new();
    private DateTime? expiresAtDate;

    // --- NUEVAS VARIABLES PARA VALIDAR ---
    private string slugToValidate = "";
    private ValidateSharePasswordRequestDto validationRequest = new();

    // --- Lifecycle and Data Loading ---
    protected override async Task OnInitializedAsync()
    {
        await LoadTokenFromLocalStorage();
    }

    private async Task LoadTokenFromLocalStorage()
    {
        try { sessionToken = await LocalStorage.GetItemAsync<string>("authToken") ?? ""; } catch { }
        StateHasChanged();
    }

    // --- Action Handlers ---
    private async Task HandleCreateShareLink()
    {
        if (string.IsNullOrWhiteSpace(sessionToken))
        {
            DisplayResult(new { Error = "Se requiere un token de sesión." });
            return;
        }
        if (dashboardId == 0)
        {
            DisplayResult(new { Error = "Por favor, introduce un ID de Dashboard." });
            return;
        }

        shareRequest.ExpiresAt = expiresAtDate;
        var fullUrl = $"{ApiBaseUrl}/{dashboardId}/share?token={sessionToken}";

        DisplayResult($"Llamando a: POST {fullUrl}");

        try
        {
            var response = await Http.PostAsJsonAsync(fullUrl, shareRequest);
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var parsedJson = JsonSerializer.Deserialize<object>(content);
                // Si la creación es exitosa, auto-rellena el campo 'slug' para la validación
                if (parsedJson is JsonElement el && el.TryGetProperty("slug", out var slugElement))
                {
                    slugToValidate = slugElement.GetString() ?? "";
                }
                DisplayResult(new { Message = "Enlace creado con éxito", Url = fullUrl, Response = parsedJson });
            }
            else
            {
                DisplayResult(new { Error = $"Fallo en la llamada a la API (Status: {response.StatusCode})", Url = fullUrl, Details = content });
            }
        }
        catch (Exception ex)
        {
            DisplayResult(new { Error = $"Fallo en POST {fullUrl}", ex.Message });
        }
    }

    // --- NUEVA FUNCIÓN DE VALIDACIÓN ---
    private async Task HandleValidatePassword()
    {
        if (string.IsNullOrWhiteSpace(slugToValidate))
        {
            DisplayResult(new { Error = "Por favor, introduce un 'slug' para validar." });
            return;
        }

        // Construye la URL según tu controlador
        var fullUrl = $"{ApiBaseUrl}/ValidateShare/{slugToValidate}/validate";
        DisplayResult($"Llamando a: POST {fullUrl}");

        try
        {
            var response = await Http.PostAsJsonAsync(fullUrl, validationRequest);
            var content = await response.Content.ReadAsStringAsync();
            var parsedJson = JsonSerializer.Deserialize<object>(content);

            if (response.IsSuccessStatusCode)
            {
                DisplayResult(new { Message = "Validación Exitosa (Contraseña Correcta)", Url = fullUrl, Response = parsedJson });
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                DisplayResult(new { Warning = "Validación Fallida (Contraseña Incorrecta)", Url = fullUrl, Response = parsedJson });
            }
            else
            {
                DisplayResult(new { Error = $"Fallo en la llamada a la API (Status: {response.StatusCode})", Url = fullUrl, Details = content });
            }
        }
        catch (Exception ex)
        {
            DisplayResult(new { Error = $"Fallo en POST {fullUrl}", ex.Message });
        }
    }

    private void DisplayResult(object data)
    {
        resultJson = JsonSerializer.Serialize(data, new JsonSerializerOptions
        {
            WriteIndented = true,
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
    }

    // --- DTOs (Basados en tu definición) ---
    public class ShareRequestDto
    {
        [Required]
        public string Visibility { get; set; } = "public";
        public DateTime? ExpiresAt { get; set; }
        public string? Password { get; set; }
    }

    // --- NUEVOS DTOS PARA VALIDACIÓN ---
    public class ValidateSharePasswordRequestDto
    {
        public string Password { get; set; }
    }

    public class ValidateSharePasswordResponseDto
    {
        public bool IsValid { get; set; }
        public int? DashboardId { get; set; }
    }
}

