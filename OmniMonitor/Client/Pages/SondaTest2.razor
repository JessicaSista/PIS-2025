@page "/sonda-test-sources-groups"
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http
@using System.Net.Http.Json

<PageTitle>Prueba Sources y DeviceGroups</PageTitle>

<h3>Prueba Sources</h3>

<div class="mb-3">
    <button class="btn btn-primary me-2" @onclick="GetAllSourcesAsync" disabled="@isLoadingSources">
        @if (isLoadingSources)
        {
            <span class="spinner-border spinner-border-sm"></span>
            <span class="ms-1">Cargando...</span>
        }
        else
        {
            <span>Obtener Todos los Sources</span>
        }
    </button>

    <input type="number" class="form-control d-inline-block w-auto" placeholder="ID Source" @bind="sourceId" />

    <button class="btn btn-secondary ms-2" @onclick="GetSourceByIdAsync" disabled="@isLoadingSources">
        @if (isLoadingSources)
        {
            <span class="spinner-border spinner-border-sm"></span>
            <span class="ms-1">Cargando...</span>
        }
        else
        {
            <span>Obtener Source por ID</span>
        }
    </button>
</div>

@if (!string.IsNullOrEmpty(errorSources))
{
    <div class="alert alert-danger">@errorSources</div>
}

@if (sources != null && sources.Any())
{
    <ul>
        @foreach (var s in sources)
        {
            <li>@s.Id - @s.Name (@(s.IsActive ? "Activo" : "Inactivo"))</li>
        }
    </ul>
}

@if (selectedSource != null)
{
    <div class="alert alert-info">
        <strong>Source Seleccionado:</strong> @selectedSource.Id - @selectedSource.Name
    </div>
}

<hr />

<h3>Prueba DeviceGroups</h3>

<div class="mb-3">
    <button class="btn btn-primary me-2" @onclick="GetAllDeviceGroupsAsync" disabled="@isLoadingGroups">
        @if (isLoadingGroups)
        {
            <span class="spinner-border spinner-border-sm"></span>
            <span class="ms-1">Cargando...</span>
        }
        else
        {
            <span>Obtener Todos los Groups</span>
        }
    </button>

    <input type="number" class="form-control d-inline-block w-auto" placeholder="ID Group" @bind="groupId" />

    <button class="btn btn-secondary ms-2" @onclick="GetDeviceGroupByIdAsync" disabled="@isLoadingGroups">
        @if (isLoadingGroups)
        {
            <span class="spinner-border spinner-border-sm"></span>
            <span class="ms-1">Cargando...</span>
        }
        else
        {
            <span>Obtener Group por ID</span>
        }
    </button>
</div>

@if (!string.IsNullOrEmpty(errorGroups))
{
    <div class="alert alert-danger">@errorGroups</div>
}

@if (groups != null && groups.Any())
{
    <ul>
        @foreach (var g in groups)
        {
            <li>@g.Id - @g.Name (@(g.IsActive ? "Activo" : "Inactivo"))</li>
        }
    </ul>
}

@if (selectedGroup != null)
{
    <div class="alert alert-info">
        <strong>Group Seleccionado:</strong> @selectedGroup.Id - @selectedGroup.Name
    </div>
}

@code {
    // Sources
    private List<Source>? sources;
    private Source? selectedSource;
    private int sourceId;
    private bool isLoadingSources = false;
    private string? errorSources;

    // DeviceGroups
    private List<DeviceGroup>? groups;
    private DeviceGroup? selectedGroup;
    private int groupId;
    private bool isLoadingGroups = false;
    private string? errorGroups;

    // Métodos Sources
    private async Task GetAllSourcesAsync()
    {
        isLoadingSources = true;
        sources = null;
        selectedSource = null;
        errorSources = null;

        try
        {
            sources = await Http.GetFromJsonAsync<List<Source>>("api/SondaMain/sources");
        }
        catch (Exception ex)
        {
            errorSources = $"Error al obtener Sources: {ex.Message}";
        }
        finally
        {
            isLoadingSources = false;
        }
    }

    private async Task GetSourceByIdAsync()
    {
        if (sourceId <= 0) return;

        isLoadingSources = true;
        selectedSource = null;
        errorSources = null;

        try
        {
            selectedSource = await Http.GetFromJsonAsync<Source>($"api/SondaMain/sources/{sourceId}");
        }
        catch (Exception ex)
        {
            errorSources = $"Error al obtener Source {sourceId}: {ex.Message}";
        }
        finally
        {
            isLoadingSources = false;
        }
    }

    // Métodos DeviceGroups
    private async Task GetAllDeviceGroupsAsync()
    {
        isLoadingGroups = true;
        groups = null;
        selectedGroup = null;
        errorGroups = null;

        try
        {
            groups = await Http.GetFromJsonAsync<List<DeviceGroup>>("api/SondaMain/groups");
        }
        catch (Exception ex)
        {
            errorGroups = $"Error al obtener Groups: {ex.Message}";
        }
        finally
        {
            isLoadingGroups = false;
        }
    }

    private async Task GetDeviceGroupByIdAsync()
    {
        if (groupId <= 0) return;

        isLoadingGroups = true;
        selectedGroup = null;
        errorGroups = null;

        try
        {
            selectedGroup = await Http.GetFromJsonAsync<DeviceGroup>($"api/SondaMain/groups/{groupId}");
        }
        catch (Exception ex)
        {
            errorGroups = $"Error al obtener Group {groupId}: {ex.Message}";
        }
        finally
        {
            isLoadingGroups = false;
        }
    }
}
