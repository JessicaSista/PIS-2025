@page "/sonda-test-login"
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http
@using System.Net.Http.Json

<PageTitle>Prueba Login</PageTitle>

<h3>Login</h3>

<div class="mb-3">
    <input type="text" class="form-control mb-2" placeholder="Username" @bind="username" />
    <input type="password" class="form-control mb-2" placeholder="Password" @bind="password" />

    <button class="btn btn-primary" @onclick="LoginAsync" disabled="@isLoadingLogin">
        @if (isLoadingLogin)
        {
            <span class="spinner-border spinner-border-sm"></span>
            <span class="ms-1">Ingresando...</span>
        }
        else
        {
            <span>Login</span>
        }
    </button>
</div>

@if (!string.IsNullOrEmpty(errorLogin))
{
    <div class="alert alert-danger">@errorLogin</div>
}

@if (!string.IsNullOrEmpty(successLogin))
{
    <div class="alert alert-success">@successLogin</div>
}

@code {
    private string username = string.Empty;
    private string password = string.Empty;
    private bool isLoadingLogin = false;
    private string? errorLogin;
    private string? successLogin;

    private async Task LoginAsync()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorLogin = "Debe ingresar usuario y contraseña.";
            return;
        }

        isLoadingLogin = true;
        errorLogin = null;
        successLogin = null;

        try
        {
            var request = new { Username = username, Password = password };

            var response = await Http.PostAsJsonAsync("api/Auth/login", request);

            if (response.IsSuccessStatusCode)
            {
                var token = await response.Content.ReadAsStringAsync();
                successLogin = $"Login exitoso. Respuesta: {token}";
            }
            else
            {
                errorLogin = $"Error en login: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorLogin = $"Error al intentar login: {ex.Message}";
        }
        finally
        {
            isLoadingLogin = false;
        }
    }
}
