@page "/create-scheduled-report"
@using System.Net.Http.Json

<h3>Crear Programación de Reporte</h3>

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="alert alert-info">@StatusMessage</div>
}

<EditForm Model="scheduledReport" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Reporte ID:</label>
        <InputNumber @bind-Value="scheduledReport.ReportId" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Destinatarios (separados por coma):</label>
        <InputText @bind-Value="RecipientsString" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Tipo de Frecuencia:</label>
        <select @bind="scheduledReport.ScheduleType" class="form-select">
            <option value="DAILY">Diaria</option>
            <option value="WEEKLY">Semanal</option>
            <option value="MONTHLY">Mensual</option>
            <option value="ADVANCED">Avanzada</option>
        </select>
    </div>

    <div class="mb-3">
        <label>Hora de envío (HH:mm):</label>
        <InputText @bind-Value="scheduledReport.SendAtLocalTime" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Regla avanzada (JSON):</label>
        <InputText @bind-Value="scheduledReport.AdvancedRule"
                   class="form-control"
                   placeholder='{ "day": "MON" }' />
    </div>

    <div class="mb-3">
        <label>Zona horaria:</label>
        <InputText @bind-Value="scheduledReport.TimeZone" class="form-control" placeholder="America/Montevideo" />
    </div>

    <div class="mb-3">
        <label>Asunto:</label>
        <InputText @bind-Value="scheduledReport.Subject" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Mensaje:</label>
        <InputTextArea @bind-Value="scheduledReport.Message" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Crear Programación</button>
</EditForm>

@code {
    private ScheduledReportRequest scheduledReport = new ScheduledReportRequest();

    private string RecipientsString
    {
        get => string.Join(",", scheduledReport.Recipients ?? new List<string>());
        set => scheduledReport.Recipients = value
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(e => e.Trim()).ToList();
    }

    private string StatusMessage;

    [Inject]
    private HttpClient Http { get; set; }

    private async Task HandleValidSubmit()
    {
        try
        {
            StatusMessage = "Enviando...";
            var response = await Http.PostAsJsonAsync("api/Reports/scheduled-reports", scheduledReport);

            if (response.IsSuccessStatusCode)
            {
                var id = await response.Content.ReadFromJsonAsync<int>();
                StatusMessage = $"Programación creada con ID: {id}";
                scheduledReport = new ScheduledReportRequest(); // reset
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                StatusMessage = $"Error: {error["message"]}";
            }
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error inesperado: {ex.Message}";
        }
    }

    public class ScheduledReportRequest
    {
        public int ReportId { get; set; }
        public List<string> Recipients { get; set; } = new();
        public string ScheduleType { get; set; } = "DAILY";
        public string SendAtLocalTime { get; set; }
        public string AdvancedRule { get; set; }
        public string TimeZone { get; set; }
        public string Subject { get; set; }
        public string Message { get; set; }
        public int? IntervalMinutes { get; set; }
    }
}
