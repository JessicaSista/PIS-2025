@page "/device-data-test"
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar
@using System.Net.Http.Json
@using System.Text.Json
@using System.Globalization

<PageTitle>Página de Prueba de Datos de Dispositivo</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Prueba de Endpoint de Datos de Dispositivo</MudText>

<MudPaper Class="pa-4">
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" md="3">
            <MudNumericField @bind-Value="request.DeviceId" Label="ID de Dispositivo" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="request.User" Label="Usuario" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="request.Password" Label="Contraseña" Variant="Variant.Outlined" InputType="InputType.Password" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDateRangePicker @bind-DateRange="dateRange" Label="Rango de Fechas" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12">
            <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="GetDeviceData" Disabled="@isLoading">
                @if (isLoading)
                {
                    <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" />
                    <span class="ms-2">Consultando...</span>
                }
                else
                {
                    <span>Obtener Datos</span>
                }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (deviceData != null)
{
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">Resultados (@deviceData.Count)</MudText>
        <MudTable Items="deviceData" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>Device ID</MudTh>
                <MudTh>Sensor</MudTh>
                <MudTh>Fecha y Hora</MudTh>
                <MudTh>Dato</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Device ID">@context.DeviceId</MudTd>
                <MudTd DataLabel="Sensor">@context.SensorDisplayName</MudTd>
                <MudTd DataLabel="Fecha y Hora">@context.TimeStamp.ToString("g")</MudTd>
                <MudTd DataLabel="Dato">@context.Data</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private class DeviceDataRequest
    {
        public int DeviceId { get; set; } = 52726; // Valor de ejemplo
        public string User { get; set; } = "admin";
        public string Password { get; set; } = "admin";
    }

    private DeviceDataRequest request = new();
    private DateRange dateRange = new DateRange(DateTime.Now.Date, DateTime.Now.Date.AddDays(1));
    private bool isLoading = false;
    private List<DeviceData>? deviceData;

    private async Task GetDeviceData()
    {
        if (dateRange == null || !dateRange.Start.HasValue || !dateRange.End.HasValue)
        {
            Snackbar.Add("Por favor, selecciona un rango de fechas válido.", Severity.Warning);
            return;
        }

        isLoading = true;
        deviceData = null;
        try
        {
            // --- LÓGICA CORREGIDA ---
            // 1. Formatear las fechas en un formato que el backend pueda interpretar (ISO 8601 round-trip)
            string from = dateRange.Start.Value.ToString("o");
            string to = dateRange.End.Value.ToString("o");

            // 2. Construir la URL correcta que coincide con el controlador del backend
            string url = $"api/SondaMain/data?deviceId={request.DeviceId}&dateFrom={from}&dateTo={to}&user={request.User}&password={request.Password}";

            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                deviceData = await response.Content.ReadFromJsonAsync<List<DeviceData>>();
                Snackbar.Add($"Se encontraron {deviceData?.Count ?? 0} registros.", Severity.Success);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error de la API: {response.StatusCode} - {errorContent}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error en la solicitud: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}
