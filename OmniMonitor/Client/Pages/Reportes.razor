@page "/reportes"
@using OmniMonitor.Shared.Dtos
@inject HttpClient Http
@using MudBlazor
@using OmniMonitor.Shared
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Reportes</PageTitle>

<MudStack Style="height: 100%; padding: 20px;">
    <!-- Header -->
    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudStack>
            <MudText Typo="Typo.h4" Style="color: #E5EAEB; font-weight: bold;">Reportes</MudText>
            <MudText Typo="Typo.body1" Style="color: #9ca3af;">Gestiona y visualiza tus reportes de datos</MudText>
        </MudStack>
        <MudButton Href="/crearReporte" Variant="Variant.Filled" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.Add">Nuevo Reporte</MudButton>
    </MudStack>

    <!-- Search Bar -->
    <MudTextField @bind-Value="searchText" 
                 Placeholder="Buscar reportes..." 
                 Variant="Variant.Outlined" 
                 Adornment="Adornment.Start" 
                 AdornmentIcon="@Icons.Material.Filled.Search" 
                 Class="mb-4"
                 Style="max-width: 500px;" />

    <!-- Report Cards Grid -->
    <MudGrid Spacing="3" Justify="Justify.FlexStart" Style="flex: 1; overflow-y: auto; padding: 8px;">
        @foreach (var reporte in reportes)
        {
            <MudItem xs="12" sm="6" md="4" Class="d-flex">
        <div style="width: 100%; height: 100%;">
            <ReportCardComponent 
                Reporte="reporte"
                Description="@reporte.Descripcion"
                OnClick="@((id) => VerDetalle(id))"
                OnDelete="@((id) => EliminarReporte(id))" />
        </div>
    </MudItem>
        }
    </MudGrid>
</MudStack>

@code {
    private List<ReporteDto> reportes = new();
    private string searchText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        reportes = new List<ReporteDto>
        {
            new ReporteDto { Id = 1, Nombre = "Ventas Mensuales", Descripcion = "Datos de ventas agregados por mes y producto", FechaCreacion = DateTime.Parse("2024-01-07T14:30:00") },
            new ReporteDto { Id = 2, Nombre = "API Tiempo Real", Descripcion = "Stream de datos en tiempo real desde sensores IoT", FechaCreacion = DateTime.Parse("2024-01-07T14:30:00") },
            new ReporteDto { Id = 3, Nombre = "Base Usuarios", Descripcion = "Información de usuarios registrados", FechaCreacion = DateTime.Parse("2024-01-07T14:30:00") },
        };

        var json = await JS.InvokeAsync<string>("localStorage.getItem", "reportes");
        if (!string.IsNullOrEmpty(json))
        {
            var locales = System.Text.Json.JsonSerializer.Deserialize<List<ReporteDto>>(json);
            if (locales != null)
                reportes.AddRange(locales);
        }

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (!string.IsNullOrEmpty(uri.Query))
        {
            var query = uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
            foreach (var q in query)
            {
                var kv = q.Split('=', 2);
                if (kv.Length == 2 && kv[0] == "snackbar")
                {
                    var mensaje = Uri.UnescapeDataString(kv[1]);
                    Snackbar.Add(mensaje, Severity.Success, config =>
                    {
                        config.SnackbarVariant = Variant.Filled;
                        config.Action = "OK";
                        config.ActionColor = MudBlazor.Color.Primary;
                    });
                }
            }
        }
    }

    private void VerDetalle(int id)
    {
        NavigationManager.NavigateTo($"/reportes/{id}");
    }

    private void EliminarReporte(int id)
    {
        var reporteAEliminar = reportes.FirstOrDefault(r => r.Id == id);
        if (reporteAEliminar != null)
        {
            reportes.Remove(reporteAEliminar);
            Snackbar.Add($"Reporte '{reporteAEliminar.Nombre}' eliminado.", Severity.Info);
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (reportes.Count > 0)
        {
            await JS.InvokeVoidAsync("equalizeCardHeights");
        }
    }
}