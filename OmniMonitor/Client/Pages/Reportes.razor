@page "/reportes"
@using OmniMonitor.Shared.Dtos
@using MudBlazor
@using OmniMonitor.Client.Shared
@using System.Text.Json
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JSRuntime

<PageTitle>Reportes</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-0 pt-2">
    <!-- Fila 1: Título y botón -->
    <MudGrid>
        <MudItem xs="12" sm="6" Class="d-flex align-center">
            <MudText Typo="Typo.h4" Style="color: #e1e6e7; font-weight: 500; font-family: Inter, Roboto, sans-serif; margin: 0;">
                Reportes
            </MudText>
        </MudItem>
        <MudItem xs="12" sm="6" Class="d-flex justify-sm-end mt-sm-0 mt-2">
            <MudButton Variant="Variant.Filled" 
                    StartIcon="@Icons.Material.Filled.Add"
                    OnClick="@(() => Navigation.NavigateTo("/crearReporte"))"
                    DisableElevation="true"
                    Style="background-color: #C2C2C3; color: #3A3A42; border-radius: 7px; text-transform: none;">
                Nuevo Reporte
            </MudButton>
        </MudItem>
    </MudGrid>

    <!-- Fila 2: Descripción -->
    <MudText Typo="Typo.body1" Class="mb-4 mt-2" Style="color: #a5a8b5; font-family: Inter, Roboto, sans-serif;">
        Gestiona y visualiza tus reportes de datos
    </MudText>

    <!-- Fila 3: Barra de búsqueda -->
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="8" md="6" lg="5" xl="4">
            <MudTextField @bind-Value="_searchText"
                        Immediate="true"
                        Placeholder="Buscar reportes..."
                        Variant="Variant.Outlined"
                        Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Search"
                        Class="w-100"
                        Style="height:50px; background-color: #020817; border: 1px solid #1D283A; border-radius: 4px;"
                        InputStyle="color: white; background-color: #020817; padding-left: 8px;"
                        PlaceholderStyle="color: #94a3b8"
                        AdornmentColor="MudBlazor.Color.Default"
                        IconColor="MudBlazor.Color.Default"
                        AdornmentMargin="Margin.Dense" />
        </MudItem>
    </MudGrid>

    <!-- Fila 4: Grid de tarjetas -->
    <MudGrid Spacing="2">

        @foreach (var reporte in _reportesFiltrados)
        {
            <MudItem xs="12" sm="12" md="4" lg="4" Class="d-flex">
                <ReportCardComponent Reporte="reporte"
                                   OnEdit="@EditarReporte"
                                   OnDelete="@EliminarReporte" 
                                   Class="flex-grow-1" />
            </MudItem>
        }
    </MudGrid>
</MudContainer>

@code {
    private string _searchText = "";

    private List<ReporteDto> _reportes = new();
    
    protected override async Task OnInitializedAsync()
    {
        await CargarReportes();
        
        // Si no hay reportes guardados, crea los predeterminados
        if (!_reportes.Any())
        {
            _reportes = new List<ReporteDto>
            {
                new() { Id = 1, Nombre = "Reporte de ventas", Descripcion = "Resumen de ventas mensuales", RecordCount = 120, FechaCreacion = DateTime.Now.AddDays(-2) },
                new() { Id = 2, Nombre = "Reporte de usuarios", Descripcion = "Usuarios activos en la plataforma", RecordCount = 56, FechaCreacion = DateTime.Now.AddDays(-7) },
                new() { Id = 3, Nombre = "Reporte de errores", Descripcion = "Errores registrados en el sistema", RecordCount = 15, FechaCreacion = DateTime.Now.AddDays(-1) }
            };
            await GuardarReportes();
        }
    }

    private IEnumerable<ReporteDto> _reportesFiltrados =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _reportes
            : _reportes.Where(r => r.Nombre.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    private void EditarReporte(int id)
    {
        Console.WriteLine($"Editar reporte: {id}");
        // Navigation.NavigateTo($"/editarReporte/{id}");
    }

    private async Task EliminarReporte(int id)
    {
        var reporteAEliminar = _reportes.FirstOrDefault(r => r.Id == id);
        if (reporteAEliminar != null)
        {
            _reportes.Remove(reporteAEliminar);
            await GuardarReportes();
            StateHasChanged();
        }
    }

    // Cambié Guid -> int porque Reporte.Id es int
    private void VerReporte(int id)
    {
        Navigation.NavigateTo($"/reporte/{id}");
    }
    
    private async Task GuardarReportes()
    {
        try
        {
            var reportesJson = JsonSerializer.Serialize(_reportes);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "reportes", reportesJson);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar reportes: {ex.Message}");
        }
    }
    
    private async Task CargarReportes()
    {
        try
        {
            var reportesJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "reportes");
            if (!string.IsNullOrEmpty(reportesJson))
            {
                _reportes = JsonSerializer.Deserialize<List<ReporteDto>>(reportesJson) ?? new List<ReporteDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar reportes: {ex.Message}");
            _reportes = new List<ReporteDto>();
        }
    }
}
