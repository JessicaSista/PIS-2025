@page "/editarDataset/{id:int}"
@using OmniMonitor.Shared.Dtos
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Blazored.LocalStorage
@using OmniMonitor.Shared.Dtos.AM
@using OmniMonitor.Shared.Dtos.EM
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http
@using MudBlazor
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Datasets> Localizer
@inject ILocalStorageService LocalStorage


<PageTitle>Editar Dataset</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1 mt-2 mx-4" Style=" font-weight: 500; font-family: Inter, Roboto, sans-serif;">
    @Localizer["EditarDataset"]
</MudText>

<!-- Selector de tipo de dataset -->
<MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Modulo"]</MudText>
<MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
    <MudSelect T="string"
               Value="@selectedTipo"
               ValueChanged="OnModuleChanged"
               Variant="Variant.Outlined"
               Class="flex-grow-1 dark-field"
               InputClass="dark-field-input"
               PopoverClass="dark-field-popover"
               Disabled="true">
        @foreach (var tipo in tiposDataset)
        {
            <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
        }
    </MudSelect>
</MudStack>

@if (cargando)
{
    <MudProgressCircular Class="mx-4" Indeterminate="true" Color="MudBlazor.Color.Primary" />
}
else if (noEncontrado)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mx-4 my-4">
        No se encontró el dataset solicitado.
    </MudAlert>
}
else if (selectedTipo == "Insight Monitor")
{
    <!-- Campo Nombre -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Nombre"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField @bind-Value="addName" Placeholder="@Localizer["AgregarNombre"]"
                      Variant="Variant.Outlined"
                      Class="flex-grow-1 dark-field"
                      MaxLength="50"
                      Required="true" />
    </MudStack>

    <!-- Campo Descripción -->
    <MudText Typo="Typo.h6" Class="mb-1 mx-4">@Localizer["Descripcion"]</MudText>
    <MudStack Row Justify="Justify.SpaceBetween" Class="mb-4 mx-4">
        <MudTextField T="string"
                      @bind-Value="addDesc"
                      Placeholder="@Localizer["AgregarDescripcion"]"
                      Variant="Variant.Outlined"
                      Lines="3"
                      Class="@($"flex-grow-1 dark-field mt-0 {(string.IsNullOrWhiteSpace(addDesc) ? "required-empty" : "")}")"
                      MaxLength="200"
                      Required="true" />
    </MudStack>

    @if (isImFiltered)
    {
        <!-- Modo Filtrado -->
        <!-- Toggle de modo: Device, Source, Sensor -->
        <MudStack Row Spacing="2" Class="mb-1 mx-4">
            <MudButton Variant="@(imMode == 1 ? Variant.Filled : Variant.Outlined)" 
                       Color="MudBlazor.Color.Primary" 
                       OnClick="() => SetImMode(1)"
                       Disabled="@isEditingIM">@Localizer["Dispositivo"]</MudButton>
            <MudButton Variant="@(imMode == 2 ? Variant.Filled : Variant.Outlined)" 
                       Color="MudBlazor.Color.Primary" 
                       OnClick="() => SetImMode(2)"
                       Disabled="@isEditingIM">@Localizer["Fuente"]</MudButton>
            <MudButton Variant="@(imMode == 3 ? Variant.Filled : Variant.Outlined)" 
                       Color="MudBlazor.Color.Primary" 
                       OnClick="() => SetImMode(3)"
                       Disabled="@isEditingIM">Sensor</MudButton>
        </MudStack>

        @if (imMode == 1 || imMode == 2 || imMode == 3)
        {
            <!-- Sistema de Filtros -->
            <MudStack Class="mb-4 mx-4">
                <MudText Typo="Typo.h6" Class="mb-2">@Localizer["Filtros"]</MudText>
                
                @if (imFilters.Count > 0)
                {
                    <MudPaper Elevation="1" Class="pa-3 mb-3">
                        @foreach (var filter in imFilters)
                        {
                            <MudChip T="FilterCondition"
                                    Size="MudBlazor.Size.Small" 
                                    Color="MudBlazor.Color.Primary" 
                                    Variant="Variant.Filled"
                                    OnClose="() => RemoveImFilter(filter)"
                                    CloseIcon="@Icons.Material.Filled.Close"
                                    Class="ma-1">
                                @RenderFilterDisplay(filter)
                            </MudChip>
                        }
                    </MudPaper>
                }

                <MudButton StartIcon="@Icons.Material.Filled.Add" 
                          Variant="Variant.Outlined" 
                          Color="MudBlazor.Color.Primary"
                          OnClick="OpenImFilterModal">
                    @Localizer["AgregarFiltro"]
                </MudButton>
            </MudStack>
        }

        <div class="mb-4 mx-4" style="display: flex; justify-content: flex-end; gap: 12px; align-items: center;">
            @if (isSavingIM)
            {
                <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                    <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" />
                    <MudText Typo="Typo.body2">Guardando...</MudText>
                </MudStack>
            }
            <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="MudBlazor.Color.Secondary">
                @Localizer["Cancelar"]
            </MudButton>
            <MudButton OnClick="GuardarCambiosIM"
                       Variant="Variant.Filled"
                       Color="MudBlazor.Color.Primary"
                       Disabled="@(isSavingIM || string.IsNullOrWhiteSpace(addDesc) || string.IsNullOrWhiteSpace(addName) || !HasChangesIMFiltered)">
                @Localizer["GuardarCambios"]
            </MudButton>
        </div>
    }
    else
    {
        <!-- Modo Original -->
    <!-- Cuatro selects en la misma línea: Fuente, Grupo, Dispositivo y Sensor -->
    <MudStack Row Spacing="2" Class="mb-4 mx-4">
        <!-- Fuente -->
        <div style="width: 25%;">
            <MudSelect T="int?"
                       Value="@selectedSourceId"
                       ValueChanged="@OnSourceChanged"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarFuente"]"
                       Class="@($"dark-field")"
                       Required="true">
                @foreach (var source in sources)
                {
                    <MudSelectItem Value="@((int?)source.Id)">@source.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Grupo -->
        <div style="width: 25%;">
            <MudSelect T="int?"
                       Value="@selectedGroupId"
                       ValueChanged="@OnGroupChanged"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarGrupo"]"
                       Class="dark-field">
                @foreach (var group in deviceGroups)
                {
                    <MudSelectItem Value="@((int?)group.Id)">@group.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Dispositivo -->
        <div style="width: 25%;">
            <MudSelect T="int"
                       SelectedValues="selectedDeviceIds"
                       SelectedValuesChanged="OnSelectedDevicesChanged"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarDispositivo"]"
                       Class="dark-field"
                       Disabled="@(!selectedSourceId.HasValue)"
                       ToStringFunc="@(id => devices.FirstOrDefault(d => d.Id == id)?.Name ?? id.ToString())">
                @foreach (var device in devices)
                {
                    <MudSelectItem T="int" Value="@device.Id">@device.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <!-- Sensor -->
        <div style="width: 25%;">
            <MudSelect T="string"
                       @bind-Value="selectedSensor"
                       Variant="Variant.Outlined"
                       Clearable
                       FullWidth="true"
                       Label="@Localizer["SeleccionarSensor"]"
                       Class="@($"dark-field")"
                       Disabled="@(!selectedSourceId.HasValue)"
                       Required="true">
                @foreach (var sensor in sensores)
                {
                    <MudSelectItem Value="@sensor">@sensor</MudSelectItem>
                }
            </MudSelect>
        </div>
    </MudStack>

    <div class="mb-4 mx-4" style="display: flex; justify-content: flex-end; gap: 12px; align-items: center;">
        @if (isSaving)
        {
            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" />
                <MudText Typo="Typo.body2">Guardando...</MudText>
            </MudStack>
        }
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="MudBlazor.Color.Secondary">
            @Localizer["Cancelar"]
        </MudButton>
        <MudButton OnClick="GuardarCambios"
                   Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   Disabled="@(isSaving || !selectedSourceId.HasValue || string.IsNullOrWhiteSpace(selectedSensor) || string.IsNullOrWhiteSpace(addDesc) || string.IsNullOrWhiteSpace(addName) || !HasChangesIM)">
            @Localizer["GuardarCambios"]
        </MudButton>
    </div>
    }
}

