    private async Task LoadDataset()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;
            var token = await LocalStorage.GetItemAsync<string>("authToken") ?? "";

            if (string.IsNullOrEmpty(username))
            {
                noEncontrado = true;
                return;
            }

            bool datasetFound = false;

            if (string.IsNullOrEmpty(ModuleHint))
            {
                try
                {
                    var moduleResponse = await Http.GetAsync($"api/Dataset/GetDatasetModule?datasetId={id}");
                    if (moduleResponse.IsSuccessStatusCode)
                    {
                        var module = await moduleResponse.Content.ReadFromJsonAsync<string>();
                        if (!string.IsNullOrEmpty(module))
                        {
                            ModuleHint = module;
                        }
                    }
                }
                catch (Exception ex)
                {
                }
            }

            // Si tenemos un hint del módulo, intentar cargar directamente desde ese módulo primero
            if (!string.IsNullOrEmpty(ModuleHint))
            {
                switch (ModuleHint)
                {
                    case "Insight Monitor":
                        datasetFound = await TryLoadAsInsightMonitor(token);
                        break;
                    case "Asset Manager":
                        datasetFound = await TryLoadAsAssetManager(token);
                        break;
                    case "Urban Monitor":
                        datasetFound = await TryLoadAsUrbanMonitor(token);
                        break;
                    case "Event Manager":
                        datasetFound = await TryLoadAsEventManager(token);
                        break;
                }

                // Si se encontró con el hint, terminamos aquí
                if (datasetFound)
                {
                    cargando = false;
                    StateHasChanged();
                    return;
                }
            }

            // Si no hay hint o no se encontró, intentar con todos los módulos
            if (!datasetFound)
            {
                datasetFound = await TryLoadAsInsightMonitor(token);
            }

            if (!datasetFound)
            {
                datasetFound = await TryLoadAsAssetManager(token);
            }

            if (!datasetFound)
            {
                datasetFound = await TryLoadAsUrbanMonitor(token);
            }

            if (!datasetFound)
            {
                datasetFound = await TryLoadAsEventManager(token);
            }

            if (!datasetFound)
            {
                noEncontrado = true;
            }
        }
        catch
        {
            noEncontrado = true;
        }
        finally
        {
            cargando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> TryLoadAsInsightMonitor(string token)
    {
        try
        {
            var response = await Http.GetAsync($"api/Dataset/GetDataset?datasetId={id}");
            if (response.IsSuccessStatusCode)
            {
                var existente = await response.Content.ReadFromJsonAsync<DatasetIM>();
                if (existente != null)
                {
                    selectedTipo = "Insight Monitor";
                    addName = existente.Name ?? string.Empty;
                    addDesc = existente.Description ?? string.Empty;
                    
                    // Determinar si es un dataset filtrado
                    isImFiltered = existente.Is_Dataset == "N" && !string.IsNullOrEmpty(existente.JsonFilters);
                    isEditingIM = true; // Bloquear cambio de modo al editar
                    
                    if (isImFiltered)
                    {
                        // Dataset con filtros
                        // Determinar el modo basado en ContentType
                        if (existente.ContentType == "1") // Device
                        {
                            imMode = 1;
                        }
                        else if (existente.ContentType == "2") // Source
                        {
                            imMode = 2;
                        }
                        else if (existente.ContentType == "3") // Sensor
                        {
                            imMode = 3;
                        }
                        else
                        {
                            imMode = 1; // Default
                        }
                        
                        // Cargar filtros si existen
                        if (!string.IsNullOrEmpty(existente.JsonFilters))
                        {
                            try
                            {
                                imFilters = System.Text.Json.JsonSerializer.Deserialize<List<FilterCondition>>(existente.JsonFilters) ?? new List<FilterCondition>();
                            }
                            catch (Exception ex)
                            {
                                imFilters = new List<FilterCondition>();
                            }
                        }
                        else
                        {
                            imFilters = new List<FilterCondition>();
                        }
                        
                        // Cargar atributos disponibles
                        await LoadImAvailableAttributes();
                    }
                    else
                    {
                        // Dataset original (método tradicional)
                    selectedSourceId = existente.Id_Source;
                    selectedGroupId = existente.Id_Group;
                    selectedSensor = existente.SensorName ?? string.Empty;

                    selectedDeviceIds.Clear();
                    if (existente.DatasetDevices != null && existente.DatasetDevices.Any())
                    {
                        selectedDeviceIds = new HashSet<int>(existente.DatasetDevices.Select(dd => dd.Id_device));
                    }
                    await Task.WhenAll(
                        LoadSourcesAndGroups(),
                        LoadDevices(),
                        LoadSensors()
                    );
                    }

                    // Copia el estado original al cargar el dataset
                    SetOriginalState();
                    
                    return true;
                }
            }
        }
        catch (Exception ex)
        {
        }
        return false;
    }

