@code {
    [Parameter] public int id { get; set; }
    
    [SupplyParameterFromQuery(Name = "module")]
    public string? ModuleHint { get; set; }

    private string selectedTipo = "Insight Monitor";
    private List<string> tiposDataset = new() { "Insight Monitor", "Asset Manager", "Urban Monitor", "Event Manager" };

    // Listas dinámicas desde la API
    private List<Source> sources = new();
    private List<DeviceGroup> deviceGroups = new();
    private List<Device> devices = new();

    // Valores seleccionados (ahora son IDs)
    private int? selectedSourceId = null;
    private int? selectedGroupId = null;
    private HashSet<int> selectedDeviceIds = new();

    private string selectedSensor = string.Empty;
    private List<string> sensores = new();

    private string addName = string.Empty;
    private string addDesc = string.Empty;

    private bool cargando = true;
    private bool noEncontrado = false;

    // Credenciales del usuario / token logic from develop
    private string currentUsername = string.Empty;
    private string authToken = string.Empty;
    private string GetEncodedToken() => Uri.EscapeDataString(authToken ?? "");

    // amMode: 1 = Event Task, 2 = Asset, 3 = Stock
    private int amMode = 2;
    private bool isEditingAM = false; // Indica si estamos editando un dataset AM (para bloquear cambio de modo)

    // Asset flow
    private List<AssetTypeDto> assetTypes = new();
    private int? selectedAssetTypeId = null;
    private List<AssetDto> assets = new();
    private HashSet<string> selectedAssetIds = new();

    // Event Task flow
    private List<TaskTypeDto> taskTypes = new();
    private int? selectedTaskTypeId = null;
    private List<EventTaskInstanceDto> eventTaskInstances = new();
    private HashSet<int> selectedEventTaskInstanceIds = new();
    private List<EventTaskInstanceStockDto> stocks = new();
    private HashSet<int> selectedStockIds = new();
    
    // Filtros para AM
    private List<FilterCondition> amFilters = new();
    private List<PropiedadEntidadDto> availableAttributes = new();

    // UM UI State
    // umMode: 1 = Eventos, 2 = Noticias
    private int umMode = 1;
    private bool isEditingUM = false; // Indica si estamos editando un dataset UM (para bloquear cambio de modo)
    
    // Filtros para UM
    private List<FilterCondition> umFilters = new();
    private List<PropiedadEntidadDto> umAvailableAttributes = new();

    // EM UI State
    // emMode: 1 = Alertas, 2 = Eventos, 3 = Extensiones
    private int emMode = 1;
    private bool isEditingEM = false; // Indica si estamos editando un dataset EM (para bloquear cambio de modo)
    
    // Filtros para EM
    private List<FilterCondition> emFilters = new();
    private List<PropiedadEntidadDto> emAvailableAttributes = new();

    private bool EnableStocksSelect => selectedEventTaskInstanceIds.Count == 1;

    private bool CanSaveUM
    {
        get
        {
            if (string.IsNullOrWhiteSpace(addName) || string.IsNullOrWhiteSpace(addDesc)) return false;
            // Requiere al menos un filtro
            return umFilters.Count > 0;
        }
    }
    

    private bool CanSaveAM
    {
        get
        {
            if (string.IsNullOrWhiteSpace(addName) || string.IsNullOrWhiteSpace(addDesc)) return false;
            // Requiere al menos un filtro
            return amFilters.Count > 0;
        }
    }


    private string GetEventTaskInstanceDisplayName(int instanceId)
    {
        var instance = eventTaskInstances.FirstOrDefault(e => e.Id == instanceId);
        if (instance == null) return instanceId.ToString();
        
        if (!string.IsNullOrWhiteSpace(instance.Subject))
            return $"#{instance.Id} {instance.Subject}";
        
        if (instance.EventTaskDto != null && !string.IsNullOrWhiteSpace(instance.EventTaskDto.Subject))
            return $"#{instance.Id} {instance.EventTaskDto.Subject}";
        
        return $"#{instance.Id}";
    }

    private bool CanSaveEM
    {
        get
        {
            if (string.IsNullOrWhiteSpace(addName) || string.IsNullOrWhiteSpace(addDesc)) return false;
            // Requiere al menos un filtro
            return emFilters.Count > 0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            currentUsername = authState.User.Identity?.Name ?? "";

            authToken = await LocalStorage.GetItemAsync<string>("authToken") ?? "";

            if (string.IsNullOrEmpty(currentUsername) || string.IsNullOrEmpty(authToken))
            {
                noEncontrado = true;
                return;
            }

            // NO cargar nada aquí - solo cargaremos lo necesario después de saber el módulo
        }
        catch (Exception ex)
        {
            noEncontrado = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadDataset();
    }

    private async Task OnModuleChanged(string newModule)
    {
        selectedTipo = newModule;
        
        ClearAllSelections();
        switch (newModule)
        {
            case "Insight Monitor":
                await LoadSourcesAndGroups();
                break;
            case "Asset Manager":
                await InitializeAMLists();
                break;
            case "Urban Monitor":
                await InitializeUMLists();
                break;
            case "Event Manager":
                await InitializeEMLists();
                break;
        }
        
        StateHasChanged();
    }

    private void ClearAllSelections()
    {
        // Clear Insight Monitor
        selectedSourceId = null;
        selectedGroupId = null;
        selectedDeviceIds.Clear();
        selectedSensor = string.Empty;
        sources.Clear();
        deviceGroups.Clear();
        devices.Clear();
        sensores.Clear();
        
        // Clear Asset Manager
        selectedAssetTypeId = null;
        selectedAssetIds.Clear();
        selectedTaskTypeId = null;
        selectedEventTaskInstanceIds.Clear();
        selectedStockIds.Clear();
        assetTypes.Clear();
        assets.Clear();
        taskTypes.Clear();
        eventTaskInstances.Clear();
        stocks.Clear();
        
        // Clear Urban Monitor
        umMode = 1;
        umFilters.Clear();
        umAvailableAttributes.Clear();
        isEditingUM = false;
        
        // Clear Event Manager
        emMode = 1;
        emFilters.Clear();
        emAvailableAttributes.Clear();
        isEditingEM = false;
    }

    private async Task LoadDataset()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;
            var token = await LocalStorage.GetItemAsync<string>("authToken") ?? "";

            if (string.IsNullOrEmpty(username))
            {
                noEncontrado = true;
                return;
            }

            bool datasetFound = false;

            if (string.IsNullOrEmpty(ModuleHint))
            {
                try
                {
                    var moduleResponse = await Http.GetAsync($"api/Dataset/GetDatasetModule?datasetId={id}");
                    if (moduleResponse.IsSuccessStatusCode)
                    {
                        var module = await moduleResponse.Content.ReadFromJsonAsync<string>();
                        if (!string.IsNullOrEmpty(module))
                        {
                            ModuleHint = module;
                        }
                    }
                }
                catch (Exception ex)
                {
                }
            }

            // Si tenemos un hint del módulo, intentar cargar directamente desde ese módulo primero
            if (!string.IsNullOrEmpty(ModuleHint))
            {
                switch (ModuleHint)
                {
                    case "Insight Monitor":
                        datasetFound = await TryLoadAsInsightMonitor(token);
                        break;
                    case "Asset Manager":
                        datasetFound = await TryLoadAsAssetManager(token);
                        break;
                    case "Urban Monitor":
                        datasetFound = await TryLoadAsUrbanMonitor(token);
                        break;
                    case "Event Manager":
                        datasetFound = await TryLoadAsEventManager(token);
                        break;
                }

                // Si se encontró con el hint, terminamos aquí
                if (datasetFound)
                {
                    cargando = false;
                    StateHasChanged();
                    return;
                }
            }

            // Si no hay hint o no se encontró, intentar con todos los módulos
            if (!datasetFound)
            {
                datasetFound = await TryLoadAsInsightMonitor(token);
            }

            if (!datasetFound)
            {
                datasetFound = await TryLoadAsAssetManager(token);
            }

            if (!datasetFound)
            {
                datasetFound = await TryLoadAsUrbanMonitor(token);
            }

            if (!datasetFound)
            {
                datasetFound = await TryLoadAsEventManager(token);
            }

            if (!datasetFound)
            {
                noEncontrado = true;
            }
        }
        catch
        {
            noEncontrado = true;
        }
        finally
        {
            cargando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

