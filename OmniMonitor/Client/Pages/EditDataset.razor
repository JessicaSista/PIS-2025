            if (string.IsNullOrEmpty(username))
            {
                ShowError("No se pudo obtener el usuario actual");
                return;
            }
            if (string.IsNullOrWhiteSpace(addDesc))
            {
                ShowError("La descripción es obligatoria");
                return;
            }
            if (string.IsNullOrWhiteSpace(addName))
            {
                ShowError("Error al actualizar el dataset: El nombre del dataset es obligatorio.");
                return;
            }
            if (umFilters.Count == 0)
            {
                ShowError("Debe agregar al menos un filtro para actualizar el dataset.");
                return;
            }

            var contentType = umMode switch
            {
                1 => "1", // Eventos
                2 => "2", // Noticias
                _ => "1"
            };

            var datasetRequest = new CreateDatasetUMRequest
            {
                Username = username,
                Name = addName,
                Description = addDesc,
                IsDataset = "S",
                ContentType = contentType
            };

            var filteredRequest = new CreateDatasetUMFilteredRequest
            {
                DatasetRequest = datasetRequest,
                Filters = umFilters
            };

            var resp = await Http.PutAsJsonAsync($"api/DatasetUM/with-filters/{id}", filteredRequest);
            if (resp.IsSuccessStatusCode)
            {
                var updated = await resp.Content.ReadFromJsonAsync<DatasetUM>();
                ShowSuccess($"Dataset '{updated?.Name}' {Localizer["Actualizado"]}");
                Nav.NavigateTo("/datasets");
            }
            else
            {
                var error = await resp.Content.ReadAsStringAsync();
                ShowError(error);
            }
        }
        catch (Exception ex)
        {
            ShowError($"No se pudo actualizar el dataset UM: {ex.Message}");
        }
    }

    // ====== Event Manager Methods ======

    private async Task<bool> TryLoadAsEventManager(string token)
    {
        try
        {
            var responseEM = await Http.GetAsync($"api/DatasetEM/{id}?datasetId={id}");
            if (responseEM.IsSuccessStatusCode)
            {
                var existenteEM = await responseEM.Content.ReadFromJsonAsync<DatasetEM>();
                if (existenteEM != null)
                {
                    selectedTipo = "Event Manager";
                    addName = existenteEM.Name ?? string.Empty;
                    addDesc = existenteEM.Description ?? string.Empty;
                    
                    // Determinar el modo basado en ContentType
                    if (existenteEM.ContentType == "1") // Alertas
                    {
                        emMode = 1;
                    }
                    else if (existenteEM.ContentType == "2") // Eventos
                    {
                        emMode = 2;
                    }
                    else if (existenteEM.ContentType == "3") // Extensiones
                    {
                        emMode = 3;
                    }
                    else
                    {
                        emMode = 1; // Default
                    }
                    
                    isEditingEM = true; // Bloquear cambio de modo al editar
                    
                    // Cargar filtros si existen
                    if (!string.IsNullOrEmpty(existenteEM.Filters))
                    {
                        try
                        {
                            emFilters = System.Text.Json.JsonSerializer.Deserialize<List<FilterCondition>>(existenteEM.Filters) ?? new List<FilterCondition>();
                        }
                        catch (Exception ex)
                        {
                            emFilters = new List<FilterCondition>();
                        }
                    }
                    else
                    {
                        emFilters = new List<FilterCondition>();
                    }
                    
                    // Cargar atributos disponibles
                    await InitializeEMLists();
                    await LoadEmAvailableAttributes();

                    return true;
                }
            }
        }
        catch (Exception ex)
        {
        }
        return false;
    }

    private async Task InitializeEMLists()
    {
        // Ya no necesitamos cargar categorías, eventos, alertas o extensiones
    }

    private async Task SetEmMode(int mode)
    {
        // No permitir cambiar el modo si estamos editando
        if (isEditingEM) return;
        
        if (emMode == mode) return;
        emMode = mode;
        // Reset filtros y atributos cuando cambia el modo
        emFilters.Clear();
        emAvailableAttributes.Clear();
        
        // Cargar atributos disponibles para la entidad seleccionada
        await LoadEmAvailableAttributes();
        
        StateHasChanged();
    }
    
    private async Task LoadEmAvailableAttributes()
    {
        try
        {
            var entidadId = emMode switch
            {
                1 => 1, // Alertas
                2 => 2, // Eventos
                3 => 3, // Extensiones
                _ => 1
            };
            
            var url = $"api/DatasetFilter/FiltrarPorModuloYEntidad?modulo=EM&entidadId={entidadId}";
            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                emAvailableAttributes = await response.Content.ReadFromJsonAsync<List<PropiedadEntidadDto>>() ?? new List<PropiedadEntidadDto>();
            }
        }
        catch (Exception ex)
        {
            ShowError($"Error cargando atributos: {ex.Message}");
            emAvailableAttributes = new List<PropiedadEntidadDto>();
        }
    }
    
    private async Task OpenEmFilterModal()
    {
        if (emAvailableAttributes.Count == 0)
        {
            await LoadEmAvailableAttributes();
        }
        
        var parameters = new DialogParameters<FilterModal>
        {
            { x => x.AvailableAttributes, emAvailableAttributes },
            { x => x.Modulo, "EM" },
            { x => x.EntidadId, emMode switch { 1 => 1, 2 => 2, 3 => 3, _ => 1 } },
            { x => x.Token, authToken }
        };
        
        var options = new DialogOptions 
        { 
            MaxWidth = MaxWidth.Medium, 
            FullWidth = true,
            CloseButton = true
        };
        
        var dialog = await DialogService.ShowAsync<FilterModal>("Crear Filtro", parameters, options);
        var result = await dialog.Result;
        
        if (!result.Canceled && result.Data is FilterCondition filter)
        {
            emFilters.Add(filter);
            StateHasChanged();
        }
    }
    
