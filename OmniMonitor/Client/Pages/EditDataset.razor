@code {
    [Parameter] public int id { get; set; }
    
    [SupplyParameterFromQuery(Name = "module")]
    public string? ModuleHint { get; set; }

    private string selectedTipo = "Insight Monitor";
    private List<string> tiposDataset = new() { "Insight Monitor", "Asset Manager", "Urban Monitor", "Event Manager" };

    // Listas dinámicas desde la API
    private List<Source> sources = new();
    private List<DeviceGroup> deviceGroups = new();
    private List<Device> devices = new();

    // Valores seleccionados (ahora son IDs)
    private int? selectedSourceId = null;
    private int? selectedGroupId = null;
    private HashSet<int> selectedDeviceIds = new();

    private string selectedSensor = string.Empty;
    private List<string> sensores = new();

    private string addName = string.Empty;
    private string addDesc = string.Empty;

    private bool cargando = true;
    private bool noEncontrado = false;

    // Credenciales del usuario / token logic from develop
    private string currentUsername = string.Empty;
    private string authToken = string.Empty;
    private string GetEncodedToken() => Uri.EscapeDataString(authToken ?? "");

    // amMode: 1 = Event Task, 2 = Asset, 3 = Stock
    private int amMode = 2;
    private bool isEditingAM = false; // Indica si estamos editando un dataset AM (para bloquear cambio de modo)

    // Asset flow
    private List<AssetTypeDto> assetTypes = new();
    private int? selectedAssetTypeId = null;
    private List<AssetDto> assets = new();
    private HashSet<string> selectedAssetIds = new();

    // Event Task flow
    private List<TaskTypeDto> taskTypes = new();
    private int? selectedTaskTypeId = null;
    private List<EventTaskInstanceDto> eventTaskInstances = new();
    private HashSet<int> selectedEventTaskInstanceIds = new();
    private List<EventTaskInstanceStockDto> stocks = new();
    private HashSet<int> selectedStockIds = new();
    
    // Filtros para AM
    private List<FilterCondition> amFilters = new();
    private List<PropiedadEntidadDto> availableAttributes = new();

    // UM UI State
    // umMode: 1 = Eventos, 2 = Noticias
    private int umMode = 1;
    private bool isEditingUM = false; // Indica si estamos editando un dataset UM (para bloquear cambio de modo)
    
    // Filtros para UM
    private List<FilterCondition> umFilters = new();
    private List<PropiedadEntidadDto> umAvailableAttributes = new();

    // EM UI State
    // emMode: 1 = Alertas, 2 = Eventos, 3 = Extensiones
    private int emMode = 1;
    private bool isEditingEM = false; // Indica si estamos editando un dataset EM (para bloquear cambio de modo)
    
    // Filtros para EM
    private List<FilterCondition> emFilters = new();
    private List<PropiedadEntidadDto> emAvailableAttributes = new();

    // IM UI State
    // imMode: 1 = Device, 2 = Source, 3 = Sensor
    private int imMode = 1;
    private bool isEditingIM = false; // Indica si estamos editando un dataset IM (para bloquear cambio de modo)
    private bool isImFiltered = false; // Indica si el dataset es de tipo filtrado (Is_Dataset = "N" con filtros)
    
    // Filtros para IM
    private List<FilterCondition> imFilters = new();
    private List<PropiedadEntidadDto> imAvailableAttributes = new();

    // Estado de carga para guardar datasets
    private bool isSaving = false;
    private bool isSavingIM = false;
    private bool isSavingAM = false;
    private bool isSavingUM = false;
    private bool isSavingEM = false;

    private bool EnableStocksSelect => selectedEventTaskInstanceIds.Count == 1;

    private bool CanSaveUM
    {
        get
        {
            if (string.IsNullOrWhiteSpace(addName) || string.IsNullOrWhiteSpace(addDesc)) return false;
