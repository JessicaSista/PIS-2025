            }

            var contentType = amMode switch
            {
                1 => "1", // EventTask
                2 => "2", // Asset
                3 => "3", // Stock
                _ => "2"
            };

            var datasetRequest = new CreateDatasetAMRequest
            {
                Username = username,
                Nombre = addName,
                Descripcion = addDesc,
                IsDataset = "S",
                ContentType = contentType,
                Type_Dataset = amMode
            };

            var filteredRequest = new CreateDatasetAMFilteredRequest
            {
                DatasetRequest = datasetRequest,
                Filters = amFilters
            };

            var resp = await Http.PutAsJsonAsync($"api/DatasetAM/with-filters/{id}", filteredRequest);
            if (resp.IsSuccessStatusCode)
