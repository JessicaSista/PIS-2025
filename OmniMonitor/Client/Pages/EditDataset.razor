    // Estado original para cada tipo
    private string originalName = string.Empty;
    private string originalDesc = string.Empty;
    private int? originalSourceId = null;
    private int? originalGroupId = null;
    private HashSet<int> originalDeviceIds = new();
    private string originalSensor = string.Empty;
    private int originalAmMode;
    private List<FilterCondition> originalAmFilters = new();
    private int originalUmMode;
    private List<FilterCondition> originalUmFilters = new();
    private int originalEmMode;
    private List<FilterCondition> originalEmFilters = new();
    private int originalImMode;
    private List<FilterCondition> originalImFilters = new();

    // Llama esto después de cargar los datos del dataset
    private void SetOriginalState()
    {
        originalName = addName;
        originalDesc = addDesc;
        originalSourceId = selectedSourceId;
        originalGroupId = selectedGroupId;
        originalDeviceIds = new HashSet<int>(selectedDeviceIds);
        originalSensor = selectedSensor;
        originalAmMode = amMode;
        originalAmFilters = amFilters.Select(f => CloneFilter(f)).ToList();
        originalUmMode = umMode;
        originalUmFilters = umFilters.Select(f => CloneFilter(f)).ToList();
        originalEmMode = emMode;
        originalEmFilters = emFilters.Select(f => CloneFilter(f)).ToList();
        originalImMode = imMode;
        originalImFilters = imFilters.Select(f => CloneFilter(f)).ToList();
    }

    
    private FilterCondition CloneFilter(FilterCondition f)
    {
        return new FilterCondition
        {
            AttributeName = f.AttributeName,
            
        };
    }

    // Compara listas de filtros
    private bool AreFiltersEqual(List<FilterCondition> a, List<FilterCondition> b)
    {
        if (a.Count != b.Count) return false;
        for (int i = 0; i < a.Count; i++)
        {
            if (!FilterEquals(a[i], b[i])) return false;
        }
        return true;
    }

    private bool FilterEquals(FilterCondition f1, FilterCondition f2)
    {
        return f1.AttributeName == f2.AttributeName;
        
    }

    // Detecta cambios para cada tipo
    private bool HasChangesIM =>
        addName != originalName ||
        addDesc != originalDesc ||
        selectedSourceId != originalSourceId ||
        selectedGroupId != originalGroupId ||
        !selectedDeviceIds.SetEquals(originalDeviceIds) ||
        selectedSensor != originalSensor;

    private bool HasChangesIMFiltered =>
        addName != originalName ||
        addDesc != originalDesc ||
        imMode != originalImMode ||
        !AreFiltersEqual(imFilters, originalImFilters);

    private bool HasChangesAM =>
        addName != originalName ||
        addDesc != originalDesc ||
        amMode != originalAmMode ||
        !AreFiltersEqual(amFilters, originalAmFilters);

    private bool HasChangesUM =>
        addName != originalName ||
        addDesc != originalDesc ||
        umMode != originalUmMode ||
        !AreFiltersEqual(umFilters, originalUmFilters);

    private bool HasChangesEM =>
        addName != originalName ||
        addDesc != originalDesc ||
        emMode != originalEmMode ||
        !AreFiltersEqual(emFilters, originalEmFilters);
}
