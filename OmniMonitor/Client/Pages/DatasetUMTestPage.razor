@page "/datasetum-test"
@using OmniMonitor.Shared.Dtos
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>Dataset UM - Página de Prueba</PageTitle>

<div class="container mt-4">
    <h2>🧪 Dataset UM - Página de Prueba</h2>
    <p class="text-muted">Pantalla temporal para probar los endpoints del módulo UM</p>

    <div class="row">
        <!-- Panel de Creación -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>📝 Crear Dataset UM</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre del Dataset:</label>
                        <input type="text" class="form-control" @bind="newDataset.Name" placeholder="Ej: Mi Dataset UM" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Descripción:</label>
                        <textarea class="form-control" @bind="newDataset.Description" rows="2" placeholder="Descripción del dataset"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tipo de Dataset:</label>
                        <select class="form-select" @bind="newDataset.IsDataset">
                            <option value="S">Formal (búsqueda dinámica)</option>
                            <option value="N">Individual (entidades específicas)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Username:</label>
                        <input type="text" class="form-control" @bind="newDataset.Username" placeholder="admin" />
                    </div>

                    <!-- Filtros para búsqueda dinámica -->
                    <div class="mb-3" style="display: @(newDataset.IsDataset == "S" ? "block" : "none")">
                        <h6>🔍 Filtros de Búsqueda:</h6>
                        <div class="mb-2">
                            <label class="form-label">Zona:</label>
                            <select class="form-select" @bind="selectedZoneId">
                                <option value="">-- Seleccionar Zona --</option>
                                @if (zones != null)
                                {
                                    @foreach (var zone in zones)
                                    {
                                        <option value="@zone.Id">@zone.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Noticia:</label>
                            <select class="form-select" @bind="selectedNewsId">
                                <option value="">-- Seleccionar Noticia --</option>
                                @if (news != null)
                                {
                                    @foreach (var newsItem in news)
                                    {
                                        <option value="@newsItem.Id">@newsItem.Title</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Evento:</label>
                            <select class="form-select" @bind="selectedEventId">
                                <option value="">-- Seleccionar Evento --</option>
                                @if (events != null)
                                {
                                    @foreach (var eventItem in events)
                                    {
                                        <option value="@eventItem.Id">@eventItem.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <button class="btn btn-sm btn-outline-primary" @onclick="LoadDropdownData" disabled="@isLoadingDropdowns">
                                @if (isLoadingDropdowns)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Cargar Datos
                            </button>
                        </div>
                    </div>

                    <!-- Entidades específicas -->
                    <div class="mb-3" style="display: @(newDataset.IsDataset == "N" ? "block" : "none")">
                        <h6>🎯 Entidades Específicas:</h6>
                        <div class="mb-2">
                            <label class="form-label">Eventos (mantén Ctrl para seleccionar múltiples):</label>
                            <select class="form-select" multiple size="4" @onchange="OnEventSelectionChanged" id="eventSelect">
                                @if (events != null)
                                {
                                    @foreach (var eventItem in events)
                                    {
                                        <option value="@eventItem.Id">@eventItem.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Noticias (mantén Ctrl para seleccionar múltiples):</label>
                            <select class="form-select" multiple size="4" @onchange="OnNewsSelectionChanged" id="newsSelect">
                                @if (news != null)
                                {
                                    @foreach (var newsItem in news)
                                    {
                                        <option value="@newsItem.Id">@newsItem.Title</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted">
                                Eventos seleccionados: @(selectedEventIds?.Count ?? 0) | 
                                Noticias seleccionadas: @(selectedNewsIds?.Count ?? 0)
                            </small>
                        </div>
                    </div>

                    <button class="btn btn-primary" @onclick="CreateDataset" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Crear Dataset
                    </button>
                </div>
            </div>
        </div>

        <!-- Panel de Consultas -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>📋 Consultar Datasets</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Username:</label>
                        <input type="text" class="form-control" @bind="queryUsername" placeholder="admin" />
                    </div>

                    <div class="mb-3">
                        <button class="btn btn-info me-2" @onclick="GetAllDatasets" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Listar Todos
                        </button>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Dataset ID:</label>
                        <div class="input-group">
                            <input type="number" class="form-control" @bind="datasetId" placeholder="ID del dataset" />
                            <button class="btn btn-success" @onclick="GetDatasetById" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Obtener
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel de Eliminación de Dataset -->
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5>🗑️ Eliminar Dataset</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Username:</label>
                        <input type="text" class="form-control" @bind="deleteUsername" placeholder="admin" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Dataset ID a eliminar:</label>
                        <div class="input-group">
                            <input type="number" class="form-control" @bind="deleteDatasetId" placeholder="ID del dataset" />
                            <button class="btn btn-danger" @onclick="DeleteDatasetById" disabled="@isLoadingDelete">
                                @if (isLoadingDelete)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Eliminar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Resultados -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>📊 Resultados</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(resultMessage))
                    {
                        <div class="alert @(isError ? "alert-danger" : "alert-success")">
                            @resultMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(resultData))
                    {
                        <div class="mt-3">
                            <h6>Datos JSON:</h6>
                            <pre class="bg-light p-3 rounded"><code>@resultData</code></pre>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CreateDatasetUMRequest newDataset = new();
    private string queryUsername = "admin";
    private int? datasetId;
    private string resultMessage = "";
    private string resultData = "";
    private bool isLoading = false;
    private bool isError = false;
    private bool isLoadingDropdowns = false;

    // Datos para dropdowns
    private List<Zone>? zones;
    private List<News>? news;
    private List<Event>? events;

    // Filtros para búsqueda dinámica (ahora usando dropdowns)
    private int? selectedZoneId;
    private int? selectedNewsId;
    private int? selectedEventId;

    // Entidades específicas (ahora usando selección múltiple)
    private List<int>? selectedEventIds = new();
    private List<int>? selectedNewsIds = new();

    private int? deleteDatasetId;
    private string deleteUsername = "admin";
    private bool isLoadingDelete = false;

    protected override async Task OnInitializedAsync()
    {
        newDataset.Username = "admin";
        newDataset.IsDataset = "S";
        await LoadDropdownData();
    }

    private async Task LoadDropdownData()
    {
        isLoadingDropdowns = true;
        resultMessage = "";
        isError = false;

        try
        {
            // Cargar zonas
            var zonesResponse = await Http.GetAsync("api/sondamain/zones");
            if (zonesResponse.IsSuccessStatusCode)
            {
                zones = await zonesResponse.Content.ReadFromJsonAsync<List<Zone>>();
            }

            // Cargar noticias
            var newsResponse = await Http.GetAsync("api/sondamain/newsUM?count=100");
            if (newsResponse.IsSuccessStatusCode)
            {
                news = await newsResponse.Content.ReadFromJsonAsync<List<News>>();
            }

            // Cargar eventos
            var eventsResponse = await Http.GetAsync("api/sondamain/events");
            if (eventsResponse.IsSuccessStatusCode)
            {
                events = await eventsResponse.Content.ReadFromJsonAsync<List<Event>>();
            }

            resultMessage = $"✅ Datos cargados: {zones?.Count ?? 0} zonas, {news?.Count ?? 0} noticias, {events?.Count ?? 0} eventos";
        }
        catch (Exception ex)
        {
            resultMessage = $"❌ Error al cargar datos: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoadingDropdowns = false;
        }
    }

    private async Task OnEventSelectionChanged(ChangeEventArgs e)
    {
        await UpdateSelectedEventIds();
    }

    private async Task OnNewsSelectionChanged(ChangeEventArgs e)
    {
        await UpdateSelectedNewsIds();
    }

    private async Task UpdateSelectedEventIds()
    {
        try
        {
            var selectedValues = await JSRuntime.InvokeAsync<string[]>("getSelectedValues", "eventSelect");
            selectedEventIds = selectedValues?.Select(v => int.Parse(v)).ToList() ?? new List<int>();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating event selection: {ex.Message}");
        }
    }

    private async Task UpdateSelectedNewsIds()
    {
        try
        {
            var selectedValues = await JSRuntime.InvokeAsync<string[]>("getSelectedValues", "newsSelect");
            selectedNewsIds = selectedValues?.Select(v => int.Parse(v)).ToList() ?? new List<int>();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating news selection: {ex.Message}");
        }
    }

    private async Task CreateDataset()
    {
        isLoading = true;
        resultMessage = "";
        resultData = "";
        isError = false;

        try
        {
            // Configurar filtros según el tipo de dataset
            if (newDataset.IsDataset == "S")
            {
                newDataset.ZoneId = selectedZoneId;
                newDataset.NewsId = selectedNewsId;
                // Para eventos, usamos el ID seleccionado para buscar por nombre
                if (selectedEventId.HasValue && events != null)
                {
                    var selectedEvent = events.FirstOrDefault(e => e.Id == selectedEventId.Value);
                    if (selectedEvent != null)
                    {
                        newDataset.EventName = selectedEvent.Name;
                    }
                }
            }
            else
            {
                // Usar las listas de IDs seleccionados
                newDataset.EventIds = selectedEventIds?.Any() == true ? selectedEventIds : null;
                newDataset.NewsIds = selectedNewsIds?.Any() == true ? selectedNewsIds : null;
            }

            var response = await Http.PostAsJsonAsync("api/datasetum", newDataset);
            
            if (response.IsSuccessStatusCode)
            {
                var createdDataset = await response.Content.ReadFromJsonAsync<DatasetUM>();
                resultMessage = $"✅ Dataset creado exitosamente con ID: {createdDataset?.Id}";
                resultData = JsonSerializer.Serialize(createdDataset, new JsonSerializerOptions { WriteIndented = true });
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                resultMessage = $"❌ Error al crear dataset: {response.StatusCode} - {errorContent}";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            resultMessage = $"❌ Excepción: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GetAllDatasets()
    {
        isLoading = true;
        resultMessage = "";
        resultData = "";
        isError = false;

        try
        {
            var response = await Http.GetAsync($"api/datasetum/user/{queryUsername}");
            
            if (response.IsSuccessStatusCode)
            {
                var datasets = await response.Content.ReadFromJsonAsync<List<DatasetUM>>();
                resultMessage = $"✅ Se encontraron {datasets?.Count ?? 0} datasets";
                resultData = JsonSerializer.Serialize(datasets, new JsonSerializerOptions { WriteIndented = true });
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                resultMessage = $"❌ Error al obtener datasets: {response.StatusCode} - {errorContent}";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            resultMessage = $"❌ Excepción: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GetDatasetById()
    {
        if (!datasetId.HasValue)
        {
            resultMessage = "❌ Por favor ingresa un ID de dataset";
            isError = true;
            return;
        }

        isLoading = true;
        resultMessage = "";
        resultData = "";
        isError = false;

        try
        {
            var response = await Http.GetAsync($"api/datasetum/{datasetId.Value}/{queryUsername}");
            
            if (response.IsSuccessStatusCode)
            {
                var dataset = await response.Content.ReadFromJsonAsync<DatasetUM>();
                resultMessage = $"✅ Dataset encontrado: {dataset?.Name}";
                resultData = JsonSerializer.Serialize(dataset, new JsonSerializerOptions { WriteIndented = true });
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                resultMessage = $"❌ No se encontró el dataset con ID {datasetId.Value}";
                isError = true;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                resultMessage = $"❌ Error al obtener dataset: {response.StatusCode} - {errorContent}";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            resultMessage = $"❌ Excepción: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteDatasetById()
    {
        if (!deleteDatasetId.HasValue)
        {
            resultMessage = "❌ Por favor ingresa un ID de dataset para eliminar";
            isError = true;
            return;
        }

        isLoadingDelete = true;
        resultMessage = "";
        resultData = "";
        isError = false;

        try
        {
            // Ajusta la URL según tu API (usualmente DELETE api/datasetum/{id}/{username})
            var response = await Http.DeleteAsync($"api/datasetum/{deleteDatasetId.Value}/{deleteUsername}");

            if (response.IsSuccessStatusCode)
            {
                resultMessage = $"✅ Dataset con ID {deleteDatasetId.Value} eliminado correctamente";
                resultData = "";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                resultMessage = $"❌ No se encontró el dataset con ID {deleteDatasetId.Value}";
                isError = true;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                resultMessage = $"❌ Error al eliminar dataset: {response.StatusCode} - {errorContent}";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            resultMessage = $"❌ Excepción: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoadingDelete = false;
        }
    }
}

<script>
    window.getSelectedValues = (selectId) => {
        const select = document.getElementById(selectId);
        if (!select) return [];
        
        const selectedOptions = Array.from(select.selectedOptions);
        return selectedOptions.map(option => option.value);
    };
</script>
