@page "/marrunoPage/{Id:int}"
@using OmniMonitor.Shared
@inject HttpClient Http
@using OmniMonitor.Shared.Dtos

<PageTitle>Detalle Negro</PageTitle>

@if (Raperos == null)
{
    <MudText>Cargando...</MudText>
}
else
{
    <MudCard Style="max-width:400px;">
        <MudCardContent>
            <MudText Typo="Typo.h5">@Raperos.Nombre (@Raperos.NombreRapero)</MudText>
            <MudText>Edad: @Raperos.Edad</MudText>
            <MudText>Balas Recibidas: @Raperos.Millones</MudText>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Primary" Href="/marrunoPage">Volver</MudButton>
        </MudCardActions>
    </MudCard>
}

@code {
    [Parameter] public int Id { get; set; }

    private Rapero? Raperos;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Raperos = await Http.GetFromJsonAsync<Rapero>($"Marruno/{Id}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar el Rapero: {ex.Message}");
        }
    }
}