@page "/datasetem-test"
@using OmniMonitor.Shared.Dtos
@using OmniMonitor.Shared.Dtos.EM
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>Dataset EM - Página de Prueba</PageTitle>

<div class="container mt-4">
    <h2>🧪 Dataset EM - Página de Prueba</h2>
    <p class="text-muted">Pantalla temporal para probar los endpoints del módulo EM (Alertas, Eventos, Extensiones, Recursos)</p>

    <div class="row">
        <!-- Panel de Creación -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>📝 Crear Dataset EM</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre del Dataset:</label>
                        <input type="text" class="form-control" @bind="newDataset.Name" placeholder="Ej: Mi Dataset EM" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Descripción:</label>
                        <textarea class="form-control" @bind="newDataset.Description" rows="2" placeholder="Descripción del dataset"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tipo de Dataset:</label>
                        <select class="form-select" @bind="newDataset.IsDataset">
                            <option value="S">Formal (búsqueda dinámica)</option>
                            <option value="N">Individual (entidades específicas)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Username:</label>
                        <input type="text" class="form-control" @bind="newDataset.Username" placeholder="admin" />
                    </div>

                    <!-- Filtros para búsqueda dinámica -->
                    <div class="mb-3" style="display: @(newDataset.IsDataset == "S" ? "block" : "none")">
                        <h6>🔍 Filtros de Búsqueda:</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-2">
                                    <label class="form-label">Alerta:</label>
                                    <select class="form-select" @bind="selectedAlertId">
                                        <option value="">-- Seleccionar Alerta --</option>
                                        @if (alerts != null)
                                        {
                                            @foreach (var alert in alerts)
                                            {
                                                <option value="@alert.AlertId">@alert.AlertName</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">Evento:</label>
                                    <select class="form-select" @bind="selectedEventId">
                                        <option value="">-- Seleccionar Evento --</option>
                                        @if (events != null)
                                        {
                                            @foreach (var eventItem in events)
                                            {
                                                <option value="@eventItem.Id">@eventItem.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-2">
                                    <label class="form-label">Extensión:</label>
                                    <select class="form-select" @bind="selectedExtensionId">
                                        <option value="">-- Seleccionar Extensión --</option>
                                        @if (extensions != null)
                                        {
                                            @foreach (var extension in extensions)
                                            {
                                                <option value="@extension.ExtensionId">@extension.EventName</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">Recurso:</label>
                                    <select class="form-select" @bind="selectedResourceId">
                                        <option value="">-- Seleccionar Recurso --</option>
                                        @if (resources != null)
                                        {
                                            @foreach (var resource in resources)
                                            {
                                                <option value="@resource.Id">@resource.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-2">
                                    <label class="form-label">Alert State:</label>
                                    <input type="text" class="form-control" @bind="alertState" placeholder="Estado de alerta" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">Event State:</label>
                                    <input type="text" class="form-control" @bind="eventState" placeholder="Estado de evento" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-2">
                                    <label class="form-label">Extension State:</label>
                                    <input type="text" class="form-control" @bind="extensionState" placeholder="Estado de extensión" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">Resource State:</label>
                                    <input type="text" class="form-control" @bind="resourceState" placeholder="Estado de recurso" />
                                </div>
                            </div>
                        </div>
                        <div class="mb-2">
                            <button class="btn btn-sm btn-outline-primary" @onclick="LoadDropdownData" disabled="@isLoadingDropdowns">
                                @if (isLoadingDropdowns)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Cargar Datos
                            </button>
                        </div>
                    </div>

                    <!-- Entidades específicas -->
                    <div class="mb-3" style="display: @(newDataset.IsDataset == "N" ? "block" : "none")">
                        <h6>🎯 Entidades Específicas:</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-2">
                                    <label class="form-label">Alertas (mantén Ctrl para seleccionar múltiples):</label>
                                    <select class="form-select" multiple size="3" @onchange="OnAlertSelectionChanged" id="alertSelect">
                                        @if (alerts != null)
                                        {
                                            @foreach (var alert in alerts)
                                            {
                                                <option value="@alert.AlertId">@alert.AlertName</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">Eventos (mantén Ctrl para seleccionar múltiples):</label>
                                    <select class="form-select" multiple size="3" @onchange="OnEventSelectionChanged" id="eventSelect">
                                        @if (events != null)
                                        {
                                            @foreach (var eventItem in events)
                                            {
                                                <option value="@eventItem.Id">@eventItem.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-2">
                                    <label class="form-label">Extensiones (mantén Ctrl para seleccionar múltiples):</label>
                                    <select class="form-select" multiple size="3" @onchange="OnExtensionSelectionChanged" id="extensionSelect">
                                        @if (extensions != null)
                                        {
                                            @foreach (var extension in extensions)
                                            {
                                                <option value="@extension.ExtensionId">@extension.EventName</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">Recursos (mantén Ctrl para seleccionar múltiples):</label>
                                    <select class="form-select" multiple size="3" @onchange="OnResourceSelectionChanged" id="resourceSelect">
                                        @if (resources != null)
                                        {
                                            @foreach (var resource in resources)
                                            {
                                                <option value="@resource.Id">@resource.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted">
                                Alertas: @(selectedAlertIds?.Count ?? 0) | 
                                Eventos: @(selectedEventIds?.Count ?? 0) | 
                                Extensiones: @(selectedExtensionIds?.Count ?? 0) | 
                                Recursos: @(selectedResourceIds?.Count ?? 0)
                            </small>
                        </div>
                    </div>

                    <button class="btn btn-primary" @onclick="CreateDataset" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Crear Dataset
                    </button>
                </div>
            </div>
        </div>

        <!-- Panel de Consultas -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>📋 Consultar Datasets</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Username:</label>
                        <input type="text" class="form-control" @bind="queryUsername" placeholder="admin" />
                    </div>

                    <div class="mb-3">
                        <button class="btn btn-info me-2" @onclick="GetAllDatasets" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Listar Todos
                        </button>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Dataset ID:</label>
                        <div class="input-group">
                            <input type="number" class="form-control" @bind="datasetId" placeholder="ID del dataset" />
                            <button class="btn btn-success" @onclick="GetDatasetById" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Obtener
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Resultados -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>📊 Resultados</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(resultMessage))
                    {
                        <div class="alert @(isError ? "alert-danger" : "alert-success")">
                            @resultMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(resultData))
                    {
                        <div class="mt-3">
                            <h6>Datos JSON:</h6>
                            <pre class="bg-light p-3 rounded"><code>@resultData</code></pre>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CreateDatasetEMRequest newDataset = new();
    private string queryUsername = "admin";
    private int? datasetId;
    private string resultMessage = "";
    private string resultData = "";
    private bool isLoading = false;
    private bool isError = false;
    private bool isLoadingDropdowns = false;

    // Datos para dropdowns
    private List<AlertDto>? alerts;
    private List<EventDto>? events;
    private List<ExtensionDto>? extensions;
    private List<ResourceDto>? resources;

    // Filtros para búsqueda dinámica (ahora usando dropdowns)
    private int? selectedAlertId;
    private int? selectedEventId;
    private int? selectedExtensionId;
    private int? selectedResourceId;
    private string alertState = "";
    private string eventState = "";
    private string extensionState = "";
    private string resourceState = "";

    // Entidades específicas (ahora usando selección múltiple)
    private List<int>? selectedAlertIds = new();
    private List<int>? selectedEventIds = new();
    private List<int>? selectedExtensionIds = new();
    private List<int>? selectedResourceIds = new();

    
    protected override async Task OnInitializedAsync()
    {
        newDataset.Username = "admin";
        newDataset.IsDataset = "S";
        await LoadDropdownData();
    }

    private async Task LoadDropdownData()
    {
        isLoadingDropdowns = true;
        resultMessage = "";
        isError = false;

        try
        {
            // Cargar alertas
            var alertsResponse = await Http.GetAsync("api/sondaem/alert?pageSize=100&user=admin&pass=admin");
            if (alertsResponse.IsSuccessStatusCode)
            {
                alerts = await alertsResponse.Content.ReadFromJsonAsync<List<AlertDto>>();
            }

            // Cargar eventos
            var eventsResponse = await Http.GetAsync("api/sondaem/event/events?pageSize=100&user=admin&pass=admin");
            if (eventsResponse.IsSuccessStatusCode)
            {
                events = await eventsResponse.Content.ReadFromJsonAsync<List<EventDto>>();
            }

            // Cargar extensiones
            var extensionsResponse = await Http.GetAsync("api/sondaem/extensions?pageSize=100&user=admin&pass=admin");
            if (extensionsResponse.IsSuccessStatusCode)
            {
                extensions = await extensionsResponse.Content.ReadFromJsonAsync<List<ExtensionDto>>();
            }

            // Nota: No hay endpoint para obtener todos los recursos, solo por ID individual
            // Por ahora, inicializamos como lista vacía
            resources = new List<ResourceDto>();

            resultMessage = $"✅ Datos cargados: {alerts?.Count ?? 0} alertas, {events?.Count ?? 0} eventos, {extensions?.Count ?? 0} extensiones, {resources?.Count ?? 0} recursos";
        }
        catch (Exception ex)
        {
            resultMessage = $"❌ Error al cargar datos: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoadingDropdowns = false;
        }
    }

    private async Task OnAlertSelectionChanged(ChangeEventArgs e)
    {
        await UpdateSelectedAlertIds();
    }

    private async Task OnEventSelectionChanged(ChangeEventArgs e)
    {
        await UpdateSelectedEventIds();
    }

    private async Task OnExtensionSelectionChanged(ChangeEventArgs e)
    {
        await UpdateSelectedExtensionIds();
    }

    private async Task OnResourceSelectionChanged(ChangeEventArgs e)
    {
        await UpdateSelectedResourceIds();
    }

    private async Task UpdateSelectedAlertIds()
    {
        try
        {
            var selectedValues = await JSRuntime.InvokeAsync<string[]>("getSelectedValues", "alertSelect");
            selectedAlertIds = selectedValues?.Select(v => int.Parse(v)).ToList() ?? new List<int>();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating alert selection: {ex.Message}");
        }
    }

    private async Task UpdateSelectedEventIds()
    {
        try
        {
            var selectedValues = await JSRuntime.InvokeAsync<string[]>("getSelectedValues", "eventSelect");
            selectedEventIds = selectedValues?.Select(v => int.Parse(v)).ToList() ?? new List<int>();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating event selection: {ex.Message}");
        }
    }

    private async Task UpdateSelectedExtensionIds()
    {
        try
        {
            var selectedValues = await JSRuntime.InvokeAsync<string[]>("getSelectedValues", "extensionSelect");
            selectedExtensionIds = selectedValues?.Select(v => int.Parse(v)).ToList() ?? new List<int>();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating extension selection: {ex.Message}");
        }
    }

    private async Task UpdateSelectedResourceIds()
    {
        try
        {
            var selectedValues = await JSRuntime.InvokeAsync<string[]>("getSelectedValues", "resourceSelect");
            selectedResourceIds = selectedValues?.Select(v => int.Parse(v)).ToList() ?? new List<int>();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating resource selection: {ex.Message}");
        }
    }

    private async Task CreateDataset()
    {
        isLoading = true;
        resultMessage = "";
        resultData = "";
        isError = false;

        try
        {
            // Configurar filtros según el tipo de dataset
            if (newDataset.IsDataset == "S")
            {
                newDataset.AlertId = selectedAlertId;
                newDataset.EventId = selectedEventId;
                newDataset.ExtensionId = selectedExtensionId;
                newDataset.ResourceId = selectedResourceId;
                newDataset.AlertState = alertState;
                newDataset.EventState = eventState;
                newDataset.ExtensionState = extensionState;
                newDataset.ResourceState = resourceState;
            }
            else
            {
                // Usar las listas de IDs seleccionados
                newDataset.AlertIds = selectedAlertIds?.Any() == true ? selectedAlertIds : null;
                newDataset.EventIds = selectedEventIds?.Any() == true ? selectedEventIds : null;
                newDataset.ExtensionIds = selectedExtensionIds?.Any() == true ? selectedExtensionIds : null;
                newDataset.ResourceIds = selectedResourceIds?.Any() == true ? selectedResourceIds : null;
            }

            var response = await Http.PostAsJsonAsync("api/datasetem", newDataset);
            
            if (response.IsSuccessStatusCode)
            {
                var createdDataset = await response.Content.ReadFromJsonAsync<DatasetEM>();
                resultMessage = $"✅ Dataset creado exitosamente con ID: {createdDataset?.Id}";
                resultData = JsonSerializer.Serialize(createdDataset, new JsonSerializerOptions { WriteIndented = true });
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                resultMessage = $"❌ Error al crear dataset: {response.StatusCode} - {errorContent}";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            resultMessage = $"❌ Excepción: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GetAllDatasets()
    {
        isLoading = true;
        resultMessage = "";
        resultData = "";
        isError = false;

        try
        {
            var response = await Http.GetAsync($"api/datasetem/user/{queryUsername}");
            
            if (response.IsSuccessStatusCode)
            {
                var datasets = await response.Content.ReadFromJsonAsync<List<DatasetEM>>();
                resultMessage = $"✅ Se encontraron {datasets?.Count ?? 0} datasets";
                resultData = JsonSerializer.Serialize(datasets, new JsonSerializerOptions { WriteIndented = true });
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                resultMessage = $"❌ Error al obtener datasets: {response.StatusCode} - {errorContent}";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            resultMessage = $"❌ Excepción: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GetDatasetById()
    {
        if (!datasetId.HasValue)
        {
            resultMessage = "❌ Por favor ingresa un ID de dataset";
            isError = true;
            return;
        }

        isLoading = true;
        resultMessage = "";
        resultData = "";
        isError = false;

        try
        {
            var response = await Http.GetAsync($"api/datasetem/{datasetId.Value}/{queryUsername}");
            
            if (response.IsSuccessStatusCode)
            {
                var dataset = await response.Content.ReadFromJsonAsync<DatasetEM>();
                resultMessage = $"✅ Dataset encontrado: {dataset?.Name}";
                resultData = JsonSerializer.Serialize(dataset, new JsonSerializerOptions { WriteIndented = true });
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                resultMessage = $"❌ No se encontró el dataset con ID {datasetId.Value}";
                isError = true;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                resultMessage = $"❌ Error al obtener dataset: {response.StatusCode} - {errorContent}";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            resultMessage = $"❌ Excepción: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }
}

<script>
    window.getSelectedValues = (selectId) => {
        const select = document.getElementById(selectId);
        if (!select) return [];
        
        const selectedOptions = Array.from(select.selectedOptions);
        return selectedOptions.map(option => option.value);
    };
</script>
