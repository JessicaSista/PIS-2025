@using MudBlazor
@using OmniMonitor.Client.Pages
@using OmniMonitor.Shared
@using OmniMonitor.Shared.Dtos

<MudPaper Class="pa-4" Elevation="2" Style="height: 75vh; overflow-y: auto;">
    <TabSelector ActiveTab="@ActiveTab"
                 OnTabChange="SetActiveTab" />

    @if (ActiveTab == "datasets")
    {
        <DatasetSelector SelectedDatasets="SelectedDatasets"
                         FilteredDatasets="FilteredDatasets"
                         OnDatasetToggle="OnDatasetToggle"
                         IsDatasetSelected="IsDatasetSelected"
                         ResolveSelectedEntity="ResolveSelectedEntity"
                         ResolveEntityOptions="ResolveEntityOptions"
                         OnEntityChanged="OnDatasetEntityChanged"
                         SearchText="@DatasetSearchText"
                         OnSearchTextChanged="OnDatasetSearchTextChanged" />
    }
    else if (ActiveTab == "columnas")
    {
        <ColumnSelector SelectedDatasets="SelectedDatasets"
                        Joins="Joins"
                        AvailableColumns="AvailableColumns"
                        HasJoinColumns="HasJoinColumns"
                        OnSelectAllColumns="OnSelectAllColumns"
                        OnDeselectAllColumns="OnDeselectAllColumns"
                        OnColumnToggled="OnColumnToggled"
                        ResolveDatasetLabel="ResolveDatasetLabel"
                        ResolveJoinLabel="ResolveJoinLabel" />
    }
    else if (ActiveTab == "joins")
    {
        <JoinSelector SelectedDatasets="SelectedDatasets"
                      Joins="Joins"
                      OnJoinAdd="OnJoinAdd"
                      OnJoinRemove="OnJoinRemove"
                      OnApplyJoins="OnApplyJoins"
                      ResolvePropertyNames="ResolvePropertyNamesForDataset"
                      OnJoinDatasetsChanged="OnJoinDatasetsChanged" />
    }
    else if (ActiveTab == "filtros")
    {
        <FilterSelector Filters="Filters"
                        AvailableColumns="AvailableColumns"
                        OnFilterAdd="OnFilterAdd"
                        OnFilterRemove="OnFilterRemove" />
    }
</MudPaper>

@code {
    [Parameter] public string ActiveTab { get; set; } = "datasets";
    [Parameter] public EventCallback<string> OnActiveTabChanged { get; set; }

    [Parameter] public IReadOnlyList<DatasetDto> SelectedDatasets { get; set; } = Array.Empty<DatasetDto>();
    [Parameter] public IReadOnlyList<DatasetDto>? FilteredDatasets { get; set; }
        = Array.Empty<DatasetDto>();
    [Parameter] public EventCallback<DatasetDto> OnDatasetToggle { get; set; }
    [Parameter] public Func<DatasetDto, bool>? IsDatasetSelected { get; set; }
    [Parameter] public Func<DatasetDto, EntityName>? ResolveSelectedEntity { get; set; }
    [Parameter] public Func<string?, IEnumerable<EntityName>>? ResolveEntityOptions { get; set; }
    [Parameter] public EventCallback<DatasetSelector.EntitySelectionChangedArgs> OnDatasetEntityChanged { get; set; }
    [Parameter] public string DatasetSearchText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnDatasetSearchTextChanged { get; set; }

    [Parameter] public List<EditReport.ColumnDefinition> AvailableColumns { get; set; } = new();
    [Parameter] public IReadOnlyList<EditReport.JoinDto> Joins { get; set; } = Array.Empty<EditReport.JoinDto>();
    [Parameter] public bool HasJoinColumns { get; set; }
    [Parameter] public EventCallback OnSelectAllColumns { get; set; }
    [Parameter] public EventCallback OnDeselectAllColumns { get; set; }
    [Parameter] public EventCallback<EditReport.ColumnDefinition> OnColumnToggled { get; set; }
    [Parameter] public Func<DatasetDto, string>? ResolveDatasetLabel { get; set; }
    [Parameter] public Func<int, string>? ResolveJoinLabel { get; set; }

    [Parameter] public EventCallback OnJoinAdd { get; set; }
    [Parameter] public EventCallback<EditReport.JoinDto> OnJoinRemove { get; set; }
    [Parameter] public EventCallback OnApplyJoins { get; set; }
    [Parameter] public Func<string?, IEnumerable<string>>? ResolvePropertyNamesForDataset { get; set; }
    [Parameter] public EventCallback<EditReport.JoinDto> OnJoinDatasetsChanged { get; set; }

    [Parameter] public List<EditReport.FilterDto> Filters { get; set; } = new();
    [Parameter] public EventCallback OnFilterAdd { get; set; }
    [Parameter] public EventCallback<EditReport.FilterDto> OnFilterRemove { get; set; }

    private async Task SetActiveTab(string tab)
    {
        ActiveTab = tab;
        if (OnActiveTabChanged.HasDelegate)
        {
            await OnActiveTabChanged.InvokeAsync(tab);
        }
    }
}
