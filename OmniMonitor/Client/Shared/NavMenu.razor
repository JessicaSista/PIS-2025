@using Microsoft.Extensions.Localization
@using MudBlazor
@inject IStringLocalizer<NavMenu> Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer

<div Class="navmenu-container">
    <MudPaper Width="250px" Class="py-3" Elevation="0">
        
        <MudNavMenu>
    
        @if (_drawerOpen)
        {
            <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary">Principal</MudText>
        }        
        <MudNavLink Href="/dashboards" Icon=@Icons.Material.Filled.Home>
            @if (_drawerOpen)
            {
                <span class="ml-2">@SharedLocalizer["DashboardsTitle"]</span>
            }
        </MudNavLink>
        <MudNavLink Href="/datasets" Icon="@Icons.Material.Filled.Dataset">
            @if (_drawerOpen)
            {
                <span class="ml-2">@SharedLocalizer["DatasetsTitle"]</span>
            }
        </MudNavLink>
        <MudNavLink Href="/visualizaciones" Icon=@Icons.Material.Filled.InsertChart>
            @if (_drawerOpen)
            {
                <span class="ml-2">@SharedLocalizer["VisualizationsTitle"]</span>
            }
        </MudNavLink>
        <MudNavLink Href="/reportes" Icon=@Icons.Material.Filled.Article>
            @if (_drawerOpen)
            {
                <span class="ml-2">@SharedLocalizer["ReportsTitle"]</span>
            }
        </MudNavLink>
        <MudNavLink Href="/Visualizacion-rapida" Icon=@Icons.Material.Filled.TrendingUp>
            @if (_drawerOpen)
            {
                <span class="ml-2">Visualizacion Rapida</span>
            }
        </MudNavLink>
              
        </MudNavMenu>
    </MudPaper>
</div>

@code {
    [CascadingParameter] private bool _drawerOpen { get; set; } 
}
