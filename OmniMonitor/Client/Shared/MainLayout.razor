@using MudBlazor
@inherits LayoutComponentBase

@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout Style="background: linear-gradient(to bottom, #0F1522, #20262F); min-height: 100vh;">
    <MudStack Row Style="min-height: 100vh;">
        <NavMenu />
        <main>
            @Body
        </main>
    </MudStack>
</MudLayout>