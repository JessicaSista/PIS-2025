@using MudBlazor
@using OmniMonitor.Client.Services
@inherits LayoutComponentBase
@inject ThemeService ThemeService

<MudThemeProvider Theme="ThemeService.CurrentTheme"
                  IsDarkMode="@(ThemeService.CurrentMode == ThemeMode.Dark)" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />


<!--<MudLayout Style="background: linear-gradient(to bottom, #0F1522, #20262F); min-height: 100vh;">
    <MudStack Row Style="min-height: 100vh;">
        <NavMenu />
        <main>
            @Body
        </main>
    </MudStack>
</MudLayout> -->



<div style="@ThemeService.CurrentThemeVariables">
    <MudLayout>
        <CascadingValue Value="_drawerOpen">
            <AuthorizeView>
                <Authorized>
                    <MudDrawer @bind-Open="_drawerOpen"
                               Variant="DrawerVariant.Mini"
                               Elevation="1"
                               MiniVariantWidth="80px"
                               Anchor="Anchor.Start"
                               Class="custom-drawer">
                        <NavMenu />
                    </MudDrawer>
                </Authorized>
            </AuthorizeView>
        </CascadingValue>
        <MudMainContent Class="d-flex flex-grow">
            <AppBar ToggleDrawer="ToggleDrawer"/>

            <MudContainer MaxWidth="MaxWidth.False" Class="pa-4 d-flex flex-column flex-grow">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</div>

@code {
    private bool _drawerOpen = true;

    protected override async Task OnInitializedAsync()
    {
        // 1. Inicializa el tema al inicio de la app (carga desde LocalStorage)
        await ThemeService.InitializeThemeAsync();

        // 2. Se suscribe al evento para que sepa cuándo redibujar
        ThemeService.OnThemeChange += ThemeChanged;
    }

    private void ThemeChanged()
    {
        // CRÍTICO: Fuerza el redibujado en el hilo de la UI cuando el tema cambia
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        // Importante: elimina la suscripción al evento al desechar el componente
        ThemeService.OnThemeChange -= ThemeChanged;
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

}

