@using MudBlazor.Extensions
@inject ISnackbar SnackbarService

@if(!esKPI){
    <MudItem lg=@WidthLg md=@WidthMd sm="@WidthXs" xs=@WidthXs>
        <MudCard Style="@($"background-color: #010717; color: #ffffff; height: {height}px; border: 1px solid #222832;")" Outlined="true">
            <MudCardHeader Class="d-flex justify-space-between pt-5 pl-3 pr-2" Style="height: 40px; color: #ccc">
                <MudStack Row="true" Spacing="0">
                    <MudStack Spacing="0">
                        <MudIconButton @onclick="ResizeUp" Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="MudBlazor.Size.Small" class="pa-0" Color="MudBlazor.Color.Inherit"/>
                        <MudIconButton @onclick="ResizeDown" Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="MudBlazor.Size.Small" class="pa-0" Color="MudBlazor.Color.Inherit"/>
                    </MudStack>
                    <MudIconButton @onclick="ResizeLeft" Icon="@Icons.Material.Filled.KeyboardArrowLeft" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Inherit"/>
                    <MudIconButton @onclick="ResizeRight" Icon="@Icons.Material.Filled.KeyboardArrowRight" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Inherit"/>
                </MudStack>
                <MudIconButton Icon="@Icons.Material.Filled.Settings" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Inherit"/>
            </MudCardHeader>
            <MudText Class="px-7 py-5" Typo="Typo.h6" Style="color: #bfc2c0">@Title</MudText>
            <MudCardContent Class="pl-7  pr-8" Style="color: #e7ebea !important">
                <ApexChart TItem="DataPoint" @key="height" Height="@(height - 130)">
                    @foreach (var (nombre, color, _, seriesData) in Datos)
                    {
                        <ApexPointSeries TItem="DataPoint" Items="GetDataPoints(seriesData)" Name="@nombre" Color=@color SeriesType=@GraphTypes[GraphType] XValue="@(item => item.X)" YValue="@(item => item.Y)"  />
                    }
                </ApexChart>
            </MudCardContent>
        </MudCard>
    </MudItem>
} else{
    <MudItem lg=@WidthLg md=6 sm=12 xs=12>
        <MudCard Style="@($"background-color: #121a26; color: #ffffff; border: 1px solid #3f4555")" Outlined="true">
            <MudCardContent>
                <MudContainer Class="d-flex flex-column gap-2">
                    <MudText Typo="Typo.body2" Style="color: #6e8290; font-weight: bold;">@Title</MudText>
                    <MudText Typo="Typo.h4" Style="color: #e7ebea; font-weight: 500;">$2,405.90</MudText>
                    <MudText Typo="Typo.body2" Style="color: #677e8b">+12.5% desde último mes</MudText>
                </MudContainer>
            </MudCardContent>
        </MudCard>
    </MudItem>
}

@code{
    //Parametro para saber el Breakpoint actual
    [CascadingParameter] public Breakpoint CurrentBreakpoint { get; set; }

    //Parametros
    [Parameter] public int height {get; set;} = 400;
    [Parameter] public int WidthLg { get; set; } = 3;
    [Parameter] public int WidthMd { get; set; } = 6;
    [Parameter] public int WidthXs { get; set; } = 12;
    [Parameter] public System.String Title  { get; set; } = "no deberías ver esto";

    [Parameter] public (System.String, System.String, double, double[])[] Datos { get; set; } = Array.Empty<(System.String, System.String, double, double[])>();
    [Parameter] public int GraphType { get; set; } = 0;
    [Parameter] public System.String[] dominio { get; set; } = {};
    [Parameter] public double Multiplier {get; set;} = 1;

    //Parameto temporal para saber si es KPI
    [Parameter] public bool esKPI {get; set;} = false;

    //Estructura de mapping para los tipos de grafica
    private SeriesType[] GraphTypes = {SeriesType.Line, SeriesType.Bar, SeriesType.Area};


    //Funciones para cambiar la disposicion de los widgets en el dashboard
    private void ResizeUp(){
        if(height == 300){
            SnackbarService.Add("No se puede disminuir más. Recuerde que puede cambiar el tamaño mínimo en ajustes", Severity.Warning);
            return;
        }
        height -= 50;
    }
    
    private void ResizeDown(){
        height +=50;
        Console.WriteLine(CurrentBreakpoint);
    }

    private void ResizeLeft(){
        if((CurrentBreakpoint == Breakpoint.Xs  || CurrentBreakpoint == Breakpoint.Sm) && WidthXs > 6){
            WidthXs -= 1; 
            return;
        }
        else if((CurrentBreakpoint == Breakpoint.Md) && WidthMd > 4){
            WidthMd -= 1;
            return;
        }
        else if((CurrentBreakpoint == Breakpoint.Lg || CurrentBreakpoint == Breakpoint.Xl) && WidthLg > 3){
            WidthLg -= 1;
            return;
        }
        SnackbarService.Add("No se puede disminuir más. Recuerde que puede cambiar el tamaño mínimo en ajustes", Severity.Warning);
    }

    private void ResizeRight(){
        if((CurrentBreakpoint == Breakpoint.Xs  || CurrentBreakpoint == Breakpoint.Sm) && WidthXs < 12){
            WidthXs += 1; 
            return;
        }
        else if(CurrentBreakpoint == Breakpoint.Md && WidthMd < 12){
            WidthMd += 1;
            return;
        }
        else if((CurrentBreakpoint == Breakpoint.Lg || CurrentBreakpoint == Breakpoint.Xl) && WidthLg < 12){
            WidthLg += 1;
            return;
        }
        SnackbarService.Add("No se puede aumentar más.", Severity.Warning);
    }


    //CODIGO PARA LAS GRAFICAS
    public class DataPoint {
        public System.String X { get; set; } = System.String.Empty;
        public decimal Y { get; set; }
    }

    // Método para convertir array de ints a DataPoints
    private DataPoint[] GetDataPoints(double[] data) {
        return data.Select((value, index) => new DataPoint
        {
            X = index < dominio.Length ? dominio[index] : index.ToString(),
            Y = (decimal)value
        }).ToArray();
    }
}