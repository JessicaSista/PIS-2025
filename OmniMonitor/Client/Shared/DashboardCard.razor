@using OmniMonitor.Shared.Dtos
@using System.Text.Json
@using MudBlazor.Extensions
@using System.Globalization
@using Microsoft.Extensions.Localization
@using static OmniMonitor.Client.Shared.VisualizationCard
@using Blazored.LocalStorage
@using System.Reflection.Metadata
@using Microsoft.AspNetCore.Components.Web
@inject ISnackbar SnackbarService
@inject IStringLocalizer<DashboardCard> Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject IDialogService DialogService


<MudItem lg=@WidthLg md=@WidthMd sm="@WidthXs" xs=@WidthXs>
    <div style="cursor: move;" draggable="true" data-drag-ghost="card"
         @ondragstart="HandleDragStart"
         @ondragend="HandleDragEnd"
         @ondragenter:preventDefault
         @ondragover:preventDefault
         @ondragover="HandleDragOver"
         @ondrop:preventDefault
         @ondragenter="HandleDragEnter"
         @ondragleave="HandleDragLeave"
         @ondrop="HandleDrop">
    <MudCard Style="@($"background-color: var(--card); color: var(--card-text-primary); height: {Height}px; border: 1px solid {_borderColor}; border-radius:7px;")"
             Outlined="true">

        <MudCardHeader Class="d-flex justify-space-between pt-5 pl-3 pr-2"
                       Style="height: 40px; color: var(--card-text-secondary); position:relative">
            <MudStack Row="true" Spacing="0">
                <MudStack Spacing="0">
                    <MudIconButton @onclick="ResizeUp" Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="MudBlazor.Size.Small" class="pa-0" Color="MudBlazor.Color.Inherit" />
                    <MudIconButton @onclick="ResizeDown" Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="MudBlazor.Size.Small" class="pa-0" Color="MudBlazor.Color.Inherit" />
                </MudStack>
                <MudIconButton @onclick="ResizeLeft" Icon="@Icons.Material.Filled.KeyboardArrowLeft" Size="MudBlazor.Size.Small" class="pa-0" Color="MudBlazor.Color.Inherit" />
                <MudIconButton @onclick="ResizeRight" Icon="@Icons.Material.Filled.KeyboardArrowRight" Size="MudBlazor.Size.Small" class="pa-0" Color="MudBlazor.Color.Inherit" />
            </MudStack>
            <!-- <span style="position:absolute; left:56px; top:8px; background:#111827; color:#e5e7eb; border:1px solid #374151; border-radius:6px; padding:2px 6px; font-size:12px; line-height:1;">
                @VisualizationId
            </span> -->
            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                     AnchorOrigin="Origin.TopRight"
                     TransformOrigin="Origin.TopRight"
                     Class="position-absolute"
                     Style="position:absolute; top:8px; right:8px;">

                <MudMenuItem OnClick="@(() => OpenEditVisualizationDialog())">
                    @Localizer["Editar"]
                </MudMenuItem>

                <MudMenuItem OnClick="@(() => ConfirmDelete())">
                    @Localizer["Eliminar"]
                </MudMenuItem>
            </MudMenu>
        </MudCardHeader>

        
                 
        @if (!_esKPI)
        {
            

            <ChartViewer @key="_chartViewerKey" ChartReloadKey="@_chartKey" VisualizationId="VisualizationId" />
            

        } 
        else
        {

            <div class="d-flex flex-grow: 1; pa-5">
                <KpiViewer KpiId="@VisualizationId"/>
            </div>

        }
    </MudCard>
    </div>
</MudItem>

@code{
    //Parametro para saber el Breakpoint actual
    [CascadingParameter] public Breakpoint CurrentBreakpoint { get; set; }

    //Parametros
    [Parameter] public int dashboardId { get; set; }
    [Parameter] public int VisualizationId { get; set; }
    [Parameter] public int VisualizationType { get; set; }
    [Parameter] public int Index { get; set; }
    [Parameter] public int WidthLg { get; set; }
    [Parameter] public int WidthMd { get; set; }
    [Parameter] public int WidthXs { get; set; }
    [Parameter] public int Height {get; set;}

    [Parameter] public EventCallback<(int, int, int, int, int, int)> UpdateCardSize { get; set; }
    [Parameter] public EventCallback<(int, int)> RemoveCard { get; set; }
    [Parameter] public EventCallback<int> DragStarted { get; set; }
    [Parameter] public EventCallback<int> DroppedOn { get; set; }


    // Variables Locales
    private bool _esKPI {get; set;} = false;
    private bool _isDragOver = false;
    private bool _isDraggingSelf = false;
    private int _dragOverDepth = 0;
    private string _borderColor => _isDragOver ? "#22c55e" : "#374151";
    private string _authenticatedUser = string.Empty;


    private int _chartViewerKey = 0; //cuando se modifica esta variable, el ChartViewer vuelve a pedir los datos
    private int _chartKey = 0; //cuando se modifica esta variable, la grafica se re-renderiza


    protected override async Task OnInitializedAsync()
    {
        _esKPI = VisualizationType == 2;

    }

    //Funciones para cambiar la disposicion de los widgets en el dashboard
    private void ResizeUp(){
        if(Height == 300){
            SnackbarService.Add(Localizer["NoDisminuirMas"], Severity.Warning);
            return;
        }
        Height -= 50;
        UpdateCardSize.InvokeAsync((VisualizationId, VisualizationType, WidthXs, WidthMd, WidthLg, Height));
        _chartKey++;
        StateHasChanged();
    }

    private void ResizeDown(){
        Height +=50;
        UpdateCardSize.InvokeAsync((VisualizationId, VisualizationType, WidthXs, WidthMd, WidthLg, Height));
        _chartKey++;
        StateHasChanged();
    }

    private void ResizeLeft(){
        if((CurrentBreakpoint == Breakpoint.Xs  || CurrentBreakpoint == Breakpoint.Sm) && WidthXs > 6){
            WidthXs -= 1;
            UpdateCardSize.InvokeAsync((VisualizationId, VisualizationType, WidthXs, WidthMd, WidthLg, Height));
            return;
        }
        else if((CurrentBreakpoint == Breakpoint.Md) && WidthMd > 4){
            WidthMd -= 1;
            UpdateCardSize.InvokeAsync((VisualizationId, VisualizationType, WidthXs, WidthMd, WidthLg, Height));
            return;
        }
        else if((CurrentBreakpoint == Breakpoint.Lg || CurrentBreakpoint == Breakpoint.Xl) && WidthLg > 3){
            WidthLg -= 1;
            UpdateCardSize.InvokeAsync((VisualizationId, VisualizationType, WidthXs, WidthMd, WidthLg, Height));
            return;
        }
        SnackbarService.Add(Localizer["NoDisminuirMas"], Severity.Warning);
    }

    private void ResizeRight(){
        if((CurrentBreakpoint == Breakpoint.Xs  || CurrentBreakpoint == Breakpoint.Sm) && WidthXs < 12){
            WidthXs += 1;
            UpdateCardSize.InvokeAsync((VisualizationId, VisualizationType, WidthXs, WidthMd, WidthLg, Height));
            return;
        }
        else if(CurrentBreakpoint == Breakpoint.Md && WidthMd < 12){
            WidthMd += 1;
            UpdateCardSize.InvokeAsync((VisualizationId, VisualizationType, WidthXs, WidthMd, WidthLg, Height));
            return;
        }
        else if((CurrentBreakpoint == Breakpoint.Lg || CurrentBreakpoint == Breakpoint.Xl) && WidthLg < 12){
            WidthLg += 1;
            UpdateCardSize.InvokeAsync((VisualizationId, VisualizationType, WidthXs, WidthMd, WidthLg, Height));
            return;
        }
        SnackbarService.Add(Localizer["NoAumentarMas"], Severity.Warning);
    }

    private async Task OpenEditVisualizationDialog()
    {
        //Provisionalmente si es KPI no hago nada
        if (VisualizationType != 2) {
            DialogOptions? options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium };
            DialogParameters parameters = new DialogParameters
                {

                    ["dashboardId"] = dashboardId,
                    ["visualizationId"] = VisualizationId
                };
            IDialogReference? dialog = await DialogService.ShowAsync<EditVisualizationDialog>("Editar Visualización", parameters, options);
            DialogResult? result = await dialog.Result;

            if (result != null && !result.Canceled)
            {
                try
                {
                    _chartViewerKey++;

                    StateHasChanged();

                    SnackbarService.Add("Visualización actualizada", Severity.Success);
                }
                catch (Exception ex)
                {
                    SnackbarService.Add($"Error actualizando visualizacion: {ex.Message}", Severity.Warning);
                }
            }
        }
    }


    private async Task ConfirmDelete()
    {
        bool? result = await DialogService.ShowMessageBox(
            SharedLocalizer[""],
            SharedLocalizer["RemoveCardText"],
            yesText: SharedLocalizer["DeleteButtonText"],
            cancelText: SharedLocalizer["CancelButtonText"],
            options: new DialogOptions
            {
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.ExtraSmall
            }
        );

        if (result == true)
        {
            RemoveCard.InvokeAsync((VisualizationId,VisualizationType));
        }
    }

    private Task HandleDragStart(DragEventArgs e)
    {
        try
        {
            if (e.DataTransfer != null)
            {
                e.DataTransfer.EffectAllowed = "move";
                e.DataTransfer.DropEffect = "move";
            }
        }
        catch {}
        _isDraggingSelf = true;
        return DragStarted.InvokeAsync(Index);
    }

    private void HandleDragEnd(DragEventArgs e)
    {
        _isDraggingSelf = false;
        _dragOverDepth = 0;
        _isDragOver = false;
        StateHasChanged();
    }

    private Task HandleDrop(DragEventArgs e)
    {
        _dragOverDepth = 0;
        _isDragOver = false;
        _isDraggingSelf = false;
        return DroppedOn.InvokeAsync(Index);
    }

    private void HandleDragEnter(DragEventArgs e)
    {
        if (_isDraggingSelf) return;
        _dragOverDepth++;
        _isDragOver = _dragOverDepth > 0;
        StateHasChanged();
    }

    private void HandleDragLeave(DragEventArgs e)
    {
        if (_dragOverDepth > 0) _dragOverDepth--;
        _isDragOver = _dragOverDepth > 0;
        StateHasChanged();
    }

    private void HandleDragOver(DragEventArgs e)
    {
        try
        {
            if (e.DataTransfer != null)
            {
                e.DataTransfer.DropEffect = "move";
            }
        }
        catch {}
        if (_isDraggingSelf) return;
    }
}