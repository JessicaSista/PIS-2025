    //Funciones para cambiar la disposicion de los widgets en el dashboard
    private void ResizeUp(){
        if(Height == 300){
            SnackbarService.Add(Localizer["NoDisminuirMas"], Severity.Warning);
            return;
        }
        Height -= 50;
        UpdateCardSize.InvokeAsync((VisualizationId, VisualizationType, WidthXs, WidthMd, WidthLg, Height));
        _chartKey++;
        StateHasChanged();
    }

    private void ResizeDown(){
        Height +=50;
        UpdateCardSize.InvokeAsync((VisualizationId, VisualizationType, WidthXs, WidthMd, WidthLg, Height));
        _chartKey++;
        StateHasChanged();
    }

    private void ResizeLeft(){
        if((CurrentBreakpoint == Breakpoint.Xs  || CurrentBreakpoint == Breakpoint.Sm) && WidthXs > 6){
            WidthXs -= 1;
            UpdateCardSize.InvokeAsync((VisualizationId, VisualizationType, WidthXs, WidthMd, WidthLg, Height));
            return;
        }
        else if((CurrentBreakpoint == Breakpoint.Md) && WidthMd > 4){
            WidthMd -= 1;
            UpdateCardSize.InvokeAsync((VisualizationId, VisualizationType, WidthXs, WidthMd, WidthLg, Height));
            return;
        }
        else if((CurrentBreakpoint == Breakpoint.Lg || CurrentBreakpoint == Breakpoint.Xl) && WidthLg > 3){
            WidthLg -= 1;
            UpdateCardSize.InvokeAsync((VisualizationId, VisualizationType, WidthXs, WidthMd, WidthLg, Height));
            return;
        }
        SnackbarService.Add(Localizer["NoDisminuirMas"], Severity.Warning);
    }

    private void ResizeRight(){
        if((CurrentBreakpoint == Breakpoint.Xs  || CurrentBreakpoint == Breakpoint.Sm) && WidthXs < 12){
            WidthXs += 1;
            UpdateCardSize.InvokeAsync((VisualizationId, VisualizationType, WidthXs, WidthMd, WidthLg, Height));
            return;
        }
        else if(CurrentBreakpoint == Breakpoint.Md && WidthMd < 12){
            WidthMd += 1;
            UpdateCardSize.InvokeAsync((VisualizationId, VisualizationType, WidthXs, WidthMd, WidthLg, Height));
            return;
        }
        else if((CurrentBreakpoint == Breakpoint.Lg || CurrentBreakpoint == Breakpoint.Xl) && WidthLg < 12){
            WidthLg += 1;
            UpdateCardSize.InvokeAsync((VisualizationId, VisualizationType, WidthXs, WidthMd, WidthLg, Height));
            return;
        }
        SnackbarService.Add(Localizer["NoAumentarMas"], Severity.Warning);
    }

    private async Task OpenEditVisualizationDialog()
    {
        //Provisionalmente si es KPI no hago nada
        if (VisualizationType != 2) {
            DialogOptions? options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium };
            DialogParameters parameters = new DialogParameters
                {

                    ["dashboardId"] = dashboardId,
                    ["visualizationId"] = VisualizationId
                };
            IDialogReference? dialog = await DialogService.ShowAsync<EditVisualizationDialog>("Editar Visualización", parameters, options);
            DialogResult? result = await dialog.Result;

            if (result != null && !result.Canceled)
            {
                try
                {
                    // _seriesData.Clear();
                    // StateHasChanged();

                    // await RefreshVisualizationData();

                    _chartViewerKey++;

                    StateHasChanged();

                    SnackbarService.Add("Visualización actualizada", Severity.Success);
                }
                catch (Exception ex)
                {
                    SnackbarService.Add($"Error actualizando visualizacion: {ex.Message}", Severity.Warning);
                }
            }
        }
    }

