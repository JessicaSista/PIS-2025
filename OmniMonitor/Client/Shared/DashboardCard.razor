@inject ISnackbar SnackbarService

<MudItem lg=@width_lg md=@width_md xs=@width_xs>
    <MudCard Style="@($"background-color: #121a2d; color: #ffffff; height: {card_height}px; border: 1px solid #343a49")" Outlined="true">
        <MudCardHeader Class="d-flex justify-space-between pt-5 pl-3 pr-2" Style="height: 40px; color: #ccc">
            <MudStack Row="true" Spacing="0">
                <MudStack Spacing="0">
                    <MudIconButton @onclick="resizeUp" Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="MudBlazor.Size.Small" class="pa-0" Color="MudBlazor.Color.Inherit"/>
                    <MudIconButton @onclick="resizeDown" Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="MudBlazor.Size.Small" class="pa-0" Color="MudBlazor.Color.Inherit"/>
                </MudStack>
                <MudIconButton @onclick="resizeLeft" Icon="@Icons.Material.Filled.KeyboardArrowLeft" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Inherit"/>
                <MudIconButton @onclick="resizeRight" Icon="@Icons.Material.Filled.KeyboardArrowRight" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Inherit"/>
            </MudStack>
            <MudIconButton Icon="@Icons.Material.Filled.Settings" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Inherit"/>
        </MudCardHeader>
        <MudText Typo="Typo.h6" Align="MudBlazor.Align.Center" SColor="MudBlazor.Color.Inherit">@titulo</MudText>
        <MudCardContent>
        </MudCardContent>
    </MudCard>
</MudItem>

@code{
    //Parametros
    [Parameter] public int card_height {get; set;} = 400;
    [Parameter] public int width_lg { get; set; } = 3;
    [Parameter] public int width_md { get; set; } = 6;
    [Parameter] public int width_xs { get; set; } = 12;
    [Parameter] public string titulo  { get; set; } = "Titulo Genérico";

    //Funciones para cambiar la disposicion de los widgets en el dashboard
    private void resizeUp(){
        if(card_height == 300){
            SnackbarService.Add("No se puede disminuir más. Recuerde que puede cambiar el tamaño mínimo en ajustes", Severity.Warning);
            return;
        }
        card_height -= 50;
    }
    
    private void resizeDown(){
        card_height +=50;
    }

    private void resizeLeft(){
        if(width_lg == 3){
            SnackbarService.Add("No se puede disminuir más. Recuerde que puede cambiar el tamaño mínimo en ajustes", Severity.Warning);
            return;
        }
        width_lg -= 1;
    }

    private void resizeRight(){
        if(width_lg == 12){
            SnackbarService.Add("No se puede aumentar más.", Severity.Warning);
            return;
        }
        width_lg += 1;
    }
}