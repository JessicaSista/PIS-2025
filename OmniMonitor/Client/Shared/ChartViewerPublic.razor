@using ApexCharts;
@using MudBlazor;
@using MudBlazor.Extensions;
@using OmniMonitor.Shared.Dtos;
@using System.Text.Json;

@inject HttpClient Http

<MudItem Style="background-color: transparent; display:flex; flex-direction:column; height: 100%">
    <MudCardHeader>
        <CardHeaderAvatar>
            @if (ShowIcon)
            {
                <MudPaper Square="true" Class="pa-2" Style="background-color: #1d283a !important; color: #f4f8fd; border-radius: 2px">
                    <MudIcon Icon="@GetIcon(_chartType)" />
                </MudPaper>
            }
            else
            {
                <div style="width: 0px;"></div>
            }
        </CardHeaderAvatar>
        <CardHeaderContent>
            @if (ShowTitle)
            {
                <MudText Typo="Typo.h6" Style="color: var(--card-text-primary)">@_title</MudText>
            }
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent Class="pl-7 pr-8" Style="color: var(--card-text-secondary); height: 100%">
        @if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
        }
        else if (_requiresAuthenticatedData)
        {
            <MudAlert Severity="Severity.Info">
                No se pueden mostrar los datos de esta visualización en modo público porque los endpoints necesarios aún requieren autenticación.
            </MudAlert>
        }
        else if (_seriesData.Any())
        {
            <ApexChart @key="_chartKey" TItem="ChartPoint" Height="320" Options="_chartOptions">
                @foreach (var serie in _seriesData)
                {
                    <ApexPointSeries TItem="ChartPoint"
                                     Items="serie.Points"
                                     Name="@serie.DatasetName"
                                     SeriesType="@_seriesType"
                                     XValue="@(p => p.X)"
                                     YValue="@(p => (decimal)p.Y)"
                                     Color="@serie.Color" />
                }
            </ApexChart>
        }
        else
        {
            <MudSkeleton />
        }
    </MudCardContent>

    <MudCardActions Class="d-block">
        @if (ShowDatasetsInfo && !string.IsNullOrWhiteSpace(_datasetNames))
        {
            <MudText Typo="Typo.body2">Datasets: @_datasetNames.</MudText>
        }
        @if (ShowLastUpdatedInfo)
        {
            <MudText Typo="Typo.caption">Actualizado: @DateTime.Now.ToString("g")</MudText>
        }
    </MudCardActions>
</MudItem>

@code {
    [Parameter] public int VisualizationId { get; set; }

    [Parameter]
    public int ChartReloadKey
    {
        get => _chartKey;
        set
        {
            if (_chartKey != value)
            {
                _chartKey = value;
                StateHasChanged();
            }
        }
    }

    [Parameter] public bool ShowTitle { get; set; } = true;
    [Parameter] public bool ShowIcon { get; set; } = false;
    [Parameter] public bool ShowDatasetsInfo { get; set; } = false;
    [Parameter] public bool ShowLastUpdatedInfo { get; set; } = false;

    private readonly ApexChartOptions<ChartPoint> _chartOptions = new()
    {
        Xaxis = new XAxis
        {
            TickAmount = 4,
            Labels = new XAxisLabels
            {
                Rotate = -35,
                Style = new AxisLabelStyle
                {
                    FontSize = "8px"
                }
            }
        }
    };

    private string _title = string.Empty;
    private string _datasetNames = string.Empty;
    private SeriesType _seriesType = SeriesType.Line;
    private List<DatasetSeries> _seriesData = new();
    private string _chartType = "line";
    private int _chartKey;
    private string? _loadError;
    private bool _requiresAuthenticatedData;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetAsync($"api/Visualizacion/GetVisualizacionByIdSinToken?idVisualizacion={VisualizationId}");
            if (!response.IsSuccessStatusCode)
            {
                _loadError = $"No se pudo cargar la visualización ({response.StatusCode}).";
                return;
            }

            var cardVisualization = await response.Content.ReadFromJsonAsync<Visualizacion>();
            if (cardVisualization == null)
            {
                _loadError = "La visualización solicitada no existe.";
                return;
            }

            _title = cardVisualization.Nombre;
            if (!string.IsNullOrWhiteSpace(cardVisualization.JsonDesign))
            {
                try
                {
                    using var design = JsonDocument.Parse(cardVisualization.JsonDesign);
                    if (design.RootElement.TryGetProperty("ChartType", out var chartTypeProperty))
                    {
                        _chartType = chartTypeProperty.GetString() ?? "line";
                        _seriesType = MapSeriesType(_chartType);
                    }
                }
                catch (JsonException)
                {
                    _loadError = "El diseño de la visualización es inválido.";
                    return;
                }
            }

            if (cardVisualization.GrupoDatasets != null && cardVisualization.GrupoDatasets.Any())
            {
                _datasetNames = string.Join(", ", cardVisualization.GrupoDatasets
                    .Select(gd => gd.Dataset?.Name)
                    .Where(name => !string.IsNullOrWhiteSpace(name)));
            }

            _requiresAuthenticatedData = true;
        }
        catch (Exception ex)
        {
            _loadError = $"Error al cargar la visualización: {ex.Message}";
        }
    }

    private SeriesType MapSeriesType(string type)
    {
        return Enum.TryParse(type, true, out SeriesType parsed) ? parsed : SeriesType.Line;
    }

    private string GetIcon(string chartType)
    {
        return chartType switch
        {
            "line" => Icons.Material.Filled.ShowChart,
            "bar" => Icons.Material.Filled.BarChart,
            "area" => Icons.Material.Filled.AreaChart,
            "pie" => Icons.Material.Filled.PieChart,
            "donut" => Icons.Material.Filled.DonutLarge,
            "radialBar" => Icons.Material.Filled.DonutSmall,
            "scatter" => Icons.Material.Filled.BubbleChart,
            "heatmap" => Icons.Material.Filled.GridOn,
            "radar" => Icons.Material.Filled.Radar,
            "bubble" => Icons.Material.Filled.BubbleChart,
            "candlestick" => Icons.Material.Filled.CandlestickChart,
            "boxPlot" => Icons.Material.Filled.Analytics,
            "treemap" => Icons.Material.Filled.AccountTree,
            _ => Icons.Material.Filled.InsertChart
        };
    }

    private sealed class DatasetSeries
    {
        public string DatasetName { get; set; } = string.Empty;
        public string Color { get; set; } = "#00FFE7";
        public List<ChartPoint> Points { get; set; } = new();
    }

    private sealed class ChartPoint
    {
        public string X { get; set; } = string.Empty;
        public double Y { get; set; }
    }
}
