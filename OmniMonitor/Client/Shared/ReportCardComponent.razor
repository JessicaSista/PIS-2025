@using OmniMonitor.Shared.Dtos
@using OmniMonitor.Shared
@using MudBlazor
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<SharedResource> SharedLocalizer

<MudCard @onclick="HandleCardClick"
         Class="@Class"
         Style="width:100%; background-color:var(--card); border:1px solid #374151; border-radius:12px; cursor:pointer; padding:16px; display:flex; flex-direction:column; height:200px;">
    <MudCardContent Style="width:100%; display:flex; flex-direction:column; flex-grow:1;">
        <MudStack Row AlignItems="AlignItems.Start" Spacing="0" Style="width:100%;">
            <div style="width:44px; height:44px; background-color:var(--mud-palette-primary); border-radius:6px; display:flex; align-items:center; justify-content:center; margin-right:12px;">
                <MudIcon Icon="@Icons.Material.Filled.Article"
                         Size="MudBlazor.Size.Large"
                         Color="MudBlazor.Color.Inherit"
                         Style="font-size:24px; color:var(--mud-palette-primary-text);" />
            </div>

            <MudStack Style="width:100%; flex:1;" Spacing="0">
                <MudText Style="color:var(--card-text-primary); font-weight:600; font-size:1.2rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                    @Reporte?.Nombre
                </MudText>
                <MudText Style="color:var(--card-text-secondary); font-size:1rem; white-space:normal; word-wrap:break-word; overflow-wrap:anywhere; word-break:break-word; hyphens:auto; overflow:hidden; display:-webkit-box; -webkit-line-clamp:4; -webkit-box-orient:vertical; text-overflow:ellipsis;">
                    @(!string.IsNullOrWhiteSpace(Reporte?.Descripcion) ? Reporte?.Descripcion : string.Empty)
                </MudText>
            </MudStack>
        </MudStack>

        <MudStack Row Justify="Justify.SpaceBetween" Style="width:100%; margin-top:auto;">
            <MudText Style="color:var(--card-text-secondary); font-size:0.7rem;">
                @if (Reporte != null && Reporte.FechaCreacion != default)
                {
                    <text>@SharedLocalizer["Actualizado"] @Reporte.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</text>
                }
            </MudText>
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public ReporteDto? Reporte { get; set; }
    [Parameter] public EventCallback<int> OnNavigate { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    protected override void OnInitialized()
    {
        Reporte ??= new ReporteDto();
    }

    private async Task HandleCardClick()
    {
        if (Reporte?.Id > 0)
        {
            if (OnNavigate.HasDelegate)
            {
                await OnNavigate.InvokeAsync(Reporte.Id);
            }
            else
            {
                NavigationManager.NavigateTo($"editarReporte/{Reporte.Id}");
            }
        }
    }
}
