@using OmniMonitor.Shared.Dtos
@using MudBlazor
@using Microsoft.AspNetCore.Components.Web

<MudCard Class="@($"h-100 clickable-card {Class}")"
         @onclick="NavigateToDetails"
         Style="display:flex; flex-direction:column; background-color: var(--card); color: var(--mud-palette-text-primary); height: 100%; border: 1px solid var(--mud-palette-lines-inputs); border-radius: 8px; cursor: pointer;">
    <MudCardHeader Style="padding: 16px 16px 0 16px; align-items:center;">
        <div class="d-flex align-center mr-3"
             style="width: 44px; height: 44px; background-color: var(--mud-palette-primary); border-radius: 6px; justify-content: center;">
            <MudIcon Icon="@Icons.Material.Filled.Article" 
                     Size="MudBlazor.Size.Large" 
                     Color="MudBlazor.Color.Inherit"
                     Style="font-size: 24px; color: var(--mud-palette-primary-text);" />
        </div>

        <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-primary);">@Reporte?.Nombre</MudText>
        <MudSpacer />

        <div @onclick:stopPropagation="true">
            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                    Dense="true"
                    Class="ml-auto"
                    AnchorOrigin="Origin.TopRight"
                    TransformOrigin="Origin.TopRight"
                    Style="color: var(--mud-palette-text-secondary);">
                <MudMenuItem OnClick="EditReport"
                            Class="menu-item-edit"
                            Style="color: #949FD0 !important; padding: 8px 16px !important;">
                    <span style="font-weight: 800 !important; font-family: 'Inter', 'Roboto', sans-serif !important;">Editar</span>
                </MudMenuItem>

                <MudMenuItem OnClick="@(() => OnDelete.InvokeAsync(Reporte?.Id ?? 0))" 
                            Class="menu-item-delete"
                            Style="color: #F47F7F !important; padding: 8px 16px !important;">
                    <span style="font-weight: 800 !important; font-family: 'Inter', 'Roboto', sans-serif !important;">Eliminar</span>
                </MudMenuItem>
            </MudMenu>
        </div>

    </MudCardHeader>

    <MudCardContent Style="flex: 1; display: flex; flex-direction: column; justify-content: space-between; padding: 16px;">
        @if (!string.IsNullOrEmpty(Reporte?.Descripcion))
        {
            <MudText Typo="Typo.body2" Class="mb-4"
                     Style="flex-grow: 1; overflow: hidden; text-overflow: ellipsis;
                            display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
                            color: var(--mud-palette-text-secondary);">
                @Reporte.Descripcion
            </MudText>
        }
        else
        {
            <div style="flex-grow: 1;"></div>
        }

        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="margin-top: auto;">
            <MudText Typo="Typo.caption" Class="mt-2" Style="color: var(--mud-palette-text-secondary);">
                @(Reporte?.FechaCreacion.ToShortDateString() ?? string.Empty)
            </MudText>
            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                @if (Reporte != null)
                {
                    <text>Registros: @Reporte.RecordCount</text>
                }
            </MudText>
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public ReporteDto? Reporte { get; set; }
    [Parameter] public EventCallback<int> OnEdit { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public EventCallback<int> OnNavigate { get; set; }
    [Parameter] public string Class { get; set; } = "";

    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    protected override void OnInitialized()
    {
        Reporte ??= new ReporteDto();
    }

    private async Task EditReport()
    {
        if (Reporte?.Id > 0)
        {
            if (OnEdit.HasDelegate)
            {
                await OnEdit.InvokeAsync(Reporte.Id);
            }
            else
            {
                NavigationManager.NavigateTo($"/editarReporte/{Reporte.Id}");
            }
        }
    }

    private async Task NavigateToDetails(MouseEventArgs args)
    {
        if (Reporte?.Id > 0)
        {
            if (OnNavigate.HasDelegate)
            {
                await OnNavigate.InvokeAsync(Reporte.Id);
            }
            else
            {
                NavigationManager.NavigateTo($"editarReporte/{Reporte.Id}");
            }
        }
    }
}
