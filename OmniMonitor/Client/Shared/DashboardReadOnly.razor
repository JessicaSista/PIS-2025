@using System.ComponentModel.DataAnnotations
@using MudBlazor
@using OmniMonitor.Client.Shared

<MudBreakpointProvider>
    <MudGrid Class="pa-10 dashboard" Spacing="6">
        @for (int i = 0; i < CardsData.Count; i++)
        {
            var (id, type, anchoSm, anchoMd, anchoLg, alto) = CardsData[i];

            <DashboardCardReadOnly @key="@($"RO{id}_{type}")"
                                    dashboardId="@dashboardId"
                                    VisualizationId="@id"
                                    VisualizationType="@type"
                                    WidthXs="@anchoSm"
                                    WidthMd="@anchoMd"
                                    WidthLg="@anchoLg"
                                    Height="@alto" />
        }
    </MudGrid>
</MudBreakpointProvider>

@code {
    [Parameter] [Required] public int dashboardId { get; set; }
    [Parameter] public List<(int, int, int, int, int, int)> CardsData { get; set; } = new();
}
