@using MudBlazor
@inject ISnackbar Snackbar
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject HttpClient Http
@using OmniMonitor.Shared.Dtos

<MudForm @ref="_form">
    <MudDialog>
        <DialogContent>
            <MudTextField T="string"
                          Value="_name"
                          ValueChanged="OnNameChanged"
                          ValueExpression="@(() => _name)"
                          Label="Nombre del reporte"
                          Disabled="_isSubmitting"
                          Immediate="true"
                          Validation="@((string? value) => ValidateName(value))" />
            <MudTextField T="string"
                          Value="_description"
                          ValueChanged="OnDescriptionChanged"
                          ValueExpression="@(() => _description)"
                          Label="Descripción"
                          Lines="3"
                          Disabled="_isSubmitting"
                          Immediate="true" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel" Disabled="_isSubmitting">Cancelar</MudButton>
            <MudButton OnClick="Submit" Color="MudBlazor.Color.Primary" Disabled="_isSubmitting || !_formIsValid">@SubmitButtonText</MudButton>
        </DialogActions>
    </MudDialog>
</MudForm>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string Username { get; set; } = string.Empty;

    [Parameter]
    public bool IsEditMode { get; set; }

    [Parameter]
    public int? ReportId { get; set; }

    [Parameter]
    public string? InitialName { get; set; }

    [Parameter]
    public string? InitialDescription { get; set; }

    [Parameter]
    public IEnumerable<string> ExistingNames { get; set; } = Array.Empty<string>();

    private MudForm? _form;
    private bool _formIsValid;
    private bool _isSubmitting;
    private string _name = string.Empty;
    private string _description = string.Empty;

    private string SubmitButtonText => IsEditMode ? "Guardar" : "Siguiente";

    protected override void OnInitialized()
    {
        Username ??= string.Empty;
        _name = InitialName ?? string.Empty;
        _description = InitialDescription ?? string.Empty;
        UpdateFormState();
    }

    private void Cancel() => MudDialog.Cancel();

    private Task OnNameChanged(string value)
    {
        _name = value ?? string.Empty;
        UpdateFormState();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnDescriptionChanged(string value)
    {
        _description = value ?? string.Empty;
        UpdateFormState();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private string? ValidateName(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "El nombre es obligatorio";
        }

        var trimmed = value.Trim();
        var existing = ExistingNames ?? Array.Empty<string>();

        if (!IsEditMode)
        {
            if (existing.Any(n => string.Equals(n?.Trim(), trimmed, StringComparison.OrdinalIgnoreCase)))
            {
                return "Ya existe un reporte con ese nombre";
            }
        }
        else if (ReportId.HasValue)
        {
            var initialNameTrimmed = (InitialName ?? string.Empty).Trim();
            if (!string.Equals(initialNameTrimmed, trimmed, StringComparison.OrdinalIgnoreCase) &&
                existing.Any(n => string.Equals(n?.Trim(), trimmed, StringComparison.OrdinalIgnoreCase)))
            {
                return "Ya existe un reporte con ese nombre";
            }
        }

        return null;
    }

    private void UpdateFormState()
    {
        var nameValid = ValidateName(_name) is null;
        _formIsValid = nameValid && HasChanges();
    }

    private bool HasChanges()
    {
        var trimmedName = (_name ?? string.Empty).Trim();
        var trimmedDescription = (_description ?? string.Empty).Trim();

        if (!IsEditMode)
        {
            return !string.IsNullOrEmpty(trimmedName);
        }

        var initialNameTrimmed = (InitialName ?? string.Empty).Trim();
        var initialDescriptionTrimmed = (InitialDescription ?? string.Empty).Trim();

        return !string.Equals(initialNameTrimmed, trimmedName, StringComparison.Ordinal) ||
               !string.Equals(initialDescriptionTrimmed, trimmedDescription, StringComparison.Ordinal);
    }

    private async Task Submit()
    {
        if (_form == null)
        {
            return;
        }

        await _form.Validate();
        UpdateFormState();
        if (!_formIsValid)
        {
            return;
        }

        _isSubmitting = true;
        try
        {
            var trimmedName = _name.Trim();
            var trimmedDescription = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim();

            if (!HasChanges())
            {
                Snackbar.Add("No hay cambios para guardar", Severity.Warning);
                return;
            }

            var nameValidation = ValidateName(trimmedName);
            if (!string.IsNullOrEmpty(nameValidation))
            {
                Snackbar.Add(nameValidation, Severity.Warning);
                return;
            }

            if (IsEditMode && ReportId.HasValue)
            {
                var resultPayload = new ReportDialogResult(ReportId.Value, trimmedName, trimmedDescription, true);
                MudDialog.Close(DialogResult.Ok(resultPayload));
                return;
            }

            var payload = new CreateReportRequestDto
            {
                Name = trimmedName,
                Description = trimmedDescription,
                JSON_config = "{}"
            };

            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var response = await Http.PostAsJsonAsync("api/reports", payload);
            if (response.IsSuccessStatusCode)
            {
                var createdReport = await response.Content.ReadFromJsonAsync<ReporteDto>();
                MudDialog.Close(DialogResult.Ok(createdReport?.Id));
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al crear el reporte: {response.StatusCode}", Severity.Error);
            }
        }
        finally
        {
            _isSubmitting = false;
            UpdateFormState();
        }
    }

    public record ReportDialogResult(int ReportId, string Name, string? Description, bool IsEdit);
}

