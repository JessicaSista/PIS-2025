@using MudBlazor
@using Microsoft.Extensions.Localization
@inject ISnackbar Snackbar
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject HttpClient Http
@inject IStringLocalizer<CreateReportDialog> Localizer
@using OmniMonitor.Shared.Dtos

<MudForm @ref="_form">
    <MudDialog>
        <DialogContent>
            <MudTextField T="string"
                          Value="_name"
                          ValueChanged="OnNameChanged"
                          ValueExpression="@(() => _name)"
                          Label="@Localizer["NameLabel"].Value"
                          Disabled="_isSubmitting"
                          Immediate="true"
                          Validation="@((string? value) => ValidateName(value))" />
            <MudTextField T="string"
                          Value="_description"
                          ValueChanged="OnDescriptionChanged"
                          ValueExpression="@(() => _description)"
                          Label="@Localizer["DescriptionLabel"].Value"
                          Lines="3"
                          Disabled="_isSubmitting"
                          Immediate="true"
                          MaxLength="@DescriptionMaxLength"
                          Counter="@DescriptionMaxLength" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel" Disabled="_isSubmitting">@Localizer["CancelButton"]</MudButton>
            <MudButton OnClick="Submit" Color="MudBlazor.Color.Primary" Disabled="_isSubmitting || !_formIsValid">@SubmitButtonText</MudButton>
        </DialogActions>
    </MudDialog>
</MudForm>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string Username { get; set; } = string.Empty;

    [Parameter]
    public bool IsEditMode { get; set; }

    [Parameter]
    public int? ReportId { get; set; }

    [Parameter]
    public string? InitialName { get; set; }

    [Parameter]
    public string? InitialDescription { get; set; }

    [Parameter]
    public IEnumerable<string> ExistingNames { get; set; } = Array.Empty<string>();

    private MudForm? _form;
    private bool _formIsValid;
    private bool _isSubmitting;
    private string _name = string.Empty;
    private string _description = string.Empty;
    private const int DescriptionMaxLength = 250;

    private string SubmitButtonText => (IsEditMode ? Localizer["SaveButton"] : Localizer["NextButton"]).Value;

    protected override void OnInitialized()
    {
        Username ??= string.Empty;
        _name = InitialName ?? string.Empty;
        _description = EnforceMaxLength(InitialDescription ?? string.Empty);
        UpdateFormState();
    }

    private void Cancel() => MudDialog.Cancel();

    private Task OnNameChanged(string value)
    {
        _name = value ?? string.Empty;
        UpdateFormState();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnDescriptionChanged(string value)
    {
        _description = EnforceMaxLength(value ?? string.Empty);
        UpdateFormState();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private string? ValidateName(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Localizer["NameRequired"].Value;
        }

        var trimmed = value.Trim();
        var existing = ExistingNames ?? Array.Empty<string>();

        if (!IsEditMode)
        {
            if (existing.Any(n => string.Equals(n?.Trim(), trimmed, StringComparison.OrdinalIgnoreCase)))
            {
                return Localizer["NameExists"].Value;
            }
        }
        else if (ReportId.HasValue)
        {
            var initialNameTrimmed = (InitialName ?? string.Empty).Trim();
            if (!string.Equals(initialNameTrimmed, trimmed, StringComparison.OrdinalIgnoreCase) &&
                existing.Any(n => string.Equals(n?.Trim(), trimmed, StringComparison.OrdinalIgnoreCase)))
            {
                return Localizer["NameExists"].Value;
            }
        }

        return null;
    }

    private void UpdateFormState()
    {
        var nameValid = ValidateName(_name) is null;
        _formIsValid = nameValid && HasChanges();
    }

    private bool HasChanges()
    {
        var trimmedName = (_name ?? string.Empty).Trim();
        var normalizedDescription = NormalizeDescription(_description);

        if (!IsEditMode)
        {
            return !string.IsNullOrEmpty(trimmedName);
        }

        var initialNameTrimmed = (InitialName ?? string.Empty).Trim();
        var initialDescriptionNormalized = NormalizeDescription(InitialDescription);

        return !string.Equals(initialNameTrimmed, trimmedName, StringComparison.Ordinal) ||
               !string.Equals(initialDescriptionNormalized, normalizedDescription, StringComparison.Ordinal);
    }

    private static string EnforceMaxLength(string value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return string.Empty;
        }

        return value.Length <= DescriptionMaxLength ? value : value[..DescriptionMaxLength];
    }

    private static string NormalizeDescription(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var trimmed = value.Trim();
        return trimmed.Length <= DescriptionMaxLength ? trimmed : trimmed[..DescriptionMaxLength];
    }

    private async Task Submit()
    {
        if (_form == null)
        {
            return;
        }

        await _form.Validate();
        UpdateFormState();
        if (!_formIsValid)
        {
            return;
        }

        _isSubmitting = true;
        try
        {
            var trimmedName = _name.Trim();
            var normalizedDescription = NormalizeDescription(_description);
            var trimmedDescription = string.IsNullOrEmpty(normalizedDescription) ? null : normalizedDescription;

            if (!HasChanges())
            {
                Snackbar.Add(Localizer["NoChanges"].Value, Severity.Warning);
                return;
            }

            var nameValidation = ValidateName(trimmedName);
            if (!string.IsNullOrEmpty(nameValidation))
            {
                Snackbar.Add(nameValidation, Severity.Warning);
                return;
            }

            if (IsEditMode && ReportId.HasValue)
            {
                var resultPayload = new ReportDialogResult(ReportId.Value, trimmedName, trimmedDescription, true);
                MudDialog.Close(DialogResult.Ok(resultPayload));
                return;
            }

            var payload = new CreateReportRequestDto
            {
                Name = trimmedName,
                Description = trimmedDescription,
                JSON_config = "{}"
            };

            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var response = await Http.PostAsJsonAsync("api/reports", payload);
            if (response.IsSuccessStatusCode)
            {
                var createdReport = await response.Content.ReadFromJsonAsync<ReporteDto>();
                MudDialog.Close(DialogResult.Ok(createdReport?.Id));
            }
            else
            {
                Snackbar.Add(Localizer["CreateError", response.StatusCode].Value, Severity.Error);
            }
        }
        finally
        {
            _isSubmitting = false;
            UpdateFormState();
        }
    }

    public record ReportDialogResult(int ReportId, string Name, string? Description, bool IsEdit);
}

