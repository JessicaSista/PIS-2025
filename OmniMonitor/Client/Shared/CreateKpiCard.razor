@using OmniMonitor.Shared.Dtos
@using System.Net.Http.Json
@using Blazored.LocalStorage
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ILocalStorageService LocalStorage
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CreateVisualizationCard> Localizer
@inject IDialogService DialogService

<MudDialog Style="background-color: var(--fondo-dialog)">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: var(--text-primary);">
            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Class="mb-n1 mr-1" />
            @Localizer["NewKPI"]
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3">

            <!-- Dataset + Multiplicador + Color -->
            <!-- Dataset + Multiplicador + Color por defecto -->
            <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">

                <!-- Dataset select -->
                <div style="display: flex; flex-direction: column;">
                    <MudText Typo="Typo.h6" Style="color: var(--text-primary);">Dataset</MudText>
                    <MudSelect T="int"
                               @bind-Value="_selectedDatasetId"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Style="background: var(--card); width: 280px;"
                               Required="true">
                        @foreach (var ds in _datasets)
                        {
                            <MudSelectItem T="int" Value="@ds.Id">
                                @ds.Name (@(ds.ContentType ?? ds.SensorName ?? "—"))
                            </MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <!-- Multiplicador (solo si es numérico) -->
                @if (IsNumericDataset)
                {
                    <div style="display: flex; flex-direction: column;">
                        <MudText Typo="Typo.h6" Style="color: var(--text-primary);">@Localizer["Multiplier"]</MudText>
                        <MudNumericField @bind-Value="_multiplier"
                                         Variant="Variant.Outlined"
                                         Dense="true"
                                         HideSpinButtons="true"
                                         Step=".1M"
                                         Style="background: var(--card); width: 120px;" />
                    </div>
                }

                <!-- Color por defecto (cuadrado centrado, sin texto) -->
                <div style="display: flex; align-items: center; height: 100%; ">
                    <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" OffsetY="true">
                        <ActivatorContent>
                            <MudTooltip Text="@_color">
                                <div style="
                        width: 56.5px;
                        height: 56.5px;
                        border-radius: 6px;
                        border: 1px solid var(--borde-drawer);
                        cursor: pointer;
margin-top:30.5px;
                        background-color:@_color;
                        transition: box-shadow 0.2s ease;"
                                     onmouseover="this.style.boxShadow='0 0 4px var(--borde-drawer)'"
                                     onmouseout="this.style.boxShadow='none'">
                                </div>
                            </MudTooltip>
                        </ActivatorContent>
                        <ChildContent>
                            <div style="padding: 8px; background: var(--card); border-radius: 8px;">
                                <MudColorPicker @bind-Text="_color"
                                                DisableAlpha="true"
                                                Variant="Variant.Outlined"
                                                Style="width: 220px;" />
                            </div>
                        </ChildContent>
                    </MudMenu>
                </div>

            </div>




            <!-- Nombre -->
            <MudText Typo="Typo.h6" Style="color: var(--text-primary);">@Localizer["Name"]</MudText>
            <MudTextField @bind-Value="_name" Variant="Variant.Outlined" Required="true" Style="background: var(--card);" />

            <!-- Descripción -->
            <MudText Typo="Typo.h6" Style="color: var(--text-primary);">@Localizer["Description"]</MudText>
            <MudTextField @bind-Value="_description" Variant="Variant.Outlined" Lines="2" Style="background: var(--card);" />

            <!-- Tipo de métrica -->
            <MudText Typo="Typo.h6" Style="color: var(--text-primary);">@Localizer["Metric"]</MudText>
            <MudSelect T="string" @bind-Value="_metric" Variant="Variant.Outlined" Dense="true" Style="background: var(--card);">
                @foreach (var tipo in _kpiTypes)
                {
                    <MudSelectItem T="string" Value="@tipo">@tipo</MudSelectItem>
                }
            </MudSelect>

            <!-- Rangos de color (solo numérico) -->
            @if (IsNumericDataset)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.h6" Style="color: var(--text-primary);">@Localizer["ColorRanges"]</MudText>

                @foreach (var range in _colorRanges)
                {
                    <div class="d-flex align-items-end mb-2" style="gap: 12px; flex-wrap: wrap;">
                        <div style="display: flex; flex-direction: column;">
                            <MudText Typo="Typo.body2" Style="color: var(--text-secondary);">@Localizer["MinValue"]</MudText>
                            <MudNumericField @bind-Value="range.Min"
                                             Dense="true"
                                             Variant="Variant.Outlined"
                                             Style="width: 120px; background: var(--card);" />
                        </div>

                        <div style="display: flex; flex-direction: column;">
                            <MudText Typo="Typo.body2" Style="color: var(--text-secondary);">@Localizer["MaxValue"]</MudText>
                            <MudNumericField @bind-Value="range.Max"
                                             Dense="true"
                                             Variant="Variant.Outlined"
                                             Style="width: 120px; background: var(--card);" />
                        </div>

                        <!-- Selector de color -->
                        <div style="display: flex; flex-direction: column; align-items: flex-start;">
                            <MudText Typo="Typo.body2" Style="color: var(--text-secondary);">@Localizer["Color"]</MudText>
                            <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" OffsetY="true">
                                <ActivatorContent>
                                    <div style="width: 36px; height: 36px; border-radius: 6px;
                                        border: 1px solid var(--borde-drawer);
                                        cursor: pointer;
                                        background-color:@range.Color;">
                                    </div>
                                </ActivatorContent>
                                <ChildContent>
                                    <MudColorPicker @bind-Text="range.Color"
                                                    Variant="Variant.Outlined"
                                                    DisableAlpha="true"
                                                    Style="width: 220px;" />
                                </ChildContent>
                            </MudMenu>
                        </div>

                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Color="MudBlazor.Color.Error"
                                       OnClick="@(() => RemoveRange(range))" />
                    </div>
                }


                <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Primary" OnClick="AddRange" StartIcon="@Icons.Material.Filled.Add">
                    @Localizer["AddRange"]
                </MudButton>
            }

        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Cancel"]</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" OnClick="Submit">@Localizer["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance _mudDialog { get; set; }

    private List<DatasetIM> _datasets = new();
    private int _selectedDatasetId;
    private DatasetIM? _selectedDataset => _datasets.FirstOrDefault(d => d.Id == _selectedDatasetId);

    private decimal _multiplier = 1.0M;
    private string _name = string.Empty;
    private string _description = string.Empty;
    private string _metric = "average";
    private string _color = "#FFFFFF";

    private List<string> _kpiTypes = new() { "lastValue", "average", "min", "max" };
    private List<ColorRange> _colorRanges = new();

    private bool IsNumericDataset =>
        _selectedDataset?.ContentType?.ToLower().Contains("num") == true ||
        _selectedDataset?.Name.ToLower().Contains("num") == true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var response = await Http.GetAsync($"api/Dataset/GetAllDatasets?token={Uri.EscapeDataString(token)}");

            if (response.IsSuccessStatusCode)
            {
                var datasets = await response.Content.ReadFromJsonAsync<List<DatasetIM>>();
                _datasets = datasets ?? new();
                _selectedDatasetId = _datasets.FirstOrDefault()?.Id ?? 0;
            }
            else
            {
                Snackbar.Add("Error al obtener datasets del backend.", Severity.Warning);
                _datasets = GetFallbackDatasets();
            }
        }
        catch
        {
            _datasets = GetFallbackDatasets();
        }
    }

    private List<DatasetIM> GetFallbackDatasets() => new()
    {
        new DatasetIM { Id = 1, Name = "Dataset numérico", ContentType = "Numerico" },
        new DatasetIM { Id = 2, Name = "Dataset categórico", ContentType = "Categorico" },
    };

    private void AddRange() => _colorRanges.Add(new ColorRange());
    private void RemoveRange(ColorRange range) => _colorRanges.Remove(range);

    private void Cancel() => _mudDialog.Cancel();

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("El nombre del KPI es obligatorio.", Severity.Warning);
            return;
        }

        var request = new KpiRequest
        {
            Name = _name,
            Description = _description,
            DatasetId = _selectedDatasetId,
            Unit = "x",
            Metric = _metric,
            Multiplier = (double)_multiplier,
            DefaultColor = _color,
            ColorRanges = IsNumericDataset ? System.Text.Json.JsonSerializer.Serialize(_colorRanges) : "[]",
            ExtraInfo = "{}",
            SourceModule = "IM"
        };

        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var response = await Http.PostAsJsonAsync($"api/Kpi?token={token}", request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"KPI '{_name}' creado correctamente.", Severity.Success);
                _mudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add($"Error creando KPI: {await response.Content.ReadAsStringAsync()}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al conectar con el servidor: {ex.Message}", Severity.Error);
        }
    }

    private class ColorRange
    {
        public decimal Min { get; set; }
        public decimal Max { get; set; }
        public string Color { get; set; } = "#00FF00";
    }
}
