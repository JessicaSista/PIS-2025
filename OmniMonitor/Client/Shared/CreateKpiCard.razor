@using OmniMonitor.Shared.Dtos
@using System.Net.Http.Json
@using Blazored.LocalStorage
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ILocalStorageService LocalStorage
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CreateVisualizationCard> Localizer
@inject IDialogService DialogService

<MudDialog Style="background-color: var(--fondo-dialog)">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: var(--text-primary);">
            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Class="mb-n1 mr-1" />
            @Localizer["NewKPI"]
        </MudText>
    </TitleContent>

    <DialogContent>
        @if (_isLoadingDatasets)
        {
            <div style="display:flex; justify-content:center; align-items:center; height:100px;">
                <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Size="MudBlazor.Size.Medium" />
            </div>
        }
        else
        {
            <MudStack Spacing="3">

                @if (!string.IsNullOrEmpty(_serverError))
                {
                    <MudAlert Severity="Severity.Error" Elevation="0">@_serverError</MudAlert>
                }

                <!-- Dataset + Multiplier + Color -->
                <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">

                    <!-- Dataset select -->
                    <div style="display: flex; flex-direction: column;">
                        <MudSelect T="int"
                                   Label="@Localizer["Dataset"]"
                                   Value="_selectedDatasetId"
                                   ValueChanged="OnDatasetChanged"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Style="background: var(--card); width: 280px;"
                                   Required="true">
                            @foreach (var ds in _datasets)
                            {
                                var displayName = ds.Nombre;
                                <MudSelectItem T="int" Value="@ds.Id">
                                    @displayName
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <!-- Multiplier (visible si dataset numérico) -->
                    @if (_isNumericDataset)
                    {
                        <div style="display: flex; flex-direction: column;">
                            <MudNumericField @bind-Value="_multiplier"
                                             Label="@Localizer["Multiplier"]"
                                             Variant="Variant.Outlined"
                                             Dense="true"
                                             HideSpinButtons="true"
                                             Step=".1M"
                                             Style="background: var(--card); width: 120px;" />
                        </div>
                    }

                    <!-- Color -->
                    <div style="display: flex; align-items: center; height: 100%;">
                        <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" OffsetY="true">
                            <ActivatorContent>
                                <MudTooltip Text="@_color">
                                    <div style="
                                            width: 56.5px;
                                            height: 56.5px;
                                            border-radius: 6px;
                                            cursor: pointer;
                                            background-color:@_color;">
                                    </div>
                                </MudTooltip>
                            </ActivatorContent>
                            <ChildContent>
                                <div style="padding: 8px; background: var(--card); border-radius: 8px;">
                                    <MudColorPicker @bind-Text="_color"
                                                    DisableAlpha="true"
                                                    Variant="Variant.Outlined"
                                                    Style="width: 220px;" />
                                </div>
                            </ChildContent>
                        </MudMenu>
                    </div>

                </div>

                <!-- Name -->
                <MudTextField @bind-Value="_name"
                              Label="@Localizer["Name"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              Style="background: var(--card);" />

                <!-- Description -->
                <MudTextField @bind-Value="_description"
                              Label="@Localizer["Description"]"
                              Variant="Variant.Outlined"
                              Lines="2"
                              MaxLength="200"
                              Style="background: var(--card);" />

                <!-- Module-specific UI -->
                @if (string.Equals(_selectedModuleName, "Insight Monitor", StringComparison.OrdinalIgnoreCase))
                {
                    <!-- IM: Metric + DateRange -->
                    <MudSelect T="string" @bind-Value="_metric"
                               Label="@Localizer["Metric"]"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Style="background: var(--card);"
                               Required="true">
                        @foreach (var tipo in (_isNumericDataset ? _kpiTypes : new List<string> { "lastValue" }))
                        {
                            <MudSelectItem T="string" Value="@tipo">@_metricLabels[tipo]</MudSelectItem>
                        }
                    </MudSelect>

                    <MudText Typo="Typo.body1" Style="color: var(--text-primary);">@Localizer["DateRange"]</MudText>

                    <div style="display:flex; flex-wrap:wrap; gap:12px;">
                        <div>
                            <MudDatePicker @bind-Date="_dateFrom"
                                            Label="@Localizer["From"]"
                                            Variant="Variant.Outlined"
                                            Style="width:180px;"
                                            Required="true" />
                        </div>
                        <div>
                            <MudDatePicker @bind-Date="_dateTo"
                                            Label="@Localizer["To"]"
                                            Variant="Variant.Outlined"
                                            Style="width:180px;"
                                            Required="true" />
                        </div>
                    </div>

                    @if (_dateRangeInvalid)
                    {
                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Error">@Localizer["DateRangeInvalid"]</MudText>
                    }
                }
                else if (!string.IsNullOrEmpty(_selectedModuleName))
                {
                    <!-- Non-IM modules: Type buttons + Atributo + Valor -->
                    <MudText Typo="Typo.body1" Style="color: var(--text-primary);">@Localizer["ModuleType"]</MudText>

                    <div class="d-flex" style="gap:8px; margin-bottom:8px;">
                        @if (string.Equals(_selectedModuleName, "Asset Manager", StringComparison.OrdinalIgnoreCase))
                        {
                            <MudButton Variant="Variant.Outlined" Color="@(_selectedType==1?MudBlazor.Color.Primary:MudBlazor.Color.Default)" OnClick="@(()=>_selectedType=1)">Asset</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="@(_selectedType==2?MudBlazor.Color.Primary:MudBlazor.Color.Default)" OnClick="@(()=>_selectedType=2)">EventTask</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="@(_selectedType==3?MudBlazor.Color.Primary:MudBlazor.Color.Default)" OnClick="@(()=>_selectedType=3)">Stock</MudButton>
                        }
                        else if (string.Equals(_selectedModuleName, "Urban Monitor", StringComparison.OrdinalIgnoreCase))
                        {
                            <MudButton Variant="Variant.Outlined" Color="@(_selectedType==1?MudBlazor.Color.Primary:MudBlazor.Color.Default)" OnClick="@(()=>_selectedType=1)">Evento</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="@(_selectedType==2?MudBlazor.Color.Primary:MudBlazor.Color.Default)" OnClick="@(()=>_selectedType=2)">Noticia</MudButton>
                        }
                        else if (string.Equals(_selectedModuleName, "Event Monitor", StringComparison.OrdinalIgnoreCase))
                        {
                            <MudButton Variant="Variant.Outlined" Color="@(_selectedType==1?MudBlazor.Color.Primary:MudBlazor.Color.Default)" OnClick="@(()=>_selectedType=1)">Alerta</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="@(_selectedType==2?MudBlazor.Color.Primary:MudBlazor.Color.Default)" OnClick="@(()=>_selectedType=2)">Evento</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="@(_selectedType==3?MudBlazor.Color.Primary:MudBlazor.Color.Default)" OnClick="@(()=>_selectedType=3)">Extensión</MudButton>
                        }
                        else
                        {
                            <!-- Fallback: muestra el nombre del módulo -->
                            <MudText Typo="Typo.subtitle2">@_selectedModuleName</MudText>
                        }
                    </div>

                    <!-- Atributo select -->
                    <MudSelect T="string" @bind-Value="SelectedAtributo"
                               Label="@Localizer["Atributo"]"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Style="background: var(--card); width: 280px;">
                        @if (_attributes != null && _attributes.Any())
                        {
                            @foreach (var a in _attributes)
                            {
                                <MudSelectItem T="string" Value="@a">@a</MudSelectItem>
                            }
                        }
                        else
                        {
                            <MudSelectItem T="string" Disabled="true">—</MudSelectItem>
                        }
                    </MudSelect>

                    <!-- Valor select (poblado tras elegir atributo) -->
                    @if (!string.IsNullOrEmpty(_selectedAtributo))
                    {
                        <MudSelect T="string" @bind-Value="_selectedAttributeValue"
                                   Label="@Localizer["Valor"]"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Style="background: var(--card); width: 280px;">
                            @if (_attributeValues != null && _attributeValues.Any())
                            {
                                @foreach (var v in _attributeValues)
                                {
                                    <MudSelectItem T="string" Value="@v">@v</MudSelectItem>
                                }
                            }
                            else
                            {
                                <MudSelectItem T="string" Disabled="true">@Localizer["NoData"]</MudSelectItem>
                            }
                        </MudSelect>
                    }
                }

                <!-- Color ranges for numeric datasets (both IM and non-IM) -->
                @if (_isNumericDataset)
                {
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.body1" Style="color: var(--text-primary);">@Localizer["ColorRanges"]</MudText>

                    @foreach (var range in _colorRanges)
                    {
                        <div class="d-flex align-items-end mb-2" style="gap: 12px; flex-wrap: wrap;">
                            <div style="display: flex; flex-direction: column;">
                                <MudNumericField @bind-Value="range.Min"
                                                 Label="@Localizer["MinValue"]"
                                                 Dense="true"
                                                 Variant="Variant.Outlined"
                                                 Style="width: 120px; background: var(--card);" />
                            </div>

                            <div style="display: flex; flex-direction: column;">
                                <MudNumericField @bind-Value="range.Max"
                                                 Label="@Localizer["MaxValue"]"
                                                 Dense="true"
                                                 Variant="Variant.Outlined"
                                                 Style="width: 120px; background: var(--card);" />
                            </div>

                            <!-- Color -->
                            <div style="display: flex; flex-direction: column; align-items: flex-start;">
                                <MudText Typo="Typo.body2" Style="color: var(--text-secondary);">@Localizer["Color"]</MudText>
                                <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" OffsetY="true">
                                    <ActivatorContent>
                                        <div style="width: 36px; height: 36px; border-radius: 6px;
                                                                border: 1px solid var(--borde-drawer);
                                                                cursor: pointer;
                                                                background-color:@range.Color;">
                                        </div>
                                    </ActivatorContent>
                                    <ChildContent>
                                        <MudColorPicker @bind-Text="range.Color"
                                                        Variant="Variant.Outlined"
                                                        DisableAlpha="true"
                                                        Style="width: 220px;" />
                                    </ChildContent>
                                </MudMenu>
                            </div>

                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Color="MudBlazor.Color.Error"
                                           OnClick="@(() => RemoveRange(range))" />
                        </div>
                    }

                    <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Primary" OnClick="AddRange" StartIcon="@Icons.Material.Filled.Add">
                        @Localizer["AddRange"]
                    </MudButton>
                }

            </MudStack>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Cancel"]</MudButton>
        <MudButton Color="MudBlazor.Color.Primary"
                   OnClick="Submit"
                   Disabled="!IsFormValid || _isSubmitting">
                   @Localizer["Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance _mudDialog { get; set; }

    // datasets list from API
    private List<DatasetDto> _datasets = new();
    private int _selectedDatasetId;
    private bool _isNumericDataset = false;

    // module detection
    private string? _selectedModuleName; // e.g. "Insight Monitor", "Asset Manager", etc.
    private List<string> _attributes = new();
    private string? _selectedAtributo;
    private List<string> _attributeValues = new();
    private string? _selectedAttributeValue;
    private int? _selectedType;

    // common fields
    private decimal _multiplier = 1;
    private string _name = string.Empty;
    private string _description = string.Empty;
    private string _metric = "lastValue"; // only used for IM
    private string _color = "#FFFFFF";
    private DateTime? _dateFrom;
    private DateTime? _dateTo;
    private bool _isLoadingDatasets = true;
    private bool _isSubmitting = false;

    private List<string> _kpiTypes = new() { "lastValue", "average", "min", "max" };
    private List<ColorRange> _colorRanges = new();

    private string? _serverError;
    private bool _dateRangeInvalid => (_metric is "average" or "min" or "max") && _dateFrom.HasValue && _dateTo.HasValue && (_dateFrom > _dateTo);
   

    public string? SelectedAtributo
    {
        get => _selectedAtributo;
        set
        {
            if (_selectedAtributo != value)
            {
                _selectedAtributo = value;
                // Llamada asincrónica "fire-and-forget" al método que obtiene los valores.
                // Pasamos string.Empty si value es null para mantener la firma actual.
                _ = OnAtributoChanged(value ?? string.Empty);
            }
        }
    }


    protected override async Task OnInitializedAsync()
    {
        await LoadDatasets();
    }

    private async Task LoadDatasets()
    {
        _isLoadingDatasets = true;
        _serverError = null;

        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (string.IsNullOrWhiteSpace(token))
            {
                _serverError = "Token no encontrado";
                _datasets = new List<DatasetDto>();
                return;
            }

            // Llamada al endpoint unificado
            var url = $"api/DatasetUM/GetAllDatasetsDto?token={Uri.EscapeDataString(token)}";
            var response = await Http.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var loadedDatasets = await response.Content.ReadFromJsonAsync<List<DatasetDto>>() ?? new();
                _datasets = loadedDatasets.OrderBy(d => d.Nombre).ToList();
                _selectedDatasetId = _datasets.FirstOrDefault()?.Id ?? 0;

                if (_selectedDatasetId != 0)
                    await OnDatasetChanged(_selectedDatasetId);
            }
            else
            {
                _serverError = $"Error cargando datasets: {response.ReasonPhrase}";
                _datasets = new List<DatasetDto>();
            }
        }
        catch (Exception ex)
        {
            _serverError = $"Error al cargar datasets: {ex.Message}";
            _datasets = new List<DatasetDto>();
        }
        finally
        {
            _isLoadingDatasets = false;
            StateHasChanged();
        }
        Console.WriteLine("=== Datasets cargados ===");
foreach (var ds in _datasets)
{
    Console.WriteLine($"ID: {ds.Id} | Nombre: {ds.Nombre}");
}
Console.WriteLine("========================");

    }

    private async Task OnDatasetChanged(int datasetId)
    {
        _selectedDatasetId = datasetId;
        await UpdateSensorType(datasetId);

        // Reset module-related selections
        _selectedModuleName = null;
        _attributes.Clear();
        _selectedAtributo = null;
        _attributeValues.Clear();
        _selectedAttributeValue = null;
        _selectedType = null;

        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            // Llamamos al endpoint que ya tenés: GetDatasetModule (devuelve nombre largo)
            var url = $"api/Dataset/GetDatasetModule?datasetId={datasetId}&token={Uri.EscapeDataString(token ?? "")}";
            var resp = await Http.GetAsync(url);

            if (resp.IsSuccessStatusCode)
            {
                // el backend devuelve un string con el nombre largo (p. ej. "Asset Manager")
                var moduleName = await resp.Content.ReadAsStringAsync();
                moduleName = moduleName?.Trim().Trim('"'); // limpiar comillas si vienen
                _selectedModuleName = string.IsNullOrWhiteSpace(moduleName) ? null : moduleName;
            }
            else
            {
                _selectedModuleName = null;
            }

            // Si módulo distinto de IM: intentar obtener atributos (endpoint backend sugerido)
            if (!string.IsNullOrEmpty(_selectedModuleName) &&
                !string.Equals(_selectedModuleName, "Insight Monitor", StringComparison.OrdinalIgnoreCase))
            {
                try
                {
                    var attrResp = await Http.GetAsync($"api/Kpi/GetDatasetAttributes?datasetId={datasetId}&token={Uri.EscapeDataString(token ?? "")}");
                    if (attrResp.IsSuccessStatusCode)
                    {
                        var attrList = await attrResp.Content.ReadFromJsonAsync<List<string>>() ?? new();
                        _attributes = attrList;
                    }
                    else
                    {
                        _attributes = new();
                    }
                }
                catch
                {
                    _attributes = new();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"OnDatasetChanged error: {ex.Message}");
            _selectedModuleName = null;
            _attributes = new();
        }

        StateHasChanged();
    }

    private async Task UpdateSensorType(int datasetId)
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var response = await Http.GetAsync($"api/Dataset/GetSensorType?datasetId={datasetId}&token={Uri.EscapeDataString(token)}");

            if (response.IsSuccessStatusCode)
            {
                var type = await response.Content.ReadAsStringAsync();

                string[] numericTypes = { "num", "int", "float", "double", "decimal" };
                _isNumericDataset = numericTypes.Any(t => type.Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            else
            {
                _isNumericDataset = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting dataset type {datasetId}: {ex.Message}");
            _isNumericDataset = false;
        }
    }

    private async Task OnAtributoChanged(string atributo)
    {
        _selectedAtributo = atributo;
        _attributeValues.Clear();
        _selectedAttributeValue = null;

        if (string.IsNullOrWhiteSpace(_selectedAtributo))
            return;

        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var resp = await Http.GetAsync($"api/Kpi/GetFieldValues?datasetId={_selectedDatasetId}&field={Uri.EscapeDataString(_selectedAtributo)}&token={Uri.EscapeDataString(token ?? "")}");
            if (resp.IsSuccessStatusCode)
            {
                _attributeValues = await resp.Content.ReadFromJsonAsync<List<string>>() ?? new();
            }
            else
            {
                _attributeValues = new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching field values: {ex.Message}");
            _attributeValues = new();
        }

        StateHasChanged();
    }

    private void AddRange() => _colorRanges.Add(new ColorRange());

    private void RemoveRange(ColorRange range) => _colorRanges.Remove(range);

    private void Cancel() => _mudDialog.Cancel();

    private Dictionary<string, string> _metricLabels = new()
    {
        { "lastValue", "Last Value" },
        { "average", "Average" },
        { "min", "Minimum" },
        { "max", "Maximum" }
    };

    private bool IsFormValid
    {
        get
        {
            if (_selectedDatasetId == 0) return false;
            if (string.IsNullOrWhiteSpace(_name)) return false;

            // IM requires metric and date range for certain metrics
            if (string.Equals(_selectedModuleName, "Insight Monitor", StringComparison.OrdinalIgnoreCase))
            {
                if (string.IsNullOrWhiteSpace(_metric)) return false;
                if ((_metric == "average" || _metric == "min" || _metric == "max"))
                {
                    if (!_dateFrom.HasValue || !_dateTo.HasValue || _dateRangeInvalid) return false;
                }
            }
            else if (!string.IsNullOrEmpty(_selectedModuleName))
            {
                // non-IM requires Type and Atributo selected; if atributo requires value, require that too
                if (!_selectedType.HasValue) return false;
                if (_attributes != null && _attributes.Any())
                {
                    if (string.IsNullOrWhiteSpace(_selectedAtributo)) return false;
                    // if attribute has values loaded, require selected
                    if (_attributeValues != null && _attributeValues.Any() && string.IsNullOrWhiteSpace(_selectedAttributeValue))
                        return false;
                }
            }

            return true;
        }
    }

    private async Task Submit()
    {
        _serverError = null;

        // client-side validation
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add(Localizer["KpiNameRequired"], Severity.Warning);
            return;
        }

        if (string.Equals(_selectedModuleName, "Insight Monitor", StringComparison.OrdinalIgnoreCase))
        {
            if ((_metric == "average" || _metric == "min" || _metric == "max"))
            {
                if (!_dateFrom.HasValue || !_dateTo.HasValue)
                {
                    Snackbar.Add(Localizer["DateRangeRequired"], Severity.Warning);
                    return;
                }
                if (_dateFrom > _dateTo)
                {
                    Snackbar.Add(Localizer["DateRangeInvalid"], Severity.Warning);
                    return;
                }
            }
        }
        else
        {
            if (!_selectedType.HasValue)
            {
                Snackbar.Add(Localizer["InvalidForm"], Severity.Warning);
                return;
            }
            if (_attributes != null && _attributes.Any() && string.IsNullOrWhiteSpace(_selectedAtributo))
            {
                Snackbar.Add(Localizer["InvalidForm"], Severity.Warning);
                return;
            }
            if (_attributeValues != null && _attributeValues.Any() && string.IsNullOrWhiteSpace(_selectedAttributeValue))
            {
                Snackbar.Add(Localizer["InvalidForm"], Severity.Warning);
                return;
            }
        }

        // prepare extraInfo
        object? extraInfoObj = null;
        if (string.Equals(_selectedModuleName, "Insight Monitor", StringComparison.OrdinalIgnoreCase))
        {
            if (_dateFrom.HasValue && _dateTo.HasValue)
                extraInfoObj = new { dateFrom = _dateFrom.Value.ToString("o"), dateTo = _dateTo.Value.ToString("o") };
            else
                extraInfoObj = new { };
        }
        else
        {
            // for non-IM modules we store selected attribute value in extraInfo (optional)
            if (!string.IsNullOrWhiteSpace(_selectedAttributeValue))
                extraInfoObj = new { selectedValue = _selectedAttributeValue };
            else
                extraInfoObj = new { };
        }

        var request = new KpiRequest
        {
            Name = _name.Trim(),
            Description = _description?.Trim(),
            DatasetId = _selectedDatasetId,
            Unit = "x",
            // Metric only for IM
            Metric = string.Equals(_selectedModuleName, "Insight Monitor", StringComparison.OrdinalIgnoreCase) ? _metric : null,
            // Multiplier only if numeric
            Multiplier = _isNumericDataset ? (double?)_multiplier : null,
            DefaultColor = _color,
            ColorRanges = _isNumericDataset ? JsonSerializer.Serialize(_colorRanges) : "[]",
            ExtraInfo = extraInfoObj is null ? null : JsonSerializer.Serialize(extraInfoObj),
            // Save the long module name returned by backend
            SourceModule = _selectedModuleName,
            // Non-IM fields
            Atributo = !string.IsNullOrWhiteSpace(_selectedAtributo) ? _selectedAtributo : null,
            Type = _selectedType
        };

        _isSubmitting = true;
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var response = await Http.PostAsJsonAsync($"api/Kpi?token={Uri.EscapeDataString(token ?? "")}", request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(Localizer["KpiCreated", _name], Severity.Success);
                _mudDialog.Close(DialogResult.Ok(2));
            }
            else
            {
                string serverMsg;
                try
                {
                    serverMsg = await response.Content.ReadAsStringAsync();
                    if (string.IsNullOrWhiteSpace(serverMsg))
                        serverMsg = response.ReasonPhrase ?? "Unknown server error";
                }
                catch
                {
                    serverMsg = response.ReasonPhrase ?? "Unknown server error";
                }

                _serverError = Localizer["ErrorCreatingKpi", serverMsg];
                Snackbar.Add(_serverError, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _serverError = Localizer["ServerConnectionError", ex.Message];
            Snackbar.Add(_serverError, Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private class ColorRange
    {
        public decimal Min { get; set; }
        public decimal Max { get; set; }
        public string Color { get; set; } = "#00FF00";
    }

    
}
