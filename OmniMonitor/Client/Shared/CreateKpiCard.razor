@using OmniMonitor.Shared.Dtos
@using System.Net.Http.Json
@using Blazored.LocalStorage
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ILocalStorageService LocalStorage
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CreateVisualizationCard> Localizer
@inject IDialogService DialogService

<MudDialog Style="background-color: var(--fondo-dialog)">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: var(--text-primary);">
            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Class="mb-n1 mr-1" />
            @Localizer["NewKPI"]
        </MudText>
    </TitleContent>

    <DialogContent>
        @if (_isLoadingDatasets)
        {
            <div style="display:flex; justify-content:center; align-items:center; height:100px;">
                <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Size="MudBlazor.Size.Medium" />
            </div>
        }
        else
        {
            <MudStack Spacing="3">

                @if (!string.IsNullOrEmpty(_serverError))
                {
                    <MudAlert Severity="Severity.Error" Elevation="0">@_serverError</MudAlert>
                }

                <!-- Dataset + Multiplier + Color -->
                <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">

                    <!-- Dataset select -->
                    <div style="display: flex; flex-direction: column;">
                        <MudSelect T="string"
                                   Label="@Localizer["Dataset"]"
                                   Value="_selectedDatasetKey"
                                   ValueChanged="OnDatasetChanged"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Style="background: var(--card); width: 380px;"
                                   Required="true">
                            @foreach (var ds in _datasetItems)
                            {
                                <MudSelectItem T="string" Value="@ds.Key">
                                    @($"{ds.Nombre}")
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <!-- Multiplier (visible si dataset numérico) -->
                    @if (_isNumericDataset)
                    {
                        <div style="display: flex; flex-direction: column;">
                            <MudNumericField @bind-Value="_multiplier"
                                             Label="@Localizer["Multiplier"]"
                                             Variant="Variant.Outlined"
                                             Dense="true"
                                             HideSpinButtons="true"
                                             Step=".1M"
                                             Style="background: var(--card); width: 120px;" />
                        </div>
                    }

                    <!-- Color -->
                    <div style="display: flex; align-items: center; height: 100%;">
                        <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" OffsetY="true">
                            <ActivatorContent>
                                <MudTooltip Text="@_color">
                                    <div style="
                                                            width: 56.5px;
                                                            height: 56.5px;
                                                            border-radius: 6px;
                                                            cursor: pointer;
                                                            background-color:@_color;">
                                    </div>
                                </MudTooltip>
                            </ActivatorContent>
                            <ChildContent>
                                <div style="padding: 8px; background: var(--card); border-radius: 8px;">
                                    <MudColorPicker @bind-Text="_color"
                                                    DisableAlpha="true"
                                                    Variant="Variant.Outlined"
                                                    Style="width: 220px;" />
                                </div>
                            </ChildContent>
                        </MudMenu>
                    </div>

                </div>

                <!-- Name -->
                <MudTextField @bind-Value="_name"
                              Label="@Localizer["Name"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              MaxLength="50"
                              Style="background: var(--card);" />

                <!-- Description -->
                <MudTextField @bind-Value="_description"
                              Label="@Localizer["Description"]"
                              Variant="Variant.Outlined"
                              Lines="2"
                              MaxLength="200"
                              Style="background: var(--card);" />

                <!-- Module-specific UI -->
                <!-- Si el módulo soporta métricas mostramos la select de métricas -->
                @if (ModuleHasMetric)
                {
                    <MudSelect T="string" @bind-Value="_metric"
                               Label="@Localizer["Metric"]"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Style="background: var(--card);"
                               Required="true">
                        @foreach (var tipo in GetMetricOptions())
                        {
                            <MudSelectItem T="string" Value="@tipo">@_metricLabels[tipo]</MudSelectItem>
                        }
                    </MudSelect>

                    @* Solo para IM mostramos DateRange *@
                    @if (string.Equals(_selectedModuleName, "Insight Monitor", StringComparison.OrdinalIgnoreCase))
                    {
                        <MudText Typo="Typo.body1" Style="color: var(--text-primary);">@Localizer["DateRange"]</MudText>

                        <div style="display:flex; flex-wrap:wrap; gap:12px;">
                            <div>
                                <MudDatePicker @bind-Date="_dateFrom"
                                               Label="@Localizer["From"]"
                                               Variant="Variant.Outlined"
                                               Style="width:180px;"
                                               Required="true" />
                            </div>
                            <div>
                                <MudDatePicker @bind-Date="_dateTo"
                                               Label="@Localizer["To"]"
                                               Variant="Variant.Outlined"
                                               Style="width:180px;"
                                               Required="true" />
                            </div>
                        </div>

                        @if (_dateRangeInvalid)
                        {
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Error">@Localizer["DateRangeInvalid"]</MudText>
                        }
                    }
                }

                /* --- importante: mostramos atributos para TODOS los módulos que NO sean Insight Monitor,
                incluyendo AM/EM/UM — esto reemplaza el antiguo 'else if' que ocultaba la UI cuando había métricas */
                @if (!string.IsNullOrEmpty(_selectedModuleName) && !string.Equals(_selectedModuleName, "Insight Monitor", StringComparison.OrdinalIgnoreCase))
                {
                    <!-- Non-IM modules: Type buttons + Atributo + Valor -->
                    <MudText Typo="Typo.body1" Style="color: var(--text-primary);">@Localizer["ModuleType"]</MudText>

                    <div class="d-flex" style="gap:8px; margin-bottom:8px;">
                        @if (string.Equals(_selectedModuleName, "Asset Manager", StringComparison.OrdinalIgnoreCase))
                        {
                            <MudButton Variant="Variant.Outlined" Color="@(_selectedType == 1 ? MudBlazor.Color.Primary : MudBlazor.Color.Default)" OnClick="@(() => SetType(1))">Asset</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="@(_selectedType == 2 ? MudBlazor.Color.Primary : MudBlazor.Color.Default)" OnClick="@(() => SetType(2))">EventTask</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="@(_selectedType == 3 ? MudBlazor.Color.Primary : MudBlazor.Color.Default)" OnClick="@(() => SetType(3))">Stock</MudButton>
                        }
                        else if (string.Equals(_selectedModuleName, "Urban Monitor", StringComparison.OrdinalIgnoreCase))
                        {
                            <MudButton Variant="Variant.Outlined" Color="@(_selectedType == 1 ? MudBlazor.Color.Primary : MudBlazor.Color.Default)" OnClick="@(() => SetType(1))">Evento</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="@(_selectedType == 2 ? MudBlazor.Color.Primary : MudBlazor.Color.Default)" OnClick="@(() => SetType(2))">Noticia</MudButton>
                        }
                        else if (string.Equals(_selectedModuleName, "Event Manager", StringComparison.OrdinalIgnoreCase)
                        || string.Equals(_selectedModuleName, "EM", StringComparison.OrdinalIgnoreCase))
                        {
                            <MudButton Variant="Variant.Outlined" Color="@(_selectedType == 1 ? MudBlazor.Color.Primary : MudBlazor.Color.Default)" OnClick="@(() => SetType(1))">Alerta</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="@(_selectedType == 2 ? MudBlazor.Color.Primary : MudBlazor.Color.Default)" OnClick="@(() => SetType(2))">Evento</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="@(_selectedType == 3 ? MudBlazor.Color.Primary : MudBlazor.Color.Default)" OnClick="@(() => SetType(3))">Extensión</MudButton>
                        }
                    </div>

                    <MudSelect T="string" @bind-Value="SelectedAtributo"
                               Label="@Localizer["Atributo"]"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Style="background: var(--card); width: 280px;">
                        @if (_attributes != null && _attributes.Any())
                        {
                            @foreach (var a in _attributes)
                            {
                                <MudSelectItem T="string" Value="@a">@a</MudSelectItem>
                            }
                        }
                        else
                        {
                            <MudSelectItem T="string" Disabled="true">—</MudSelectItem>
                        }
                    </MudSelect>

                    @if (!string.IsNullOrEmpty(_selectedAtributo))
                    {
                        <MudSelect T="string" @bind-Value="_selectedAttributeValue"
                                   Label="@Localizer["Valor"]"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Style="background: var(--card); width: 280px;">
                            @if (_attributeValues != null && _attributeValues.Any())
                            {
                                @foreach (var v in _attributeValues)
                                {
                                    <MudSelectItem T="string" Value="@v">@v</MudSelectItem>
                                }
                            }
                            else
                            {
                                <MudSelectItem T="string" Disabled="true">@Localizer["NoData"]</MudSelectItem>
                            }
                        </MudSelect>
                    }
                }


                <!-- Color ranges for numeric datasets (both IM and non-IM) -->
                @if (_isNumericDataset)
                {
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.body1" Style="color: var(--text-primary);">@Localizer["ColorRanges"]</MudText>

                    @foreach (var range in _colorRanges)
                    {
                        <div class="d-flex align-items-end mb-2" style="gap: 12px; flex-wrap: wrap;">
                            <div style="display: flex; flex-direction: column;">
                                <MudNumericField @bind-Value="range.Min"
                                                 Label="@Localizer["MinValue"]"
                                                 Dense="true"
                                                 Variant="Variant.Outlined"
                                                 Style="width: 120px; background: var(--card);" />
                            </div>

                            <div style="display: flex; flex-direction: column;">
                                <MudNumericField @bind-Value="range.Max"
                                                 Label="@Localizer["MaxValue"]"
                                                 Dense="true"
                                                 Variant="Variant.Outlined"
                                                 Style="width: 120px; background: var(--card);" />
                            </div>

                            <!-- Color -->
                            <div style="display: flex; flex-direction: column; align-items: flex-start;">
                                <MudText Typo="Typo.body2" Style="color: var(--text-secondary);">@Localizer["Color"]</MudText>
                                <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" OffsetY="true">
                                    <ActivatorContent>
                                        <div style="width: 36px; height: 36px; border-radius: 6px;
                                                                                                                border: 1px solid var(--borde-drawer);
                                                                                                                cursor: pointer;
                                                                                                                background-color:@range.Color;">
                                        </div>
                                    </ActivatorContent>
                                    <ChildContent>
                                        <MudColorPicker @bind-Text="range.Color"
                                                        Variant="Variant.Outlined"
                                                        DisableAlpha="true"
                                                        Style="width: 220px;" />
                                    </ChildContent>
                                </MudMenu>
                            </div>

                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Color="MudBlazor.Color.Error"
                                           OnClick="@(() => RemoveRange(range))" />
                        </div>
                    }

                    <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Primary" OnClick="AddRange" StartIcon="@Icons.Material.Filled.Add">
                        @Localizer["AddRange"]
                    </MudButton>
                }

            </MudStack>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Cancel"]</MudButton>
        <MudButton Color="MudBlazor.Color.Primary"
                   OnClick="Submit"
                   Disabled="!IsFormValid || _isSubmitting">
            @Localizer["Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance _mudDialog { get; set; }

    // dataset items with module for unique key
    private class DatasetItem
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Module { get; set; } = string.Empty;
        public string Key => $"{Module}__{Id}";
    }

    private List<DatasetItem> _datasetItems = new();
    private string? _selectedDatasetKey;
    private int _selectedDatasetId;
    private string? _selectedDatasetModule;

    private KpiRequest request;

    private bool _isNumericDataset = false;

    // module detection
    private string? _selectedModuleName;
    private List<string> _attributes = new();
    private string? _selectedAtributo;
    private List<string> _attributeValues = new();
    private string? _selectedAttributeValue;
    private int? _selectedType;

    // common fields
    private decimal _multiplier = 1;
    private string _name = string.Empty;
    private string _description = string.Empty;
    private string _metric = "lastValue";
    private string _color = "#FFFFFF";
    private DateTime? _dateFrom;
    private DateTime? _dateTo;
    private bool _isLoadingDatasets = true;
    private bool _isSubmitting = false;

    private List<ColorRange> _colorRanges = new();

    private string? _serverError;
    private bool _dateRangeInvalid => (_metric is "average" or "min" or "max") && _dateFrom.HasValue && _dateTo.HasValue && (_dateFrom > _dateTo);

    public string? SelectedAtributo
    {
        get => _selectedAtributo;
        set
        {
            if (_selectedAtributo != value)
            {
                _selectedAtributo = value;
                _ = OnAtributoChanged(value ?? string.Empty);
            }
        }
    }

    // 1) Helpers y labels (agregados)
    private Dictionary<string, string> _metricLabels = new()
    {
        { "lastValue", "Last Value" },
        { "average", "Average" },
        { "min", "Minimum" },
        { "max", "Maximum" },
        { "count", "Count" },
        { "percentage", "Percentage" }
    };

    private List<string> _kpiTypes = new() { "lastValue", "average", "min", "max" };
    private List<string> _countPercentTypes = new() { "count", "percentage" };

    // helper: el módulo acepta las métricas count/percentage
    private bool ModuleUsesCountPercentage =>
        !string.IsNullOrWhiteSpace(_selectedModuleName) &&
        (string.Equals(_selectedModuleName, "Asset Manager", StringComparison.OrdinalIgnoreCase)
         || string.Equals(_selectedModuleName, "AM", StringComparison.OrdinalIgnoreCase)
         || string.Equals(_selectedModuleName, "Urban Monitor", StringComparison.OrdinalIgnoreCase)
         || string.Equals(_selectedModuleName, "UM", StringComparison.OrdinalIgnoreCase)
         || string.Equals(_selectedModuleName, "Event Manager", StringComparison.OrdinalIgnoreCase)
         || string.Equals(_selectedModuleName, "EM", StringComparison.OrdinalIgnoreCase));

    // helper: el módulo tiene métrica (IM o los otros)
    private bool ModuleHasMetric =>
        string.Equals(_selectedModuleName, "Insight Monitor", StringComparison.OrdinalIgnoreCase)
        || ModuleUsesCountPercentage;

    // helper: obtener las opciones de métrica según módulo
    private IEnumerable<string> GetMetricOptions()
    {
        if (string.Equals(_selectedModuleName, "Insight Monitor", StringComparison.OrdinalIgnoreCase))
            return _isNumericDataset ? _kpiTypes : new List<string> { "lastValue" };

        if (ModuleUsesCountPercentage)
            return _countPercentTypes;

        return new List<string>();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDatasets();
    }

    private async Task LoadDatasets()
    {
        _isLoadingDatasets = true;
        _serverError = null;

        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (string.IsNullOrWhiteSpace(token))
            {
                _serverError = "Token no encontrado";
                _datasetItems = new List<DatasetItem>();
                return;
            }

            var url = $"api/DatasetUM/GetAllDatasetsDto?token={Uri.EscapeDataString(token)}";

            var response = await Http.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var loadedDatasets = await response.Content.ReadFromJsonAsync<List<DatasetDto>>() ?? new();

                var items = loadedDatasets.Select(ds =>
                {
                    string moduleName = string.Empty;
                    try
                    {
                        var moduleProp = ds.GetType().GetProperty("Module") ?? ds.GetType().GetProperty("SourceModule");
                        if (moduleProp != null)
                        {
                            var val = moduleProp.GetValue(ds) as string;
                            if (!string.IsNullOrWhiteSpace(val))
                                moduleName = val.Trim();
                        }
                    }
                    catch
                    {
                        moduleName = string.Empty;
                    }

                    if (string.IsNullOrWhiteSpace(moduleName))
                        moduleName = "Unknown";

                    return new DatasetItem
                    {
                        Id = ds.Id,
                        Nombre = ds.Nombre,
                        Module = moduleName
                    };
                })
                .OrderBy(i => i.Module)
                .ThenBy(i => i.Nombre)
                .ToList();

                _datasetItems = items;

                var first = _datasetItems.FirstOrDefault();
                if (first != null)
                {
                    _selectedDatasetKey = first.Key;
                    _selectedDatasetId = first.Id;
                    _selectedDatasetModule = first.Module;
                    await OnDatasetChanged(_selectedDatasetKey);
                }
            }
            else
            {
                _serverError = $"Error cargando datasets: {response.ReasonPhrase}";
                _datasetItems = new List<DatasetItem>();
            }
        }
        catch (Exception ex)
        {
            _serverError = $"Error al cargar datasets: {ex.Message}";
            _datasetItems = new List<DatasetItem>();
        }
        finally
        {
            _isLoadingDatasets = false;
            StateHasChanged();
        }
    }

    // 3) OnDatasetChanged: no comprobar numericidad para AM/EM/UM y setear _metric por defecto
    private async Task OnDatasetChanged(string selectedKey)
    {
        _selectedDatasetKey = selectedKey;

        if (string.IsNullOrWhiteSpace(_selectedDatasetKey))
        {
            _selectedDatasetId = 0;
            _selectedDatasetModule = null;
            _selectedModuleName = null;
            return;
        }

        var idx = _selectedDatasetKey.LastIndexOf("__", StringComparison.Ordinal);
        if (idx >= 0)
        {
            var modulePart = _selectedDatasetKey.Substring(0, idx);
            var idPart = _selectedDatasetKey.Substring(idx + 2);

            if (int.TryParse(idPart, out var id))
                _selectedDatasetId = id;
            else
                _selectedDatasetId = 0;

            _selectedDatasetModule = string.IsNullOrWhiteSpace(modulePart) ? null : modulePart;
        }
        else
        {
            if (int.TryParse(_selectedDatasetKey, out var idOnly))
            {
                _selectedDatasetId = idOnly;
                _selectedDatasetModule = null;
            }
            else
            {
                _selectedDatasetId = 0;
                _selectedDatasetModule = null;
            }
        }

        _selectedModuleName = _selectedDatasetModule;

        // Si el módulo es AM/EM/UM asumimos dataset numérico (no hacemos la comprobación)
        var moduleCode = GetModuleCode(_selectedModuleName);
        if (!string.IsNullOrWhiteSpace(moduleCode) &&
            (moduleCode.Equals("am", StringComparison.OrdinalIgnoreCase)
             || moduleCode.Equals("em", StringComparison.OrdinalIgnoreCase)
             || moduleCode.Equals("um", StringComparison.OrdinalIgnoreCase)))
        {
            _isNumericDataset = true;
        }
        else
        {
            // para IM y otros módulos hacemos la comprobación del sensor (si aplica)
            if (_selectedDatasetId != 0)
                await UpdateSensorType(_selectedDatasetId);
            else
                _isNumericDataset = false;
        }

        // setear métrica por defecto según módulo
        if (string.Equals(_selectedModuleName, "Insight Monitor", StringComparison.OrdinalIgnoreCase))
        {
            _metric = "lastValue";
        }
        else if (ModuleUsesCountPercentage)
        {
            _metric = "count";
        }

        _attributes.Clear();
        _selectedAtributo = null;
        _attributeValues.Clear();
        _selectedAttributeValue = null;
        _selectedType = null;

        StateHasChanged();
    }

    private async Task UpdateSensorType(int datasetId)
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var response = await Http.GetAsync($"api/Dataset/GetSensorType?datasetId={datasetId}&token={Uri.EscapeDataString(token)}");

            if (response.IsSuccessStatusCode)
            {
                var type = await response.Content.ReadAsStringAsync();

                string[] numericTypes = { "num", "int", "float", "double", "decimal" };
                _isNumericDataset = numericTypes.Any(t => type.Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            else
            {
                _isNumericDataset = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting dataset type {datasetId}: {ex.Message}");
            _isNumericDataset = false;
        }
    }

    private string? GetModuleCode(string? moduleLongName)
    {
        if (string.IsNullOrWhiteSpace(moduleLongName)) return null;

        var s = moduleLongName.Trim().ToLowerInvariant();
        return s switch
        {
            "asset manager" => "am",
            "am" => "am",
            "event manager" => "em",
            "em" => "em",
            "urban monitor" => "um",
            "um" => "um",
            "insight monitor" => "im",
            "im" => "im",
            _ => s
        };
    }

    private async Task LoadFieldTypes()
    {
        _attributes.Clear();
        _selectedAtributo = null;
        _attributeValues.Clear();
        _selectedAttributeValue = null;

        var moduleCode = GetModuleCode(_selectedModuleName);
        if (string.IsNullOrWhiteSpace(moduleCode) || !_selectedType.HasValue)
            return;

        try
        {
            var resp = await Http.GetAsync($"api/Kpi/field-types?modulo={Uri.EscapeDataString(moduleCode)}&choice={_selectedType.Value}");

            if (resp.IsSuccessStatusCode)
            {
                var list = await resp.Content.ReadFromJsonAsync<List<string>>() ?? new();
                _attributes = list;
            }
            else
            {
                _attributes = new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading field types: {ex.Message}");
            _attributes = new();
        }
        StateHasChanged();
    }

    private async Task SetType(int type)
    {
        if (_selectedType == type) return;
        _selectedType = type;

        await LoadFieldTypes();
    }

    private async Task OnAtributoChanged(string atributo)
    {
        _selectedAtributo = atributo;
        _attributeValues.Clear();
        _selectedAttributeValue = null;

        if (string.IsNullOrWhiteSpace(_selectedAtributo))
            return;

        var moduleCode = GetModuleCode(_selectedModuleName);
        if (string.IsNullOrWhiteSpace(moduleCode))
            return;

        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            // si _selectedType es null, mandar 0 por seguridad (o podrías requerir que el usuario elija tipo)
            var choice = _selectedType ?? 0;

            var url = $"api/Kpi/field-values?datasetId={_selectedDatasetId}&modulo={Uri.EscapeDataString(moduleCode)}&campo={Uri.EscapeDataString(_selectedAtributo)}&choice={choice}&token={Uri.EscapeDataString(token ?? "")}";

            var resp = await Http.GetAsync(url);
            if (resp.IsSuccessStatusCode)
            {
                _attributeValues = await resp.Content.ReadFromJsonAsync<List<string>>() ?? new();
                Console.WriteLine(_attributeValues);
            }
            else
            {
                _attributeValues = new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching field values: {ex.Message}");
            _attributeValues = new();
        }

        StateHasChanged();
    }

    private void AddRange() => _colorRanges.Add(new ColorRange());

    private void RemoveRange(ColorRange range) => _colorRanges.Remove(range);

    private void Cancel() => _mudDialog.Cancel();

    
    private bool IsFormValid
    {
        get
        {
            if (_selectedDatasetId == 0) return false;
            if (string.IsNullOrWhiteSpace(_name)) return false;

            // Si el módulo usa métricas (IM o AM/EM/UM con count/percentage) exigir métrica
            if (ModuleHasMetric)
            {
                if (string.IsNullOrWhiteSpace(_metric)) return false;

                // Para IM, las métricas average/min/max requieren date range
                if (string.Equals(_selectedModuleName, "Insight Monitor", StringComparison.OrdinalIgnoreCase))
                {
                    if ((_metric == "average" || _metric == "min" || _metric == "max"))
                    {
                        if (!_dateFrom.HasValue || !_dateTo.HasValue || _dateRangeInvalid) return false;
                    }
                }
            }

            // Para todos los módulos que NO sean Insight Monitor, exigir Type/Atributo si aplica
            if (!string.IsNullOrEmpty(_selectedModuleName) && !string.Equals(_selectedModuleName, "Insight Monitor", StringComparison.OrdinalIgnoreCase))
            {
                if (!_selectedType.HasValue) return false;
                if (_attributes != null && _attributes.Any())
                {
                    if (string.IsNullOrWhiteSpace(_selectedAtributo)) return false;
                    if (_attributeValues != null && _attributeValues.Any() && string.IsNullOrWhiteSpace(_selectedAttributeValue))
                        return false;
                }
            }

            return true;
        }
    }


    private async Task Submit()
    {
        _serverError = null;

        // client-side validation
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add(Localizer["KpiNameRequired"], Severity.Warning);
            return;
        }

        if (string.Equals(_selectedModuleName, "Insight Monitor", StringComparison.OrdinalIgnoreCase))
        {
            if ((_metric == "average" || _metric == "min" || _metric == "max"))
            {
                if (!_dateFrom.HasValue || !_dateTo.HasValue)
                {
                    Snackbar.Add(Localizer["DateRangeRequired"], Severity.Warning);
                    return;
                }
                if (_dateFrom > _dateTo)
                {
                    Snackbar.Add(Localizer["DateRangeInvalid"], Severity.Warning);
                    return;
                }
            }
        }
        else
        {
            if (!_selectedType.HasValue)
            {
                Snackbar.Add(Localizer["InvalidForm"], Severity.Warning);
                return;
            }
            if (_attributes != null && _attributes.Any() && string.IsNullOrWhiteSpace(_selectedAtributo))
            {
                Snackbar.Add(Localizer["InvalidForm"], Severity.Warning);
                return;
            }
            if (_attributeValues != null && _attributeValues.Any() && string.IsNullOrWhiteSpace(_selectedAttributeValue))
            {
                Snackbar.Add(Localizer["InvalidForm"], Severity.Warning);
                return;
            }
        }

        // prepare extraInfo
        object? extraInfoObj = null;
        if (string.Equals(_selectedModuleName, "Insight Monitor", StringComparison.OrdinalIgnoreCase))
        {
            if (_dateFrom.HasValue && _dateTo.HasValue)
                extraInfoObj = JsonSerializer.Serialize(new { dateFrom = _dateFrom.Value.ToString("o"), dateTo = _dateTo.Value.ToString("o") });
            else
                extraInfoObj = JsonSerializer.Serialize(new { });
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(_selectedAttributeValue))
                extraInfoObj = _selectedAttributeValue;
            else
                extraInfoObj = new { };
        }

        request = new KpiRequest
        {
            Name = _name.Trim(),
            Description = _description?.Trim(),
            DatasetId = _selectedDatasetId,
            Unit = "x",
            // 4) Metric: enviarla si el módulo soporta métricas (IM o AM/EM/UM)
            Metric = ModuleHasMetric ? _metric : null,
            // Multiplier only if numeric
            Multiplier = _isNumericDataset ? (double?)_multiplier : null,
            DefaultColor = _color,
            ColorRanges = _isNumericDataset ? JsonSerializer.Serialize(_colorRanges) : "[]",
            ExtraInfo = extraInfoObj is null ? null : extraInfoObj.ToString(),
            // Save the long module name returned by backend (but passing module code uppercased)
            SourceModule = GetModuleCode(_selectedModuleName)?.ToUpperInvariant() ?? _selectedModuleName,
            // Non-IM fields
            Atributo = !string.IsNullOrWhiteSpace(_selectedAtributo) ? _selectedAtributo : null,
            Type = _selectedType
        };

        _isSubmitting = true;

        try
        {
            // Funcion vacía para el callback
            Func<ValueTuple<int, int>, Task> emptyHandler = _ => Task.CompletedTask;
            var emptyEventCallback = EventCallback.Factory.Create<ValueTuple<int, int>>(
                receiver: this,
                callback: emptyHandler
            );

            DialogParameters parameters = new DialogParameters
            {
                ["VisualizationType"] = 2,
                ["OnVisualizationCreated"] = emptyEventCallback,
                ["KpiData"] = new KpiResponse
                {
                    Name = request.Name,
                    Description = request.Description,
                    ActualColor = request.DefaultColor,
                    Unit = request.Unit,
                }
            };


            DialogOptions options = new DialogOptions
            {
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.Medium,
                FullWidth = true
            };

            IDialogReference? dialog = await DialogService.ShowAsync<PreviewVisualizationDialog>(
                "Preview",
                parameters,
                options
            );
            DialogResult? dialogResult = await dialog.Result;

            if (!dialogResult.Canceled)
            {
                SubmitKpi();
            }

        }
        catch (Exception ex)
        {
            Snackbar.Add("No se pudo cargar la previsualización: " + ex.Message, Severity.Error);
        }
        
    }

    private Task EmptyVisualizationCreatedCallback((int id, int type) result)
    {
        // Esta función no hace nada, solo satisface la firma.
        // Opcionalmente: Console.WriteLine($"Visualization Created: ID={id}, Type={type}");
        return Task.CompletedTask;
    }

    private async Task SubmitKpi()
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var response = await Http.PostAsJsonAsync($"api/Kpi", request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(Localizer["KpiCreated", _name], Severity.Success);
                _mudDialog.Close(DialogResult.Ok(2));
            }
            else
            {
                string serverMsg;
                try
                {
                    serverMsg = await response.Content.ReadAsStringAsync();
                    if (string.IsNullOrWhiteSpace(serverMsg))
                        serverMsg = response.ReasonPhrase ?? "Unknown server error";
                }
                catch
                {
                    serverMsg = response.ReasonPhrase ?? "Unknown server error";
                }

                _serverError = Localizer["ErrorCreatingKpi", serverMsg];
                Snackbar.Add(_serverError, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _serverError = Localizer["ServerConnectionError", ex.Message];
            Snackbar.Add(_serverError, Severity.Error);
        }
    }

    private class ColorRange
    {
        public decimal Min { get; set; }
        public decimal Max { get; set; }
        public string Color { get; set; } = "#00FF00";
    }
}
