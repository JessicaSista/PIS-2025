@using Microsoft.Extensions.Localization
@using OmniMonitor.Client.Pages
@using OmniMonitor.Shared.Dtos
@using System.Text.Json
@inject IDialogService DialogService
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject IStringLocalizer<Dashboards> Localizer

<MudDialog Style="background-color: var(--fondo-dialog)">
    <DialogContent>
        <MudContainer>
            @{
                if (VisualizationType == 1)
                {
                    if (VisualizationId != 0)
                    {
                        <ChartViewer VisualizationId="VisualizationId" retrieveOnInitialized="@true" OnReady="OnChartReady" />
                    }
                    else
                    {
                        <ChartViewer VisualizationId="0" Visualization="ChartData" retrieveOnInitialized="@true" OnReady="OnChartReady" />
                    }
                }
                else if (VisualizationType == 2)
                {
                    if (VisualizationId != 0)
                    {
                        <KpiViewer KpiId="VisualizationId" IsPreview="@true" OnValueReady="OnKpiReady" />
                    }
                    else
                    {
                        <KpiViewer Kpi="KpiData" IsPreview="true" OnValueReady="OnKpiReady" />
                    }
                }
        }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["CancelButtonText"]</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" OnClick="Submit" Disabled="@(!_canConfirm)">@Localizer["ConfirmButtonText"]</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; }

    [Parameter] public int VisualizationId { get; set; } = 0;

    [Parameter] public int VisualizationType { get; set; } = new();

    [Parameter] public KpiResponse KpiData { get; set; }

    [Parameter] public Visualizacion ChartData { get; set; }

    [Parameter] public EventCallback<(int,int)> OnVisualizationCreated { get; set; }

    private bool _kpiReady = false;

    private bool _chartReady = false;

    private bool _canConfirm => VisualizationType == 1
        ? ChartIsReady
        : _kpiReady;

    private bool KpiIsReady =>
        VisualizationType == 2 &&
        ((VisualizationId != 0 && KpiData?.Value != null && !string.IsNullOrEmpty(KpiData.Value.ToString()) && KpiData.Value.ToString() != "-")
        || (KpiData != null && KpiData.Value != null && !string.IsNullOrEmpty(KpiData.Value.ToString()) && KpiData.Value.ToString() != "-"));

    private bool ChartIsReady => _chartReady;


    private void Cancel()
    {
        MudDialog.Close(DialogResult.Cancel());
    }

    private async Task Submit()
    {
        try
        {
            await OnVisualizationCreated.InvokeAsync(ValueTuple.Create(VisualizationId, VisualizationType));
        }
        catch(Exception e)
        {
            Snackbar.Add($"Error al agregar visualizacion: {e.Message}", Severity.Error);
        }
        finally
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private void OnKpiReady(object? value)
    {
        // Considera el KPI listo si tiene un valor válido
        _kpiReady = value != null && !string.IsNullOrEmpty(value.ToString()) && value.ToString() != "-";
        StateHasChanged();
    }

    private void OnChartReady(bool ready)
    {
        _chartReady = ready;
        StateHasChanged();
    }
}
