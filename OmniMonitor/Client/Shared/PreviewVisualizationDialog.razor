@using OmniMonitor.Shared.Dtos
@using System.Text.Json
@inject IDialogService DialogService
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar

<MudDialog Style="background-color: var(--fondo-dialog)">
    <DialogContent>
        <MudContainer>
            @{
                if (VisualizationType == 1)
                {
                    if (VisualizationId != 0)
                    {
                        <ChartViewer VisualizationId="VisualizationId" retrieveOnInitialized="@true"/>
                    }
                    else
                    {
                        <ChartViewer VisualizationId="0" Visualization="ChartData" retrieveOnInitialized="@true" />
                    }
                }
                else if (VisualizationType == 2)
                {
                    if (VisualizationId != 0)
                    {
                        <KpiViewer KpiId="VisualizationId" />
                    }
                    else
                    {    
                        <KpiViewer Kpi="KpiData" />
                    }
                }
        }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" OnClick="Submit">Confirmar</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; }

    [Parameter] public int VisualizationId { get; set; } = 0;

    [Parameter] public int VisualizationType { get; set; } = new();

    [Parameter] public KpiResponse KpiData { get; set; }

    [Parameter] public Visualizacion ChartData { get; set; }

    [Parameter] public EventCallback<(int,int)> OnVisualizationCreated { get; set; }


    private void Cancel()
    {
        MudDialog.Close(DialogResult.Cancel());
    }

    private async Task Submit()
    {
        try
        {
            await OnVisualizationCreated.InvokeAsync(ValueTuple.Create(VisualizationId, VisualizationType));
        }
        catch(Exception e)
        {
            Snackbar.Add($"Error al agregar visualizacion: {e.Message}", Severity.Error);
        }
        finally
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
    }
}
