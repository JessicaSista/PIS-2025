@using OmniMonitor.Shared.Dtos
@using System.Net.Http.Json
@using Blazored.LocalStorage
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components
@using MudBlazor
@using System.Net

@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ILocalStorageService LocalStorage
@inject IStringLocalizer<CreateVisualizationCard> Localizer
@inject IDialogService DialogService

<MudDialog Style="background-color: var(--fondo-dialog); max-width: 450px">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: var(--text-primary);">
            @Localizer["EditKPI"]
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3">
            @if (!string.IsNullOrEmpty(_serverError))
            {
                <MudAlert Severity="Severity.Error" Elevation="0">@_serverError</MudAlert>
            }

            <MudTextField @bind-Value="_name"
                          Label="@Localizer["Name"]"
                          Variant="Variant.Outlined"
                          Required="true"
                          Style="background: var(--card);" />

            <MudTextField @bind-Value="_description"
                          Label="@Localizer["Description"]"
                          Variant="Variant.Outlined"
                          Lines="2"
                          MaxLength="200"
                          Style="background: var(--card);" />

            <MudColorPicker @bind-Text="_actualColor"
                            Label="@Localizer["Color"]"
                            Variant="Variant.Outlined"
                            DisableAlpha="true"
                            Style="width:220px;" />



        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Cancel"]</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" OnClick="Submit" Disabled="!IsFormValid || _isSubmitting">
            @Localizer["Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance _mudDialog { get; set; }

    [Parameter] public required int KpiId { get; set; } = 0;

    [Parameter] public required KpiResponse ExistingKpi { get; set; }

    private string _name = string.Empty;
    private string _description = string.Empty;
    private string _actualColor = "#FFFFFF";
    private string _initialName = string.Empty;
    private string _initialDescription = string.Empty;
    private string _initialColor = "#FFFFFF";
    private bool _isSubmitting = false;
    private string? _serverError;



    protected override async Task OnInitializedAsync()
    {
        if (KpiId != 0)
        {
            try
            {
                var resp = await Http.GetAsync($"api/KPI/{KpiId}");
                if (resp.IsSuccessStatusCode)
                {
                    var kpi = await resp.Content.ReadFromJsonAsync<KpiResponse>();
                    if (kpi is not null)
                    {
                        ExistingKpi = kpi;
                    }
                    else
                    {
                        _serverError = "No se pudo obtener los datos del KPI";
                    }
                }
                else
                {
                    var err = await resp.Content.ReadAsStringAsync();
                    _serverError = string.IsNullOrWhiteSpace(err) ? $"Error {resp.StatusCode}" : err;
                }
            }
            catch (Exception ex)
            {
                _serverError = ex.Message;
            }
        }

        _name = ExistingKpi.Name ?? string.Empty;
        _description = ExistingKpi.Description ?? string.Empty;
        _actualColor = string.IsNullOrWhiteSpace(ExistingKpi.ActualColor)
            ? "#FFFFFF"
            : ExistingKpi.ActualColor;
        _initialName = _name;
        _initialDescription = _description;
        _initialColor = _actualColor;
    }

    private bool HasChanges =>
        !string.Equals(_name, _initialName, StringComparison.Ordinal) ||
        !string.Equals(_description ?? string.Empty, _initialDescription ?? string.Empty, StringComparison.Ordinal) ||
        !string.Equals(_actualColor, _initialColor, StringComparison.Ordinal);

    private bool IsFormValid => !string.IsNullOrWhiteSpace(_name) && HasChanges;

    private async Task Submit()
    {
        _serverError = null;
        if (!HasChanges)
        {
            Snackbar.Add(Localizer["NoChanges"], Severity.Info);
            return;
        }
        _isSubmitting = true;

        var request = new
        {
            Name = _name.Trim(),
            Description = _description?.Trim(),
            DefaultColor = _actualColor
        };

        try
        {
            // Preview flow before saving
            Func<ValueTuple<int, int>, Task> emptyHandler = _ => Task.CompletedTask;
            var emptyEventCallback = EventCallback.Factory.Create<ValueTuple<int, int>>(
                receiver: this,
                callback: emptyHandler
            );

            var previewKpi = new KpiResponse
            {
                Id = ExistingKpi.Id,
                Name = request.Name,
                Description = request.Description,
                ActualColor = request.DefaultColor,
                Unit = ExistingKpi.Unit,
                Value = ExistingKpi.Value,
            };

            var parameters = new DialogParameters
            {
                ["VisualizationType"] = 2,
                ["OnVisualizationCreated"] = emptyEventCallback,
                ["KpiData"] = previewKpi
            };

            var options = new DialogOptions
            {
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.Medium,
                FullWidth = true
            };

            IDialogReference? dialog = await DialogService.ShowAsync<PreviewVisualizationDialog>(
                "Preview",
                parameters,
                options
            );
            DialogResult? dialogResult = await dialog.Result;

            if (dialogResult.Canceled)
            {
                _isSubmitting = false;
                return;
            }

            
            var url = $"api/KPI/{ExistingKpi.Id}";
            var response = await Http.PatchAsJsonAsync(url, request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(Localizer["KpiUpdatedSuccess"], Severity.Success);
                _mudDialog.Close(DialogResult.Ok(ExistingKpi.Id));
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                if (response.StatusCode == HttpStatusCode.BadRequest &&
                    err.Contains("kpi", StringComparison.OrdinalIgnoreCase) &&
                    err.Contains("nombre", StringComparison.OrdinalIgnoreCase))
                {
                    _serverError = Localizer["KpiNameDuplicate"];
                }
                else
                {
                    _serverError = err;
                }
                Snackbar.Add(_serverError, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _serverError = ex.Message;
            Snackbar.Add(_serverError, Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel() => _mudDialog.Cancel();
}
