            if (string.IsNullOrEmpty(username))
            {
                Snackbar.Add(Localizer["UserNotFound"], Severity.Warning);
                _datasets = new List<DatasetDto>();
                return;
            }

            HttpResponseMessage? response = await Http.GetAsync($"api/DatasetUM/GetAllDatasetsDto?token=" + token);
            if (response.IsSuccessStatusCode)
            {
                List<DatasetDto>? _datasetsFromApi = await response.Content.ReadFromJsonAsync<List<DatasetDto>>();

                _datasets = _datasetsFromApi?.Select(d => new DatasetDto
                {
                    Id = d.Id,
                    Nombre = d.Nombre,
                    Descripcion = d.Descripcion ?? "Sin descripcion"
                }).ToList() ?? new List<DatasetDto>();
            }
            else
            {
                Snackbar.Add(Localizer["ErrorLoadingDatasets", response.StatusCode], Severity.Error);
                _datasets = new List<DatasetDto>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(Localizer["GeneralError", ex.Message], Severity.Error);
            _datasets = new List<DatasetDto>();
        }
        */

        await RestoreDraftAndHandleReturnAsync();
    }
    private void RemoveDataset(DatasetSelection ds)
    {
        var found = _selectedDatasets.FirstOrDefault(x => x.DatasetId == ds.DatasetId && x.Color == ds.Color && x.Multiplier == ds.Multiplier);
        if (found != null)
        {
            _selectedDatasets.Remove(found);
            StateHasChanged();
        }
    }
    public class DatasetSelection
    {
        public int DatasetId { get; set; }
        public System.String DatasetName {get; set;}
        public System.String DatasetType {get; set;}
        public decimal Multiplier { get; set; }
        public string Color { get; set; } = "rgb(0, 255, 231)";
        
    }

    private async Task RestoreDraftAndHandleReturnAsync()
    {
        try
        {
            var returnTo = ReturnTo;
            int? newDatasetId = NewDatasetId;

            if (string.Equals(returnTo, "VisualizationCreate", StringComparison.OrdinalIgnoreCase))
            {
                // Try restore draft
                if (DraftService.TryGet(out var draft))
                {
                    _visualizationName = draft.VisualizationName ?? string.Empty;
                    _selectedChartType = draft.SelectedChartType ?? _selectedChartType;
                    _beginDate = draft.BeginDate;
                    _beginHour = draft.BeginHour;
                    _endDate = draft.EndDate;
                    _endHour = draft.EndHour;

                    _selectedDatasets = draft.SelectedDatasets?.Select(d => new DatasetSelection
                    {
                        DatasetId = d.DatasetId,
                        Multiplier = d.Multiplier,
                        Color = string.IsNullOrWhiteSpace(d.Color) ? "rgb(0, 255, 231)" : d.Color
                    }).ToList() ?? new();

                    StateHasChanged();
                }

                if (newDatasetId.HasValue)
                {
                    if (!_selectedDatasets.Any(sd => sd.DatasetId == newDatasetId.Value))
                    {
                        _selectedDatasets.Add(new DatasetSelection
                        {
                            DatasetId = newDatasetId.Value,
                            Multiplier = 1.0M,
                            Color = "rgb(0, 255, 231)"
                        });
                        Snackbar.Add(Localizer["NewDatasetAdded"], Severity.Success);
                    }
                }

                // Do NOT auto-open AddDatasetModal when returning from dataset creation flow
                // The user just created a dataset and we already attached it above (if provided)
                // Avoid stacking the Add Dataset modal on top of this dialog

                // Clear draft so it doesn't persist unexpectedly
                DraftService.Clear();
            }
        }
        catch
        {
            // swallow restore errors to not block UI
        }
    }

    private System.String getEntityFromDataset(System.Int32 datasetId)
    {
        return "";
    }
}