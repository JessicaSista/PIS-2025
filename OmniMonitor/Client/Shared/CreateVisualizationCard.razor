    private async Task HydrateSelectionsAsync(List<DatasetSelection> selections)
    {
        if (selections == null || selections.Count == 0) return;
        string? token = await LocalStorage.GetItemAsync<string>("authToken");
        foreach (var sel in selections)
        {
            if (!string.IsNullOrWhiteSpace(sel.DatasetName) && !string.IsNullOrWhiteSpace(sel.DatasetType) && !string.IsNullOrWhiteSpace(sel.Entity))
            {
                continue;
            }
            var info = await TryFetchDatasetInfoAsync(sel.DatasetId, token, sel.DatasetType);
            if (info != null)
            {
                sel.DatasetName = info.Value.Name;
                sel.DatasetType = info.Value.Module;
                var entity = await GetEntityFromDatasetAsync(sel.DatasetId, info.Value.Module);
                sel.Entity = entity;
                if (!string.IsNullOrWhiteSpace(entity) && _entityAttributes.TryGetValue(entity, out var attrs) && attrs.Count > 0)
                {
                    sel.EntityAttribute = attrs[0];
                }
            }
        }
    }

    private async Task<DatasetSelection?> HydrateSingleDatasetAsync(int datasetId, string? hintedModule = null)
    {
        string? token = await LocalStorage.GetItemAsync<string>("authToken");
        var info = await TryFetchDatasetInfoAsync(datasetId, token, hintedModule);
        if (info == null)
        {
            return null;
        }
        var module = info.Value.Module;
        var entity = await GetEntityFromDatasetAsync(datasetId, module);
        string? entityAttr = null;
        if (!string.IsNullOrWhiteSpace(entity) && _entityAttributes.TryGetValue(entity, out var attrs) && attrs.Count > 0)
        {
            entityAttr = attrs[0];
        }
        return new DatasetSelection
        {
            DatasetId = datasetId,
            DatasetName = info.Value.Name,
            DatasetType = module,
            Entity = entity,
            EntityAttribute = entityAttr ?? selDefault(entity),
            Multiplier = 1.0M,
            Color = "rgb(0, 255, 231)"
        };

        static string? selDefault(string e)
        {
            return null;
        }
    }

    private async Task<(string Name, string Module)?> TryFetchDatasetInfoAsync(int datasetId, string? token, string? hintedModule = null)
    {
        try
        {
            // 1) Resolve module: use hinted module if provided, else detect
            string? module = hintedModule;
            if (string.IsNullOrWhiteSpace(module))
            {
                var moduleResp = await Http.GetAsync($"api/Dataset/GetDatasetModule?datasetId={datasetId}&token={Uri.EscapeDataString(token ?? string.Empty)}");
                if (!moduleResp.IsSuccessStatusCode)
                {
                    return null;
                }
                module = (await moduleResp.Content.ReadAsStringAsync())?.Trim('"');
                if (string.IsNullOrWhiteSpace(module)) return null;
            }

            // 2) Fetch dataset by module to get its display name (minimal, aligned to backend DTOs)
            if (string.Equals(module, "Insight Monitor", StringComparison.OrdinalIgnoreCase))
            {
                var resp = await Http.GetAsync($"api/Dataset/GetDataset?datasetId={datasetId}&token={Uri.EscapeDataString(token ?? string.Empty)}");
                if (resp.IsSuccessStatusCode)
                {
                    var dto = await resp.Content.ReadFromJsonAsync<DatasetIM>();
                    if (dto != null && !string.IsNullOrWhiteSpace(dto.Name))
                        return (Name: dto.Name, Module: module);
                }
            }
            else if (string.Equals(module, "Asset Manager", StringComparison.OrdinalIgnoreCase))
            {
                var resp = await Http.GetAsync($"api/DatasetAM/GetDatasetAMById?id={datasetId}&token={Uri.EscapeDataString(token ?? string.Empty)}");
                if (resp.IsSuccessStatusCode)
                {
                    var dto = await resp.Content.ReadFromJsonAsync<DatasetAM>();
                    if (dto != null && !string.IsNullOrWhiteSpace(dto.Nombre))
                        return (Name: dto.Nombre, Module: module);
                }
            }
            else if (string.Equals(module, "Urban Monitor", StringComparison.OrdinalIgnoreCase))
            {
                var resp = await Http.GetAsync($"api/DatasetUM/GetDatasetById?datasetId={datasetId}&token={Uri.EscapeDataString(token ?? string.Empty)}");
                if (resp.IsSuccessStatusCode)
                {
                    var dto = await resp.Content.ReadFromJsonAsync<DatasetUM>();
                    if (dto != null && !string.IsNullOrWhiteSpace(dto.Name))
                        return (Name: dto.Name, Module: module);
                }
            }
            else if (string.Equals(module, "Event Manager", StringComparison.OrdinalIgnoreCase))
            {
                var resp = await Http.GetAsync($"api/DatasetEM/{datasetId}?token={Uri.EscapeDataString(token ?? string.Empty)}");
                if (resp.IsSuccessStatusCode)
                {
                    var dto = await resp.Content.ReadFromJsonAsync<DatasetEM>();
                    if (dto != null && !string.IsNullOrWhiteSpace(dto.Name))
                        return (Name: dto.Name, Module: module);
                }
            }

            return (Name: $"Dataset {datasetId}", Module: module);
        }
        catch
        {
            return null;
        }
    }

    private async Task<string> GetEntityFromDatasetAsync(System.Int32 datasetId, System.String module)
    {
        try
        {
            AuthenticationState? authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            string? username = authState.User.Identity?.Name;
            string? token = await LocalStorage.GetItemAsync<string>("authToken");

            if (string.IsNullOrEmpty(username))
            {
                Snackbar.Add(Localizer["UserNotFound"], Severity.Warning);
                throw new InvalidOperationException("No se encontró el usuario autenticado.");
            }

            if(module.Equals("Insight Monitor"))
            {
                HttpResponseMessage? response = await Http.GetAsync($"/api/Dataset/GetDataset?datasetId={datasetId}&token={token}");
                DatasetIM? datasetFromApi = await response.Content.ReadFromJsonAsync<DatasetIM>();

                if (datasetFromApi == null)
                    throw new NullReferenceException("La respuesta del servidor fue vacía.");
                return datasetFromApi.ContentType == "0" ? "Sensor" : "Device";
            }
            else if(module.Equals("Asset Manager"))
            {
                HttpResponseMessage? response = await Http.GetAsync($"api/DatasetAM/GetDatasetAmById?id={datasetId}&token={token}");
                DatasetAM? datasetFromApi = await response.Content.ReadFromJsonAsync<DatasetAM>();

                if (datasetFromApi == null)
                    throw new NullReferenceException("La respuesta del servidor fue vacía.");

                return datasetFromApi.Type_Dataset == 2 ? "Asset" : "EventAM";
            }
            else if(module.Equals("Urban Monitor"))
            {
                HttpResponseMessage? response = await Http.GetAsync($"api/DatasetUM/GetDatasetById?datasetId={datasetId}&token={token}");
                DatasetUM? datasetFromApi = await response.Content.ReadFromJsonAsync<DatasetUM>();

                if (datasetFromApi == null)
                    throw new NullReferenceException("La respuesta del servidor fue vacía.");

                //una solucion fea para saber el tipo, pero funciona... :thumbsup
                return datasetFromApi.DatasetNews.Count > 0 ? "New" : "EventUM";
            }
            else
            {
                HttpResponseMessage? response = await Http.GetAsync($"api/DatasetEM/{datasetId}?token={token}");
                DatasetEM? datasetFromApi = await response.Content.ReadFromJsonAsync<DatasetEM>();

                if (datasetFromApi == null)
                    throw new NullReferenceException("La respuesta del servidor fue vacía.");
                
                List<System.String> Types = datasetFromApi.ContentType.Split(',').Select(s => s.Trim()).ToList();
                if(Types.Contains("Extensions"))
                {
                    return "Extension";
                }
                else if(Types.Contains("Alerts")){
                    return "Alert";
                }
                else
                {
                    return "EventEM";
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            return string.Empty;
        }
    }

}