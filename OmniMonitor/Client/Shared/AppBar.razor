@using MudBlazor
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider


<div class="appbar-container">
    <MudAppBar Elevation="3">
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" OnClick="ToggleDrawer" />
            </Authorized>
        </AuthorizeView>
        <MudNavLink OnClick="@(() => Navigation.NavigateTo("/dashboards"))" Class="logo-link">
            <div class="logo-container">
                <MudImage Src="LogoSonda.jpg" Alt="LogoS" Style="width:40px; height:40px;" Class="rounded-lg logo-image" />
                <MudText Typo="Typo.h6" Class="logo-text">OmniMonitor</MudText>
            </div>
        </MudNavLink>

        <MudSpacer />
        
        <MudIconButton Icon="@(IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" 
                        OnClick="ToggleTheme" 
                        Title="@($"Cambiar a modo {(IsDarkMode ? "claro" : "oscuro")}")"
                        Class="theme-toggle" />
        
        <MudMenu Direction="Direction.Left" OffsetX="true" Dense="true">
            <ActivatorContent>
                <MudButton Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowDropDown" Class="language-selector">
                    ES
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem>
                    <MudText>Español</MudText>
                </MudMenuItem>
                <MudMenuItem>
                    <MudText>English</MudText>
                </MudMenuItem>
            </ChildContent>
        </MudMenu> 
      
       <LanguageSelector />

        <AuthorizeView>
            <Authorized>
                <MudMenu Direction="Direction.Left" OffsetX="true" Dense="true">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Text" Class="user-selector">
                            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Class="icon-account" />
                            <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Class="icon-arrow" />
                        </MudButton>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem OnClick="Logout">
                            <MudIcon Icon="@Icons.Material.Filled.Login" Class="mr-2" />
                            <span>Cerrar Sesion</span>
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
        </AuthorizeView>

    </MudAppBar>
</div>

@code {
    [Parameter] public EventCallback ToggleDrawer { get; set; }
    [Parameter] public bool IsDarkMode { get; set; }
    [Parameter] public EventCallback ToggleTheme { get; set; }

    private async Task Logout()
    {   
        var apiAuthStateProvider = (Auth.ApiAuthenticationStateProvider)AuthStateProvider;
        await apiAuthStateProvider.NotifyUserLogout();
        Navigation.NavigateTo("/login");
    }
}