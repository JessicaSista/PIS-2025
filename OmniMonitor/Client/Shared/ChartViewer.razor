    @using ApexCharts
@using MudBlazor.Extensions
@using OmniMonitor.Shared.Dtos
@using System.Text.Json
@using Blazored.LocalStorage
@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject HttpClient Http
@inject IStringLocalizer<ChartViewer> Localizer
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject OmniMonitor.Client.Services.SignalR.TelemetryHubClient TelemetryHubClient




<MudItem Style="background-color: transparent; display:flex; flex-direction:column; height: 100%">


    <MudCardHeader>
        <CardHeaderAvatar>
            @if (ShowIcon)
            {
                <MudPaper Square="true" Class="pa-2" Style="background-color: #1d283a !important; color: #f4f8fd; border-radius: 2px">
                    <MudIcon Icon="@GetIcon(_chartType)" />
                </MudPaper>
            }
            else
            {
                <div style="width: 0px;"></div>
            }
        </CardHeaderAvatar>
        <CardHeaderContent>
            @if (ShowTitle)
            {
                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.h6" Style="color: var(--card-t+ext-primary)">@_title</MudText>
                    @if (LiveOn && visualization != null && visualization.LiveEnabled)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Color="MudBlazor.Color.Error" Size="MudBlazor.Size.Small" />
                    }
                </MudStack>
            }
        </CardHeaderContent>

        <CardHeaderActions>
            @if (showCustomizationIcon)
            {
                <MudMenu Icon="@Icons.Material.Filled.MoreVert">
                    <MudMenuItem OnClick="@(() => OpenEditVisualizationDialog())">
                        <MudText Typo="Typo.body2">@Localizer["Edit"]</MudText>
                    </MudMenuItem>
                    <MudMenuItem OnClick="@(() => DeleteVisualization())">
                        <MudText Typo="Typo.body2" Color=@MudBlazor.Color.Error>@Localizer["Delete"]</MudText>
                    </MudMenuItem>
                </MudMenu>
            }
            @if (_connState == OmniMonitor.Client.Services.SignalR.ConnectionState.Reconnecting)
            {
                <MudChip T="string" Color="MudBlazor.Color.Warning" Variant="Variant.Outlined" Size="MudBlazor.Size.Small">Reconnecting…</MudChip>
            }
            else if (_connState == OmniMonitor.Client.Services.SignalR.ConnectionState.Disconnected && _liveJoined)
            {
                <MudChip T="string" Color="MudBlazor.Color.Error" Variant="Variant.Outlined" Size="MudBlazor.Size.Small">Disconnected</MudChip>
            }
        </CardHeaderActions>

    </MudCardHeader>

    <MudCardContent Class="pl-7 pr-8"
                    Style="color: var(--card-text-secondary); height: 100%">
        @if (_dataRetrieved)
        {
            @if (_seriesData.Any())
            {
                <ApexChart @key="_chartKey" TItem="ChartPoint" Height="270" Options="@ChartOptions">
                    @if (_isTimeSeries)
                    {
                        @foreach (DatasetSeries serie in _seriesData)
                        {
                            <ApexPointSeries TItem="ChartPoint"
                                             Items="serie.Points"
                                             Name="@serie.DatasetName"
                                             SeriesType="@_seriesType"
                                             XValue="@(p => p.T)"
                                             YValue="@(p => (decimal)p.Y)"
                                             Color="@serie.Color" />
                        }
                    }
                    else
                    {
                        @foreach (DatasetSeries serie in _seriesData)
                        {
                            <ApexPointSeries TItem="ChartPoint"
                                             Items="serie.Points"
                                             Name="@serie.DatasetName"
                                             SeriesType="@_seriesType"
                                             XValue="@(p => p.X)"
                                             YValue="@(p => (decimal)p.Y)"
                                             Color="@serie.Color" />
                        }
                    }
                </ApexChart>
            }
            else
            {
                <MudText>@Localizer["NoDataFound"]</MudText>
            }
        }
        else
        {
            <MudContainer Class="d-flex justify-center align-center" Style="min-height: 270px">
                <MudButton Disabled="@_retrievingData" OnClick="RetrieveData" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.CloudDownload" Style="color: var(--card-text-secondary)">
                    @if (_retrievingData)
                    {
                        <MudProgressCircular Class="ms-n1" Size="MudBlazor.Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">@Localizer["Loading"].</MudText>
                    }
                    else
                    {
                        <MudText>@Localizer["LoadData"]</MudText>
                    }
                </MudButton>
            </MudContainer>
        }
    </MudCardContent>


    <MudCardActions Class="d-block">
        @if (ShowDatasetsInfo)
        {
            <MudText Typo="Typo.body2">Datasets: @_datasetNames.</MudText>
        }
        @if (ShowLastUpdatedInfo)
        {

        }
    </MudCardActions>

</MudItem>

@code {

    //Parametros
    [Parameter] public int VisualizationId { get; set; }
    [Parameter] public bool LiveOn { get; set; } = false;

    // Para recargar la gráfica desde el exterior
    [Parameter]
    public int ChartReloadKey
    {
        get => _chartKey;
        set
        {
            if (_chartKey != value)
            {
                _chartKey = value;
                StateHasChanged();
            }
        }
    }

    [Parameter] public bool ShowTitle { get; set; } = true;
    [Parameter] public bool ShowIcon { get; set; } = false;
    [Parameter] public bool ShowDatasetsInfo { get; set; } = false;
    [Parameter] public bool ShowLastUpdatedInfo { get; set; } = false;
    [Parameter] public bool retrieveOnInitialized { get; set; } = true;
    [Parameter] public bool showCustomizationIcon { get; set; } = false;
    [Parameter] public EventCallback<System.Int32> OnDeleted { get; set; }
    [Parameter] public Visualizacion visualization { get; set; } = null;


    private bool _dataRetrieved = false;
    private bool _retrievingData = false;
    private string _authenticatedUser = string.Empty;
    private int _chartKey = 0; //cuando se modifica esta variable, la grafica se re-renderiza

    private System.String _title { get; set; } = string.Empty;
    private System.String _datasetNames { get; set; } = string.Empty;

    // Chart Variables
    private SeriesType _seriesType = SeriesType.Line;
    private List<DatasetSeries> _seriesData = new();
    private string _chartType { get; set; } = "line";
    private List<object> _dataCharts { get; set; } = new();
    private ApexChart<ChartPoint>? _apexChart;
    private bool _isTimeSeries = false;
    private readonly ApexChartOptions<ChartPoint> _timeChartOptions = new()
    {
        Xaxis = new XAxis
        {
            TickAmount = 4,
            Labels = new XAxisLabels
            {
                Rotate = -35,
                Style = new AxisLabelStyle
                {
                    FontSize = "8px"
                },
            }
        }
    };
    private readonly ApexChartOptions<ChartPoint> _categoryChartOptions = new()
    {
        Xaxis = new XAxis
        {
            TickAmount = 4,
            Labels = new XAxisLabels
            {
                Rotate = -35,
                Style = new AxisLabelStyle
                {
                    FontSize = "8px"
                },
            }
        }
    };
    private ApexChartOptions<ChartPoint> ChartOptions => _isTimeSeries ? _timeChartOptions : _categoryChartOptions;

    protected override async Task OnInitializedAsync()
    {
        await DownloadVisualization();
        await SetupLiveAsync();
    }

    private bool _liveJoined = false;
    private OmniMonitor.Client.Services.SignalR.ConnectionState _connState = OmniMonitor.Client.Services.SignalR.ConnectionState.Connected;
    private long _seq = 0;
    private System.DateTime _lastUpdatedAt = default;

    protected override async Task OnParametersSetAsync()
    {
        if (visualization == null)
        {
            return;
        }
        if (LiveOn && visualization.LiveEnabled)
        {
            if (!_liveJoined)
            {
                try
                {
                    TelemetryHubClient.ConnectionStateChanged += OnConnStateChanged;
                    TelemetryHubClient.TelemetryReceived += OnTelemetryPoint;
                    await TelemetryHubClient.JoinVisualizationAsync(VisualizationId);
                    _liveJoined = true;
                }
                catch { }
            }
        }
        else
        {
            if (_liveJoined)
            {
                try { await TelemetryHubClient.LeaveVisualizationAsync(VisualizationId); } catch { }
                TelemetryHubClient.TelemetryReceived -= OnTelemetryPoint;
                TelemetryHubClient.ConnectionStateChanged -= OnConnStateChanged;
                _liveJoined = false;
            }
        }
    }

    private async Task SetupLiveAsync()
    {
        if (visualization != null && visualization.LiveEnabled && LiveOn)
        {
            TelemetryHubClient.ConnectionStateChanged += OnConnStateChanged;
            TelemetryHubClient.TelemetryReceived += OnTelemetryPoint;
            await TelemetryHubClient.JoinVisualizationAsync(VisualizationId);
            _liveJoined = true;
        }
    }

    private void OnTelemetryPoint(OmniMonitor.Client.Services.SignalR.TelemetryPointMessage msg)
    {
        if (visualization == null) return;
        if (msg.VisualizationId != VisualizationId) return;
        _isTimeSeries = true;

        var gd = visualization.GrupoDatasets.FirstOrDefault(g => g.DatasetId == msg.DatasetId);
        if (gd == null) return;

        decimal multiplier = 1;
        string color = "#00FFE7";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(gd.JsonDesign);
            var root = doc.RootElement;
            if (root.TryGetProperty("Multiplier", out var multProp) && multProp.ValueKind == System.Text.Json.JsonValueKind.Number)
            {
                multiplier = multProp.GetDecimal();
            }
            if (root.TryGetProperty("Color", out var colorProp) && colorProp.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                color = colorProp.GetString() ?? color;
            }
        }
        catch { }

        decimal y = 0;
        if (msg.Value.HasValue)
        {
            y = (decimal)msg.Value.Value;
        }
        else if (!string.IsNullOrWhiteSpace(msg.Raw))
        {
            if (!decimal.TryParse(msg.Raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out y))
            {
                if (string.Equals(msg.Raw, "True", StringComparison.OrdinalIgnoreCase)) y = 1; else y = 0;
            }
        }
        y *= multiplier;

        string datasetName = gd.Dataset?.NameDataset ?? "Dataset";
        string x = msg.Time.ToString("dd/MM/yyyy HH:mm:ss");

        var serie = _seriesData.FirstOrDefault(s => s.DatasetName == datasetName);
        if (serie == null)
        {
            serie = new DatasetSeries { DatasetName = datasetName, Color = color };
            _seriesData.Add(serie);
        }

        int existingIdx = -1;
        for (int i = serie.Points.Count - 1; i >= 0; i--)
        {
            if (serie.Points[i].X == x)
            {
                existingIdx = i;
                break;
            }
        }

        if (existingIdx >= 0)
        {
            var existing = serie.Points[existingIdx];
            if (existing.Y == y)
            {
                return;
            }
            serie.Points[existingIdx] = new ChartPoint { X = x, Y = y, Seq = ++_seq, T = msg.Time };
        }
        else
        {
            serie.Points.Add(new ChartPoint { X = x, Y = y, Seq = ++_seq, T = msg.Time });
        }

        SortSeriesByTime(serie);
        TrimSeriesToWindow();

        _lastUpdatedAt = System.DateTime.Now;

        _seriesData = _seriesData
            .Select(s => new DatasetSeries { DatasetName = s.DatasetName, Color = s.Color, Points = s.Points.ToList() })
            .ToList();

        _chartKey++;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnConnStateChanged(OmniMonitor.Client.Services.SignalR.ConnectionState state)
    {
        _connState = state;
        _ = InvokeAsync(StateHasChanged);
    }

    private void TrimSeriesToWindow()
    {
        try
        {
            if (visualization == null) return;
            System.TimeSpan span = visualization.FechaHasta - visualization.FechaDesde;
            if (span.TotalSeconds <= 0) return;
            System.DateTime thresholdLocal = System.DateTime.Now - span;
            foreach (var s in _seriesData)
            {
                s.Points.RemoveAll(p => p.T != default && p.T < thresholdLocal);
                const int MaxPoints = 1500;
                if (s.Points.Count > MaxPoints)
                {
                    int toRemove = s.Points.Count - MaxPoints;
                    s.Points.RemoveRange(0, System.Math.Min(toRemove, s.Points.Count));
                }
            }
        }
        catch { }
    }

    private static void SortSeriesByTime(DatasetSeries serie)
    {
        try
        {
            serie.Points = serie.Points
                .OrderBy(p => p.T != default ? p.T : System.DateTime.MinValue)
                .ThenBy(p => p.Seq)
                .ToList();
        }
        catch { }
    }

    private async Task DownloadVisualization()
    {
        try
        {
            if (visualization == null)
            {
                HttpResponseMessage? response = await Http.GetAsync($"api/Visualizacion/GetVisualizacionById?idVisualizacion={VisualizationId}");

                if (response.IsSuccessStatusCode)
                {
                    Visualizacion? cardVisualization = await response.Content.ReadFromJsonAsync<Visualizacion>();
                    visualization = cardVisualization;
                }
            }
            _title = visualization.Nombre;

            JsonDocument design = JsonDocument.Parse(visualization.JsonDesign);
            _chartType = design.RootElement.GetProperty("ChartType").ToString();
            _seriesType = MapSeriesType(_chartType);

            _datasetNames = string.Join(", ", visualization.GrupoDatasets.Select(gd => gd.Dataset.NameDataset));
            if (retrieveOnInitialized)
            {
                await RetrieveData();
            }
        }
        catch (Exception ex)
        {
        }
    }

    private async Task RetrieveData()
    {
        _seriesData = new List<DatasetSeries>();
        _dataRetrieved = false;
        _retrievingData = true;
        StateHasChanged();
        _isTimeSeries = false;
        var allData = new List<object>();
        try
        {
            DateTime dateFrom = visualization.FechaDesde;
            DateTime dateTo = visualization.FechaHasta;

            List<(System.String, System.String, decimal, List<VisualizationValue>)> tmpDataDatasets = new();

            foreach (var grupoDataset in visualization.GrupoDatasets)
            {
                try
                {
                    decimal multiplier = 1;
                    string color = "#00FFE7";
                    string attribute = String.Empty;
                    string module = String.Empty;
                    string entity = String.Empty;
                    string displayName = String.Empty;
                    int idInModule = 0;

                    if (!string.IsNullOrEmpty(grupoDataset.JsonDesign))
                    {
                        JsonDocument? designDoc = JsonDocument.Parse(grupoDataset.JsonDesign);
                        if (designDoc.RootElement.TryGetProperty("IdInModule", out var idProp))
                        {
                            idInModule = idProp.GetInt32();
                        }
                        if (designDoc.RootElement.TryGetProperty("Multiplier", out var multProp))
                        {
                            multiplier = multProp.GetDecimal();
                        }
                        if (designDoc.RootElement.TryGetProperty("Color", out var colorProp))
                        {
                            color = colorProp.GetString() ?? "#00FFE7";
                        }
                        if (designDoc.RootElement.TryGetProperty("EntityAttribute", out var attributeProp))
                        {
                            attribute = attributeProp.GetString();
                        }
                        if (designDoc.RootElement.TryGetProperty("Module", out var moduleProp))
                        {
                            module = moduleProp.GetString();
                        }
                        if (designDoc.RootElement.TryGetProperty("Entity", out var entityProp))
                        {
                            entity = entityProp.GetString();
                        }
                        if (designDoc.RootElement.TryGetProperty("DisplayName", out var displayNameProp))
                        {
                            displayName = displayNameProp.GetString();
                        }
                    }
                    if (module.Equals("Insight Monitor") && attribute.Equals("SensorData"))
                    {
                        HttpResponseMessage? datasetResponse = await Http.GetAsync($"api/Dataset/GetDataset?datasetId={idInModule}");

                        if (datasetResponse.IsSuccessStatusCode)
                        {
                            DatasetIM? dataset = await datasetResponse.Content.ReadFromJsonAsync<DatasetIM>();

                            if (dataset != null)
                            {
                                if (dataset.DatasetDevices.Any())
                                {
                                    foreach (var datasetDevice in dataset.DatasetDevices)
                                    {
                                        try
                                        {
                                            var sensorDataResponse = await Http.GetAsync(
                                                $"api/SondaMain/sensors/data?deviceId={datasetDevice.Id_device}&sensorName={dataset.SensorName}&dateFrom={dateFrom.ToString("o", new CultureInfo("en-US"))}&dateTo={dateTo.ToString("o", new CultureInfo("en-US"))}"
                                            );

                                            if (sensorDataResponse.IsSuccessStatusCode)
                                            {
                                                var sensorData = await sensorDataResponse.Content.ReadFromJsonAsync<List<SensorData>>();

                                                if (sensorData != null && sensorData.Any())
                                                {
                                                    foreach (var data in sensorData)
                                                    {
                                                        decimal numericValue;

                                                        if (Decimal.TryParse(data.Data, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal parsedDecimal))
                                                        {
                                                            numericValue = parsedDecimal;
                                                        }
                                                        else
                                                        {
                                                            numericValue = data.Data.Equals("True", StringComparison.OrdinalIgnoreCase) ? 1 : 0;
                                                        }

                                                        allData.Add(new
                                                        {
                                                            Timestamp = data.Time,
                                                            Value = numericValue * multiplier,
                                                            Color = color,
                                                            DatasetName = grupoDataset.Dataset.NameDataset,
                                                            SensorName = dataset.SensorName,
                                                            DeviceId = datasetDevice.Id_device
                                                        });
                                                    }
                                                }
                                            }
                                        }
                                        catch (Exception ex)
                                        {
                                        }
                                    }
                                }
                                else
                                {
                                }
                            }
                        }
                        _seriesData = BuildSeriesFromData(allData);
                        _isTimeSeries = true;
                    }
                    else
                    {
                        VisualizationRequest? req = new VisualizationRequest
                        {
                            moduleType = (ModuleType)Enum.Parse(typeof(ModuleType), module.Replace(" ", "")),
                            entity = (EntityName)Enum.Parse(typeof(EntityName), entity),
                            column = attribute,
                            datasetId = idInModule,
                            dateFrom = dateFrom,
                            dateTo = dateTo
                        };
                        HttpResponseMessage? result = await Http.PostAsJsonAsync($"api/Visualizacion/visualization-data", req);
                        VisualizationResponse? visualizationResponse = await result.Content.ReadFromJsonAsync<VisualizationResponse>();
                        if (visualizationResponse.Type.Equals("unknown", StringComparison.OrdinalIgnoreCase))
                        {
                            continue;
                        }
                        tmpDataDatasets.Add((displayName, color, multiplier, visualizationResponse.Values));
                    }
                }
                catch (Exception ex)
                {
                }
            }
            if (tmpDataDatasets.Any())
            {
                // dominio de la funcion a graficar
                List<System.String> domain = new List<System.String>();
                foreach (var (_, _, _, dataList) in tmpDataDatasets)
                {
                    foreach (var data in dataList)
                    {
                        if (!domain.Contains(data.Name))
                        {
                            domain.Add(data.Name);
                        }
                    }
                }

                // diccionario para manejo mas eficiente
                List<Dictionary<System.String, System.Int32>> countValuesDatasets = tmpDataDatasets
                .Select(tuple => tuple.Item4.ToDictionary(v => v.Name, v => v.Value))
                .ToList();

                // creacion de la funcion final a graficar
                for (System.Int32 index = 0; index < tmpDataDatasets.Count; index++)
                {
                    _seriesData.Add(new DatasetSeries
                    {
                        DatasetName = tmpDataDatasets[index].Item1,
                        Color = tmpDataDatasets[index].Item2,
                        Points = domain.Select(point => new ChartPoint
                        {
                            X = point,
                            Y = countValuesDatasets[index].ContainsKey(point) ? countValuesDatasets[index][point] * tmpDataDatasets[index].Item3 : 0
                        })
                        .ToList()
                    });
                }
            }

            _retrievingData = false;
            _dataRetrieved = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
        }
    }


    private SeriesType MapSeriesType(string type)
    {
        return type switch
        {
            "line" => SeriesType.Line,
            "bar" => SeriesType.Bar,
            "area" => SeriesType.Area,
            "pie" => SeriesType.Pie,
            "donut" => SeriesType.Donut,
            "radar" => SeriesType.Radar,
            "heatMap" => SeriesType.Heatmap,
            "radialBar" => SeriesType.RadialBar,
        };
    }

    private List<DatasetSeries> BuildSeriesFromData(List<object> data)
    {
        var grouped = new Dictionary<string, DatasetSeries>();

        foreach (var item in data)
        {
            try
            {
                System.String json = JsonSerializer.Serialize(item);
                using JsonDocument? doc = JsonDocument.Parse(json);
                JsonElement root = doc.RootElement;

                System.String datasetName = root.TryGetProperty("DatasetName", out var dnProp)
                    ? dnProp.GetString() ?? "SinNombre"
                    : "SinNombre";

                System.String color = root.TryGetProperty("Color", out var colorProp)
                    ? colorProp.GetString() ?? "#00FFE7"
                    : "#00FFE7";

                System.DateTime? tdt = root.TryGetProperty("Timestamp", out var tProp)
                    ? tProp.GetDateTime()
                    : (System.DateTime?)null;
                System.String? timestamp = tdt.HasValue ? tdt.Value.ToString("dd/MM/yyyy HH:mm") : null;

                double value = 0;
                if (root.TryGetProperty("Value", out var vProp))
                {
                    double.TryParse(vProp.ToString(), out value);
                }

                if (!grouped.ContainsKey(datasetName))
                {
                    grouped[datasetName] = new DatasetSeries
                    {
                        DatasetName = datasetName,
                        Color = color
                    };
                }

                grouped[datasetName].Points.Add(new ChartPoint
                {
                    X = timestamp ?? DateTime.Now.ToString("HH:mm"),
                    Y = (decimal)value,
                    Seq = ++_seq,
                    T = (tdt ?? DateTime.Now)
                });
            }
            catch (Exception ex)
            {
            }
        }

        return grouped.Values.ToList();
    }

    private string GetIcon(string chartType)
    {
        return chartType switch
        {
            "line" => Icons.Material.Filled.ShowChart,
            "bar" => Icons.Material.Filled.BarChart,
            "area" => Icons.Material.Filled.AreaChart,
            "pie" => Icons.Material.Filled.PieChart,
            "donut" => Icons.Material.Filled.DonutLarge,
            "radialBar" => Icons.Material.Filled.DonutSmall,
            "scatter" => Icons.Material.Filled.BubbleChart,
            "heatMap" => Icons.Material.Filled.GridOn,
            "radar" => Icons.Material.Filled.Radar,
            "bubble" => Icons.Material.Filled.BubbleChart,
            "candlestick" => Icons.Material.Filled.CandlestickChart,
            "boxPlot" => Icons.Material.Filled.Analytics,
            "treemap" => Icons.Material.Filled.AccountTree,
            _ => Icons.Material.Filled.InsertChart
        };
    }

    private async Task OpenEditVisualizationDialog()
    {
        DialogOptions? options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium };
        DialogParameters parameters = new DialogParameters { ["currVisualization"] = visualization, };
        IDialogReference? dialog = await DialogService.ShowAsync<EditVisualizationDialog>("Editar Visualización", parameters, options);
        DialogResult? result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            visualization = null;
            await DownloadVisualization();
            await RetrieveData();
            StateHasChanged();
            _chartKey++;
            Snackbar.Add("Visualización actualizada", Severity.Success);
        }
    }

    private async Task DeleteVisualization()
    {
        try
        {
            HttpResponseMessage? response = await Http.DeleteAsync($"api/Visualizacion/{VisualizationId}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Visualizacion eliminada", Severity.Success);
                await OnDeleted.InvokeAsync(visualization == null ? VisualizationId : visualization.IdVisualizacion);
            }
            else
            {
                Snackbar.Add("No se pudo eliminar la visualizacion", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error inesperado", Severity.Error);
        }
    }

    public class DatasetSeries
    {
        public System.String DatasetName { get; set; } = String.Empty;
        public System.String Color { get; set; } = "#00FFE7";
        public List<ChartPoint> Points { get; set; } = new();
    }

    public class ChartPoint
    {
        public System.String X { get; set; } = string.Empty;
        public decimal Y { get; set; }
        public System.DateTime T { get; set; }
        public long Seq { get; set; }
    }

    public async ValueTask DisposeAsync()
    {
        try { await TelemetryHubClient.LeaveVisualizationAsync(VisualizationId); } catch { }
        TelemetryHubClient.TelemetryReceived -= OnTelemetryPoint;
        TelemetryHubClient.ConnectionStateChanged -= OnConnStateChanged;
        _liveJoined = false;
    }

}
