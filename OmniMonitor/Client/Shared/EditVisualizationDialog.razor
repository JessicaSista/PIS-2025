@using OmniMonitor.Shared.Dtos
@using OmniMonitor.Client.Services
@using System.Text.Json;
@using Microsoft.Extensions.Localization;
@using Blazored.LocalStorage;
@using Microsoft.AspNetCore.Components;
@using System.Globalization

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HttpClient Http
@inject IDialogService DialogService
@inject ILocalStorageService LocalStorage
@inject ISnackbar Snackbar
@inject IStringLocalizer<CreateVisualizationCard> Localizer

<MudDialog Style="background-color: var(--fondo-dialog)">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: var(--text-primary);">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mb-n1" />
            Editar Visualización
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @foreach (DatasetSelection dsItem in _selectedDatasets)
            {
                <MudGrid Class="ml-0 mt-0 pa-5" Style="width: 100%; background-color: var(--card); border-radius: 3px; " Spacing="3">
                    <MudItem Lg="2" Sm="2" Xs="12" Class="pl-0 pt-0">
                        <MudText Typo="Typo.body2" Style="color: var(--text-primary)">@Localizer["Dataset"]</MudText>
                        <MudText Typo="Typo.body1">@dsItem.Dataset.Nombre</MudText>
                    </MudItem>

                    <MudItem Lg="3" Sm="3" Xs="12" Class="pt-0">
                        <MudText Typo="Typo.body2" Style="color: var(--text-primary)">Nombre a mostrar</MudText>
                        <MudTextField @bind-Value="dsItem.DisplayName" Variant="Variant.Outlined" Dense="true">@dsItem.DisplayName</MudTextField>
                    </MudItem>

                    <MudItem Lg="2" Sm="2" Xs="12" Class="pt-0">
                        <MudText Typo="Typo.body2" Style="color: var(--text-primary)">Atributo</MudText>
                        <MudSelect T="System.String" @bind-Value="dsItem.EntityAttribute" Variant="Variant.Outlined" Dense="true">
                            @foreach (System.String attr in _entityAttributes[dsItem.Entity])
                            {
                                <MudSelectItem T="System.String" Value="attr">
                                    @attr
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>


                    <MudItem Lg="2" Sm="2" Xs="5" Class="pt-0">
                        <MudText Typo="Typo.body2" Style="color: var(--text-primary)">@Localizer["Multiplier"]</MudText>
                        <MudNumericField HideSpinButtons="true"
                                         Immediate="true"
                                         @bind-Value="dsItem.Multiplier"
                                         Variant="Variant.Outlined"
                                         Culture="@(new CultureInfo("en-US"))"
                                         Step=".2M"
                                         Validation="@((decimal m) => m == 0 ? "No puede ser 0" : null)" />
                    </MudItem>

                    <MudItem Lg="2" Sm="2" Xs="5" Class="pt-0">
                        <MudText Typo="Typo.body2" Style="color: var(--text-primary)">@Localizer["Color"]</MudText>
                        <MudColorPicker @bind-Text="dsItem.Color" Style="@($"color: {dsItem.Color};")" Placeholder="Seleccionar color" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem Lg="1" Sm="1" Xs="2" Class="d-flex align-items-center">
                        <MudButton OnClick="@(() => RemoveDataset(dsItem))">
                            <MudIcon Icon="@Icons.Material.Filled.Close"
                                     Color="MudBlazor.Color.Error" />
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudStack>
        <MudGrid Class="mt-0 mb-5">
            <MudItem lg="12" xs="12">
                <MudButton OnClick="OpenAddDatasetModal"
                           FullWidth="true"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.AddCircleOutline"
                           Color="MudBlazor.Color.Inherit"
                           Size="MudBlazor.Size.Large"
                           Style="padding: 20px 10px; color: var(--text-primary); background: var(--card); border: 3px solid var(--borde-drawer)"
                           Disabled="false">
                    @Localizer["AddDataset"]
                </MudButton>
            </MudItem>

            <MudButton OnClick="OpenSelectDashboardLinkModal"
                       FullWidth="true"
                       Variant="@(_selectedDashboard != null ? Variant.Filled : Variant.Outlined)"
                       StartIcon="@(_selectedDashboard != null ? Icons.Material.Filled.Check : Icons.Material.Filled.AddLink)"
                       Color="MudBlazor.Color.Inherit"
                       Size="MudBlazor.Size.Large"
                       Style="padding: 20px 10px; color: var(--text-primary); background: var(--card); border: 3px solid var(--borde-drawer)"
                       Disabled="false">

                @if (_selectedDashboard != null)
                {
                    <MudText Typo="Typo.body1">@($"{Localizer["DashboardLinked"]} {_selectedDashboard.Nombre}, {Localizer["ClickForSelectOther"]}")</MudText>
                }
                else
                {
                    @Localizer["AddDashboard"]
                }
            </MudButton>
        </MudGrid>

        <MudText Typo="Typo.h6" Style="color: var(--text-primary);">@Localizer["VisualisationName"]</MudText>
        <MudTextField Class="mb-2" @bind-Value="_visualizationName" T="string"
                      Label="@Localizer["Name"]"
                      Variant="Variant.Outlined"
                      Required="true"
                      RequiredError="@Localizer["NameRequired"]"
                      Style="background: var(--card);" />

        <MudText Typo="Typo.h6" Style="color: var(--text-primary);">@Localizer["ChartType"]</MudText>
        <MudSelect T="string"
                   @bind-Value="_selectedChartType"
                   Variant="Variant.Outlined"
                   Margin="Margin.Normal"
                   Dense="true"
                   Style="background: var(--card);">
            @foreach (var tipo in _chartTypes)
            {
                <MudSelectItem T="string" Value="@tipo">@tipo</MudSelectItem>
            }
        </MudSelect>

        <MudDivider DividerType="DividerType.Middle" Class="mt-5 mb-10" />

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle1" Style="color: var(--text-primary);">@Localizer["From"]</MudText>
                <MudGrid>
                    <MudItem xs="6">
                        <MudDatePicker Label="@Localizer["Date"]" @bind-Date="_beginDate" DateFormat="dd/MM/yyyy" Required="true" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTimePicker Label="@Localizer["Time"]" @bind-Time="_beginHour" Required="true" />
                    </MudItem>
                </MudGrid>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle1" Style="color: var(--text-primary);">@Localizer["To"]</MudText>
                <MudGrid>
                    <MudItem xs="6">
                        <MudDatePicker Label="@Localizer["Date"]" @bind-Date="_endDate" DateFormat="dd/MM/yyyy" Required="true" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTimePicker Label="@Localizer["Time"]" @bind-Time="_endHour" Required="true" />
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Cancel"]</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" OnClick="Submit">@Localizer["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public required IMudDialogInstance _mudDialog { get; set; }

    [Parameter]
    public string? ReturnTo { get; set; }

    [Parameter]
    public bool restore { get; set; } = false;

    [Parameter]
    public int? NewDatasetId { get; set; }

    [Parameter]
    public string? NewDatasetModule { get; set; }

    [Parameter]
    public System.Int32 visualizationId { get; set; }

    [Parameter]
    public Visualizacion currVisualization { get; set; } = null;

    [Parameter]
    public System.Int32 dashboardId { get; set; } = -1; //caso en el que se edita desde visualizaciones

    private List<string> _chartTypes = new List<string>() { "line", "bar", "area", "pie", "donut", "heatMap", "radar", "radialBar" };
    private string _selectedChartType = "line";
    private DateTime? _beginDate { get; set; }
    private TimeSpan? _beginHour { get; set; }
    private DateTime? _endDate { get; set; }
    private TimeSpan? _endHour { get; set; }
    private string _visualizationName { get; set; } = string.Empty;
    private DashboardSummaryResponse _selectedDashboard { get; set; } = null;
    private List<DatasetSelection> _selectedDatasets = new List<DatasetSelection>();
    private Dictionary<System.String, List<System.String>> _entityAttributes = new Dictionary<System.String, List<System.String>>
    {
        { "Device", new List<string> { "LayerId", "IsActive", "SectorId", "TenantId"} },
        { "Source", new List<string> { "Name", "Type", "TimeTolerance", "TimeRange", "IsActive", "TenantId", "NoDataAlert", "NoDataSleepByDevice", "NoDataInterval", "OutputId"} },
        { "Group", new List<string> { "IsActive", "State", "TenantId" } },
        { "Sensor", new List<string> { "DisplayName", "Type", "Integration", "LastUpdate", "LastPersisted"} },
        { "Zone", new List<string> { "Name", "Reference" } },
        { "EventUM", new List<string> { "Date", "Type", "ApprovalState", "ReviewedAt" } },
        { "New", new List<string> { "DatePublished", "Important", "StartDate", "EndDate" } },
        { "EventAM", new List<string> { "undefined"} },
        { "Stock", new List<string> { "Location", "BundleId" } },
        { "Asset", new List<string> { "CreatedAt", "BundleId" } },
        { "Alert", new List<string> { "AlertState", "CreatedAt" } },
        { "EventEM", new List<string> { "Origin", "CreationDate", "State" } },
        { "Extension", new List<string> { "ExtensionState", "TakenByUsername", "CreatedAt", "Dangerous"} },
        { "Categoria", new List<string> { "Name", "Priority", "Protocol", "CategoryState", "Selected" } }
    };


    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (currVisualization == null)
            {
                AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                string? username = authState.User.Identity?.Name;
                string token = await LocalStorage.GetItemAsync<string>("authToken");

                if (string.IsNullOrEmpty(username))
                {
                    Snackbar.Add("No se pudo obtener el usuario actual", Severity.Warning);
                    return;
                }

                HttpResponseMessage? responseVisualization = await Http.GetAsync(
                    $"api/Visualizacion/GetVisualizacionById?idVisualizacion={visualizationId}&token={token}"
                );

                currVisualization = await responseVisualization.Content.ReadFromJsonAsync<Visualizacion>();
            }
            string _visualizationLink = currVisualization.Link;
            try
            {
                HttpResponseMessage? response = await Http.GetAsync($"api/Dashboard/GetDashboard?id={_visualizationLink}");
                DashboardResponse? dashboardData = await response.Content.ReadFromJsonAsync<DashboardResponse>();
                _selectedDashboard = new DashboardSummaryResponse { Nombre = dashboardData.Nombre, IdDashboard = dashboardData.IdDashboard };
            }
            catch (Exception ex)
            {
                Snackbar.Add("ErrorFetchingDashboard", Severity.Error);
                return;
            }


            visualizationId = currVisualization.IdVisualizacion;
            _visualizationName = currVisualization.Nombre;
            _beginDate = currVisualization.FechaDesde.Date;
            _beginHour = currVisualization.FechaDesde.TimeOfDay;
            _endDate = currVisualization.FechaHasta.Date;
            _endHour = currVisualization.FechaHasta.TimeOfDay;

            JsonDocument design = JsonDocument.Parse(currVisualization.JsonDesign);
            _selectedChartType = design.RootElement.GetProperty("ChartType").ToString();

            try
            {
                foreach (var grupoDataset in currVisualization.GrupoDatasets)
                {
                    JsonElement root = JsonDocument.Parse(grupoDataset.JsonDesign).RootElement;

                    decimal multiplier = root.GetProperty("Multiplier").GetDecimal();
                    System.String color = root.GetProperty("Color").GetString();
                    System.String datasetEntity = root.GetProperty("Entity").GetString();
                    System.String selectedAttribute = root.GetProperty("EntityAttribute").GetString();
                    System.String displayName = root.GetProperty("DisplayName").GetString();
                    System.String module = root.GetProperty("Module").GetString();
                    System.Int32 IdInModule = root.GetProperty("IdInModule").GetInt32();

                    _selectedDatasets.Add(new DatasetSelection
                    {
                        Dataset = new DatasetDtoGenerico
                        {
                            Id = IdInModule,
                            IdGenerico = grupoDataset.DatasetId,
                            Nombre = grupoDataset.Dataset.NameDataset,
                            Module = module
                        },
                        DisplayName = displayName,
                        Entity = datasetEntity,
                        EntityAttribute = selectedAttribute,
                        Multiplier = multiplier,
                        Color = color
                    });
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error fetching properties of datasets: {ex.Message}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error cargando visualización: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenAddDatasetModal()
    {
        var parameters = new DialogParameters
        {
            { "OnDatasetSelected", EventCallback.Factory.Create<DatasetDtoGenerico>(this, HandleDatasetSelected) },
            { "OnNewDataset", EventCallback.Factory.Create(this, HandleNewDataset) }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<AddDatasetModal>(Localizer["AddDataset"], parameters, options);
    }

    private async Task OpenSelectDashboardLinkModal()
    {
        var parameters = new DialogParameters
        {
            { "OnDashboardSelected", EventCallback.Factory.Create<DashboardSummaryResponse>(this, HandleDashboardSelected) }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<SelectDashboardLink>(Localizer["AddDashboard"], parameters, options);
    }

    private async Task HandleNewDataset()
    {
        DialogOptions? options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        IDialogReference? dialog = DialogService.Show<CreateDatasetDialog>("Crear nuevo dataset", options);
        DialogResult? result = await dialog.Result;

        if (!result.Canceled && result.Data != null)
        {
            if (result.Data is DatasetDtoGenerico newDataset)
            {
                await HandleDatasetSelected(newDataset);
            }
        }
    }

    private async Task HandleDatasetSelected(DatasetDtoGenerico dataset)
    {
        if (_selectedDatasets.Any(sd => sd.Dataset.IdGenerico == dataset.IdGenerico))
        {
            Snackbar.Add(Localizer["DatasetAlreadyAdded"], Severity.Warning);
            return;
        }
        System.String entity = await GetEntityFromDatasetAsync(dataset.Id, dataset.Module);
        _selectedDatasets.Add(new DatasetSelection
        {
            Dataset = dataset,
            Entity = entity,
            EntityAttribute = _entityAttributes[entity][0],
            Multiplier = 1,
            Color = "rgb(0, 255, 231)"
        });
        Snackbar.Add(Localizer["DatasetAdded"], Severity.Info);
        StateHasChanged();
        return;
    }

    private async Task HandleDashboardSelected(DashboardSummaryResponse dashboard)
    {
        _selectedDashboard = dashboard;
        Snackbar.Add(Localizer["DashboardLinkAdded"], Severity.Info);
        StateHasChanged();
        return;
    }

    private bool ValidateSubmission()
    {
        if (string.IsNullOrWhiteSpace(_visualizationName))
        {
            Snackbar.Add("El nombre de la visualización es obligatorio.", Severity.Warning);
            return false;
        }

        if (!_selectedDatasets.Any())
        {
            Snackbar.Add("Debe seleccionar al menos un dataset.", Severity.Warning);
            return false;
        }

        if (_selectedDatasets.Any(ds => ds.Multiplier == 0))
        {
            Snackbar.Add("El multiplicador de un dataset no puede ser 0.", Severity.Warning);
            return false;
        }

        if (_beginDate == null || _beginHour == null || _endDate == null || _endHour == null)
        {
            Snackbar.Add("Debe especificar una fecha y hora de inicio y fin.", Severity.Warning);
            return false;
        }

        DateTime fullBeginDateTime = _beginDate.Value.Date + _beginHour.Value;
        DateTime fullEndDateTime = _endDate.Value.Date + _endHour.Value;

        if (fullEndDateTime <= fullBeginDateTime)
        {
            Snackbar.Add("La fecha 'Hasta' debe ser posterior a la fecha 'Desde'.", Severity.Warning);
            return false;
        }

        return true;
    }

    private async Task Submit()
    {
        if (!ValidateSubmission())
        {
            return;
        }

        try
        {
            AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            string? username = authState.User.Identity?.Name;

            if (string.IsNullOrEmpty(username))
            {
                Snackbar.Add("No se pudo obtener el usuario actual", Severity.Error);
                return;
            }

            CreateVisualizacionRequest request = new CreateVisualizacionRequest
            {
                Nombre = _visualizationName,
                JsonDiseñoGeneral = "{ \"ChartType\": \"" + _selectedChartType + "\" }",
                Link = _selectedDashboard == null ? null : _selectedDashboard.IdDashboard.ToString(),
                Datasets = _selectedDatasets.Select(ds => new DatasetConfig
                {
                    DatasetId = ds.Dataset.IdGenerico,
                    JsonDiseño = JsonSerializer.Serialize(new Dictionary<string, object>
                    {
                        {"IdInModule", ds.Dataset.Id},
                        { "Multiplier", (double)ds.Multiplier },
                        { "Color", ds.Color },
                        { "Module", ds.Dataset.Module},
                        { "Entity", ds.Entity},
                        { "EntityAttribute", ds.EntityAttribute },
                        { "DisplayName", System.String.IsNullOrEmpty(ds.DisplayName) ? ds.Dataset.Nombre : ds.DisplayName }
                    })
                }).ToList(),
                FechaDesde = _beginDate.Value.Date + _beginHour.Value,
                FechaHasta = _endDate.Value.Date + _endHour.Value
            };
            if (dashboardId == -1)
            {
                HttpResponseMessage? response = await Http.PutAsJsonAsync($"api/Visualizacion/{visualizationId}", request);
                if (!response.IsSuccessStatusCode)
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Error al editar la visualización: {error}", Severity.Error);
                }
                else
                {
                    _mudDialog.Close(DialogResult.Ok(1));
                }
            }
            
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al editar la visualización: {ex.Message}", Severity.Error);
        }
        StateHasChanged();
    }

    private void Cancel() => _mudDialog.Cancel();

    private void RemoveDataset(DatasetSelection item)
    {
        _selectedDatasets.Remove(item);
    }

    private async Task<string> GetEntityFromDatasetAsync(System.Int32 datasetId, System.String module)
    {
        try
        {
            AuthenticationState? authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            string? username = authState.User.Identity?.Name;

            if (string.IsNullOrEmpty(username))
            {
                Snackbar.Add(Localizer["UserNotFound"], Severity.Warning);
                throw new InvalidOperationException("No se encontró el usuario autenticado.");
            }

            if (module.Equals("Insight Monitor"))
            {
                HttpResponseMessage? response = await Http.GetAsync($"/api/Dataset/GetDataset?datasetId={datasetId}");
                DatasetIM? datasetFromApi = await response.Content.ReadFromJsonAsync<DatasetIM>();

                if (datasetFromApi == null)
                    throw new NullReferenceException("La respuesta del servidor fue vacía.");
                return datasetFromApi.ContentType == "0" ? "Sensor" : "Device";
            }
            else if (module.Equals("Asset Manager"))
            {
                HttpResponseMessage? response = await Http.GetAsync($"api/DatasetAM/GetDatasetAmById?id={datasetId}");
                DatasetAM? datasetFromApi = await response.Content.ReadFromJsonAsync<DatasetAM>();

                if (datasetFromApi == null)
                    throw new NullReferenceException("La respuesta del servidor fue vacía.");

                return datasetFromApi.Type_Dataset == 2 ? "Asset" : "EventAM";
            }
            else if (module.Equals("Urban Monitor"))
            {
                HttpResponseMessage? response = await Http.GetAsync($"api/DatasetUM/GetDatasetById?datasetId={datasetId}");
                DatasetUM? datasetFromApi = await response.Content.ReadFromJsonAsync<DatasetUM>();

                if (datasetFromApi == null)
                    throw new NullReferenceException("La respuesta del servidor fue vacía.");

                return datasetFromApi.DatasetNews.Count > 0 ? "New" : "EventUM";
            }
            else
            {
                HttpResponseMessage? response = await Http.GetAsync($"api/DatasetEM/{datasetId}");
                DatasetEM? datasetFromApi = await response.Content.ReadFromJsonAsync<DatasetEM>();

                if (datasetFromApi == null)
                    throw new NullReferenceException("La respuesta del servidor fue vacía.");

                List<System.String> Types = datasetFromApi.ContentType.Split(',').Select(s => s.Trim()).ToList();
                if (Types.Contains("Extensions"))
                {
                    return "Extension";
                }
                else if (Types.Contains("Alerts"))
                {
                    return "Alert";
                }
                else
                {
                    return "EventEM";
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            return string.Empty;
        }
    }

}