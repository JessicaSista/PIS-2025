@using OmniMonitor.Shared.Dtos
@using OmniMonitor.Client.Services
@using System.Text.Json;
@using Microsoft.Extensions.Localization;
@using Blazored.LocalStorage;
@using Microsoft.AspNetCore.Components;
@using System.Globalization

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HttpClient Http
@inject IDialogService DialogService
@inject ILocalStorageService LocalStorage
@inject ISnackbar Snackbar
@inject IStringLocalizer<CreateVisualizationCard> Localizer

<MudDialog Style="background-color: var(--fondo-dialog)">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: var(--text-primary);">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mb-n1" />
            Editar Visualización
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @foreach (DatasetSelection dsItem in _selectedDatasets)
            {
                <MudGrid Class="ml-0 mt-0 pa-5" Style="width: 100%; background-color: var(--card); border-radius: 3px; " Spacing="3">
                    <MudItem Lg="2" Sm="2" Xs="12" Class="pl-0 pt-0">
                        <MudText Typo="Typo.body2" Style="color: var(--text-primary)">@Localizer["Dataset"]</MudText>
                        <MudText Typo="Typo.body1">@dsItem.Dataset.Nombre</MudText>
                    </MudItem>

                    <MudItem Lg="3" Sm="3" Xs="12" Class="pt-0">
                        <MudText Typo="Typo.body2" Style="color: var(--text-primary)">Nombre a mostrar</MudText>
                        <MudTextField Value="dsItem.DisplayName"
                                      ValueChanged="@(EventCallback.Factory.Create<string>(this,v => OnDatasetFieldChanged(dsItem, nameof(dsItem.DisplayName), v)))"
                                      Variant="Variant.Outlined"
                                      Dense="true" />
                    </MudItem>

                    <MudItem Lg="2" Sm="2" Xs="12" Class="pt-0">
                        <MudText Typo="Typo.body2" Style="color: var(--text-primary)">Atributo</MudText>
                        <MudSelect T="System.String"
                                   Value="dsItem.EntityAttribute"
                                   ValueChanged="@(v => OnDatasetFieldChanged(dsItem, nameof(dsItem.EntityAttribute), v))"
                                   Variant="Variant.Outlined"
                                   Dense="true">
                            @foreach (System.String attr in _entityAttributes[dsItem.Entity])
                            {
                                <MudSelectItem T="System.String" Value="attr">
                                    @attr
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>


                    <MudItem Lg="2" Sm="2" Xs="5" Class="pt-0">
                        <MudText Typo="Typo.body2" Style="color: var(--text-primary)">@Localizer["Multiplier"]</MudText>
                        <MudNumericField HideSpinButtons="true"
                                         Immediate="true"
                                         Value="dsItem.Multiplier"
                                         ValueChanged="@(EventCallback.Factory.Create<decimal>(this, v => OnDatasetFieldChanged(dsItem, nameof(dsItem.Multiplier), v)))"
                                         Variant="Variant.Outlined"
                                         Culture="@(new CultureInfo("en-US"))"
                                         Step=".2M"
                                         Validation="@((decimal m) => m == 0 ? "No puede ser 0" : null)" />
                    </MudItem>

                    <MudItem Lg="2" Sm="2" Xs="5" Class="pt-0">
                        <MudText Typo="Typo.body2" Style="color: var(--text-primary)">@Localizer["Color"]</MudText>
                        <MudColorPicker Text="dsItem.Color"
                                        TextChanged="@(v => OnDatasetFieldChanged(dsItem, nameof(dsItem.Color), v))"
                                        Style="@($"color: {dsItem.Color};")"
                                        Placeholder="Seleccionar color"
                                        Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem Lg="1" Sm="1" Xs="2" Class="d-flex align-items-center">
                        <MudButton OnClick="@(() => RemoveDataset(dsItem))">
                            <MudIcon Icon="@Icons.Material.Filled.Close"
                                     Color="MudBlazor.Color.Error" />
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudStack>
        <MudGrid Class="mt-0 mb-5">
            <MudItem lg="12" xs="12">
                <MudButton OnClick="OpenAddDatasetModal"
                           FullWidth="true"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.AddCircleOutline"
                           Color="MudBlazor.Color.Inherit"
                           Size="MudBlazor.Size.Large"
                           Style="padding: 20px 10px; color: var(--text-primary); background: var(--card); border: 3px solid var(--borde-drawer)"
                           Disabled="false">
                    @Localizer["AddDataset"]
                </MudButton>

                <MudButton OnClick="OpenSelectDashboardLinkModal"
                           FullWidth="true"
                           Variant="@(_selectedDashboard != null ? Variant.Filled : Variant.Outlined)"
                           StartIcon="@(_selectedDashboard != null ? Icons.Material.Filled.Link : Icons.Material.Filled.AddLink)"
                           Color="MudBlazor.Color.Inherit"
                           Size="MudBlazor.Size.Large"
                           Style="padding: 20px 10px; color: var(--text-primary); background: var(--card); border: 3px solid var(--borde-drawer)"
                           Disabled="false">

                    @if (_selectedDashboard != null)
                    {
                        <MudText Typo="Typo.body1">@($"{Localizer["DashboardLinked"]} {_selectedDashboard.Nombre}")</MudText>
                    }
                    else
                    {
                        @Localizer["AddDashboard"]
                    }
                </MudButton>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.h6" Style="color: var(--text-primary);">@Localizer["VisualisationName"]</MudText>
        <MudTextField Class="mb-2" @bind-Value="_visualizationName" T="string"
                      Label="@Localizer["Name"]"
                      Variant="Variant.Outlined"
                      Required="true"
                      RequiredError="@Localizer["NameRequired"]"
                      Style="background: var(--card);" />

        <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.body2" Class="mr-2">@Localizer["Live"]</MudText>
            <MudSwitch T="bool" Value="@_liveEnabled" ValueChanged="OnLiveSwitchChanged" Color="MudBlazor.Color.Primary" Dense="true" Disabled="@(!_liveAllowedVis)" />
        </MudStack>

        <MudText Typo="Typo.h6" Style="color: var(--text-primary);">@Localizer["ChartType"]</MudText>
        <MudSelect T="string"
                   @bind-Value="_selectedChartType"
                   Variant="Variant.Outlined"
                   Margin="Margin.Normal"
                   Dense="true"
                   Style="background: var(--card);">
            @foreach (var tipo in _chartTypes)
            {
                <MudSelectItem T="string" Value="@tipo">@tipo</MudSelectItem>
            }
        </MudSelect>

        <MudDivider DividerType="DividerType.Middle" Class="mt-5 mb-10" />

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle1" Style="color: var(--text-primary);">@Localizer["From"]</MudText>
                <MudGrid>
                    <MudItem xs="6">
                        <MudDatePicker Label="@Localizer["Date"]" @bind-Date="_beginDate" DateFormat="dd/MM/yyyy" Required="true" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTimePicker Label="@Localizer["Time"]" @bind-Time="_beginHour" Required="true" />
                    </MudItem>
                </MudGrid>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle1" Style="color: var(--text-primary);">@Localizer["To"]</MudText>
                <MudGrid>
                    <MudItem xs="6">
                        <MudDatePicker Label="@Localizer["Date"]" @bind-Date="_endDate" DateFormat="dd/MM/yyyy" Required="true" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTimePicker Label="@Localizer["Time"]" @bind-Time="_endHour" Required="true" />
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Cancel"]</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" OnClick="Submit" Disabled="!HasChanges()">
            @Localizer["Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public required IMudDialogInstance _mudDialog { get; set; }

    [Parameter]
    public string? ReturnTo { get; set; }

    [Parameter]
    public bool restore { get; set; } = false;

    [Parameter]
    public int? NewDatasetId { get; set; }

    [Parameter]
    public string? NewDatasetModule { get; set; }

    [Parameter]
    public System.Int32 visualizationId { get; set; }

    [Parameter]
    public Visualizacion currVisualization { get; set; } = null;

    [Parameter]
    public System.Int32 dashboardId { get; set; } = -1; //caso en el que se edita desde visualizaciones

    private List<string> _chartTypes = new List<string>() { "line", "bar", "area", "pie", "donut", "heatMap", "radialBar" };
    private string _selectedChartType = "bar";
    private DateTime? _beginDate { get; set; }
    private TimeSpan? _beginHour { get; set; }
    private DateTime? _endDate { get; set; }
    private TimeSpan? _endHour { get; set; }
    private string _visualizationName { get; set; } = string.Empty;
    private DashboardSummaryResponse _selectedDashboard { get; set; } = null;
    private bool _liveEnabled = false;
    private bool _liveAllowedVis = false;
    private List<DatasetSelection> _selectedDatasets = new List<DatasetSelection>();
    private Dictionary<string, List<string>> _entityAttributes = new Dictionary<string, List<string>>
    {
        { "Device", new List<string> { "Name", "Source",  "LayerId", "IsActive", "SectorId", "ConnectionString", "TenantId", "LastDataReceived",} },
        { "Source", new List<string> { "Name", "Type", "TimeTolerance", "TimeRange", "Icon", "IsActive", "TenantId", "NoDataAlert", "NoDataSleepByDevice", "NoDataInterval", "OutputId"} },
        { "Sensor", new List<string> { "Name", "DisplayName", "Type", "Integration", "LastUpdate", "LastValue", "LastPersisted"} },
        { "SensorData", new List<string> { "SensorData",} },
        { "Group", new List<string> { "IsActive", "State", "TenantId" } },

        { "Zone", new List<string> { "Name", "Reference" } },
        { "EventUM", new List<string> { "Name", "Date", "Type", "Location", "ApprovalState", "ReviewedAt" } },
        { "New", new List<string> { "Title", "DatePublished", "Important", "StartDate", "EndDate", "Zone" } },

        { "EventAM", new List<string> { "EventTaskDto", "StartDate", "State", "Subject", "FinalizedDate", "TakenOn", "TakenBy", "AlertTime", "EndingReason", "Critical" } },
        { "Stock", new List<string> { "Name", "Quantity", "Provider", "Location", "Sku", "Minimum", "Bundle", "Supervisor", "UpdatedQuantity" } },
        { "Asset", new List<string> { "Name", "CreatedAt", "ExternalId", "Code", "Address", "Reference", "LifeTimeToDate", "TypeDto", "BundleDto", "BrandDto", "StateDto", "ModelDto", "ResponsibleDto", "ProviderDto", "Device", "DeliveredTo" } },

        { "Alert", new List<string> { "AlertName", "SourceId", "Location", "SourceAddress", "AlertState", "AlertCategory", "AlertData", "CreatedAt", "ModifiedAt", "DeviceType", "StreamUrl", "FileExtension", } },
        { "EventEM", new List<string> { "Name", "Origin", "CreationDate", "LastModification", "SourceType", "State", "Address", "Location", } },
        { "Extension", new List<string> { "ExtensionState", "TakenByUsername", "TakenByName", "TakenByLastName", "EventDateTime",  "CreatedAt", "LastModification", "WorkZoneId", "WorkZoneName", "EventId", "EventName", "ExtensionSource", "Address", "Location", "Location", "Dangerous"} },
        { "Categoria", new List<string> { "Name", "Priority", "Protocol", "CategoryState", "Selected" } }
    };


    private bool IsSingleSeriesChart =>
        _selectedChartType == "pie" ||
        _selectedChartType == "donut" ||
        _selectedChartType == "radialBar";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (currVisualization == null)
            {
                AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                string? username = authState.User.Identity?.Name;
                string token = await LocalStorage.GetItemAsync<string>("authToken");

                if (string.IsNullOrEmpty(username))
                {
                    Snackbar.Add("No se pudo obtener el usuario actual", Severity.Warning);
                    return;
                }

                HttpResponseMessage? responseVisualization = await Http.GetAsync(
                    $"api/Visualizacion/GetVisualizacionById?idVisualizacion={visualizationId}&token={token}"
                );

                currVisualization = await responseVisualization.Content.ReadFromJsonAsync<Visualizacion>();
            }

            visualizationId = currVisualization.IdVisualizacion;
            _visualizationName = currVisualization.Nombre;
            _beginDate = currVisualization.FechaDesde.Date;
            _beginHour = currVisualization.FechaDesde.TimeOfDay;
            _endDate = currVisualization.FechaHasta.Date;
            _endHour = currVisualization.FechaHasta.TimeOfDay;

            JsonDocument design = JsonDocument.Parse(currVisualization.JsonDesign);
            _selectedChartType = design.RootElement.GetProperty("ChartType").ToString();
            if (currVisualization.Link != null)
            {
                string[] dataDashboard = currVisualization.Link.Split(",");
                _selectedDashboard = currVisualization.Link != null ? new DashboardSummaryResponse { IdDashboard = int.Parse(dataDashboard[0]), Nombre = dataDashboard[1] } : null;
            }
            try
            {
                foreach (var grupoDataset in currVisualization.GrupoDatasets)
                {
                    JsonElement root = JsonDocument.Parse(grupoDataset.JsonDesign).RootElement;

                    decimal multiplier = root.GetProperty("Multiplier").GetDecimal();
                    string color = root.GetProperty("Color").GetString();
                    string datasetEntity = root.GetProperty("Entity").GetString();
                    string selectedAttribute = root.GetProperty("EntityAttribute").GetString();
                    string displayName = root.GetProperty("DisplayName").GetString();
                    string module = root.GetProperty("Module").GetString();
                    int IdInModule = root.GetProperty("IdInModule").GetInt32();

                    _selectedDatasets.Add(new DatasetSelection
                    {
                        Dataset = new DatasetDtoGenerico
                        {
                            Id = IdInModule,
                            IdGenerico = grupoDataset.DatasetId,
                            Nombre = grupoDataset.Dataset.NameDataset,
                            Module = module
                        },
                        DisplayName = displayName,
                        Entity = datasetEntity,
                        EntityAttribute = selectedAttribute,
                        Multiplier = multiplier,
                        Color = color
                    });
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error fetching properties of datasets: {ex.Message}", Severity.Error);
            }
            _liveEnabled = currVisualization.LiveEnabled;
            RecomputeLiveAllowed();

            // Backup valores originales para comparación
            BackupOriginalValues();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error cargando visualización: {ex.Message}", Severity.Error);
        }
    }

    private void OnDatasetFieldChanged(DatasetSelection ds, string property, object value)
    {
        switch (property)
        {
            case nameof(ds.DisplayName): ds.DisplayName = value?.ToString(); break;
            case nameof(ds.EntityAttribute): ds.EntityAttribute = value?.ToString(); break;
            case nameof(ds.Multiplier): ds.Multiplier = value is decimal dec ? dec : Convert.ToDecimal(value); break;
            case nameof(ds.Color): ds.Color = value?.ToString(); break;
        }
        StateHasChanged();
    }

    private async Task OpenAddDatasetModal()
    {
        if (IsSingleSeriesChart && _selectedDatasets.Count >= 1)
        {
            Snackbar.Add(Localizer["ChartTypeLimitReached"] + " " + _selectedChartType, Severity.Warning);
            return;
        }
        var parameters = new DialogParameters
        {
            { "OnDatasetSelected", EventCallback.Factory.Create<DatasetDtoGenerico>(this, HandleDatasetSelected) },
            { "OnNewDataset", EventCallback.Factory.Create(this, HandleNewDataset) },
            { "ExcludedIds", _selectedDatasets.Select(ds => ds.Dataset.IdGenerico).ToHashSet() } 
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<AddDatasetModal>(Localizer["AddDataset"], parameters, options);
    }

    private async Task OpenSelectDashboardLinkModal()
    {
        var parameters = new DialogParameters
        {
            { "OnDashboardSelected", EventCallback.Factory.Create<DashboardSummaryResponse>(this, HandleDashboardSelected) },
            {"selectedDashboard", _selectedDashboard },
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<SelectDashboardLink>(Localizer["AddDashboard"], parameters, options);
    }

    private async Task HandleNewDataset()
    {
        DialogOptions? options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        IDialogReference? dialog = DialogService.Show<CreateDatasetDialog>(String.Empty, options);
        DialogResult? result = await dialog.Result;

        if (!result.Canceled && result.Data != null)
        {
            if (result.Data is DatasetDtoGenerico newDataset)
            {
                await HandleDatasetSelected(newDataset);
            }
        }
    }

    private async Task HandleDatasetSelected(DatasetDtoGenerico dataset)
    {
        if (_selectedDatasets.Any(sd => sd.Dataset.IdGenerico == dataset.IdGenerico))
        {
            Snackbar.Add(Localizer["DatasetAlreadyAdded"], Severity.Warning);
            return;
        }
        System.String entity = await GetEntityFromDatasetAsync(dataset.Id, dataset.Module);
        _selectedDatasets.Add(new DatasetSelection
        {
            Dataset = dataset,
            Entity = entity,
            EntityAttribute = _entityAttributes[entity][0],
            Multiplier = 1,
            Color = "rgb(0, 255, 231)"
        });
        Snackbar.Add(Localizer["DatasetAdded"], Severity.Info);
        RecomputeLiveAllowed();
        StateHasChanged();
        return;
    }

    private async Task HandleDashboardSelected(DashboardSummaryResponse dashboard)
    {
        _selectedDashboard = dashboard;
        string msg = dashboard != null ? Localizer["DashboardLinkAdded"] : Localizer["DashboardLinkRemoved"];
        Snackbar.Add(msg, Severity.Info);
        StateHasChanged();
        return;
    }

    private bool ValidateSubmission()
    {
        if (string.IsNullOrWhiteSpace(_visualizationName))
        {
            Snackbar.Add("El nombre de la visualización es obligatorio.", Severity.Warning);
            return false;
        }

        if (!_selectedDatasets.Any())
        {
            Snackbar.Add("Debe seleccionar al menos un dataset.", Severity.Warning);
            return false;
        }

        if (_selectedDatasets.Any(ds => ds.Multiplier == 0))
        {
            Snackbar.Add("El multiplicador de un dataset no puede ser 0.", Severity.Warning);
            return false;
        }

        if (_beginDate == null || _beginHour == null || _endDate == null || _endHour == null)
        {
            Snackbar.Add("Debe especificar una fecha y hora de inicio y fin.", Severity.Warning);
            return false;
        }

        DateTime fullBeginDateTime = _beginDate.Value.Date + _beginHour.Value;
        DateTime fullEndDateTime = _endDate.Value.Date + _endHour.Value;

        if (fullEndDateTime <= fullBeginDateTime)
        {
            Snackbar.Add("La fecha 'Hasta' debe ser posterior a la fecha 'Desde'.", Severity.Warning);
            return false;
        }
        if (IsSingleSeriesChart && _selectedDatasets.Count > 1)
        {
            Snackbar.Add(Localizer["ChartTypeLimitReached"] + " " + _selectedChartType, Severity.Warning);
            return false;
        }

        return true;
    }

    private async Task Submit()
    {
        if (!ValidateSubmission())
        {
            return;
        }

        try
        {
            AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            string? username = authState.User.Identity?.Name;

            if (string.IsNullOrEmpty(username))
            {
                Snackbar.Add("No se pudo obtener el usuario actual", Severity.Error);
                return;
            }

            CreateVisualizacionRequest request = new CreateVisualizacionRequest
            {
                Nombre = _visualizationName,
                JsonDiseñoGeneral = "{ \"ChartType\": \"" + _selectedChartType + "\" }",
                Link = _selectedDashboard == null ? null : $" {_selectedDashboard.IdDashboard},{_selectedDashboard.Nombre}",
                Datasets = _selectedDatasets.Select(ds => new DatasetConfig
                {
                    DatasetId = ds.Dataset.IdGenerico,
                    JsonDiseño = JsonSerializer.Serialize(new Dictionary<string, object>
                    {
                        {"IdInModule", ds.Dataset.Id},
                        { "Multiplier", (double)ds.Multiplier },
                        { "Color", ds.Color },
                        { "Module", ds.Dataset.Module},
                        { "Entity", ds.Entity},
                        { "EntityAttribute", ds.EntityAttribute },
                        { "DisplayName", System.String.IsNullOrEmpty(ds.DisplayName) ? ds.Dataset.Nombre : ds.DisplayName }
                    })
                }).ToList(),
                FechaDesde = _beginDate.Value.Date + _beginHour.Value,
                FechaHasta = _endDate.Value.Date + _endHour.Value,
                LiveEnabled = _liveEnabled && _liveAllowedVis
            };

            try
            {
                // Callback vacío como en CreateVisualizationCard
                Func<ValueTuple<int, int>, Task> emptyHandler = _ => Task.CompletedTask;
                var emptyEventCallback = EventCallback.Factory.Create<ValueTuple<int, int>>(
                    receiver: this,
                    callback: emptyHandler
                );

                // Visualización temporal para preview
                var tempVisualization = new Visualizacion
                {
                    Username = username,
                    Nombre = _visualizationName,
                    JsonDesign = "{ \"ChartType\": \"" + _selectedChartType + "\" }",
                    FechaDesde = _beginDate.Value.Date + _beginHour.Value,
                    FechaHasta = _endDate.Value.Date + _endHour.Value,
                    IdVisualizacion = 0,
                };

                foreach (var datasetConfig in request.Datasets)
                {
                    var selection = _selectedDatasets.FirstOrDefault(item => item.Dataset.Id == datasetConfig.DatasetId);
                    var datasetName = string.Empty;
                    if (selection != null)
                    {
                        datasetName = selection.Dataset.Nombre;
                    }
                    var nuevoGrupo = new GrupoDataset
                    {
                        DatasetId = datasetConfig.DatasetId,
                        JsonDesign = datasetConfig.JsonDiseño,
                        Dataset = new Datasets
                        {
                            NameDataset = datasetName
                        }

                    };
                    tempVisualization.GrupoDatasets.Add(nuevoGrupo);
                }

                var parameters = new DialogParameters
                {
                    ["VisualizationType"] = 1,
                    ["OnVisualizationCreated"] = emptyEventCallback,
                    ["ChartData"] = tempVisualization
                };

                var options = new DialogOptions
                {
                    CloseOnEscapeKey = true,
                    MaxWidth = MaxWidth.Medium,
                    FullWidth = true
                };

                IDialogReference? dialog = await DialogService.ShowAsync<PreviewVisualizationDialog>(
                    "Preview",
                    parameters,
                    options
                );
                DialogResult? dialogResult = await dialog.Result;

                if (dialogResult.Canceled)
                {
                    return;
                }

                // Si el usuario confirma en el preview, proceder con el PUT
                if (true)
                {
                    HttpResponseMessage? response = await Http.PutAsJsonAsync($"api/Visualizacion/{visualizationId}", request);
                    if (!response.IsSuccessStatusCode)
                    {
                        var error = await response.Content.ReadAsStringAsync();
                        Snackbar.Add($"Error al editar la visualización: {error}", Severity.Error);
                    }
                    else
                    {
                        _mudDialog.Close(DialogResult.Ok(1));
                    }
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(Localizer["ErrorLoadingPreview", ex], Severity.Error);
            }
            
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al editar la visualización: {ex.Message}", Severity.Error);
        }
        StateHasChanged();
    }

    private void Cancel() => _mudDialog.Cancel();

    private string _originalVisualizationName;
    private string _originalChartType;
    private DateTime? _originalBeginDate;
    private TimeSpan? _originalBeginHour;
    private DateTime? _originalEndDate;
    private TimeSpan? _originalEndHour;
    private bool _originalLiveEnabled;
    private DashboardSummaryResponse _originalDashboard;
    private List<DatasetSelection> _originalDatasets = new();


    private void RemoveDataset(DatasetSelection item)
    {
        _selectedDatasets.Remove(item);
        RecomputeLiveAllowed();
        StateHasChanged();
    }
    
    private void OnLiveSwitchChanged(bool value)
    {
        if (!_liveAllowedVis) { return; }
        _liveEnabled = value;
        StateHasChanged();
    }
    
    public class DatasetSelection
    {
        public DatasetDtoGenerico Dataset { get; set; } = new();
        public System.String DisplayName { get; set; } = System.String.Empty;
        public System.String Entity { get; set; } = System.String.Empty;
        public System.String EntityAttribute { get; set; } = System.String.Empty;
        public decimal Multiplier { get; set; }
        public string Color { get; set; } = "rgb(0, 255, 231)";
    }

    private async Task<string> GetEntityFromDatasetAsync(System.Int32 datasetId, System.String module)
    {
        try
        {
            if (module.Equals("Insight Monitor"))
            {
                HttpResponseMessage? response = await Http.GetAsync($"/api/Dataset/GetDataset?datasetId={datasetId}");
                DatasetIM? datasetFromApi = await response.Content.ReadFromJsonAsync<DatasetIM>();

                if (datasetFromApi == null)
                    throw new NullReferenceException("La respuesta del servidor fue vacía.");
                return datasetFromApi.ContentType switch
                {
                    "1" => "Device",
                    "2" => "Source",
                    "3" => "Sensor",
                    "0" => "SensorData",
                };
            }
            else if (module.Equals("Asset Manager"))
            {
                HttpResponseMessage? response = await Http.GetAsync($"api/DatasetAM/GetDatasetAmById?id={datasetId}");
                DatasetAM? datasetFromApi = await response.Content.ReadFromJsonAsync<DatasetAM>();

                if (datasetFromApi == null)
                {
                    throw new NullReferenceException("Error.");
                }
                return datasetFromApi.Type_Dataset switch
                {
                    1 => "EventAM",
                    2 => "Asset",
                    3 => "Stock",
                };

            }
            else if (module.Equals("Urban Monitor"))
            {
                HttpResponseMessage? response = await Http.GetAsync($"api/DatasetUM/GetDatasetById?datasetId={datasetId}");
                DatasetUM? datasetFromApi = await response.Content.ReadFromJsonAsync<DatasetUM>();

                if (datasetFromApi == null)
                    throw new NullReferenceException("La respuesta del servidor fue vacía.");

                return datasetFromApi.DatasetNews.Count > 0 ? "New" : "EventUM";
                return datasetFromApi.ContentType switch
                {
                    "1" => "EventUM",
                    "2" => "New",
                };
            }
            else
            {
                HttpResponseMessage? response = await Http.GetAsync($"api/DatasetEM/{datasetId}");
                DatasetEM? datasetFromApi = await response.Content.ReadFromJsonAsync<DatasetEM>();

                if (datasetFromApi == null)
                    throw new NullReferenceException("Error.");

                return datasetFromApi.ContentType switch
                {
                    "Alert" => "Alert",
                    "Extension" => "Extension",
                    "Event" => "EventEM",
                };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            return string.Empty;
        }
    }

    private void RecomputeLiveAllowed()
    {
        _liveAllowedVis = _selectedDatasets.All(ds =>
            !string.Equals(ds.Dataset.Module, "Asset Manager", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(ds.Dataset.Module, "Urban Monitor", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(ds.Dataset.Module, "AM", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(ds.Dataset.Module, "UM", StringComparison.OrdinalIgnoreCase)
        );
        if (!_liveAllowedVis)
        {
            _liveEnabled = false;
        }
    }

    private void BackupOriginalValues()
    {
        _originalVisualizationName = _visualizationName;
        _originalChartType = _selectedChartType;
        _originalBeginDate = _beginDate;
        _originalBeginHour = _beginHour;
        _originalEndDate = _endDate;
        _originalEndHour = _endHour;
        _originalLiveEnabled = _liveEnabled;
        _originalDashboard = _selectedDashboard == null ? null : new DashboardSummaryResponse
        {
            IdDashboard = _selectedDashboard.IdDashboard,
            Nombre = _selectedDashboard.Nombre
        };
        _originalDatasets = _selectedDatasets.Select(ds => new DatasetSelection
        {
            Dataset = ds.Dataset,
            DisplayName = ds.DisplayName,
            Entity = ds.Entity,
            EntityAttribute = ds.EntityAttribute,
            Multiplier = ds.Multiplier,
            Color = ds.Color
        }).ToList();
    }

    private bool HasChanges()
    {
        if (_visualizationName != _originalVisualizationName) return true;
        if (_selectedChartType != _originalChartType) return true;
        if (_beginDate != _originalBeginDate) return true;
        if (_beginHour != _originalBeginHour) return true;
        if (_endDate != _originalEndDate) return true;
        if (_endHour != _originalEndHour) return true;
        if (_liveEnabled != _originalLiveEnabled) return true;

        // Dashboard
        if ((_selectedDashboard?.IdDashboard ?? -1) != (_originalDashboard?.IdDashboard ?? -1)) return true;

        // Datasets
        if (_selectedDatasets.Count != _originalDatasets.Count) return true;
        for (int i = 0; i < _selectedDatasets.Count; i++)
        {
            var a = _selectedDatasets[i];
            var b = _originalDatasets[i];
            if (a.Dataset.IdGenerico != b.Dataset.IdGenerico ||
                a.DisplayName != b.DisplayName ||
                a.Entity != b.Entity ||
                a.EntityAttribute != b.EntityAttribute ||
                a.Multiplier != b.Multiplier ||
                a.Color != b.Color)
                return true;
        }

        return false;
    }
}
