@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject HttpClient Http
@using OmniMonitor.Shared.Dtos
@using System.Text.Json;
@using MudBlazor.Extensions;
@using Microsoft.Extensions.Localization;
@using Blazored.LocalStorage;
@inject IStringLocalizer<CreateVisualizationCard> Localizer
@inject ILocalStorageService LocalStorage

<MudDialog Style="background-color: var(--fondo-dialog)">

    <DialogContent>
        <MudStack Spacing="3">
            @foreach (DatasetSelection dsItem in _selectedDatasets)
            {
                <MudGrid Class="ml-0 mt-0 pa-5" Style="width: 100%; background-color: var(--card); border-radius: 3px; " Spacing="3">
                    <MudItem Lg="6" Sm="6" Xs="12" Class="pl-0 pt-0">
                        <MudText Typo="Typo.h6">@Localizer["Dataset"]</MudText>
                        <MudSelect T="int" @bind-Value="dsItem.DatasetId" Variant="Variant.Outlined" Dense="true">
                            @foreach (var ds in _datasets)
                            {
                                <MudSelectItem T="int" Value="@ds.Id" Disabled="@(_selectedDatasets.Any(sds => sds.DatasetId == ds.Id && sds.DatasetId != dsItem.DatasetId))">
                                    @ds.Nombre
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem Lg="3" Sm="3" Xs="5" Class="pt-0">
                        <MudText Typo="Typo.h6">@Localizer["Multiplier"]</MudText>
                        <MudNumericField HideSpinButtons="true" 
                                         @bind-Value="dsItem.Multiplier" 
                                         Variant="Variant.Outlined" 
                                         Step=".2M"
                                         Validation="@((decimal m) => m == 0 ? "No puede ser 0" : null)" />
                    </MudItem>

                    <MudItem Lg="2" Sm="2" Xs="5" Class="pt-0">
                        <MudText Typo="Typo.h6">@Localizer["Color"]</MudText>
                        <MudColorPicker @bind-Text="dsItem.Color" Style="@($"color: {dsItem.Color};")" Placeholder="Seleccionar color" Variant="Variant.Outlined"/>
                    </MudItem>
                    <MudItem Lg="1" Sm="1" Xs="2" Class="d-flex align-items-center">
                        <MudButton OnClick="@(() => RemoveDataset(dsItem))">
                            <MudIcon Icon="@Icons.Material.Filled.Close" 
                                     Color="MudBlazor.Color.Error" />
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudStack>
        <MudGrid Class="mt-0 mb-5">
            <MudItem xs="6">
                <MudButton FullWidth="true"
                        Variant="Variant.Outlined" 
                        StartIcon="@Icons.Material.Filled.AddCircleOutline" 
                        Color="MudBlazor.Color.Inherit"
                        Size="MudBlazor.Size.Large"
                        Style="padding: 20px 10px; color: var(--text-primary); background: var(--card); border: 3px solid var(--borde-drawer)">
                    @Localizer["AddSensor"]
                </MudButton>
            </MudItem>
            <MudItem xs="6">
                <MudButton OnClick="AddDataset" 
                        FullWidth="true"
                        Variant="Variant.Outlined" 
                        StartIcon="@Icons.Material.Filled.AddCircleOutline" 
                        Color="MudBlazor.Color.Inherit"
                        Size="MudBlazor.Size.Large"
                        Style="padding: 20px 10px; color: var(--text-primary); background: var(--card); border: 3px solid var(--borde-drawer)"
                        Disabled="@(_datasets.Count == 0 || _selectedDatasets.Count >= _datasets.Count)">
                    @Localizer["AddDataset"]
                </MudButton>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.h6" Style="color: var(--text-primary);">@Localizer["VisualisationName"]</MudText>
        <MudTextField Class="mb-2" @bind-Value="_visualizationName" T="string"
                      Label="@Localizer["Name"]"
                      Variant="Variant.Outlined"
                      Required="true" 
                      RequiredError="El nombre es obligatorio." 
                      Style="background: var(--card);"/>

        <MudText Typo="Typo.h6" Style="color: var(--text-primary);">@Localizer["ChartType"]</MudText>
        <MudSelect T="string" 
                   @bind-Value="_selectedChartType" 
                   Variant="Variant.Outlined"
                   Margin="Margin.Normal"
                   Dense="true"
                   Style="background: var(--card);">
            @foreach (var tipo in _chartTypes)
            {
                <MudSelectItem T="string" Value="@tipo">@tipo</MudSelectItem>
            }
        </MudSelect>

        <MudDivider DividerType="DividerType.Middle" Class="mt-5 mb-10"/>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle1" Style="color: var(--text-primary);">@Localizer["From"]</MudText>
                <MudGrid>
                    <MudItem xs="6">
                        <MudDatePicker Label="@Localizer["Date"]" @bind-Date="_beginDate" DateFormat="dd/MM/yyyy" Required="true" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTimePicker Label="@Localizer["Time"]" @bind-Time="_beginHour" Required="true" />
                    </MudItem>
                </MudGrid>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle1" Style="color: var(--text-primary);">@Localizer["To"]</MudText>
                <MudGrid>
                    <MudItem xs="6">
                        <MudDatePicker Label="@Localizer["Date"]" @bind-Date="_endDate" DateFormat="dd/MM/yyyy" Required="true" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTimePicker Label="@Localizer["Time"]" @bind-Time="_endHour" Required="true" />
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Cancel"]</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" OnClick="Submit">@Localizer["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public required IMudDialogInstance _mudDialog { get; set; }
    [Parameter]
    public System.Int32 visualizationId {get; set;}
    [Parameter]
    public System.Int32 dashboardId {get; set;}

    private List<string> _chartTypes = new List<string>() {"line", "bar", "area", "pie", "donut", "radialBar", "scatter", "heatmap", "radar", "bubble", "candlestick", "boxPlot", "treemap"};
    private string _selectedChartType = "line";

    private DateTime? _beginDate { get; set; }
    private TimeSpan? _beginHour { get; set; }
    private DateTime? _endDate { get; set; }
    private TimeSpan? _endHour { get; set; }
    private string _visualizationName { get; set; } = string.Empty;

    private List<DatasetDto> _datasets = new List<DatasetDto>();
    private List<DatasetSelection> _selectedDatasets = new List<DatasetSelection>();

    private bool ValidateSubmission()
    {
        if (string.IsNullOrWhiteSpace(_visualizationName))
        {
            Snackbar.Add("El nombre de la visualización es obligatorio.", Severity.Warning);
            return false;
        }

        if (!_selectedDatasets.Any())
        {
            Snackbar.Add("Debe seleccionar al menos un dataset.", Severity.Warning);
            return false;
        }

        if (_selectedDatasets.Any(ds => ds.Multiplier == 0))
        {
            Snackbar.Add("El multiplicador de un dataset no puede ser 0.", Severity.Warning);
            return false;
        }

        if (_beginDate == null || _beginHour == null || _endDate == null || _endHour == null)
        {
            Snackbar.Add("Debe especificar una fecha y hora de inicio y fin.", Severity.Warning);
            return false;
        }

        DateTime fullBeginDateTime = _beginDate.Value.Date + _beginHour.Value;
        DateTime fullEndDateTime = _endDate.Value.Date + _endHour.Value;

        if (fullEndDateTime <= fullBeginDateTime)
        {
            Snackbar.Add("La fecha 'Hasta' debe ser posterior a la fecha 'Desde'.", Severity.Warning);
            return false;
        }

        return true;
    }

    private async Task Submit()
    {
        if (!ValidateSubmission())
        {
            return;
        }
        
        try
        {
            AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            string? username = authState.User.Identity?.Name;
            string token = await LocalStorage.GetItemAsync<string>("authToken");

            if (string.IsNullOrEmpty(username))
            {
                Snackbar.Add("No se pudo obtener el usuario actual", Severity.Error);
                return;
            }

            CreateVisualizacionRequest request = new CreateVisualizacionRequest
            {
                Nombre = _visualizationName,
                Username = username,
                JsonDiseñoGeneral = "{ \"ChartType\": \"" + _selectedChartType + "\" }",
                Datasets = _selectedDatasets.Select(ds => new DatasetConfig
                {
                    DatasetId = ds.DatasetId,
                    JsonDiseño =  "{ \"Multiplier\": " + ((double)ds.Multiplier).ToString(System.Globalization.CultureInfo.InvariantCulture) + ", \"Color\": \"" + ds.Color + "\" }"
                }).ToList(),
                FechaDesde = _beginDate.Value.Date + _beginHour.Value,
                FechaHasta = _endDate.Value.Date + _endHour.Value
            };

            HttpResponseMessage? response = await Http.PutAsJsonAsync($"api/Dashboard/{dashboardId}/card/edit?username={username}&idVisualizacion={visualizationId}&jsonConfig=empty", request);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al editar la visualización: {error}", Severity.Error);
            }
            else
            {
                _mudDialog.Close(DialogResult.Ok(true));
                Snackbar.Add("Visualización editada exitosamente", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al editar la visualización: {ex.Message}", Severity.Error);
        }
        StateHasChanged();
    }
    
    private void Cancel() => _mudDialog.Cancel();

    protected override async Task OnInitializedAsync() {
        try {
            AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            string? username = authState.User.Identity?.Name;
            string token = await LocalStorage.GetItemAsync<string>("authToken");

            if (string.IsNullOrEmpty(username)) {
                Snackbar.Add("No se pudo obtener el usuario actual", Severity.Warning);
                _datasets = new List<DatasetDto>();
                return;
            }

            // Obtener la visualización actual
            HttpResponseMessage? responseVisualization = await Http.GetAsync(
                $"api/Visualizacion/GetVisualizacionById?idVisualizacion={visualizationId}&token={token}"
            );
            
            Visualizacion currVisualization = await responseVisualization.Content.ReadFromJsonAsync<Visualizacion>();

            _visualizationName = currVisualization.Nombre;
            _beginDate = currVisualization.FechaDesde.Date;
            _beginHour = currVisualization.FechaDesde.TimeOfDay;
            _endDate = currVisualization.FechaHasta.Date;
            _endHour = currVisualization.FechaHasta.TimeOfDay;
            
            JsonDocument design = JsonDocument.Parse(currVisualization.JsonDesign);
            _selectedChartType = design.RootElement.GetProperty("ChartType").ToString();

            if (currVisualization.GrupoDatasets != null && currVisualization.GrupoDatasets.Any())
            {
                foreach (var grupoDataset in currVisualization.GrupoDatasets)
                {
                    decimal multiplier = 1.0M;
                    string color = "rgb(0, 255, 231)";

                    if (!string.IsNullOrEmpty(grupoDataset.JsonDesign))
                    {
                        try
                        {
                            using var doc = JsonDocument.Parse(grupoDataset.JsonDesign);
                            var root = doc.RootElement;

                            if (root.TryGetProperty("Multiplier", out var multiplierProp))
                            {
                                if (multiplierProp.TryGetDecimal(out var multiplierValue))
                                {
                                    multiplier = multiplierValue;
                                }
                                else if (double.TryParse(multiplierProp.GetRawText(), System.Globalization.CultureInfo.InvariantCulture, out var dVal))
                                {
                                    multiplier = (decimal)dVal;
                                }
                            }

                            if (root.TryGetProperty("Color", out var colorProp) && colorProp.ValueKind == JsonValueKind.String)
                            {
                                color = colorProp.GetString() ?? "rgb(0, 255, 231)";
                            }
                        }
                        catch
                        {
                            // Si falla el parseo, usar valores por defecto
                        }
                    }

                    _selectedDatasets.Add(new DatasetSelection
                    {
                        DatasetId = grupoDataset.DatasetId,
                        Multiplier = multiplier,
                        Color = color
                    });
                }
            }

            HttpResponseMessage? response = await Http.GetAsync($"api/Dataset/user?token=" + token);
            
            if (response.IsSuccessStatusCode) {
                List<DatasetIM>? _datasetsFromApi = await response.Content.ReadFromJsonAsync<List<DatasetIM>>();
                
                _datasets = _datasetsFromApi?.Select(d => new DatasetDto
                {
                    Id = d.Id,
                    Nombre = d.Name,
                    Descripcion = d.Description ?? "Sin descripcion"
                }).ToList() ?? new List<DatasetDto>();
            }
            else {
                Snackbar.Add($"Error al cargar los datasets: {response.StatusCode}", Severity.Error);
                _datasets = new List<DatasetDto>();
            }
        }
        catch (Exception ex) {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            _datasets = new List<DatasetDto>();
        }
    }

    private void AddDataset()
    {
        var firstAvailableDataset = _datasets.FirstOrDefault(d => !_selectedDatasets.Any(sd => sd.DatasetId == d.Id));

        if (firstAvailableDataset == null)
        {
            Snackbar.Add("Todos los datasets disponibles ya han sido agregados.", Severity.Info);
            return;
        }
        
        _selectedDatasets.Add(new DatasetSelection
        {
            DatasetId = firstAvailableDataset.Id,
            Multiplier = 1.0M,
            Color = "rgb(0, 255, 231)"
        });
    }

    private void RemoveDataset(DatasetSelection item)
    {
        _selectedDatasets.Remove(item);
    }
    
    public class DatasetSelection
    {
        public int DatasetId { get; set; }
        public decimal Multiplier { get; set; }
        public string Color { get; set; } = "rgb(0, 255, 231)";
    }
}