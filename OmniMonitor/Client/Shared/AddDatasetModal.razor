@using OmniMonitor.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar
@using MudBlazor
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AddDatasetModal> Localizer
@using System.Text.Json
@using Blazored.LocalStorage
@inject ILocalStorageService LocalStorage

<MudDialog Style="background-color: var(--fondo-dialog)">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: var(--text-primary);">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mb-n1"/>
            @Localizer["AddDataset"]
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudButton FullWidth="true"
                   OnClick="NewDataset"
                   Variant="MudBlazor.Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.AddCircleOutline"
                   Color="MudBlazor.Color.Inherit"
                   Size="MudBlazor.Size.Large"
                   Style="padding: 20px 10px; color: var(--text-primary); background: var(--card); border: 3px solid var(--borde-drawer)">
            @Localizer["NewDataset"]
        </MudButton>

        <MudDivider DividerType="MudBlazor.DividerType.Middle" Class="mt-5 mb-6" />

        <MudText Typo="MudBlazor.Typo.h6" Class="mb-2" Style="color: var(--text-primary);">@Localizer["ExistingDatasets"]</MudText>

        <MudStack Spacing="3" Style="background-color: var(--card)" Class="px-4 py-8">
            @if (_isLoading)
            {
                <MudText Typo="Typo.body2">@Localizer["Loading"]</MudText>
            }
            else if (_datasets.Count == 0)
            {
                <MudText Typo="Typo.body2">@Localizer["NoDatasetsFound"]</MudText>
            }
            else
            {
                @foreach (var ds in _datasets)
                {
                    <MudButton FullWidth="true"
                               Variant="MudBlazor.Variant.Outlined"
                               OnClick="@(() => SelectDataset(ds.Id))"
                               Style="background-color: var(--fondo-dialog); text-transform: none; justify-content: start; border: 1px solid var(--borde-drawer)"
                               Class="pa-0">
                        <MudStack Row="true" AlignItems="MudBlazor.AlignItems.Center" Spacing="3" Class="pa-4">
                            <MudIcon Icon="@Icons.Material.Filled.Menu" Size="MudBlazor.Size.Large" Style="color: var(--text-primary)"/>
                            <MudText Typo="MudBlazor.Typo.body1" Style="color: var(--text-primary)">@(!string.IsNullOrWhiteSpace(ds.Nombre) ? ds.Nombre : (!string.IsNullOrWhiteSpace(ds.Descripcion) ? ds.Descripcion : $"Dataset {ds.Id}"))</MudText>
                        </MudStack>
                    </MudButton>
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">@Localizer["Cancel"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public required IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public EventCallback<int> OnDatasetSelected { get; set; }

    [Parameter]
    public EventCallback OnNewDataset { get; set; }

    private List<DatasetDto> _datasets = new();
    private bool _isLoading = true;
    

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Get token to satisfy server endpoint: GET /api/Dataset/user?token=...
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (string.IsNullOrWhiteSpace(token))
            {
                Snackbar.Add(Localizer["CouldNotGetCurrentUser"], Severity.Warning);
                _datasets = new();
                return;
            }

            var ts = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
            var req = new HttpRequestMessage(HttpMethod.Get, $"api/Dataset/user?token={Uri.EscapeDataString(token)}&_ts={ts}");
            req.Headers.Accept.Clear();
            req.Headers.Accept.ParseAdd("application/json");
            var response = await Http.SendAsync(req, HttpCompletionOption.ResponseHeadersRead);
            if (response.IsSuccessStatusCode)
            {
                var text = await response.Content.ReadAsStringAsync();
                var looksHtml = text.TrimStart().StartsWith("<!DOCTYPE html", StringComparison.OrdinalIgnoreCase)
                                   || text.Contains("<html", StringComparison.OrdinalIgnoreCase);
                if (looksHtml)
                {
                    Snackbar.Add(Localizer["ErrorLoadingDatasets"], Severity.Error);
                    _datasets = new();
                }
                else
                {
                    try
                    {
                        var json = JsonDocument.Parse(text).RootElement;
                        var list = new List<DatasetDto>();
                        if (json.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var el in json.EnumerateArray())
                            {
                                int id = 0;
                                if (el.TryGetProperty("Id", out var idProp) && idProp.TryGetInt32(out var idVal)) id = idVal;
                                else if (el.TryGetProperty("id", out var idProp2) && idProp2.TryGetInt32(out var idVal2)) id = idVal2;

                                string nombre = string.Empty;
                                if (el.TryGetProperty("Nombre", out var n1)) nombre = n1.GetString() ?? string.Empty;
                                else if (el.TryGetProperty("Name", out var n2)) nombre = n2.GetString() ?? string.Empty;
                                else if (el.TryGetProperty("name", out var n3)) nombre = n3.GetString() ?? string.Empty;

                                string descripcion = string.Empty;
                                if (el.TryGetProperty("Descripcion", out var d1)) descripcion = d1.GetString() ?? string.Empty;
                                else if (el.TryGetProperty("Description", out var d2)) descripcion = d2.GetString() ?? string.Empty;
                                else if (el.TryGetProperty("description", out var d3)) descripcion = d3.GetString() ?? string.Empty;

                                list.Add(new DatasetDto { Id = id, Nombre = nombre, Descripcion = descripcion });
                            }
                        }
                        _datasets = list;
                    }
                    catch (Exception ex)
                    {
                        Snackbar.Add(Localizer["ErrorLoadingDatasets"], Severity.Error);
                        _datasets = new();
                    }
                }
            }
            else
            {
                Snackbar.Add(string.Format(Localizer["ErrorLoadingDatasets"], response.StatusCode), Severity.Error);
                _datasets = new();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Localizer["ErrorGeneric"], ex.Message), Severity.Error);
            _datasets = new();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SelectDataset(int id)
    {
        if (OnDatasetSelected.HasDelegate)
        {
            await OnDatasetSelected.InvokeAsync(id);
        }
        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task NewDataset()
    {
        if (OnNewDataset.HasDelegate)
        {
            await OnNewDataset.InvokeAsync();
        }
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
