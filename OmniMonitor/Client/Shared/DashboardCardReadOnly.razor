@using MudBlazor
@using Microsoft.AspNetCore.Components
@using OmniMonitor.Client.Shared

<MudItem lg="@WidthLg" md="@WidthMd" sm="@WidthXs" xs="@WidthXs">
    <MudCard Style="@($"background-color: var(--card); color: var(--card-text-primary); height: {Height}px; border: 1px solid #374151; border-radius:7px;")"
             Outlined="true">
        @if (!_isKpi)
        {
            <ChartViewerPublic @key="_chartViewerKey" ChartReloadKey="@_chartKey" VisualizationId="@VisualizationId" />
        }
        else
        {
            <div class="d-flex flex-grow: 1; pa-5">
                <KpiViewerPublic KpiId="@VisualizationId" />
            </div>
        }
    </MudCard>
</MudItem>

@code {
    [Parameter] public int dashboardId { get; set; }
    [Parameter] public int VisualizationId { get; set; }
    [Parameter] public int VisualizationType { get; set; }
    [Parameter] public int WidthLg { get; set; }
    [Parameter] public int WidthMd { get; set; }
    [Parameter] public int WidthXs { get; set; }
    [Parameter] public int Height { get; set; }

    private bool _isKpi;
    private int _chartViewerKey;
    private int _chartKey;

    protected override void OnParametersSet()
    {
        _isKpi = VisualizationType == 2;
    }
}
