@using Microsoft.Extensions.Localization
@using System.ComponentModel.DataAnnotations
@inject IStringLocalizer<Dashboard> Localizer
@inject IDialogService DialogService
@inject Microsoft.JSInterop.IJSRuntime JS

<MudBreakpointProvider>
    <MudGrid Class="pa-10 dashboard" Spacing="6">
        @for (int i = 0; i < CardsData.Count; i++)
        {
            var (id, type, anchoSm, anchoMd, anchoLg, alto) = CardsData[i];

            <DashboardCard @key=@($"V{id}_{type}")
                dashboardId=@dashboardId 
                VisualizationId=@id
                VisualizationType=@type
                Index=@i
                WidthXs=@anchoSm 
                WidthMd=@anchoMd 
                WidthLg=@anchoLg 
                Height=@alto 
                UpdateCardSize="UpdateCardSize" 
                RemoveCard="RemoveCard"
                DragStarted="OnCardDragStart"
                DroppedOn="OnCardDroppedOn">
            </DashboardCard>
        }
        <MudItem xs="12" lg="3" md="6" @onclick="OpenDialogCreateCard">
            <MudPaper Class="add-card-widget d-flex flex-column justify-center align-center mud-width-full pa-10"
                      Style="background-color: var(--card);
                         color: var(--card-text-primary);
                         cursor: pointer;
                         border: 1px solid #374151;
                         border-radius: 7px;
                         height: 100%"
                      Elevation="2">

                <MudIcon Icon="@Icons.Material.Filled.Add" Size="MudBlazor.Size.Large" />

                <MudText Typo="Typo.h6" Class="mt-4" Align="MudBlazor.Align.Center"
                         Style="color: var(--card-text-primary)">
                    @Localizer["AgregarNuevaGrafica"]
                </MudText>

                <MudText Typo="Typo.body2" Class="mt-2" Align="MudBlazor.Align.Center"
                         Style="color: var(--card-text-secondary)">
                    @Localizer["TextoCrearGraficoKPI"]
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudBreakpointProvider>

@code {
    [Parameter] [Required] public System.Int32 dashboardId {get; set;}
    [Parameter] public List<(System.Int32, System.Int32, System.Int32, System.Int32, System.Int32, System.Int32)> CardsData { get; set; } = new List<(System.Int32, System.Int32, System.Int32, System.Int32, System.Int32, System.Int32)>();
    
    [Parameter] public EventCallback<(int Id, int Type)> OnVisualizationCreated { get; set; }
    [Parameter] public EventCallback<(int,int,int,int,int,int)> UpdateCardSize { get; set; }
    [Parameter] public EventCallback<(int,int)> RemoveCard { get; set; }

    private int? _draggingIndex;

    private void OnCardDragStart(int startedIndex)
    {
        _draggingIndex = startedIndex;
    }

    private async Task OnCardDroppedOn(int targetIndex)
    {
        if (_draggingIndex == null || _draggingIndex == targetIndex)
            return;

        int fromIndex = _draggingIndex.Value;
        int toIndex = targetIndex;
        if (fromIndex < 0 || toIndex < 0 || fromIndex >= CardsData.Count || toIndex >= CardsData.Count)
            return;

        // Swap items
        var temp = CardsData[fromIndex];
        CardsData[fromIndex] = CardsData[toIndex];
        CardsData[toIndex] = temp;

        _draggingIndex = null;
        try { await JS.InvokeVoidAsync("console.log", $"Dashboard swap: swapped indices {fromIndex} and {toIndex}"); } catch {}
        StateHasChanged();
    }

    private async Task OpenDialogCreateCard()
    {
        DialogOptions? options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium };
        DialogParameters parameters = new DialogParameters { ["dashboardId"] = dashboardId, ["OnVisualizationCreated"] = OnVisualizationCreated };
        IDialogReference? dialog = await DialogService.ShowAsync<AddVisualizationDashboard>("Agregar visualizacion", parameters, options);
        DialogResult? result = await dialog.Result;
    }
}
