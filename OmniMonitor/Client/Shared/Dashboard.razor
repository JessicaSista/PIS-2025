@using Microsoft.Extensions.Localization
@using System.ComponentModel.DataAnnotations
@inject IStringLocalizer<Dashboard> Localizer
@inject IDialogService DialogService

<MudBreakpointProvider>
    <MudGrid Class="pa-10 dashboard" Spacing="6">
        @for (int i = 0; i < CardsData.Count; i++)
        {
            @* var (esKPI, _widget) = Widgets[i]; *@
            
            var (id, ancho, alto) = CardsData[i];

            <DashboardCard VisualizationId=@id Width=@ancho Height=@alto></DashboardCard>
        }
        <MudItem xs="12" lg="3" md="6" @onclick="OpenDialogCreateCard">
            <MudPaper Class="add-card-widget d-flex flex-column justify-center align-center mud-width-full pa-10"
                      Style="background-color: var(--card);
                         color: var(--card-text-primary);
                         cursor: pointer;
                         border: 1px solid #374151;
                         border-radius: 7px;"
                      Elevation="2">

                <MudIcon Icon="@Icons.Material.Filled.Add" Size="MudBlazor.Size.Large" />

                <MudText Typo="Typo.h6" Class="mt-4" Align="MudBlazor.Align.Center"
                         Style="color: var(--card-text-primary)">
                    @Localizer["AgregarNuevaGrafica"]
                </MudText>

                <MudText Typo="Typo.body2" Class="mt-2" Align="MudBlazor.Align.Center"
                         Style="color: var(--card-text-secondary)">
                    @Localizer["TextoCrearGraficoKPI"]
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudBreakpointProvider>

