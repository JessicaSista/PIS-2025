@using MudBlazor

<MudButton Variant="Variant.Filled"
           Class="add-button"
           StartIcon="@Icons.Material.Filled.Add"
           OnClick="OnClick"
           Href="@Href"
           Disabled="@Disabled">
    @ChildContent
</MudButton>

<style>
    .add-button {
        background-color: var(--action-button);
        color: var(--action-button-text);
        border: 1px solid var(--action-button);
        font-weight: 500;
        text-transform: none;
        border-radius: 0.5rem;
        padding: 0.5rem 1rem;
        font-family: Inter, Roboto, sans-serif;
        box-shadow: none;
        transition: background-color 0.16s ease, color 0.16s ease, transform 0.12s ease;
    }

        .add-button:hover {
            background-color: color-mix(in srgb, var(--action-button) 85%, black);
            transform: translateY(-1px) scale(1.01);
        }


        .add-button:active {
            transform: scale(0.995);
        }

        .add-button:focus {
            outline-offset: 2px;
        }
</style>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? CssClass { get; set; }
}
