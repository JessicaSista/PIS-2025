@using Blazored.LocalStorage
@using OmniMonitor.Shared.Dtos
@using System.Text.Json
@using System.Globalization
@using System.ComponentModel.DataAnnotations
@inject ISnackbar Snackbar
@inject HttpClient Http
@inject IDialogService DialogService
@inject ILocalStorageService LocalStorage
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AddVisualizationDashboard> Localizer

<MudDialog Style="background-color: var(--fondo-dialog)">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: var(--text-primary);">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mb-n1"/>
            @Localizer["NuevaVisualizacionTitulo"]
        </MudText>
    </TitleContent>
    <DialogContent>
    <MudButton FullWidth="true"
                OnClick="OpenCreateVisualizationDialog"
                Variant="MudBlazor.Variant.Outlined"
                StartIcon="@Icons.Material.Filled.AddCircleOutline"
                Color="MudBlazor.Color.Inherit"
                Size="MudBlazor.Size.Large"
                Style="padding: 20px 10px; color: var(--text-primary); background: var(--card); border: 3px solid var(--borde-drawer)">
        @Localizer["NuevaVisualizacionBoton"]
    </MudButton>

    <MudDivider DividerType="MudBlazor.DividerType.Middle" Class="mt-5 mb-6" />

    <MudText Typo="MudBlazor.Typo.h6" Class="mb-2" Style="color: var(--text-primary);">@Localizer["VisualizacionesExistentes"]</MudText>

    @{
        var availableVisualizations = _visualizations.Where(v => !UsedVisualizations.Contains((v.IdVisualizacion,1))).ToList();
        var availableKpis = _kpiResponses.Where(k => !UsedVisualizations.Contains((k.Id,2))).ToList();
    }

    @if (!availableVisualizations.Any() && !availableKpis.Any())
    {
        <MudStack Spacing="3" Style="background-color: var(--card)" Class="px-4 py-8">
            <MudText Typo="MudBlazor.Typo.body2" Class="mt-2" Style="color: var(--text-primary); opacity: 0.8;">@Localizer["NoVisualizacionesDisponibles"]</MudText>
        </MudStack>
    }

    @if (availableVisualizations.Any())
    {
    <MudStack Spacing="3" Style="background-color: var(--card)" Class="px-4 py-8">
        @foreach(Visualizacion visualization in availableVisualizations){
            JsonDocument design = JsonDocument.Parse(visualization.JsonDesign);
            System.String chartType = design.RootElement.GetProperty("ChartType").ToString();
            <MudButton FullWidth="true"
                    Variant="MudBlazor.Variant.Outlined"
                    OnClick="@(() => HandleVisualizationClick(visualization.IdVisualizacion,1))"
                    Style="@($"background-color: var(--fondo-dialog); text-transform: none; justify-content: start; border: 1px solid var(--borde-drawer)")"
                    Class="pa-0">
                <MudStack Row="true" AlignItems="MudBlazor.AlignItems.Center" Spacing="3" Class="pa-4">
                    <MudIcon Icon="@GetIcon(chartType)" Size="MudBlazor.Size.Large" Style="color: var(--text-primary)"/>
                    <MudText Typo="MudBlazor.Typo.body1" Style="color: var(--text-primary)">@visualization.Nombre</MudText>
                </MudStack>
            </MudButton>
        }
    </MudStack>
    }

    @if (availableKpis.Any())
    {
    <MudStack Spacing="3" Style="background-color: var(--card)" Class="px-4 py-8">
        @foreach(KpiSimpleDto kpi in availableKpis){
            @* JsonDocument design = JsonDocument.Parse(visualization.JsonDesign);
            System.String chartType = design.RootElement.GetProperty("ChartType").ToString(); *@
            <MudButton FullWidth="true"
                    Variant="MudBlazor.Variant.Outlined"
                    OnClick="@(() => HandleVisualizationClick(kpi.Id,2))"
                    Style="@($"background-color: var(--fondo-dialog); text-transform: none; justify-content: start; border: 1px solid var(--borde-drawer)")"
                    Class="pa-0">
                <MudStack Row="true" AlignItems="MudBlazor.AlignItems.Center" Spacing="3" Class="pa-4">
                    
                    <MudText Typo="MudBlazor.Typo.body1" Style="color: var(--text-primary)">@kpi.Name</MudText>
                </MudStack>
            </MudButton>
        }
    </MudStack>
    }
</DialogContent>
</MudDialog>

@code
{
    [CascadingParameter]  private IMudDialogInstance MudDialog { get; set; }

    [Parameter] [Required] public System.Int32 dashboardId {get; set;}
    [Parameter] public List<(int,int)> UsedVisualizations { get; set; } = new List<(int,int)>();

    [Parameter] public EventCallback<(int,int)> OnVisualizationCreated { get; set; }

    private List<Visualizacion> _visualizations = new List<Visualizacion>();

    private List<KpiSimpleDto> _kpiResponses = new List<KpiSimpleDto>();

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog.Cancel();

    
    private async Task HandleVisualizationClick(int visualizationId, int vissualizationType)
    {
        try
        {
            // List<object>? visualizationData = await GetVisualizationData(visualization);

            DialogParameters parameters = new DialogParameters
            {
                // ["visualization"] = visualization,
                // ["visualizationData"] = visualizationData,
                ["dashboardId"] = dashboardId,
                ["VisualizationId"] = visualizationId,
                ["VisualizationType"] = vissualizationType,
                ["OnVisualizationCreated"] = OnVisualizationCreated
            };


            DialogOptions options = new DialogOptions 
            { 
                CloseOnEscapeKey = true, 
                MaxWidth = MaxWidth.Medium,
                FullWidth = true
            };

            IDialogReference? dialog = await DialogService.ShowAsync<PreviewVisualizationDialog>(
                Localizer["PreviewTitulo"], 
                parameters, 
                options
            );
            DialogResult? dialogResult = await dialog.Result;

            if (!dialogResult.Canceled)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            
        }
        catch (Exception ex)
        {
            Snackbar.Add(Localizer["ErrorCargarPreview"] + ": " + ex.Message, Severity.Error);
        }
    }

    private async Task OpenCreateVisualizationDialog()
    {
        DialogOptions? options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium };
        IDialogReference? dialog = await DialogService.ShowAsync<CreateVisualizationCard>(Localizer["CrearVisualizacionTitulo"], options);
        DialogResult? result = await dialog.Result;
        
        if (!result.Canceled)
        {
            try
            {
                HttpResponseMessage? response = await Http.GetAsync("api/Visualizacion/GetAllVisualizaciones");

                if (response.IsSuccessStatusCode)
                {
                    List<Visualizacion>? visualizacionesFromApi = await response.Content.ReadFromJsonAsync<List<Visualizacion>>();
                    if (visualizacionesFromApi != null)
                    {
                        _visualizations = visualizacionesFromApi;
                    }
                }
            }
            catch (Exception ex)
            {
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            string token = await LocalStorage.GetItemAsync<string>("authToken");

            HttpResponseMessage? response = await Http.GetAsync("api/Visualizacion/GetAllVisualizaciones");

            if (response.IsSuccessStatusCode)
            {
                List<Visualizacion>? visualizacionesFromApi = await response.Content.ReadFromJsonAsync<List<Visualizacion>>();
                if (visualizacionesFromApi != null)
                {
                    _visualizations = visualizacionesFromApi;
                }
            }

            HttpResponseMessage? kpiResponse = await Http.GetAsync("api/Kpi/GetAllKpiDtoPaginated?page=1&pageSize=1000");
            if (kpiResponse.IsSuccessStatusCode)
            {
                var kpisFromApi = await kpiResponse.Content.ReadFromJsonAsync<KpiSimplePaginatedResponse>();
                if (kpisFromApi != null)
                {
                    _kpiResponses = kpisFromApi.Items;
                }
            }
        }
        catch (Exception ex)
        {
        }
    }

    private string GetIcon(string chartType)
    {
        return chartType switch
        {
            "line"         => Icons.Material.Filled.ShowChart,
            "bar"          => Icons.Material.Filled.BarChart,
            "area"         => Icons.Material.Filled.StackedLineChart,
            "pie"          => Icons.Material.Filled.PieChart,
            "donut"        => Icons.Material.Filled.DonutLarge,
            "radialBar"    => Icons.Material.Filled.DonutSmall,
            "scatter"      => Icons.Material.Filled.BubbleChart,
            "heatmap"      => Icons.Material.Filled.GridOn,
            "radar"        => Icons.Material.Filled.Radar,
            "bubble"       => Icons.Material.Filled.BubbleChart,
            "candlestick"  => Icons.Material.Filled.CandlestickChart,
            "boxPlot"      => Icons.Material.Filled.Analytics,
            "treemap"      => Icons.Material.Filled.AccountTree,
            _              => Icons.Material.Filled.InsertChart
        };
    }

    private async Task<List<object>> GetVisualizationData(Visualizacion visualization)
    {
        List<object> allData = new List<object>();

        try
        {
            DateTime dateFrom = visualization.FechaDesde;
            DateTime dateTo = visualization.FechaHasta;

            foreach (GrupoDataset grupoDataset in visualization.GrupoDatasets)
            {
                try
                {
                    decimal multiplier = 1.0M;
                    System.String color = "#00FFE7";
                    
                    if (!string.IsNullOrEmpty(grupoDataset.JsonDesign))
                    {
                        try
                        {
                            JsonDocument? designDoc = JsonDocument.Parse(grupoDataset.JsonDesign);
                            if (designDoc.RootElement.TryGetProperty("Multiplier", out JsonElement multProp))
                            {
                                multiplier = multProp.GetDecimal();
                            }
                            if (designDoc.RootElement.TryGetProperty("Color", out JsonElement colorProp))
                            {
                                color = colorProp.GetString() ?? "#00FFE7";
                            }
                        }
                        catch (Exception ex)
                        {
                        }
                    }

                    HttpResponseMessage? response = await Http.GetAsync(
                        $"api/Dataset/GetDataset?datasetId={grupoDataset.Dataset.Id}"
                    );
                    
                    
                    if (response.IsSuccessStatusCode)
                    {
                        var dataset = await response.Content.ReadFromJsonAsync<DatasetIM>();
                        
                        if (dataset != null)
                        {
                            if (dataset.DatasetDevices != null && dataset.DatasetDevices.Any())
                            {
                                foreach (var datasetDevice in dataset.DatasetDevices)
                                {                                    
                                    try
                                    {
                                        string sensorUrl = $"api/SondaMain/sensors/data?deviceId={datasetDevice.Id_device}&sensorName={dataset.SensorName}&dateFrom={dateFrom.ToString("o", new CultureInfo("en-US"))}&dateTo={dateTo.ToString("o", new CultureInfo("en-US"))}";
                                        HttpResponseMessage? sensorDataResponse = await Http.GetAsync(sensorUrl);

                                        if (sensorDataResponse.IsSuccessStatusCode)
                                        {
                                            List<SensorData>? sensorData = await sensorDataResponse.Content.ReadFromJsonAsync<List<SensorData>>();
                                            
                                            if (sensorData != null && sensorData.Any())
                                            {                                                
                                                foreach (SensorData data in sensorData)
                                                {
                                                    
                                                    decimal numericValue;

                                                    if (Decimal.TryParse(data.Data.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal parsedDecimal))
                                                    {
                                                        numericValue = parsedDecimal;
                                                    }
                                                    else
                                                    {
                                                        numericValue = data.Data.ToString().Equals("True", StringComparison.OrdinalIgnoreCase) ? 1 : 0;
                                                    }

                                                    allData.Add(new
                                                    {
                                                        Timestamp = data.Time,
                                                        Value = numericValue * multiplier,
                                                        Color = color,
                                                        DatasetName = dataset.Name,
                                                        SensorName = dataset.SensorName,
                                                        DeviceId = datasetDevice.Id_device
                                                    });
                                                }
                                            }
                                        }
                                        else
                                        {
                                            System.String errorContent = await sensorDataResponse.Content.ReadAsStringAsync();
                                        }
                                    }
                                    catch (Exception ex)
                                    {
                                    }
                                }
                            }
                            else
                            {
                            }
                        }
                        else
                        {
                        }
                    }
                    else
                    {
                    }
                }
                catch (Exception ex)
                {
                }
            }
            // Ordenar por timestamp
            if (allData.Any())
            {
                allData = allData
                    .OrderBy(d => 
                    {
                        var type = d.GetType();
                        var timestampProp = type.GetProperty("Timestamp");
                        return timestampProp?.GetValue(d);
                    })
                    .ToList();
                
            }
            else
            {
            }
        }
        catch (Exception ex)
        {
        }

        return allData;
    }

}
