@using MudBlazor
@using Blazored.LocalStorage
@using OmniMonitor.Shared.Dtos
@using Microsoft.Extensions.Localization
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject IStringLocalizer<VisualizationCard> Localizer
@inject OmniMonitor.Client.Services.SignalR.KpiHubClient KpiHubClient
@implements IAsyncDisposable

<MudPaper Class="pa-4 kpi-card" Style="@CardStyle">
    <MudCard Elevation="0"
             Style="background-color: transparent; display:flex; flex-direction:column; height:100%;">
        <MudCardContent Style="flex:1; display:flex; flex-direction:column;">

            @if (_connState == OmniMonitor.Client.Services.SignalR.ConnectionState.Reconnecting)
            {
                <div style="align-self:flex-end; margin-bottom:4px;">
                    <MudChip T="string" Color="MudBlazor.Color.Warning" Variant="Variant.Outlined" Size="MudBlazor.Size.Small">Reconnecting…</MudChip>
                </div>
            }
            else if (_connState == OmniMonitor.Client.Services.SignalR.ConnectionState.Disconnected && _liveJoined)
            {
                <div style="align-self:flex-end; margin-bottom:4px;">
                    <MudChip T="string" Color="MudBlazor.Color.Error" Variant="Variant.Outlined" Size="MudBlazor.Size.Small">Disconnected</MudChip>
                </div>
            }

            <!-- Name -->
            <MudTooltip Text="@Kpi.Name">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="mb-4">
                    <MudText Typo="Typo.h6"
                             Style="color: var(--card-text-primary);
                                    font-weight:600;
                                    white-space: nowrap;
                                    overflow: hidden;
                                    text-overflow: ellipsis;">
                        @Kpi.Name
                    </MudText>
                    @if (LiveOn && (Kpi?.LiveEnabled ?? false))
                    {
                        <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Color="MudBlazor.Color.Error" Size="MudBlazor.Size.Small" />
                    }
                </MudStack>
            </MudTooltip>

            <!-- Value -->
            @if (string.IsNullOrEmpty(Kpi.Value?.ToString()) || Kpi.Value?.ToString() == "�")
            {
                <MudContainer Class="d-flex justify-center align-center" Style="min-height: 60px">
                    <MudButton Disabled="@_isLoading" OnClick="LoadKpiData" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.CloudDownload" Style="color: var(--card-text-secondary)">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Class="ms-n1" Size="MudBlazor.Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">@Localizer["LoadingData"]</MudText>
                        }
                        else
                        {
                            <MudText>@Localizer["LoadData"]</MudText>
                        }
                    </MudButton>
                </MudContainer>
            }
            else if (_isLoading)
            {
                <MudButton Variant="Variant.Filled"
                           Disabled="true"
                           EndIcon="@Icons.Material.Filled.CloudDownload"
                           Style="background-color:#d6ffd6; color:#111; font-weight:600; border-radius:6px; width:160px;">
                    @Localizer["LoadingData"]
                </MudButton>
            }
            else if (Kpi.Value is null || (Kpi.Value is string s && (string.IsNullOrWhiteSpace(s) || s == "—")))
            {
                <MudText Typo="Typo.body2"
                         Style="color: var(--card-text-secondary); font-weight: bold;">
                    @Localizer["NoData"]
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.h4"
                         Style="color: var(--card-text-primary)">
                    @Kpi.Value?.ToString()
                </MudText>
            }

            <!-- Description -->
            @if (!string.IsNullOrEmpty(Kpi.Description))
            {
                <MudText Typo="Typo.body2"
                         Style="color: var(--card-text-secondary);
                                    margin-top:4px;
                                    white-space: normal;
                                    word-wrap: break-word;
                                    overflow-wrap: break-word;">
                    @Kpi.Description
                </MudText>
            }

            <!-- Footer (no 'Actualizado' porque no viene del backend) -->
        </MudCardContent>
    </MudCard>
</MudPaper>

@code {
    [Parameter]
    public int KpiId { get; set; } = 0;
    [Parameter]
    public KpiResponse Kpi { get; set; } = new();
    [Parameter]
    public bool IsPreview { get; set; } = false;
    [CascadingParameter] public bool LiveOn { get; set; }
    private DateTime _lastUpdatedAt = default;

    protected override async Task OnInitializedAsync()
    {
        await LoadKpiData();
        await SetupLiveAsync();
    }

    private bool _liveJoined = false;
    private OmniMonitor.Client.Services.SignalR.ConnectionState _connState = OmniMonitor.Client.Services.SignalR.ConnectionState.Connected;

    private async Task SetupLiveAsync()
    {
        if (LiveOn && KpiId != 0 && (Kpi?.LiveEnabled ?? false))
        {
            try
            {
                KpiHubClient.ConnectionStateChanged += OnConnStateChanged;
                KpiHubClient.KpiUpdated += OnKpiUpdated;
                await KpiHubClient.JoinKpiAsync(KpiId);
                _liveJoined = true;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Live join failed for KPI {KpiId}: {ex.Message}");
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (KpiId == 0) return;
        if (LiveOn && (Kpi?.LiveEnabled ?? false))
        {
            if (!_liveJoined)
            {
                await SetupLiveAsync();
            }
        }
        else
        {
            if (_liveJoined)
            {
                try { await KpiHubClient.LeaveKpiAsync(KpiId); } catch { }
                KpiHubClient.KpiUpdated -= OnKpiUpdated;
                KpiHubClient.ConnectionStateChanged -= OnConnStateChanged;
                _liveJoined = false;
            }
        }
    }

    private void OnKpiUpdated(KpiResponse resp)
    {
        if (resp == null || resp.Id != KpiId) return;
        Kpi = resp;
        _lastUpdatedAt = DateTime.Now;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnConnStateChanged(OmniMonitor.Client.Services.SignalR.ConnectionState state)
    {
        _connState = state;
        _ = InvokeAsync(StateHasChanged);
    }

    private string CardStyle =>
        $"background-color:{GetTransparentColor(Kpi.ActualColor ?? "#00FFE7", 0.15)}; " +
        $"border:2px solid {Kpi.ActualColor ?? "#00FFE7"}; " +
        $"border-radius: 2px; flex-grow: 1;";

    private string GetTransparentColor(string colorInput, double opacity)
    {
        if (string.IsNullOrWhiteSpace(colorInput)) return colorInput;

        if (colorInput.StartsWith("#") && (colorInput.Length == 7 || colorInput.Length == 4))
        {
            try
            {
                string hex = colorInput.Substring(1);
                if (hex.Length == 3) hex = string.Concat(hex.Select(c => new string(c, 2)));

                int r = int.Parse(hex.Substring(0, 2), System.Globalization.NumberStyles.HexNumber);
                int g = int.Parse(hex.Substring(2, 2), System.Globalization.NumberStyles.HexNumber);
                int b = int.Parse(hex.Substring(4, 2), System.Globalization.NumberStyles.HexNumber);
                return $"rgba({r},{g},{b},{opacity.ToString(System.Globalization.CultureInfo.InvariantCulture)})";
            }
            catch { return colorInput; }
        }

        var parts = colorInput.Replace("rgb(", "").Replace(")", "").Split(',');
        if (parts.Length == 3)
        {
            return $"rgba({parts[0].Trim()},{parts[1].Trim()},{parts[2].Trim()},{opacity.ToString(System.Globalization.CultureInfo.InvariantCulture)})";
        }

        return colorInput;
    }

    private bool _isLoading = false;
    private bool _triedLoad = false;

    private async Task LoadKpiData()
    {
        _isLoading = true;
        try
        {
            if(!IsPreview)
            {
                var response = await Http.GetAsync($"api/KPI/{KpiId}");
                if (response.IsSuccessStatusCode)
                {
                    var kpi = await response.Content.ReadFromJsonAsync<KpiResponse>();
                    if (kpi != null)
                    {
                        Kpi = kpi;
                    }
                }
            }        
        }
        finally
        {
            _isLoading = false;
            _triedLoad = true;
            StateHasChanged();
        }
    }
    public async ValueTask DisposeAsync()
    {
        try { await KpiHubClient.LeaveKpiAsync(KpiId); } catch { }
        KpiHubClient.KpiUpdated -= OnKpiUpdated;
        KpiHubClient.ConnectionStateChanged -= OnConnStateChanged;
        _liveJoined = false;
    }
}
