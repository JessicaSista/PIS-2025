# EditorConfig para C# - Smart Cities & Mobility (versión 1.9)
# Colocarlo en la raíz de la solución

root = true

# All files
[*]
charset = utf-8
insert_final_newline = true

[*.cs]
charset = utf-8

############################################
# 🔤 Nomenclatura
############################################

# Clases, métodos y propiedades -> UpperCamelCase
dotnet_naming_rule.class_members_should_be_upper_camel_case.severity = warning
dotnet_naming_rule.class_members_should_be_upper_camel_case.symbols = class_members
dotnet_naming_rule.class_members_should_be_upper_camel_case.style = upper_camel_case_style

dotnet_naming_symbols.class_members.applicable_kinds = property, method, event
dotnet_naming_style.upper_camel_case_style.capitalization = pascal_case

# Interfaces -> I + UpperCamelCase
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.severity = warning
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.style = interface_prefix_style

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.interface_prefix_style.required_prefix = I
dotnet_naming_style.interface_prefix_style.capitalization = pascal_case

# Variables locales y parámetros -> lowerCamelCase
dotnet_naming_rule.locals_should_be_lower_camel_case.severity = suggestion
dotnet_naming_rule.locals_should_be_lower_camel_case.symbols = locals
dotnet_naming_rule.locals_should_be_lower_camel_case.style = lower_camel_case_style

dotnet_naming_symbols.locals.applicable_kinds = local, parameter
dotnet_naming_style.lower_camel_case_style.capitalization = camel_case

# Campos privados -> _lowerCamelCase
dotnet_naming_rule.private_fields_should_be_prefixed_with_underscore.severity = suggestion
dotnet_naming_rule.private_fields_should_be_prefixed_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_prefixed_with_underscore.style = private_field_style

dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_style.private_field_style.required_prefix = _
dotnet_naming_style.private_field_style.capitalization = camel_case

############################################
# 🧱 Estilo general y buenas prácticas
############################################

# Siempre usar using (en lugar de Close/Dispose manual)
csharp_prefer_using_declaration = true:warning

# Requerir llaves {} en todas las estructuras
csharp_prefer_braces = true:warning

# Evitar “var” cuando el tipo no es evidente
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Requerir inicialización explícita de variables
dotnet_diagnostic.CS0649.severity = warning

# No dejar warnings sin resolver
dotnet_analyzer_diagnostic.severity = warning

# Preferir interpolación de strings
csharp_style_prefer_interpolated_string = true:suggestion

# Preferir string.Empty en lugar de ""
dotnet_diagnostic.IDE0071.severity = suggestion

# Preferir string.Equals / IsNullOrEmpty en lugar de ==
dotnet_diagnostic.CA1307.severity = warning

############################################
# 🧮 Organización del código
############################################

# Orden de miembros dentro de clase
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

# Quitar usings innecesarios
dotnet_remove_unnecessary_imports = true

# Ordenar miembros por nivel de acceso (public → private)
dotnet_style_qualification_for_field = true:suggestion
dotnet_style_qualification_for_property = true:suggestion
dotnet_style_qualification_for_method = true:suggestion

############################################
# 🧠 Diseño y mantenibilidad
############################################

# Una clase por archivo
dotnet_diagnostic.SA1402.severity = warning

# Métodos con máximo 5 parámetros
dotnet_diagnostic.CA1505.severity = warning

# Evitar duplicación de código
dotnet_diagnostic.CA1502.severity = warning

# Complejidad ciclomática alta
dotnet_code_quality_metrics_cyclomatic_complexity = 10

# Evitar comentarios redundantes
dotnet_diagnostic.SA1123.severity = suggestion

############################################
# 💬 Logging y errores
############################################

# Exigir uso de LogError / LogInformation definidos
dotnet_diagnostic.CA1848.severity = suggestion

# No mostrar errores en Output (capturarlos)
dotnet_diagnostic.CA2201.severity = warning

############################################
# 🌐 Internacionalización y cultura
############################################

# Evitar dependencias culturales en strings
dotnet_diagnostic.CA1305.severity = warning

# Uso de recursos centralizados (LanguageResource)
dotnet_diagnostic.CA1304.severity = suggestion

# IDE0290: Usar constructor principal
dotnet_diagnostic.IDE0290.severity = none

# SA1101: Prefix local calls with this
dotnet_diagnostic.SA1101.severity = none

# SA1600: Elements should be documented
dotnet_diagnostic.SA1600.severity = none

# SA1309: Field names should not begin with underscore
dotnet_diagnostic.SA1309.severity = none

# SA1633: File should have header
dotnet_diagnostic.SA1633.severity = none

# SA1649: File name should match first type name
dotnet_diagnostic.SA1649.severity = none

# CS0114: El miembro oculta el miembro heredado. Falta una contraseña de invalidación
dotnet_diagnostic.CS0114.severity = none

# SA1611: Element parameters should be documented
dotnet_diagnostic.SA1611.severity = none

# SA1115: Parameter should follow comma
dotnet_diagnostic.SA1115.severity = none

# SA1009: Closing parenthesis should be spaced correctly
dotnet_diagnostic.SA1009.severity = none

# SA1011: Closing square brackets should be spaced correctly
dotnet_diagnostic.SA1011.severity = none

# SA1010: Opening square brackets should be spaced correctly
dotnet_diagnostic.SA1010.severity = none

# IDE0028: Simplificar la inicialización de la recopilación
dotnet_diagnostic.IDE0028.severity = none

# SA1200
dotnet_diagnostic.SA1200.severity = none

dotnet_diagnostic.IDE0058.severity = none

dotnet_diagnostic.IDE0009.severity = none

dotnet_diagnostic.CA2254.severity = none

dotnet_diagnostic.IDE0046.severity = none

dotnet_diagnostic.SA1615.severity = none

dotnet_diagnostic.IDE0055.severity = none